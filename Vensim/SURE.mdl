	~	CHF/kW
	~		|

Share of consumers considering PV weight=
	1.68632
	~	
	~		|

"PV total earnings 30 - 100 kW"[District]=
	IF THEN ELSE( Time < 2016 , 
	
	( - PV annual mantainance cost * "PV annual generation 30 - 100 kW" +  
	"PV annual generation 30 - 100 kW" * "PV FiT 30 - 100 kW" ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ 20 ) ) ) / Interest rate , 
	
	( "PV annual generation 30 - 100 kW" * "Average SC 30 - 100 kW" * Electricity price[\
		District] -
	PV annual mantainance cost * "PV annual generation 30 - 100 kW" + 
	"PV annual generation 30 - 100 kW" * ( 1 - "Average SC 30 - 100 kW" ) * PV cumulative compensation price\
		 ) * ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate )
	~	CHF
	~		|

"PV total earnings > 100 kW"[District]=
	IF THEN ELSE( Time < 2016 , 
	
	( - PV annual mantainance cost * "PV annual generation > 100 kW" +  
	"PV annual generation > 100 kW" * "PV FiT > 100 kW" ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ 20 ) ) ) / Interest rate , 
	
	( "PV annual generation > 100 kW" * "Average SC > 100 kW" * Electricity price[District\
		] -
	PV annual mantainance cost * "PV annual generation > 100 kW" + 
	"PV annual generation > 100 kW" * ( 1 - "Average SC > 100 kW" ) * PV cumulative compensation price\
		 ) * ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate )
	~	CHF
	~		|

