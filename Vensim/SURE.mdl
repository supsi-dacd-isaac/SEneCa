Self consumption degree with Storage[District,HS,Performance,Type]=
	IF THEN ELSE( kWh over MWh of demand[District,HS,Performance,Type] < 0.5 , Self consumption degree\
		[District,HS,Performance,Type] + kWh over MWh of demand[District,HS,Performance,Type\
		] / 0.5 * ("SC 0.5 kWh/MWh"[District,HS,Performance,Type] - Self consumption degree\
		[District,HS,Performance,Type]) , 
	IF THEN ELSE( kWh over MWh of demand[District,HS,Performance,Type] < 1 , "SC 0.5 kWh/MWh"\
		[District,HS,Performance,Type] + ( kWh over MWh of demand[District,HS,Performance,Type\
		] - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh"[District,HS,Performance,Type] - "SC 0.5 kWh/MWh"\
		[District,HS,Performance,Type]) , 
	"SC 1.0 kWh/MWh"[District,HS,Performance,Type] + ( kWh over MWh of demand[District,HS\
		,Performance,Type] - 1 ) / 0.5 * ("SC 1.5 kWh/MWh"[District,HS,Performance,Type] - \
		"SC 1.0 kWh/MWh"[District,HS,Performance,Type]) ) )
	~	
	~		|

Total over HS present variable costs SH[District,HS,Performance,Type]=
	Total present variable costs SH roof[District,HS,Performance,Type] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel!,Battery!])
