Roof VeryLow[District,Type,Moderate]=
	( - Roof cost Moderate[District,Type] - Total present variable costs SH average[District\
		,Moderate,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,High]=
	( - Roof cost High[District,Type] - Total present variable costs SH average[District\
		,High,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,VeryHigh]=
	( - Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,VeryLow,Type] )
	~	
	~		|

Roof VeryLow exp[District,Type,Performance]=
	exp(Roof VeryLow scaled[District,Type,Performance])
	~	
	~		|

Roof VeryLow probabilities[District,Type,Performance]=
	Roof VeryLow exp[District,Type,Performance] / SUM(Roof VeryLow exp[District,Type,Performance\
		!])
	~	
	~		|

Coeff High[SFH,Performance]=
	0 ~~|
Coeff High[DFH,Performance]=
	Coeff High[SFH,Performance] ~~|
Coeff High[MFH,Performance]=
	0
	~	
	~		|

Ground Low[District,Type,VeryLow]=
	- Ground cost Low[District,Type] ~~|
Ground Low[District,Type,Low]=
	- Ground cost Low[District,Type] ~~|
Ground Low[District,Type,Moderate]=
	- Ground cost Moderate[District,Type] - Total present variable costs SH average Ground\
		[District,Moderate,Type] + Total present variable costs SH average Ground[District,\
		Low,Type] ~~|
Ground Low[District,Type,High]=
	- Ground cost High[District,Type] - Total present variable costs SH average Ground[District\
		,High,Type] + Total present variable costs SH average Ground[District,Low,Type] ~~|
Ground Low[District,Type,VeryHigh]=
	- Ground cost VeryHigh[District,Type] - Total present variable costs SH average Ground\
		[District,VeryHigh,Type] + Total present variable costs SH average Ground[District,\
		Low,Type]
	~	
	~		|

Coeff Moderate[SFH,Performance]=
	0 ~~|
Coeff Moderate[DFH,Performance]=
	Coeff Moderate[SFH,Performance] ~~|
Coeff Moderate[MFH,Performance]=
	0
	~	
	~		|

Ground Low scaled[District,Type,Performance]=
	( Ground Low[District,Type,Performance] - ( VMAX(Ground Low[District,Type,Performance\
		!]) - VMIN(Ground Low[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff Low[Type\
		,Performance]
	~	
	~		|

Ground Moderate[District,Type,VeryLow]=
	- Ground cost Moderate[District,Type] ~~|
Ground Moderate[District,Type,Low]=
	- Ground cost Moderate[District,Type] ~~|
Ground Moderate[District,Type,Moderate]=
	- Ground cost Moderate[District,Type] ~~|
Ground Moderate[District,Type,High]=
	- Ground cost High[District,Type] - Total present variable costs SH average Ground[District\
		,High,Type] + Total present variable costs SH average Ground[District,Moderate,Type\
		] ~~|
Ground Moderate[District,Type,VeryHigh]=
	- Ground cost VeryHigh[District,Type] - Total present variable costs SH average Ground\
		[District,VeryHigh,Type] + Total present variable costs SH average Ground[District,\
		Moderate,Type]
	~	
	~		|

Ground Moderate exp[District,Type,PerformanceHigh]=
	exp(Ground Moderate scaled[District,Type,PerformanceHigh]) ~~|
Ground Moderate exp[District,Type,PerformanceLow]=
	0
	~	
	~		|

Ground Moderate probabilities[District,Type,Performance]=
	Ground Moderate exp[District,Type,Performance] / SUM(Ground Moderate exp[District,Type\
		,Performance!])
	~	
	~		|

Ground Moderate scaled[District,Type,PerformanceLow]=
	Ground Moderate scaled[District,Type,Moderate] ~~|
Ground Moderate scaled[District,Type,PerformanceHigh]=
	( Ground Moderate[District,Type,PerformanceHigh] - ( VMAX(Ground Moderate[District,Type\
		,Performance!]) - VMIN(Ground Moderate[District,Type,Performance!]) ) / 2 ) / 10000\
		 + Coeff Moderate[Type,PerformanceHigh]
	~	
	~		|

PerformanceHigh:
	Moderate, High, VeryHigh
	~	
	~		|

PerformanceLow:
	VeryLow, Low
	~	
	~		|

Low to Performance[District,Type,Performance]=
	Low changing Roof[District,Type] * Roof Low probabilities[District,Type,Performance]\
		 + 
	Low changing Wall[District,Type] * Wall Low probabilities[District,Type,Performance]\
		 +
	Low changing Ground[District,Type] * Ground Low probabilities[District,Type,Performance\
		]
	~	
	~		|

Ground VeryLow[District,Type,VeryLow]=
	- Ground cost[District,Type] ~~|
Ground VeryLow[District,Type,Low]=
	( - Ground cost Low[District,Type] - Total present variable costs SH average Ground[\
		District,Low,Type] + Total present variable costs SH average Ground[District,VeryLow\
		,Type] ) ~~|
Ground VeryLow[District,Type,Moderate]=
	( - Ground cost Moderate[District,Type] - Total present variable costs SH average Ground\
		[District,Moderate,Type] + Total present variable costs SH average Ground[District,\
		VeryLow,Type] ) ~~|
Ground VeryLow[District,Type,High]=
	( - Ground cost High[District,Type] - Total present variable costs SH average Ground\
		[District,High,Type] + Total present variable costs SH average Ground[District,VeryLow\
		,Type] ) ~~|
Ground VeryLow[District,Type,VeryHigh]=
	( - Ground cost VeryHigh[District,Type] - Total present variable costs SH average Ground\
		[District,VeryHigh,Type] + Total present variable costs SH average Ground[District,\
		VeryLow,Type] )
	~	
	~		|

Ground VeryLow exp[District,Type,Performance]=
