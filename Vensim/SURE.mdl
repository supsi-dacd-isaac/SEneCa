	~		|

PV Performance Log Likelihood[Performance]=
	IF THEN ELSE( Time < 2025 , 
	Adoption PV Performance Data[Performance] * LN( Probability of Adoption PV Performance\
		[Performance] ) + ( Buildings Performance[Performance] - Adoption PV Performance Data\
		[Performance] ) * LN( 1 - Probability of Adoption PV Performance[Performance] ) , 0\
		 )
	~	
