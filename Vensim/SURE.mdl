Grant PelletBoiler Pellet[Performance,District,Type]=
	IF THEN ELSE( Time < 2026 , 
	
	IF THEN ELSE( ( Technology SH installed capacity SH and DHW[District,Performance,Type\
		] + Technology DHW installed capacity SH and DHW[District,Type] ) < 15 , 
	
	"Initial grant < 15 kW"[PelletBoiler] + "Investment grant per kW < 15 kW"[PelletBoiler\
		] * ( Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type] ) , 
	
	"Initial grant > 15 kW"[PelletBoiler] + "Investment grant per kW > 15 kW"[PelletBoiler\
		] * ( Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type] ) ) , Grant absolute[pellet,District,Performance,Type] )
	~	
	~		|

Grant PelletBoiler WoodST[District,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 
	
	IF THEN ELSE( Technology SH installed capacity just SH[District,Performance,Type] < \
		15 , 
	
	"Initial grant < 15 kW"[PelletBoiler] + "Investment grant per kW < 15 kW"[PelletBoiler\
		] * Technology SH installed capacity just SH[District,Performance,Type] , 
	
	"Initial grant > 15 kW"[PelletBoiler] + "Investment grant per kW > 15 kW"[PelletBoiler\
		] * Technology SH installed capacity just SH[District,Performance,Type] ) , Grant absolute\
		[WoodST,District,Performance,Type] )
	~	
	~		|

Grant DH[Performance,District,Type]=
	IF THEN ELSE( Time < 2026 , 
	
	Initial grant DH + Investment grant per kW DH * ( Technology SH installed capacity SH and DHW\
		[District,Performance,Type] + Technology DHW installed capacity SH and DHW[District\
		,Type] ) , Grant absolute[DH,District,Performance,Type] )
	~	
	~		|

Grant HP HeatPump[Performance,District,Type]=
	IF THEN ELSE( Time < 2026 , 
	
	IF THEN ELSE( ( Technology SH installed capacity SH and DHW[District,Performance,Type\
		] + Technology DHW installed capacity SH and DHW[District,Type] ) < 15 , 
	
	"Initial grant < 15 kW"[HP] + "Investment grant per kW < 15 kW"[HP] * ( Technology SH installed capacity SH and DHW\
		[District,Performance,Type] + Technology DHW installed capacity SH and DHW[District\
		,Type] ) , 
	
	"Initial grant > 15 kW"[HP] + "Investment grant per kW > 15 kW"[HP] * ( Technology SH installed capacity SH and DHW\
		[District,Performance,Type] + Technology DHW installed capacity SH and DHW[District\
		,Type] ) ) , Grant absolute[HeatPump,District,Performance,Type] )
	~	
	~		|

Grant HP HPST[District,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 
	
	IF THEN ELSE( Technology SH installed capacity just SH[District,Performance,Type] < \
		15 , 
	
	"Initial grant < 15 kW"[HP] + "Investment grant per kW < 15 kW"[HP] * Technology SH installed capacity just SH\
		[District,Performance,Type] , 
	
	"Initial grant > 15 kW"[HP] + "Investment grant per kW > 15 kW"[HP] * Technology SH installed capacity just SH\
		[District,Performance,Type] ) , Grant absolute[HPST,District,Performance,Type] )
	~	
	~		|

Carrier used cost per kWh[District,OilBoiler]=
	IF THEN ELSE( Time < 2023, Historical carrier cost[OilBoiler] , 
	IF THEN ELSE( Time < 2026 , ( Historical carrier cost[OilBoiler] + Additional Oil unit cost CO2 tax\
		 ) , ( Historical carrier cost[OilBoiler] + Additional Oil unit cost CO2 tax ) ) ) ~~|
Carrier used cost per kWh[District,GasBoiler]=
	IF THEN ELSE( Time < 2023, Historical carrier cost[GasBoiler] , 
	IF THEN ELSE( Time < 2026 , ( Historical carrier cost[GasBoiler] + Additional Gas unit cost CO2 tax\
		 ) , 
	( Historical carrier cost[GasBoiler] + Additional Gas unit cost CO2 tax ) ) ) ~~|
Carrier used cost per kWh[District,PelletBoiler]=
	IF THEN ELSE( Time < 2026, Historical carrier cost[PelletBoiler] , Historical carrier cost\
		[PelletBoiler] ) ~~|
Carrier used cost per kWh[District,HP]=
	Electricity price[District] ~~|
Carrier used cost per kWh[District,EH]=
	Electricity price[District] ~~|
Carrier used cost per kWh[District,ST]=
	0 ~~|
Carrier used cost per kWh[District,WoodBoiler]=
	IF THEN ELSE( Time < 2026, Historical carrier cost[WoodBoiler] , Historical carrier cost\
		[WoodBoiler] )
	~	CHF/l
	~		|

Annual GWP Heating Solution[District,OilST,Performance,Type]=
	ST installed capacity by arch[Performance,District,Type] * Emissions per capacity installed\
		[ST] / Lifetime + 
	
	Technology SH installed capacity just SH[District,Performance,Type] * Emissions per capacity installed\
		[OilBoiler] / Lifetime + 
	
	(Annual SH demand[District,Performance,Type] + (1 - ST share of total heat production\
		) * Annual DHW demand[District,Type]) / Efficiency[OilBoiler] * Emissions per kWh carrier used\
		[OilBoiler] ~~|
Annual GWP Heating Solution[District,GasST,Performance,Type]=
	ST installed capacity by arch[Performance,District,Type]*Emissions per capacity installed\
		[ST] / Lifetime + 
	
	Technology SH installed capacity just SH[District,Performance,Type] * Emissions per capacity installed\
		[GasBoiler] / Lifetime + 
	
	(Annual SH demand[District,Performance,Type] + (1 - ST share of total heat production\
		) * Annual DHW demand[District,Type]) / Efficiency[GasBoiler] * Emissions per kWh carrier used\
		[GasBoiler] ~~|
Annual GWP Heating Solution[District,pellet,Performance,Type]=
	(Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type]) * Emissions per capacity installed[PelletBoiler] / Lifetime\
		 + 
	
	( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type] ) * Emissions per kWh carrier used[PelletBoiler] / Efficiency[PelletBoiler\
		] ~~|
Annual GWP Heating Solution[District,HeatPump,Performance,Type]=
	(Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type]) * Emissions per capacity installed[HP] / Lifetime + 
	
	( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type] ) * Emissions per kWh carrier used[HP] / Efficiency[HP] ~~|
Annual GWP Heating Solution[District,WoodST,Performance,Type]=
	ST installed capacity by arch[Performance,District,Type] * Emissions per capacity installed\
		[ST] / Lifetime + 
	
	Technology SH installed capacity just SH[District,Performance,Type] * Emissions per capacity installed\
		[WoodBoiler] / Lifetime + 
	
	(Annual SH demand[District,Performance,Type] + (1 - ST share of total heat production\
		) * Annual DHW demand[District,Type]) / Efficiency[WoodBoiler] * Emissions per kWh carrier used\
		[WoodBoiler] ~~|
Annual GWP Heating Solution[District,HPST,Performance,Type]=
	ST installed capacity by arch[Performance,District,Type] * Emissions per capacity installed\
		[ST] / Lifetime + 
	
	Technology SH installed capacity just SH[District,Performance,Type] * Emissions per capacity installed\
		[HP] / Lifetime +
	 
	(Annual SH demand[District,Performance,Type] + (1 - ST share of total heat production\
		)*Annual DHW demand[District,Type]) / Efficiency[HP] * Emissions per kWh carrier used\
		[HP] ~~|
Annual GWP Heating Solution[District,Oil,Performance,Type]=
	(Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type]) * Emissions per capacity installed[OilBoiler] / Lifetime\
		 + 
	
	( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type] ) * Emissions per kWh carrier used[OilBoiler] / Efficiency[OilBoiler\
		] ~~|
Annual GWP Heating Solution[District,Gas,Performance,Type]=
	( Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type] ) * Emissions per capacity installed[GasBoiler] / Lifetime\
		+ 
	
	( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type] ) * Emissions per kWh carrier used[GasBoiler] / Efficiency[GasBoiler\
		] ~~|
Annual GWP Heating Solution[District,ElectricHeater,Performance,Type]=
	(Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type]) * Emissions per capacity installed[EH] / Lifetime+ 
	
	( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type] ) * Emissions per kWh carrier used[EH] / Efficiency[EH] ~~|
Annual GWP Heating Solution[District,Wood,Performance,Type]=
	(Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type]) * Emissions per capacity installed[WoodBoiler] / Lifetime\
		 + 
	
	( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type] ) * Emissions per kWh carrier used[WoodBoiler] / Efficiency[WoodBoiler\
		] ~~|
Annual GWP Heating Solution[District,DH,Performance,Type]=
	( Technology DHW installed capacity SH and DHW[District,Type] + Technology SH installed capacity SH and DHW\
		[District,Performance,Type] ) * Emissions per capacity installed[WoodBoiler] / Lifetime\
		 + 
	
	(Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type]) * Emissions per kWh carrier used\
		[WoodBoiler] / 1
	~	CO2eq
