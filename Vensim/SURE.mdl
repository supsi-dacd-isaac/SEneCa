Average MS HP Type[Type]=
	Adoption HP Type[Type] / Adoption Heating Solution Type[Type]
	~	
	~		|

Average MS noHP Performance[Performance]=
	( Adoption Heating Solution Performance[Performance] - Adoption HP Performance[Performance\
		] ) / Adoption Heating Solution Performance[Performance]
	~	
	~		|

HP Type Log Likelihood[Type]=
	IF THEN ELSE( Time < 2025 , Adoption HP Type Data[Type] * LN( Average MS HP Type[Type\
		] ) + Adoption noHP Type Data[Type] * LN( Average MS noHP Type[Type] ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
