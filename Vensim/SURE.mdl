Annual DHW demand by arch[District,HS,Performance,Type]=
	Annual DHW demand[District,Type] * SUM(Heating Solution[District,HS,Performance,Type\
		,PVpanel!,Battery!]) * Share primary houses[District]
	~	
	~		|

Annual SH demand[District,Performance,Type]=
	Average building size[District,Type] * Specific SH demand[Performance]
	~	kWh/year
	~		|

Technology DHW installed capacity SH and DHW[District,Type]=
	Annual DHW demand[District,Type] / Equivalent hours SH and DHW
	~	kW
	~		|

Annualized Total Cost HS[District,HS,Performance,Type,PVpanel]=
	( Investment cost HS[District,HS,Performance,Type] - Total variable costs HS[District\
		,HS,Performance,Type,PVpanel] ) / Lifetime
	~	CHF
	~		|

Residential electricity cons DHW per building[District,HeatPump,Performance,Type]=
	Annual DHW demand[District,Type] / Efficiency[HP] / Efficiency DHW storage ~~|
Residential electricity cons DHW per building[District,HPST,Performance,Type]=
	(1 - ST share of total heat production) * Annual DHW demand[District,Type] / Efficiency\
		[HP] ~~|
Residential electricity cons DHW per building[District,ElectricHeater,Performance,Type\
		]=
	Annual DHW demand[District,Type] / Efficiency[EH] / Efficiency DHW storage ~~|
Residential electricity cons DHW per building[District,No Electricity,Performance,Type\
		]=
	0
	~	kWh
	~		|

Economic Utility HS[District,HS,Performance,Type,PVpanel]=
	( Annualized Total Cost HS[District,HS,Performance,Type,PVpanel] - VMIN(Annualized Total Cost HS\
		[District,HS!,Performance,Type,PVpanel]) ) / 
	( VMAX(Annualized Total Cost HS[District,HS!,Performance,Type,PVpanel]) - VMIN(Annualized Total Cost HS\
		[District,HS!,Performance,Type,PVpanel]) )
	~	Dmnl
	~		|

El consumption per building[District,HeatPump,Performance,Type]=
	Annual light and appl demand by arch[Performance,District,Type] + (Annual SH demand[\
		District,Performance,Type] + Annual DHW demand[District,Type] / Efficiency DHW storage\
		 ) / Efficiency[HP] + Annual electricity consumption per building EVs[Performance,District\
		,Type] ~~|
El consumption per building[District,HPST,Performance,Type]=
	Annual light and appl demand by arch[Performance,District,Type] + (Annual SH demand[\
		District,Performance,Type] + (1 - ST share of total heat production)*Annual DHW demand\
		[District,Type])/Efficiency[HP] + Annual electricity consumption per building EVs[Performance\
		,District,Type] ~~|
El consumption per building[District,ElectricHeater,Performance,Type]=
	Annual light and appl demand by arch[Performance,District,Type] + (Annual SH demand[\
		District,Performance,Type] + Annual DHW demand[District,Type] / Efficiency DHW storage\
		 ) / Efficiency[EH] + Annual electricity consumption per building EVs[Performance,District\
		,Type] ~~|
El consumption per building[District,No Electricity,Performance,Type]=
	Annual light and appl demand by arch[Performance,District,Type] + Annual electricity consumption per building EVs\
		[Performance,District,Type]
	~	kWh/year
	~		|

Roof Low probabilities[District,Type,Performance]=
	Roof Low exp[District,Type,Performance] / SUM(Roof Low exp[District,Type,Performance\
		!])
	~	
	~		|

Investment cost HS no incentives[STno,District,Performance,Type]=
	Investment cost HS noST adj[STno,District,Performance,Type] ~~|
Investment cost HS no incentives[STyes,District,Performance,Type]=
	Investment cost HS noST adj[STyes,District,Performance,Type] + Investment cost ST[Performance\
		,District,Type]
	~	CHF
	~		|

Technology SH installed capacity just SH[District,Performance,Type]=
	(Annual SH demand[District,Performance,Type] + (1 - ST share of total heat production\
		)*Annual DHW demand[District,Type]) / Equivalent hours just SH
	~	kW
	~		|

Annual DHW demand[District,Type]=
	Daily hot water consumption per building by size and type[District,Type] * 45 * 4.186\
		 * 365 / 3600
	~	kWh/year
	~		|

Residential electricity cons SH per building[District,HeatPump,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[HP] ~~|
Residential electricity cons SH per building[District,HPST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[HP] ~~|
Residential electricity cons SH per building[District,ElectricHeater,Performance,Type\
		]=
	Annual SH demand[District,Performance,Type] / Efficiency[EH] ~~|
Residential electricity cons SH per building[District,No Electricity,Performance,Type\
		]=
	0
	~	kWh
	~		|

Annual variable costs SH[District,OilST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual variable costs SH[District,GasST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual variable costs SH[District,pellet,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[PelletBoiler] * Carrier used cost per kWh\
		[District,PelletBoiler] ~~|
Annual variable costs SH[District,HeatPump,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual variable costs SH[District,WoodST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler] ~~|
Annual variable costs SH[District,HPST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual variable costs SH[District,Oil,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual variable costs SH[District,Gas,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual variable costs SH[District,Wood,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler] ~~|
Annual variable costs SH[District,ElectricHeater,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[EH] * Carrier used cost per kWh\
		[District,EH] ~~|
Annual variable costs SH[District,DH,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler]
	~	CHF
	~		|

