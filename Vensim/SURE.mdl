Public charging stations=
	( SUM(Vehicle[District!,BEV]) + ( SUM(Vehicle[District!,DieselPHEV]) + SUM(Vehicle[District\
		!,PetrolPHEV]) ) * 0.08 ) / 9
	~	
	~		|

Vehicle[District,Vechicle]= INTEG (
