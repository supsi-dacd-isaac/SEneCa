HS hourly decrease[Month,Hour]=
	IF THEN ELSE( PV hourly difference[Month,Hour] > 0 , 
	IF THEN ELSE( PV hourly difference[Month,Hour] * Share HS[Month,Hour] > Hourly total inflow for Ticino\
		[Month,Hour] , Hourly total inflow for Ticino[Month,Hour] , 
	IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Wind hourly supply\
		[Month,Hour] + Waste hourly supply[Month,Hour] + Hourly total inflow for Ticino[Month\
		,Hour] + Hourly PHS production[Month,Hour] ) > Hourly electricity grid demand[Month\
		,Hour] , ( PV hourly difference[Month,Hour] ) * Share HS[Month,Hour] , 0 ) ) , 0 )
	~	
	~	IF THEN ELSE( PV hourly difference[Month,Hour] > 0 , 
		IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Wind \
		hourly supply[Month,Hour] + Waste hourly supply[Month,Hour] ) > Hourly \
		electricity grid demand[Month,Hour] , Hourly total inflow for \
		Ticino[Month,Hour] , 
		IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Wind \
		hourly supply[Month,Hour] + Waste hourly supply[Month,Hour] + Hourly total \
		inflow for Ticino[Month,Hour] + Hourly PHS production[Month,Hour] ) > \
		Hourly electricity grid demand[Month,Hour] , 
		( PV hourly difference[Month,Hour] ) * Share HS[Month,Hour] , 0 ) ) , 0 )
	|

Total Hydro annual production=
	SUM(Total Hydro monthly production[Month!])
	~	
	~		~	:SUPPLEMENTARY 
	|

