Utility vehicle[District,Vechicle] :EXCEPT:       [District,BEV]=
	Green Utility V factor[Vechicle] + Economic Utility V factor[District,Vechicle] + Infrastructure Utility factor\
		[Vechicle] + Range Utility V factor[Vechicle] + Dummy factor V[Vechicle] + Peer effect V factor\
		[Vechicle] ~~|
Utility vehicle[District,BEV]=
	Green Utility V factor[BEV] + Economic Utility V factor[District,BEV] + Infrastructure Utility factor\
		[BEV] + Range Utility V factor[BEV] + Dummy factor V[BEV] + Alpha V[District] + Peer effect V factor\
		[BEV]
	~	
	~		|

Consumers leaving vehicle[District,Vechicle]=
	Vehicle[District,Vechicle] / Average vehicle lifetime
	~	
	~		|

Consumers acquiring vehicle[District,Vechicle]=
	Total consumers leaving vehicle[District] * MS vehicle[District,Vechicle]
	~	
	~		|

Cost per km el[District,Vechicle]=
	El consumption per km[Vechicle] * Electricity price[District] * ( 1 - Share of electricity bought from public\
		 ) * ( 1 - Share of buildings with PV ) + 
	El consumption per km[Vechicle] * Electricity price[District] * ( 1 - Share of electricity bought from public\
		 ) * 0.65 * Share of buildings with PV + 
	El consumption per km[Vechicle] * Electricity price[District] * 3 * Share of electricity bought from public
	~	CHF/km
	~		|

Annual electricity per dwelling for EVs=
	( Annual electricity charged at home EV[BEV] * Vehicle by type[BEV] + Annual electricity charged at home EV\
		[PetrolPHEV] * Vehicle by type[PetrolPHEV] + Annual electricity charged at home EV[\
		DieselPHEV] * Vehicle by type[DieselPHEV] ) / SUM(Primary dwellings by District Type and Performance\
		[District!,Type!] ) * 0
	~	
	~		|

MS vehicle[District,Vechicle]=
	Vehicle utility exp[District,Vechicle] / SUM(Vehicle utility exp[District,Vechicle!]\
		)
	~	
	~		|

