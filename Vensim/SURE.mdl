Renters adopting RCP[District,HS,Performance,Type] :EXCEPT:        [District,HS,Performance\
		,MFH]=
	0 ~~|
Renters adopting RCP[District,HS,Performance,MFH]=
	IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
