PV Type Log Likelihood[Type]=
	IF THEN ELSE( Time < 2025 , 
	Adoption PV Type Data[Type] * LN( Probability of Adoption PV Type[Type] ) + ( Buildings Type\
		[Type] - Adoption PV Type Data[Type] ) * LN( 1 - Probability of Adoption PV Type[Type\
		] ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
