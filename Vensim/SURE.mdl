	Initial DSO expenses[Vallemaggia]
	~	CHF
	~		|

TSO charge=
	70/4500
	~	CHF/kWh
	~		|

Res VeryLow Low renovation[District,Type]=
	VeryLow to Performance[District,Type,Low]
	~	building
	~		|

Res VeryLow Buildings[District,Type]= INTEG (
	-Res VeryLow demolition[District,Type]-Res VeryLow High renovation[District,Type]-Res VeryLow Low renovation\
		[District,Type]-Res VeryLow Moderate renovation[District,Type]-Res VeryLow VeryHigh renovation\
		[District,Type],
		Res VeryLow Buildings i[District,Type])
	~	building
	~		|

Res VeryLow demolition[District,Type]=
	IF THEN ELSE( Time < 2026 , 0 ,
	
	IF THEN ELSE(Res VeryLow Buildings[District,Type] > SUM(Overall demolited buildings[\
		Type!]) * Res buildings share[District,VeryLow,Type] ,
	
	SUM(Overall demolited buildings[Type!]) * Res buildings share[District,VeryLow,Type]\
		 , Res VeryLow Buildings[District,Type] ) )
	~	building
	~		|

Res VeryLow Buildings i[District,Type]=
	SUM(Res buildings i[VeryLow,District,Type,PVpanel!])
	~	building
	~		|

Res buildings i[Performance,District,Type,PVpanel]:INTERPOLATE::=
	GET VDF DATA( 'Input2011.vdfx', 'Res buildings i[Performance,District,Type,PVpanel]'\
		 , 0 , 1 )
	~	building
	~		|

Adoption Heating Solution[HS]=
	SUM(Buildings adopting HS[District!,HS,Performance!,Type!,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS,Performance!,Type!,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS,Performance!,Type!,PVpanel!])
	~	
	~		|

HS substituted[HS]=
	Old to VeryOld delay[HS] - HS VeryOld demolited[HS]
	~	
	~		|

Equivalent Lifetime[HS]=
	IF THEN ELSE( HS substituted[HS] > 0.001 , MAX( SUM(Heating Solution[District!,HS,Performance\
		!,Type!,PVpanel!,Battery!]) / HS substituted[HS] , 1 ) , 1 )
	~	
	~		|

Initial Investment PV Owner[District,Type]=
	IF THEN ELSE( Time < 2013 , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) / Dwellings per building\
		[District,Type] , 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) / Dwellings per building[District\
		,Type] , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) / Dwellings per building\
		[District,Type] ), 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) / Dwellings per building[District\
		,Type] ) )
	~	CHF
	~	IF THEN ELSE( Time < 2015, 
		
		IF THEN ELSE( kWp installed per \
		building[District,HeatingSolution,ResPerformance,ResType] < 10, 
		
		(PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] - \
		PV cantonal subsidy[District,HeatingSolution,ResPerformance,ResType] - PV \
		federal subsidy check[District,HeatingSolution,ResPerformance,ResType]) * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] , 
		
		PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] ) , 
		
		(PV total initial investment \
		cost[District,HeatingSolution,ResPerformance,ResType] - PV cantonal \
		subsidy[District,HeatingSolution,ResPerformance,ResType] - PV federal \
		subsidy check[District,HeatingSolution,ResPerformance,ResType]) * (1 - Tax \
		deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] )
	|

RCP Eco Utility Owners[District,HS,Performance,Type]=
	( ( RCP total savings Owner[District,HS,Performance,Type] - Initial Investment PV Owner\
		[District,Type] ) / Initial Investment PV Owner[District,Type] / PV lifetime ) * 100
	~	kCHF
	~	( ( 1 + ( PV total \
		savings[District,HeatingSolution,ResPerformance,ResType] - Initial \
		Investment PV[District,HeatingSolution,ResPerformance,ResType] ) / Initial \
		Investment PV[District,HeatingSolution,ResPerformance,ResType] ) ^ ( 1 / \
		PV lifetime ) - 1 ) * 100
	|

Green Utility HS[District,HS,Performance,Type]=
	Annual GWP Heating Solution[District,HS,Performance,Type] / VMAX(Annual GWP Heating Solution\
		[District,HS!,Performance,Type])
	~	Dmnl
	~		|

Total variable costs HS[District,OilST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler]  - 
	
	Annual mantainance costs HS[OilST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 +\
		 Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,GasST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler]  - 
	
	Annual mantainance costs HS[GasST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 +\
		 Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,pellet,Performance,Type,PVpanel]=
	( - ( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District\
		,PelletBoiler] - 
	
	Annual mantainance costs HS[pellet,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 \
		+ Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,HeatPump,Performance,Type,PVyes]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * Carrier used cost per kWh[District,HP] * (1 \
		- Self sufficiency degree[District,HeatPump,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * PV cumulative compensation price * Self sufficiency degree\
		[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) * ( 1 - ( 1 / ( ( \
		1 + Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,WoodST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler]  - 
	
	Annual mantainance costs HS[WoodST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 \
		+ Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,HPST,Performance,Type,PVyes]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST]  - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		 - ST share of total heat production) ) / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HPST,Performance,Type]) - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		 - ST share of total heat production)) / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type]) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,HeatPump,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * Carrier used cost per kWh[District,HP] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) * ( 1 - ( 1 / ( ( \
		1 + Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,HPST,Performance,Type,PVno]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP]  - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + \
		Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,Oil,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler\
		] - 
	
	Annual mantainance costs HS[Oil,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
