		,Vechicle] + Annual vehicle tax[Vechicle]
	~	
	~		|

Annual vehicle tax[Vechicle]=
	IF THEN ELSE( Time < 2019, IF THEN ELSE( CO2eq per km adj[Vechicle] > 0.095 , 120 + \
		(CO2eq per km adj[Vechicle]*1000 - 95)^1.422 , 120 ) , 
	IF THEN ELSE( Time < 2023 , IF THEN ELSE( CO2eq per km adj[Vechicle] > 0.12, 120 + (\
		CO2eq per km adj[Vechicle]*1000 - 120)^1.422 , 120 ) , Annual circulation tax[Vechicle\
		] ))
	~	
	~		|

