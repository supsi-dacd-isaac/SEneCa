		,Type!])
	~	
	~		|

Res High Buildings[District,Type]= INTEG (
	Res High construction[District,Type]+Res Low High renovation[District,Type]+Res Moderate High renovation\
		[District,Type]+Res VeryLow High renovation[District,Type]-Res High VeryHigh renovation\
		[District,Type],
		Res High Buildings i[District,Type])
	~	
	~		|

Low changing Ground[District,Type]=
	Res Low Buildings[District,Type] / Ground Lifetime
	~	
	~		|

Buildings by District and Type[District,Type]=
	SUM(Total Res buildings[District,Performance!,Type])
	~	
	~		|

HeatPumps[District,Type,Performance]=
	SUM(Heating Solution[District,HeatPump,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Low changing Wall[District,Type]=
	Res Low Buildings[District,Type] / Wall Lifetime
	~	
	~		|

Low changing Roof[District,Type]=
	Res Low Buildings[District,Type] / Roof Lifetime
	~	
	~		|

Res Low Buildings[District,Type]= INTEG (
	Res VeryLow Low renovation[District,Type]-Res Low High renovation[District,Type]-Res Low to Moderate renovation\
		[District,Type]-Res Low VeryHigh renovation[District,Type],
		Res Low Buildings i[District,Type])
	~	
	~		|

Overall demolited buildings[Type]=
