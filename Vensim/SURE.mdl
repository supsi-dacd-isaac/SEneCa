	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) * ( 1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ Lifetime ) ) ) / Interest rate ~~|
Total variable costs HS[District,DH,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type])\
		 / 1 * Carrier used cost per kWh[District,WoodBoiler] - 
	
	Annual mantainance costs HS[DH,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime ) ) ) / Interest rate
	~	CHF
	~		|

Share HS by archetype[District,HS,Performance,Type,PVpanel,Battery]=
	Heating Solution[District,HS,Performance,Type,PVpanel,Battery] / SUM(Heating Solution\
		[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	Dmnl
	~		|

Initial Heating Solution[District,HS,Performance,Type,PVpanel]:INTERPOLATE::=
	GET VDF DATA( 'Input2011.vdfx', 'Initial Heating Solution[District,HS,Performance,Type,PVpanel]'\
		 , 0 , 1 )
	~	
	~		|

Initial kWp installed by archetype[District,HS,Performance,Type]=
	Initial Heating Solution[District,HS,Performance,Type,PVyes] * kWp installed per building\
		[District,Type]
	~	kW
	~		|

Annual PV kW installation by archetype[District,HS,Performance,Type]=
	SUM(PV adoptions by archetype[District,HS,Performance,Type,Battery!]) * kWp installed per building\
		[District,Type] + SUM(RCPv adoptions by archetype[District,HS,Performance,Type,Battery\
		!]) * kWp installed per building RCPv[District,Type]
	~	kW
	~		|

kWp installed per building RCPv[District,Type]=
	kWp installed per building[District,Type] * ( 1 + Share additional power RCPv )
	~	kW
	~		|

