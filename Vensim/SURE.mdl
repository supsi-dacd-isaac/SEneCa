Marginal cost by supplier[Solar]=
	PV marginal cost ~~|
Marginal cost by supplier[Wind]=
	Wind marginal cost ~~|
Marginal cost by supplier[Nuclear]=
	Nuclear marginal cost ~~|
Marginal cost by supplier[RoR]=
	RR marginal cost ~~|
Marginal cost by supplier[Hydro]=
	HS marginal cost ~~|
Marginal cost by supplier[Import]=
	Import marginal cost ~~|
Marginal cost by supplier[PHS]=
	HS marginal cost - 0.5 ~~|
Marginal cost by supplier[Coal]=
	Coal marginal cost ~~|
Marginal cost by supplier[Waste]=
	Waste marginal cost
	~	
	~		|

Ppriority by supplier[Supplier]=
	-Marginal cost by supplier[Supplier]
	~	
	~		|

Electricity dispatched[Month,Hour,Supplier]=
	ALLOCATE AVAILABLE( Hourly available supply by Supplier[Month,Hour,Supplier], 
	Priority vector by supplier[Supplier,ptype] , 
	Hourly demand and PHS[Month,Hour] )
	~	
	~		|

Priority vector by supplier[Supplier,ptype]=
	Supplier priority type ~~|
Priority vector by supplier[Supplier,ppriority]=
	Ppriority by supplier[Supplier] ~~|
Priority vector by supplier[Supplier,pwidth]=
	Supplier priority width ~~|
Priority vector by supplier[Supplier,pextra]=
	Supplier priority extra
	~	
	~		|

Electricity market price[Month,Hour]=
	IF THEN ELSE( Electricity dispatched[Month,Hour,Import] > 0 , Marginal cost by supplier\
		[Import] , 
	IF THEN ELSE( Electricity dispatched[Month,Hour,Coal] > 0 , Marginal cost by supplier\
		[Coal] , 
	IF THEN ELSE( Electricity dispatched[Month,Hour,Nuclear] > 0 , Marginal cost by supplier\
		[Nuclear] , 
	IF THEN ELSE( Electricity dispatched[Month,Hour,Hydro] > 0 , Marginal cost by supplier\
		[Hydro] , 
	IF THEN ELSE( Electricity dispatched[Month,Hour,PHS] > 0 , Marginal cost by supplier\
		[PHS] , 
	IF THEN ELSE( Electricity dispatched[Month,Hour,RoR] > 0 , Marginal cost by supplier\
		[RoR] , 
	IF THEN ELSE( Electricity dispatched[Month,Hour,Wind] > 0 , Marginal cost by supplier\
		[Wind] , Marginal cost by supplier[Solar] )))))))
	~	CHF/MWh
	~		|

Annual Electricity consumed[Supplier]=
	SUM(Electricity consumed[Month!,Hour!,Supplier]) * 365 / 12
	~	GWh
	~		~	:SUPPLEMENTARY 
	|

EV by district[District]=
	Vehicle[District,BEV]
	~	
	~		~	:SUPPLEMENTARY 
	|

Dummy 3=
	1
	~	
	~		|

HeatPumps by District[District]=
	SUM(HeatPumps[District,Type!,Performance!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Total annual grid upgrading cost i[District]=0
	~	CHF
	~		|

PHS hourly demand[Month,Hour]=
	PHS annual demand * Hour factor PHS consumption[Month,Hour] + Seasonal PHS hourly demand\
		[Month,Hour]
	~	
	~		|

Hourly electricity demand and import[Month,Hour]=
	Hourly imported electricity[Month,Hour] + Hourly electricity grid demand[Month,Hour]
	~	
	~		|

PHS hourly supply[Month,Hour]=
	Hourly PHS production[Month,Hour] + PHS hourly increase[Month,Hour] - PHS hourly decrease\
		[Month,Hour] + Seasonal PHS hourly production[Month,Hour]
	~	
	~	IF THEN ELSE( Hourly PHS production[Month,Hour] + PHS hourly increase[Month,Hour] - \
		PHS hourly decrease[Month,Hour] > 0.0016 , 
		Hourly PHS production[Month,Hour] + PHS hourly increase[Month,Hour] - PHS \
		hourly decrease[Month,Hour] , 0.0016 )
	|

Seasonal PHS hourly production[Month,Hour]=
	IF THEN ELSE( SUM(Hourly imported electricity[Month,Hour!]) > 0 , 
	Seasonal PHS monthly production[Month] * Hourly imported electricity[Month,Hour] / SUM\
		(Hourly imported electricity[Month,Hour!]) / ( 365 / 12 ) , 0 )
	~	
	~		|

Seasonal PHS monthly demand[Month]=
	IF THEN ELSE( SUM(Solar electricity produced hourly[Month!,Hour!]) > 0 , 
	Seasonal PHS annual demand * SUM(Solar electricity produced hourly[Month,Hour!]) / SUM\
		(Solar electricity produced hourly[Month!,Hour!]) , 0 )
	~	
	~		|

Seasonal PHS monthly production[Month]=
	IF THEN ELSE( Seasonal PHS annual production > 0 , Seasonal PHS annual production * \
		SUM(Hourly imported electricity[Month,Hour!]) / SUM(Hourly imported electricity[Month\
		!,Hour!]) , 0 )
	~	
	~		|

Solar electricity produced hourly[Month,Hour]= DELAY FIXED (
	 Total electricity produced hourly[Month,Hour,Solar] , 0.1 , 0)
	~	
	~		|

Seasonal PHS hourly demand[Month,Hour]=
	IF THEN ELSE( SUM(Solar electricity produced hourly[Month,Hour!]) > 0 , 
	Seasonal PHS monthly demand[Month] * Solar electricity produced hourly[Month,Hour] /\
		 SUM(Solar electricity produced hourly[Month,Hour!] ) / ( 365 / 12 ) , 0 )
	~	
	~		|

Seasonal PHS annual demand=
	Seasonal PHS annual production / 0.8
	~	
	~		|

"Provvedimento 1.3"=
	0
	~	
	~		|

Seasonal PHS annual production=
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.3" * 84 * ( Time - 2026 ) / ( 2050 \
		- 2026 ) )
	~	
	~		|

Share grid demand per hour[Month,Hour]=
	IF THEN ELSE( SUM(Hourly electricity demand and import[Month,Hour!]) > 0 , Hourly electricity demand and import\
		[Month,Hour] / SUM(Hourly electricity demand and import[Month,Hour!]) , 0 )
	~	
	~	Hourly electricity grid demand[Month,Hour] / SUM(Hourly electricity grid \
		demand[Month,Hour!])
	|

Hourly imported electricity[Month,Hour]= DELAY FIXED (
	 SMOOTH( Electricity dispatched[Month,Hour,Import] , 2 ) , 0.1 , 0)
	~	
	~		|

HS monthly change check[Month]=
	HS monthly increase[Month] - HS monthly decrease[Month]
	~	
	~		~	:SUPPLEMENTARY 
	|

HS hourly increase[Month,Hour]=
	HS monthly decrease[Month] * Share grid demand per hour[Month,Hour]
	~	
	~		|

PHS monthly change check[Month]=
	PHS monthly increase[Month] - PHS monthly decrease[Month]
	~	
	~		~	:SUPPLEMENTARY 
	|

Total electricity produced hourly[Month,Hour,Supplier]=
	Electricity consumed[Month,Hour,Supplier] + Hourly exported electricity[Month,Hour,Supplier\
		]
	~	GWh
	~		|

PHS hourly increase[Month,Hour]=
	PHS monthly decrease[Month] * Share grid demand per hour[Month,Hour]
	~	
	~		|

Total Hydro monthly production[Month]=
	SUM(Total Hydro hourly production[Month,Hour!]) * 365 / 12
	~	
	~		|

PHS hourly decrease[Month,Hour]=
	IF THEN ELSE( PV hourly difference[Month,Hour] > 0 , 
	IF THEN ELSE( ( PV hourly difference[Month,Hour] ) * Share PHS[Month,Hour] > Hourly PHS production\
		[Month,Hour] , Hourly PHS production[Month,Hour] , 
	IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Wind hourly supply\
		[Month,Hour] + Waste hourly supply[Month,Hour] + Hourly total inflow for Ticino[Month\
		,Hour] + Hourly PHS production[Month,Hour] ) > Hourly electricity grid demand[Month\
		,Hour] , ( PV hourly difference[Month,Hour] ) * Share PHS[Month,Hour] , 0 ) ), 0 )
	~	
	~	IF THEN ELSE( PV hourly difference[Month,Hour] > 0 , 
		IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] ) > \
		Hourly electricity demand[Month,Hour] , Hourly PHS production[Month,Hour] \
		, 
		IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Hourly \
		total inflow for Ticino[Month,Hour] + Hourly PHS production[Month,Hour] ) \
		> Hourly electricity demand[Month,Hour] , 
		( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Hourly \
		total inflow for Ticino[Month,Hour] + Hourly PHS production[Month,Hour] - \
		Hourly electricity demand[Month,Hour] ) * Share PHS[Month,Hour] , 0 )) , 0 \
		)
	|

Waste hourly supply[M1,Hour]=
	Waste annual production / 10.6 / 24 / ( 365 / 12 ) ~~|
