		[District,HS,Performance,Type] - Self consumption degree[District,HS,Performance,Type\
		]) * Decentralized storage efficiency
	~	
	~		|

Total present variable costs SH average Ground[District,Performance,Type]=
	SUM(Total over HS present variable costs SH Ground[District,HS!,Performance,Type]) /\
		 SUM(Heating Solution[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Check[District,Type]=
	Owned buildings with PV[District,Type] + Rented buildings with PV[District,Type] + 
	Owned buildings with RCP[District,Type] + Rented buildings with RCP[District,Type] +\
		 
	Owned buildings with RCPv[District,Type] + Rented buildings with RCPv[District,Type]\
		 - SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
