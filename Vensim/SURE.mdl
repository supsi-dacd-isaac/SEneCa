	IF THEN ELSE( PV hourly SC[Month,Hour] < Hourly electricity demand[Month,Hour] , Hourly electricity demand\
		[Month,Hour] - PV hourly SC[Month,Hour] , 0 )
	~	
	~		|

Hourly demand and PHS[Month,Hour]=
