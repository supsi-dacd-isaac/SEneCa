PV total savings Owner[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2013 , IF THEN ELSE( kWp installed per building[District,Type] \
		< 10 ,
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + \
		PV annual generation per building[District,Type] * "PV FiT < 10 kW" ) / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ,
	( - PV annual mantainance cost * PV annual generation per building[District,Type] +PV annual generation per building\
		[District,Type] * "PV FiT 10 - 30 kW" ) / Dwellings per building[District,Type] * (\
		1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ) ,
	IF THEN ELSE( Time < 2016 , IF THEN ELSE( kWp installed per building[District,Type] \
		< 10 ,
	( PV annual generation per building[District,Type] * Self consumption degree[District\
		,HS,Performance,Type] * Electricity price[District] - PV annual mantainance cost* PV annual generation per building\
		[District,Type] + PV annual generation per building[District,Type] * ( 1 - Self consumption degree\
		[District,HS,Performance,Type] ) * Exp expected export price ) / Dwellings per building\
		 [District,Type] * (1 - ( 1 / (( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate\
		 ,
	( - PV annual mantainance cost* PV annual generation per building[District,Type] + PV annual generation per building\
		[District,Type] * "PV FiT 10 - 30 kW") / Dwellings per building [District,Type] * (\
		1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ),
	( PV annual generation per building[District,Type] * Self consumption degree[District\
		,HS,Performance,Type] * Electricity price[District] - PV annual mantainance cost *PV annual generation per building\
		[District,Type] + PV annual generation per building[District,Type] * ( 1 - Self consumption degree\
		[District,HS,Performance,Type] ) * Exp expected export price ) / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate\
		 ) )
	~	CHF
	~		|

