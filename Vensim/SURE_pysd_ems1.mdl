MuKEn 2014 scenario=
	IF THEN ELSE( MuKEn scenario = 0 , 0 , 1 )
	~	
	~		|

Total building construction by PV[PVpanel]=
	SUM(Building construction by archetype[District!,Performance!,Type!,PVpanel])
	~	
	~		|

MuKEn 2025 scenario=
	IF THEN ELSE( MuKEn scenario = 2 , 1 , 0 )
	~	
	~		|

MuKEn scenario=
	1
	~	
	~		|

Grant absolute ST[Performance,District,Type]=
