RCPv total savings Owner[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 0 , ( PV annual generation per building RCPv[District,Type\
		] * Self consumption degree RCPv [District,HS,Performance,Type] * Electricity price\
		[District] + PV annual generation per building RCPv[District,Type] * Self consumption degree RCPv\
		[District,HS,Performance,Type] * 1.6 * Electricity price[District] * 0.8 - PV annual mantainance cost\
		* PV annual generation per building RCPv[District,Type] + PV annual generation per building RCPv\
		[District,Type] * ( 1 - Self consumption degree RCPv[District,HS,Performance,Type] \
		* ( 1 + 0.8 * Buildings PVno connected to RCPv) ) * Exp expected export price ) / Dwellings per building\
		[District,Type] ) * (1 -( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	
	~		|

PV total savings Renter[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2013 , IF THEN ELSE( kWp installed per building[District,Type] \
		< 10 ,
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + \
		PV annual generation per building[District,Type] * "PV FiT < 10 kW" ) * (1 - ( 1 / \
		( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ,
	( - PV annual mantainance cost* PV annual generation per building[District,Type] + PV annual generation per building\
		[District,Type] * "PV FiT 10 - 30 kW" ) * (1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 )\
		) ) / Interest rate ) ,
	IF THEN ELSE( Time < 2016 , IF THEN ELSE( kWp installed per building[District,Type] \
		< 10 ,
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + \
		PV annual generation per building[District,Type] * Exp expected export price) * ( 1\
		- ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate ,
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + \
		PV annual generation per building[District,Type] * "PV FiT 10 - 30 kW") * (1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate  ),
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + \
		PV annual generation per building[District,Type] * Exp expected export price) * ( 1\
		- ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate  ) )
	~	CHF
	~		|

PV Eco Utility Renter[District,HS,Performance,Type]=
	(IF THEN ELSE(Study economics enabled>0.5 :AND: Time<2018, Study current Renter historical utility\
		[District,HS,Performance,Type],
	((PV total savings Renter[District,HS,Performance,Type]-Initial Investment PV Renter\
		[District,Type])/Initial Investment PV Renter[District,Type]/PV lifetime)*100))
	~	kCHF
	~		|

RCPv total savings Renter[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 0 , ( PV annual generation per building RCPv[District,Type\
		] * Self consumption degree RCPv[District,HS,Performance,Type] * ( 1 + 0.8 * Buildings PVno connected to RCPv\
		) * Electricity price [District] * 0.8 - PV annual mantainance cost * PV annual generation per building RCPv\
		[District,Type] + PV annual generation per building RCPv[District,Type] * ( 1 - Self consumption degree RCPv\
		[District,HS,Performance,Type] * ( 1 + 0.8 * Buildings PVno connected to RCPv) ) * \
		Exp expected export price ) ) * (1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime) )\
		 ) / Interest rate
	~	CHF
	~		|

Retrofit Moderate SFH Log Likelihood[Performance] :EXCEPT: [PerformanceLow]=
	IF THEN ELSE( Time < 2025 , Retrofit Moderate SFH Data[Performance] * LN( MAX(1e-12,\
		  Moderate to Performance SFH MS[Performance ] ) ) ,
	0 ) ~~|
Retrofit Moderate SFH Log Likelihood[PerformanceLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) + 
		Retrofit Low SFH Data[High] * LN( Low to High SFH MS ) + 
		Retrofit Low SFH Data[VeryHigh] * LN( Low to VeryHigh SFH MS ) , 0 ) )
	|

Retrofit Moderate MFH Log Likelihood[Performance] :EXCEPT: [PerformanceLow]=
	IF THEN ELSE( Time < 2025 , Retrofit Moderate MFH Data[Performance] * LN( MAX(1e-12,\
		  Moderate to Performance MFH MS[Performance ] ) ) ,
	0 ) ~~|
Retrofit Moderate MFH Log Likelihood[PerformanceLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) + 
		Retrofit Low MFH Data[High] * LN( Low to High MFH MS ) + 
		Retrofit Low MFH Data[VeryHigh] * LN( Low to VeryHigh MFH MS ) , 0 ) )
	|

Wall Low exp[District,Type,Performance] :EXCEPT:   [District,Type,VeryLow]=
	EXP(Wall Low scaled[District,Type,Performance]) ~~|
Wall Low exp[District,Type,VeryLow]=
	0
	~	
	~		|

Retrofit High SFH Log Likelihood[PerformanceHigh] :EXCEPT: [Moderate]=
	IF THEN ELSE( Time < 2025 , Retrofit High SFH Data[PerformanceHigh] * LN( MAX(1e-12,\
		  High to Performance SFH MS[PerformanceHigh ] ) ) ,
	0 ) ~~|
Retrofit High SFH Log Likelihood[PerformanceLow]=
	0 ~~|
Retrofit High SFH Log Likelihood[Moderate]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) + 
		Retrofit Low SFH Data[High] * LN( Low to High SFH MS ) + 
		Retrofit Low SFH Data[VeryHigh] * LN( Low to VeryHigh SFH MS ) , 0 ) )
	|

Ground Low exp[District,Type,Performance] :EXCEPT:   [District,Type,VeryLow]=
	EXP(Ground Low scaled[District,Type,Performance]) ~~|
Ground Low exp[District,Type,VeryLow]=
	0
	~	
	~		|

Retrofit High MFH Log Likelihood[PerformanceHigh] :EXCEPT: [Moderate]=
	IF THEN ELSE( Time < 2025 , Retrofit High MFH Data[PerformanceHigh] * LN( MAX(1e-12,\
		  High to Performance MFH MS[PerformanceHigh ] ) ) ,
	0 ) ~~|
Retrofit High MFH Log Likelihood[PerformanceLow]=
	0 ~~|
Retrofit High MFH Log Likelihood[Moderate]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) + 
		Retrofit Low MFH Data[High] * LN( Low to High MFH MS ) + 
		Retrofit Low MFH Data[VeryHigh] * LN( Low to VeryHigh MFH MS ) , 0 ) )
	|

PV investment cost[District,Type]=
	(kWp installed per building[District,Type]) * (IF THEN ELSE(Time < 2012,
	IF THEN ELSE((kWp installed per building[District,Type]) < 10, (3843.31 + 9298.4/(kWp installed per building\
		[District,Type])),
	(3953.69 + 8194.62/(kWp installed per building[District,Type]))),
	IF THEN ELSE(Time < 2013, IF THEN ELSE((kWp installed per building[District,Type]) <\
		 10,
	(3233.62 + 6182.34/(kWp installed per building[District,Type])),
	(2989.35 + 8625/(kWp installed per building[District,Type]))), IF THEN ELSE(Time < 2014\
		,
	IF THEN ELSE((kWp installed per building[District,Type]) < 10, (3118.38+ 4835.66/(kWp installed per building\
		[District,Type])),
	(2546.1 + 10558.5/(kWp installed per building[District,Type]))),
	IF THEN ELSE(Time < 2015, IF THEN ELSE((kWp installed per building[District,Type]) <\
		 10,
	(2021.37 + 8675.21/(kWp installed per building[District,Type])),
	(1775.46 + 11134.3/(kWp installed per building[District,Type]))),
	IF THEN ELSE(Time < 2016, (8875.79*(kWp installed per building[District,Type])^(-0.472415\
		)),
	IF THEN ELSE(Time < 2017, (6496.76*(kWp installed per building[District,Type])^(-0.345836\
		)),
	IF THEN ELSE(Time < 2018, (6791.45*(kWp installed per building[District,Type])^(-0.389002\
		)),
	IF THEN ELSE(Time < 2019, (4702.1*(kWp installed per building[District,Type])^(-0.264\
		)),
	IF THEN ELSE(Time < 2020, (8120/(kWp installed per building[District,Type])^0.766 + \
		1140*EXP(-0.000299*(kWp installed per building[District,Type]))),
	IF THEN ELSE(Time < 2021, (5523/(kWp installed per building[District,Type])^0.4862 +\
		 156.2*EXP(-0.2321*(kWp installed per building[District,Type])) + 578.4),
	IF THEN ELSE(Time < 2022, IF THEN ELSE((kWp installed per building[District,Type]) <\
		 10,
	(1970 + 6420/(kWp installed per building[District,Type])), IF THEN ELSE((kWp installed per building\
		[District,Type]) < 30,
	(1374 + 12382/(kWp installed per building[District,Type])), (1221 + 16979/(kWp installed per building\
		[District,Type])))),
	IF THEN ELSE(Time < 2023, IF THEN ELSE((kWp installed per building[District,Type]) <\
		 10,
	(1930 + 9240/(kWp installed per building[District,Type])), IF THEN ELSE((kWp installed per building\
		[District,Type]) < 30,
	(1646 + 12072/(kWp installed per building[District,Type])), (1307 + 22241/(kWp installed per building\
		[District,Type])))),
	IF THEN ELSE(Time < 2024, IF THEN ELSE((kWp installed per building[District,Type]) <\
		 10,
	(1358 + 14511/(kWp installed per building[District,Type])), IF THEN ELSE((kWp installed per building\
		[District,Type]) < 30,
	(1737 + 10722/(kWp installed per building[District,Type])), (1640 + 13630/(kWp installed per building\
		[District,Type])))),
	IF THEN ELSE(Time < 2025, IF THEN ELSE((kWp installed per building[District,Type]) <\
		 10,
	(2034 + 6191/(kWp installed per building[District,Type])), IF THEN ELSE((kWp installed per building\
		[District,Type]) < 30,
	(1177 + 14762/(kWp installed per building[District,Type])), (1464 + 6148/(kWp installed per building\
		[District,Type])))),
	(1628+5278/(kWp installed per building[District,Type]))))))))))))))))) * PV uncertain cost factor
	~	CHF
	~		|

Interest rate=
	0.02 * Interest rate uncertainty factor
	~	Dmnl
	~		|

PV investment cost RCPv[District,Type]=
	(kWp installed per building RCPv[District,Type]) * (IF THEN ELSE(Time < 2012,
	IF THEN ELSE((kWp installed per building RCPv[District,Type]) < 10, (3843.31 + 9298.4\
		/(kWp installed per building RCPv[District,Type])),
	(3953.69 + 8194.62/(kWp installed per building RCPv[District,Type]))),
	IF THEN ELSE(Time< 2013, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(3233.62 + 6182.34/(kWp installed per building RCPv[District,Type])),
	(2989.35 + 8625/(kWp installed per building RCPv[District,Type]))),
	IF THEN ELSE(Time < 2014, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(3118.38 + 4835.66/(kWp installed per building RCPv[District,Type])),
	(2546.1 + 10558.5/(kWp installed per building RCPv[District,Type]))),
	IF THEN ELSE(Time < 2015, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(2021.37 + 8675.21/(kWp installed per building RCPv[District,Type])),
	(1775.46 + 11134.3/(kWp installed per building RCPv[District,Type]))),
	IF THEN ELSE(Time < 2016, (8875.79*(kWp installed per building RCPv[District,Type])^\
		(-0.472415)),
	IF THEN ELSE(Time < 2017, (6496.76*(kWp installed per building RCPv[District,Type])^\
		(-0.345836)),
	IF THEN ELSE(Time < 2018, (6791.45*(kWp installed per building RCPv[District,Type])^\
		(-0.389002)),
	IF THEN ELSE(Time < 2019, (4702.1*(kWp installed per building RCPv[District,Type])^(\
		-0.264)),
	IF THEN ELSE(Time < 2020, (8120/(kWp installed per building RCPv[District,Type])^0.766\
		 + 1140*EXP(-0.000299*(kWp installed per building RCPv[District,Type]))),
	IF THEN ELSE(Time < 2021, (5523/(kWp installed per building RCPv[District,Type])^0.4862\
		 + 156.2*EXP(-0.2321*(kWp installed per building RCPv[District,Type])) + 578.4),
	IF THEN ELSE(Time < 2022, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(1970 + 6420/(kWp installed per building RCPv[District,Type])), IF THEN ELSE((kWp installed per building RCPv\
		[District,Type]) < 30,
	(1374 + 12382/(kWp installed per building RCPv[District,Type])), (1221 + 16979/(kWp installed per building RCPv\
		[District,Type])))),
	IF THEN ELSE(Time < 2023, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(1930 + 9240/(kWp installed per building RCPv[District,Type])), IF THEN ELSE((kWp installed per building RCPv\
		[District,Type]) < 30,
	(1646 + 12072/(kWp installed per building RCPv[District,Type])), (1307 + 22241/(kWp installed per building RCPv\
		[District,Type])))),
	IF THEN ELSE(Time < 2024, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(1358 + 14511/(kWp installed per building RCPv[District,Type])), IF THEN ELSE((kWp installed per building RCPv\
		[District,Type]) < 30,
	(1737 + 10722/(kWp installed per building RCPv[District,Type])), (1640 + 13630/(kWp installed per building RCPv\
		[District,Type])))),
	IF THEN ELSE(Time < 2025, IF THEN ELSE((kWp installed per building RCPv[District,Type\
		]) < 10,
	(2034 + 6191/(kWp installed per building RCPv[District,Type])), IF THEN ELSE((kWp installed per building RCPv\
		[District,Type]) < 30,
	(1177 + 14762/(kWp installed per building RCPv[District,Type])), (1464 + 6148/(kWp installed per building RCPv\
		[District,Type])))),
	(1628+5278/(kWp installed per building RCPv[District,Type]))))))))))))))))) * PV uncertain cost factor
	~	CHF
	~		|

Battery capacity[District,HS,Performance,Type]=
	MIN( Battery capacity 1[District,Type] , Battery capacity 2[District,HS,Performance,\
		Type] )
	~	
	~		|

Battery capacity 1[District,Type]=
	kWp installed per building[District,Type] * 1.5
	~	kWh
	~		|

Battery capacity 1 RCPv[District,Performance,Type]=
	kWp installed per building RCPv[District,Type] * 1.5
	~	kWh
	~		|

RCP Eco Utility Renter[District,HS,Performance,Type]=
	( ( RCP total savings Renter[District,HS,Performance,Type] - Initial Investment PV Renter\
		[District,Type] ) / Initial Investment PV Renter[District,Type] / PV lifetime ) * 100
	~	kCHF
	~		|

RCPv Eco Utility Owners[District,HS,Performance,Type]=
	( ( RCPv total savings Owner[District,HS,Performance,Type] - Initial Investment RCPv Owner\
		[District,Type] ) / Initial Investment RCPv Owner[District,Type] / PV lifetime ) * \
		100
	~	kCHF
	~		|

RCPv Eco Utility Renter[District,HS,Performance,Type]=
	( ( RCPv total savings Renter[District,HS,Performance,Type] - Initial Investment RCPv Renter\
		[District,Type] ) / Initial Investment RCPv Renter[District,Type] / PV lifetime ) *\
		 100
	~	kCHF
	~		|

Initial Investment PV Renter[District,Type]=
	(IF THEN ELSE( Time < 2013 , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) , 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) ), 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) ) )) - IF THEN ELSE(Time>=Test start year\
		, Test extra grant share, 0)*PV investment cost[District,Type]*(1-Tax deduction investment\
		)
	~	CHF
	~	IF THEN ELSE( Time < 2015, 
		
		IF THEN ELSE( kWp installed per \
		building[District,HeatingSolution,ResPerformance,ResType] < 10, 
		
		(PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] - \
		PV cantonal subsidy[District,HeatingSolution,ResPerformance,ResType] - PV \
		federal subsidy check[District,HeatingSolution,ResPerformance,ResType]) * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] , 
		
		PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] ) , 
		
		(PV total initial investment \
		cost[District,HeatingSolution,ResPerformance,ResType] - PV cantonal \
		subsidy[District,HeatingSolution,ResPerformance,ResType] - PV federal \
		subsidy check[District,HeatingSolution,ResPerformance,ResType]) * (1 - Tax \
		deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] )
	|

Initial Investment RCPv Owner[District,Type]=
	((PV investment cost RCPv[District,Type] - PV federal subsidy check RCPv[District,Type\
		] - RCPv cantonal subsidy[District,Type] ) * (1 - Tax deduction investment) / Dwellings per building\
		[District,Type]) - IF THEN ELSE(Time>=Test start year, Test extra grant share, 0)*PV investment cost RCPv\
		[District,Type]*(1-Tax deduction investment)/Dwellings per building[District,Type]
	~	CHF
	~		|

Initial Investment RCPv Renter[District,Type]=
	((PV investment cost RCPv[District,Type] - PV federal subsidy check RCPv[District,Type\
		] - RCPv cantonal subsidy[District,Type] ) * (1 - Tax deduction investment)) - IF THEN ELSE\
		(Time>=Test start year, Test extra grant share, 0)*PV investment cost RCPv[District\
		,Type]*(1-Tax deduction investment)
	~	CHF
	~		|

Self sufficiency degree[District,HS,Performance,Type]=
	kWp installed per building[District,Type] * PV annual generation per kW * Self consumption degree\
		[District,HS,Performance,Type] / El consumption per building[District,HS,Performance\
		,Type]
	~	
	~		|

Self sufficiency degree RCPv[District,HS,Performance,Type]=
	PV annual generation per building RCPv[District,Type] * Self consumption degree RCPv\
		[District,HS,Performance,Type] / El consumption per building[District,HS,Performance\
		,Type]
	~	
	~		|

kWp over MWh of demand[District,HS,Performance,Type]=
	kWp installed per building[District,Type] / El consumption per building[District,HS,\
		Performance,Type] * 1000
	~	kW/MWh
	~		|

kWp over MWh of demand RCPv[District,HS,Performance,Type]=
	kWp installed per building RCPv[District,Type] / El consumption per building[District\
		,HS,Performance,Type] * 1000
	~	kW/MWh
	~		|

PV federal subsidy check RCPv[District,Type]=
	PV rebate federal * PV investment cost RCPv[District,Type]
	~	
	~		|

PV annual generation per building RCPv[District,Type]=
	kWp installed per building RCPv[District,Type] * PV annual generation per kW
	~	kWh/year
	~		|

Technology SH installed capacity SH and DHW[District,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Equivalent hours SH and DHW
	~	kW
	~		|

ST installed capacity by arch[Performance,District,Type]=
	ST dimention by arch[District,Type]*ST capacity installed per square meter
	~	kW
	~		|

Self consumption degree[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand[District,HS,Performance,Type],
		       ([(0,0)-(10,10)],(0,1),(0.25,0.68),(0.5,0.48),(0.75,0.37),(1,0.3),(1.5,0.23)\
		,(1.75,0.205),(2.5,0.15),(4,0.08) ))
	~	Dmnl
	~		|

Daily hot water consumption per building by size and type[District,Type]=
	Occupants per dwelling by type[Type] * Dwellings per building[District,Type] * Daily hot water consumption per person
	~	l/day
	~		|

ST dimention by arch[District,Type]=
	Occupants per dwelling by type[Type] * Dwellings per building[District,Type] * sqauare meters of ST per person
	~	m2
	~		|

PV initial grant=
	IF THEN ELSE(Time < 2014, 0 , 
	IF THEN ELSE(Time < 2016, 1800, 
	IF THEN ELSE(Time < 2019, 1600, 
	IF THEN ELSE(Time < 2020, 1550, 
	IF THEN ELSE(Time < 2021, 1100, 
	IF THEN ELSE(Time < 2022, 770, 
	IF THEN ELSE(Time < 2030 , 385 , 385 )))))))
	~	CHF
	~		|

Equivalent hours just SH=
	1900
	~	hour/year
	~		|

Dwellings per building[District,SFH]=
	1 ~~|
Dwellings per building[District,DFH]=
	2 ~~|
Dwellings per building[District,MFH]=
	8.1,
	3.7,
	5.1,
	8.6,
	9.1,
	8,
	6.7,
	4.3
	~	dwelling
	~		|

ST share of total heat production=
	0.75
	~	Dmnl
	~		|

Type:
	SFH, DFH, MFH
	~	houses
	~		|

Equivalent hours SH and DHW=
	2200
	~	hour/year
	~		|

sqauare meters of ST per person=
	1
	~	m2/person
	~		|

Occupants per dwelling by type[Type]=
	2.7,
	2.7,
	2.1
	~	person/dwelling
	~		|

Daily hot water consumption per person=
	50
	~	l/(person*day)
	~		|

********************************************************
	.odis with pv
********************************************************~
	|

RCP total savings Renter[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2018 , 0 , ( PV annual generation per building[District,Type] *\
		Self consumption degree[District ,HS,Performance,Type] * Electricity price[District\
		] * 0.8 - PV annual mantainance cost * PV annual generation per building[District,Type\
		] + PV annual generation per building[District,Type] * ( 1 - Self consumption degree\
		[District ,HS,Performance,Type] ) * Exp expected export price ) ) * (1 - ( 1 / ( ( \
		1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	CHF
	~		|

RCP total savings Owner[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2018 , 0 , ( PV annual generation per building[District,Type] *\
		Self consumption degree[District ,HS,Performance,Type] * Electricity price[District\
		] - PV annual mantainance cost * PV annual generation per building[District,Type] +\
		 PV annual generation per building[District,Type] * ( 1 - Self consumption degree[District\
		,HS,Performance,Type] ) * Exp expected export price ) / Dwellings per building [District\
		,Type] ) * (1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	
	~		|

Ground High scaled[District,Type,PerformanceLow]=
	Ground High scaled[District,Type,High] ~~|
Ground High scaled[District,Type,PerformanceHigh] :EXCEPT:       [District,Type,Moderate\
		]=
	( Ground High[District,Type,PerformanceHigh] - ( VMAX(Ground High[District,Type,Performance\
		!]) - VMIN(Ground High[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff High[Type\
		,PerformanceHigh] ~~|
Ground High scaled[District,Type,Moderate]=
	Ground High scaled[District,Type,High]
	~	
	~		|

Roof High exp[District,Type,PerformanceHigh] :EXCEPT: [District,Type,Moderate]=
	EXP(Roof High scaled[District,Type,PerformanceHigh]) ~~|
Roof High exp[District,Type,PerformanceLow]=
	0 ~~|
Roof High exp[District,Type,Moderate]=
	0
	~	
	~		|

Roof High scaled[District,Type,PerformanceLow]=
	Roof High scaled[District,Type,High] ~~|
Roof High scaled[District,Type,PerformanceHigh] :EXCEPT:     [District,Type,Moderate]\
		=
	( Roof High[District,Type,PerformanceHigh] - ( VMAX(Roof High[District,Type,Performance\
		!]) - VMIN(Roof High[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff High[Type\
		,PerformanceHigh] ~~|
Roof High scaled[District,Type,Moderate]=
	Roof High scaled[District,Type,High]
	~	
	~		|

Wall High exp[District,Type,PerformanceHigh] :EXCEPT: [District,Type,Moderate]=
	EXP(Wall High scaled[District,Type,PerformanceHigh]) ~~|
Wall High exp[District,Type,PerformanceLow]=
	0 ~~|
Wall High exp[District,Type,Moderate]=
	0
	~	
	~		|

Ground High exp[District,Type,PerformanceHigh] :EXCEPT: [District,Type,Moderate]=
	EXP(Ground High scaled[District,Type,PerformanceHigh]) ~~|
Ground High exp[District,Type,PerformanceLow]=
	0 ~~|
Ground High exp[District,Type,Moderate]=
	0
	~	
	~		|

Wall High scaled[District,Type,PerformanceLow]=
	Wall High scaled[District,Type,High] ~~|
Wall High scaled[District,Type,PerformanceHigh] :EXCEPT:       [District,Type,Moderate\
		]=
	( Wall High[District,Type,PerformanceHigh] - ( VMAX(Wall High[District,Type,Performance\
		!]) - VMIN(Wall High[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff High[Type\
		,PerformanceHigh] ~~|
Wall High scaled[District,Type,Moderate]=
	Wall High scaled[District,Type,High]
	~	
	~		|

Retrofit Low SFH Log Likelihood[Performance] :EXCEPT: [VeryLow]=
	IF THEN ELSE( Time < 2025 , Retrofit Low SFH Data[Performance] * LN( MAX(1e-12,  Low to Performance SFH MS\
		[Performance] ) ) ,
	0 ) ~~|
Retrofit Low SFH Log Likelihood[VeryLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) + 
		Retrofit Low SFH Data[High] * LN( Low to High SFH MS ) + 
		Retrofit Low SFH Data[VeryHigh] * LN( Low to VeryHigh SFH MS ) , 0 ) )
	~	:SUPPLEMENTARY 
	|

Retrofit Low MFH Log Likelihood[Performance] :EXCEPT: [VeryLow]=
	IF THEN ELSE( Time < 2025 , Retrofit Low MFH Data[Performance] * LN( MAX(1e-12,  Low to Performance MFH MS\
		[Performance] ) ) ,
	0 ) ~~|
Retrofit Low MFH Log Likelihood[VeryLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) + 
		Retrofit Low MFH Data[High] * LN( Low to High MFH MS ) + 
		Retrofit Low MFH Data[VeryHigh] * LN( Low to VeryHigh MFH MS ) , 0 ) )
	~	:SUPPLEMENTARY 
	|

Annual mantainance costs HS[Oil,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,530),(5,530),(10,530),(20,580),(70,770),(100,810),(200,1000) \
		)) ~~|
Annual mantainance costs HS[Gas,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,711),(5,711),(10,722),(20,744),(70,1094),(100,1200),(200,1700\
		) )) ~~|
