		!,Type,Battery!])
	~	
	~		|

Batteries by Performance[Performance]=
	SUM(Batteries[District!,HS!,Performance,Type!,Byes]) / SUM(Batteries[District!,HS!,Performance\
		,Type!,Battery!])
	~	
	~		|

Batteries[District,HS,Performance,Type,Battery]=
	MAX( Heating Solution[District,HS,Performance,Type,PVyes,Battery] , 0.0001 )
	~	
	~		|

