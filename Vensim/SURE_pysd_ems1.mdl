	~	Mio CHF
	~		|

Batteries by District[District]=
	SUM(Batteries[District,HS!,Performance!,Type!,Byes]) / SUM(Batteries[District,HS!,Performance\
		!,Type!,Battery!])
	~	
	~		|

Average annual Federal Levy cost by Type and PV[Type,PVpanel]=
	SMOOTH( Cumulative cost Federal Levy by Type and PV[Type,PVpanel] / Total cumulative buildings by Type and PV\
		[Type,PVpanel] , 3 )
	~	
	~		|

Annual buildings by Arch[District,Performance,Type,PVpanel]=
	SUM(Heating Solution[District,HS!,Performance,Type,PVpanel,Battery!]) * Share primary houses\
		[District] * Dwellings per building[District,Type]
	~	
	~		|

Average annual Federal Levy cost by Type[Type]=
	SUM(Cumulative cost Federal Levy by Type and PV[Type,PVpanel!]) / SUM(Total cumulative buildings by Type and PV\
		[Type,PVpanel!])
	~	
	~		|

Total cumulative cost Federal Levy by arch[District,HS,Performance,Type,PVpanel,Battery\
		]= INTEG (
	Annual cost Federal Levy by arch[District,HS,Performance,Type,PVpanel,Battery],
		0)
	~	
	~		|

Buildings RCPv by archetype flow[District,HS,Performance,Type,Battery]=
	Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery]
	~	
	~		|

Average annual Cantonal Levy cost by Type and PV[Type,PVpanel]=
	Cumulative cost Cantonal Levy by Type and PV[Type,PVpanel] / Total cumulative buildings by Type and PV\
		[Type,PVpanel]
	~	
	~		|

Total cumulative buildings by Type and PV[Type,PVpanel]= INTEG (
	SUM(Annual buildings by Arch[District!,Performance!,Type,PVpanel]),
		1)
	~	
	~		|

Total cumulative cost Cantonal Levy by arch[District,HS,Performance,Type,PVpanel,Battery\
		]= INTEG (
	Annual cost Cantonal Levy by arch[District,HS,Performance,Type,PVpanel,Battery],
		0)
	~	
	~		|

Cumulative cost Federal Levy by Type and PV[Type,PVpanel]=
	SUM(Total cumulative cost Federal Levy by arch[District!,HS!,Performance!,Type,PVpanel\
		,Battery!])
	~	
	~		|

Buildings RCPv by archetype[District,HS,Performance,Type,Battery]= INTEG (
	Buildings RCPv by archetype flow[District,HS,Performance,Type,Battery],
		0)
	~	
	~		|

Cumulative cost Cantonal Levy by Type and PV[Type,PVpanel]=
	SUM(Total cumulative cost Cantonal Levy by arch[District!,HS!,Performance!,Type,PVpanel\
		,Battery!])
	~	
	~		|

Average annual Cantonal Levy cost by Type[Type]=
