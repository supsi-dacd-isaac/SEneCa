	IF THEN ELSE( Time < 2026 , 0 , Cambiamento climatico Hydro * 225 * ( Time - 2026 ) \
		/ ( 2050 - 2026 ) ) + 
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.2" * 214 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) ) +
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.3" * 293 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) )
	~	
	~		|

Applienaces hourly demand[Month,Hour]=
	Applienaces annual demand * Hour factor appliances[Month,Hour]
	~	GWh
	~		|

Nuclear marginal cost=
	10
	~	CHF/MWh
	~		|

PHS annual demand=
	PHS annual production / 0.8
	~	
	~		|

PHS annual production historical:INTERPOLATE::= GET DIRECT DATA('Input Hour Factors_pysd_ems1.csv', '', '1', 'B18') ~	
	~		|

PHS annual production time evolution degree=
	PHS annual production / PHS annual production historical
	~	
	~		|

Coal annual import:INTERPOLATE::= GET DIRECT DATA('Input Hour Factors_pysd_ems1.csv', '', '1', 'B19') ~	GWh
	~		|

Coal hourly available supply[Month,Hour]=
	Coal hourly available supply historical[Month,Hour] * Time factor coal * 0.75
	~	GWh
	~		|

Coal hourly available supply historical[M1,Hour]=
	Coal annual import / 10.6 / 24 / ( 365 / 12 ) ~~|
