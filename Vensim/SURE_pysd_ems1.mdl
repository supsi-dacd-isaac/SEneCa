********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2050
	~	year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2011
	~	year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	year [0,?]
	~	The time step for the simulation.
	|

Available PV adoption[District,HS,Performance,Type]=
	MAX(0, Heating Solution[District,HS,Performance,Type,PVno,Bno] - MAX(0, Building demolition by archetype\
		[District,HS,Performance,Type,PVno,Bno]) - MAX(0, Buildings HS Renovation From[District\
		,HS,Performance,Type,PVno,Bno]))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Total PV request[District,HS,Performance,Type]=
	MAX(0, Requested Owners adopting PV[District,HS,Performance,Type]) + 
	MAX(0, Requested Owners adopting RCP[District,HS,Performance,Type]) + 
	MAX(0, Requested Owners adopting RCPv[District,HS,Performance,Type]) + 
	MAX(0, Requested Renters adopting PV[District,HS,Performance,Type]) + 
	MAX(0, Requested Renters adopting RCP[District,HS,Performance,Type]) + 
	MAX(0, Requested Renters adopting RCPv[District,HS,Performance,Type])
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Accepted PV adoption[District,HS,Performance,Type] =
	MIN(Available PV adoption[District,HS,Performance,Type], Total PV request[District,HS\
		,Performance,Type])
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Owners adopting PV[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Owners PV[District,HS,Performance\
		,Type],
	MAX(0, Requested Owners adopting PV[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Owners adopting RCP[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Owners RCP[District,HS,Performance\
		,Type],
	MAX(0, Requested Owners adopting RCP[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Owners adopting RCPv[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Owners RCPv[District,HS,Performance\
		,Type],
	MAX(0, Requested Owners adopting RCPv[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Renters adopting PV[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Renters PV[District,HS,Performance\
		,Type],
	MAX(0, Requested Renters adopting PV[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Renters adopting RCP[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Renters RCP[District,HS,Performance\
		,Type],
	MAX(0, Requested Renters adopting RCP[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Renters adopting RCPv[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Renters RCPv[District,HS,Performance\
		,Type],
	MAX(0, Requested Renters adopting RCPv[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

