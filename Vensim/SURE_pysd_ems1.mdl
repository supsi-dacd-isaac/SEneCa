	IF THEN ELSE( Time < 2025 , Utility HS exp no incentives[District,OldS,PerformanceLow\
		,Type,PVpanel] , 
	
	IF THEN ELSE( MuKEn 2014 scenario > 0 , 0 , Utility HS exp no incentives[District,OldS\
		,PerformanceLow,Type,PVpanel] ) ) ~~|
Utility HS exp 2 no incentives[District,NewS,Performance,Type,PVpanel]=
	Utility HS exp no incentives[District,NewS,Performance,Type,PVpanel] ~~|
Utility HS exp 2 no incentives[District,OldS,PerformanceHigh,Type,PVpanel]=
	Utility HS exp no incentives[District,OldS,PerformanceHigh,Type,PVpanel]
	~	
	~		|

Oil vs HP difference[District,Performance,Type,PVpanel]=
	VMIN(Annualized Total Cost HS[District,OldS!,Performance,Type,PVpanel]) - Annualized Total Cost HS\
		[District,HeatPump,Performance,Type,PVpanel]
	~	
	~		|

Old to VeryOld[HS]=
	MiddleAge to Old delay[HS]
	~	
	~		|

MuKEn 2025 scenario application=
	IF THEN ELSE( Time < 2031 , 0 , MuKEn 2025 scenario )
	~	
	~		|

Market Share HS no incentives[District,HS,Performance,Type,PVpanel]=
	Utility HS exp 3 no incentives[District,HS,Performance,Type,PVpanel] / SUM(Utility HS exp 3 no incentives\
		[District,HS!,Performance,Type,PVpanel])
	~	
	~		|

Market Share HS no incentives filtered[District,HS,Performance,Type,PVpanel]=
	Market Share HS no incentives[District,HS,Performance,Type,PVpanel] * DH and Gas suitability\
		[District,Type] + 
	Market Share HS no incentives noGas[District,HS,Performance,Type,PVpanel] * DH only suitability\
		[District,Type] + 
	Market Share HS no incentives noDH[District,HS,Performance,Type,PVpanel] * Gas only suitability\
		[District,Type] + 
	Market Share HS no incentives noDH noGas[District,HS,Performance,Type,PVpanel] * No suitability\
		[District,Type]
	~	
	~		|

New to MiddleAge[HS]=
	VeryNew to New delay[HS]
	~	
	~		|

DH suitability[District,Type]=TABBED ARRAY(
	0.022602	0.066001	0.176036
	0.000583	0.003284	0.009009
	0.012277	0.040992	0.109515
	0.042563	0.06957	        0.263917
	0.052761	0.089121	0.305364
	0.054766	0.085355	0.2383
	0.016471	0.036468	0.075795
	0.020444	0.040307	0.036145
	)
	~	
	~		|

RenSolution:
	Wood,WoodST,HPST,HeatPump,pellet,DH
	~	
	~		|

No suitability[District,Type]=
	( 1 - DH suitability[District,Type] ) * ( 1 - Gas suitability[District,Type] )
	~	
	~		|

WithGeoConstraint:
	Gas, GasST, DH
	~	
	~		|

WithGas:
	Gas, GasST
	~	
	~		|

Gas suitability[District,Type]=TABBED ARRAY(
	0.31	0.344	0.435
	0.128	0.115	0.144
	0.183	0.138	0.162
	0.145	0.159	0.133
	0.496	0.62	0.76
	0.665	0.71	0.841
	0.125	0.157	0.142
	0.151	0.157	0.151
	)
	~	
	~		|

VeryNew to New[HS]=
	Adoption HS delay[HS]
	~	
	~		|

MiddleAge to Old[HS]=
	New to MiddleAge delay[HS]
	~	
	~		|

Share of buildings with PV=
	SUM(Heating Solution[District!,HS!,Performance!,Type!,PVyes,Battery!]) / SUM(Heating Solution\
		[District!,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		|

DH and Gas suitability[District,Type]=
	DH suitability[District,Type] * Gas suitability[District,Type]
	~	
	~		|

Gas only suitability[District,Type]=
	( 1 - DH suitability[District,Type] ) * Gas suitability[District,Type]
	~	
	~		|

DH only suitability[District,Type]=
	DH suitability[District,Type] * ( 1 - Gas suitability[District,Type] )
	~	
	~		|

NonRenSolution:
	Oil,Gas,ElectricHeater,OilST,GasST
	~	
	~		|

Aging Rate[HS]=
	1 / Lifetime[HS] * 5
	~	
	~		|

Suitability check[District,Type]=
	DH and Gas suitability[District,Type] + DH only suitability[District,Type] + Gas only suitability\
		[District,Type] + No suitability[District,Type]
	~	
	~		|

Roof Moderate exp[District,Type,PerformanceHigh]=
	EXP(Roof Moderate scaled[District,Type,PerformanceHigh]) ~~|
Roof Moderate exp[District,Type,PerformanceLow]=
	0
	~	
	~		|

Roof Moderate probabilities[District,Type,Performance]=
	Roof Moderate exp[District,Type,Performance] / SUM(Roof Moderate exp[District,Type,Performance\
		!])
	~	
	~		|

Investment grant per kW DH=
	IF THEN ELSE(Time < 2017, 0, 
	
	IF THEN ELSE(Time < 2022, 50,
	
	IF THEN ELSE(Time < 2025 , 50 , 40 ) ) )
	~	
	~		|

Ground cost High[District,Type]=
	( Ground specific cost CECE High - Incentive CECE ) * Ground size by Type and District\
		[District,Type]
	~	
	~		|

Ground cost Low[District,Type]=
	Ground specific cost Base * Ground size by Type and District[District,Type]
	~	
	~		|

Roof VeryLow[District,Type,VeryLow]=
	- Roof cost[District,Type] ~~|
Roof VeryLow[District,Type,Low]=
	( - Roof cost Low[District,Type] - Total present variable costs SH average[District,\
		Low,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,Moderate]=
	( - Roof cost Moderate[District,Type] - Total present variable costs SH average[District\
		,Moderate,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,High]=
	( - Roof cost High[District,Type] - Total present variable costs SH average[District\
		,High,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,VeryHigh]=
	( - Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,VeryLow,Type] )
	~	
	~		|

