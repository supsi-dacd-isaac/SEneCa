RoCH federal RUP data[RP30]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0),(2012,0),(2013,0),(2014,109.042\
		),(2015,147.885),(2016,108.898),(2017,91.7968),(2018,96.0353),(2019,89.4023),(2020,\
		92.1645),(2021,109.137),(2022,217.905),(2023,319.936),(2024,289.515),(2025,244.06),\
		(2026,307.296),(2027,300.999),(2028,292.426),(2029,285.711),(2030,280.462),(2031,275.967\
		),(2032,269.257),(2033,261.516),(2034,254.251),(2035,239.46),(2036,222.156),(2037,212.184\
		),(2038,204.616),(2039,197.166),(2040,189.683),(2041,181.91),(2042,170.905),(2043,159.627\
		),(2044,152.694),(2045,149.556),(2046,145.266),(2047,137.879),(2048,129.967),(2049,\
		122.941),(2050,117.223))) ~~|
RoCH federal RUP data[RP40]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0),(2012,0),(2013,0),(2014,109.042\
		),(2015,147.885),(2016,108.898),(2017,91.7968),(2018,96.0353),(2019,89.4023),(2020,\
		92.1645),(2021,109.137),(2022,217.905),(2023,319.936),(2024,289.515),(2025,244.06),\
		(2026,436.703),(2027,459.783),(2028,454.618),(2029,448.207),(2030,442.778),(2031,440.603\
		),(2032,435.918),(2033,425.434),(2034,412.508),(2035,383.963),(2036,353.594),(2037,\
		338.405),(2038,325.062),(2039,310.975),(2040,296.883),(2041,282.266),(2042,260.402)\
		,(2043,238.952),(2044,226.532),(2045,220.502),(2046,212.049),(2047,197.776),(2048,183.944\
		),(2049,171.875),(2050,162.959)))
	~	Mio CHF
	~	[RoCH] Federal RUP spending of the rest of Switzerland: Ticino spending x \
		(1/0.0508 - 1) in the runs with PV rebate federal = 0 ... 0.4 and cantonal \
		incentives at base value.
	|

Rebate interpolation weight[Rebate point]=
	MAX(0, 1-ABS(Rebate federal for RoCH-Rebate point value[Rebate point])/0.1)
	~	Dmnl
	~	[RoCH] Weight of each simulated run for linear interpolation (weights sum \
		to 1).
	|

Rebate federal for RoCH=
	MAX(0, MIN(0.4, PV rebate federal))
	~	Dmnl
	~	[RoCH] PV rebate federal limited to the simulated range 0-0.4.
	|

Rebate point value[Rebate point]=
	0, 0.1, 0.2, 0.3, 0.4
	~	Dmnl
	~	[RoCH] PV rebate federal of each simulated run.
	|

Rebate point:
	RP00, RP10, RP20, RP30, RP40
	~	
	~	[RoCH] Values of PV rebate federal simulated to build the RoCH data.
	|

Cumulative Cantonal demand 5 years before= DELAY FIXED(
	Cumulative Cantonal demand, 5, 0)
	~	kWh
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Cantonal demand= INTEG(
	SUM(Total annual grid demand Districts[District!]),
	0)
	~	kWh
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

Cumulative Cantonal net Subsidy 5 years before= DELAY FIXED(
	Cumulative Cantonal net Subsidy, 5, 0)
	~	Mio CHF
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Cantonal net Subsidy= INTEG(
	Annual Total Cantonal net Subsidy,
	0)
	~	Mio CHF
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

Cumulative Federal demand 5 years before= DELAY FIXED(
	Cumulative Federal demand, 5, 0)
	~	kWh
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Federal demand= INTEG(
	Total Federal demand grid,
	0)
	~	kWh
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

Cumulative Federal Subsidy 5 years before= DELAY FIXED(
	Cumulative Federal Subsidy, 5, 0)
	~	Mio CHF
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Federal Subsidy= INTEG(
	Annual Total Federal Subsidy,
	0)
	~	Mio CHF
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

NR Cantonal subsidy per plant[NR class]=
	NR Eligible share[NR class]*NR Cantonal CU eligible[NR class]+(1-NR Eligible share[NR class\
		])*NR Cantonal CU[NR class]
	~	CHF/plant
	~	[NR] Cantonal one-off contribution per new plant (mix of private plants up \
		to 50 kW and the others), as in the NR decision.
	|

Probability adoption RCP Renters[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability RCP Renters\
		[District,HS,Performance,Type]+Install lag share*Decision probability RCP Renters last year\
		[District,HS,Performance,Type], Decision probability RCP Renters[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Decision probability RCPv Renters last year[District,HS,Performance,Type]= DELAY FIXED\
		(
	Decision probability RCPv Renters[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCPv Renters[District,HS,Performance,Type]=
	Utility RCPv Renter exp[District,HS,Performance,Type]/(1+Utility RCPv Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability RCPv Owners last year[District,HS,Performance,Type]= DELAY FIXED\
		(
	Decision probability RCPv Owners[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCPv Owners[District,HS,Performance,Type]=
	Utility RCPv Owners exp[District,HS,Performance,Type]/(1+Utility RCPv Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability RCP Renters last year[District,HS,Performance,Type]= DELAY FIXED\
		(
	Decision probability RCP Renters[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCP Renters[District,HS,Performance,Type]=
	Utility RCP Renter exp[District,HS,Performance,Type]/(1+Utility RCP Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability RCP Owners last year[District,HS,Performance,Type]= DELAY FIXED(
	Decision probability RCP Owners[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCP Owners[District,HS,Performance,Type]=
	Utility RCP Owners exp[District,HS,Performance,Type]/(1+Utility RCP Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability PV Renters last year[District,HS,Performance,Type]= DELAY FIXED(
	Decision probability PV Renters[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability PV Renters[District,HS,Performance,Type]=
	Utility PV Renter exp[District,HS,Performance,Type]/(1+Utility PV Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability PV Owners last year[District,HS,Performance,Type]= DELAY FIXED(
	Decision probability PV Owners[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability PV Owners[District,HS,Performance,Type]=
	Utility PV Owners exp[District,HS,Performance,Type]/(1+Utility PV Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Install lag share=
	0.5
	~	Dmnl
	~	[K2N3_2025] Share of the PV installations decided the year before (about 6 \
		months of lead time); 0 = installed in the decision year.
	|

PV federal cap share=
	IF THEN ELSE(Time<2026, 0.3, 0.3+PV rebate federal-0.2)
	~	Dmnl
	~	[NR] Cap of the residential federal RU as share of the cost: 30% until \
		2025 (historical rule, independent of the lever); SURE formula from 2026.
	|

NR Payoff[NR class]=
	IF THEN ELSE(Time>=2012 :AND: Time<=NR Calibration end year, NR Log likelihood[NR class\
		], 0)
	~	Dmnl
	~	[NR] Payoff of the non-residential calibration (vpd: NR Payoff[NR \
		class]/1).
	|

NR Calibration end year=
	2025
	~	year
	~	[NR]
	|

NR Log likelihood[NR class]=
	GAMMA LN(NR Observed count[NR class]+NR Dispersion[NR class])-GAMMA LN(NR Dispersion\
		[NR class])-GAMMA LN(NR Observed count[NR class]+1)+NR Dispersion[NR class]*LN(NR Dispersion\
		[NR class]/(NR Dispersion[NR class]+NR Mu[NR class]))+NR Observed count[NR class]*LN\
		(NR Mu[NR class]/(NR Dispersion[NR class]+NR Mu[NR class]))
	~	Dmnl
	~	[NR] Negative binomial NB2 on yearly counts.
	|

NR Mu[NR class]=
	MAX(NR Completed[NR class], 1e-09)
	~	plants/year
	~	[NR]
	|

NR Dispersion[NR class]=
	10^NR Log dispersion[NR class]
	~	Dmnl
	~	[NR]
	|

NR Log dispersion[NR Mid]=
	0.944583 ~~|
NR Log dispersion[NR Large]=
	0.425646
	~	Dmnl
	~	[NR] log10 of the NB2 size parameter (calibrated NRK3_2025_s1).
	|

NR Stock[NR class]= INTEG(
	NR Installed kW[NR class], NR Initial stock[NR class])
	~	kW
	~	[NR] Additions of year t enter the stock at t+1.
	|

NR Completed[NR class]=
	NR Pending count[NR class]+NR Completion share same year*NR Orders[NR class]
	~	plants/year
	~	[NR] New plants per year.
	|

NR Pending count[NR class]= INTEG(
	NR Orders[NR class]-NR Completed[NR class],
	0)
	~	plants
	~	[NR] Plants ordered and not yet installed.
	|

NR Orders[NR class]=
	SUM(NR Orders kW district[NR class,District!])/NR Size[NR class]
	~	plants/year
	~	[NR] Plants ordered per year.
	|

NR Installed kW[NR class]=
	SUM(NR Installed kW district[NR class,District!])
	~	kW/year
	~	[NR]
	|

NR Pending kW[NR class]=
	SUM(NR Pending kW district[NR class,District!])
	~	kW
	~	[NR]
	|

NR Installed kW district[NR class,District]=
	NR Pending kW district[NR class,District]+NR Completion share same year*NR Orders kW district\
		[NR class,District]
	~	kW/year
	~	[NR] Installed power: share of this year orders plus the rest of last year \
		orders.
	|

NR Pending kW district[NR class,District]= INTEG(
	NR Orders kW district[NR class,District]-NR Installed kW district[NR class,District]\
		,
	0)
	~	kW
	~	[NR] Orders of the previous year still to be installed.
	|

NR Orders kW district[NR class,District]=
	NR Eligible kW[NR class]*NR Probability district[NR class,District]
	~	kW/year
	~	[NR] Power ordered in the decision year.
	|

NR Completion share same year=
	0.5
	~	Dmnl
	~	[NR] Share of the orders installed in the order year; the rest the year \
		after (NRK3_2025_s1; residential Install lag share = 1 - this).
	|

NR Eligible kW[NR class]=
	MAX(0, NR Potential[NR class]-NR Stock[NR class]-NR Pending kW[NR class])
	~	kW
	~	[NR] Residual potential (without the orders not yet installed).
	|

NR Probability[NR class]=
	SUM(NR Probability district[NR class,District!])
	~	Dmnl
	~	[NR]
	|

NR Probability district[NR class,District]=
	Share PV capacity installed per District[District]*(NR Eligible share[NR class]/(1+EXP\
		(-NR Utility eligible[NR class,District]))+(1-NR Eligible share[NR class])/(1+EXP(-\
		NR Utility[NR class,District])))
	~	Dmnl
	~	[NR] District contribution to the yearly probability that a residual \
		project is realised (mix of the two segments).
	|

NR Utility eligible[NR class,District]=
	NR Delta[NR class]+NR Peer utility+NR Eco weight*NR Economic utility eligible[NR class\
		,District]
	~	Dmnl
	~	[NR]
	|

NR Utility[NR class,District]=
	NR Delta[NR class]+NR Peer utility+NR Eco weight*NR Economic utility[NR class,District\
		]
	~	Dmnl
	~	[NR]
	|

NR Peer utility=
	NR Peer weight*LOG(MAX(NR Installed base share, 1e-06), 10)
	~	Dmnl
	~	[NR]
	|

NR Installed base share=
	NR Peer installed base/(NR Potential[NR Mid]+NR Potential[NR Large])
	~	Dmnl
	~	[NR] Installed base as share of the potential, canton-wide, in kW.
	|

NR Peer installed base= INTEG(
	NR Installed kW[NR Mid]+NR Installed kW[NR Large]-NR Peer decay*NR Peer installed base\
		,
	53+224.38*(1-NR Peer decay)+122.85*(1-NR Peer decay)^2)
	~	kW
	~	[NR] Installed base >=30 kW with decay; initial value from the register \
		2008-2010 with the same decay (as residential).
	|

NR Peer decay=
	0.3
	~	1/year
	~	[NR] Decay of the installed base in the peer term (NRK3_2025_s1).
	|

NR Peer weight=
	0.688591
	~	Dmnl
	~	[NR] Weight of the peer effect (calibrated NRK3_2025_s1).
	|

NR Eco weight=
	0.119568
	~	Dmnl
	~	[NR] beta (calibrated NRK3_2025_s1).
	|

NR Delta[NR Mid]=
	-4.48229 ~~|
NR Delta[NR Large]=
	-4.50799
	~	Dmnl
	~	[NR] Intercept by class (calibrated NRK3_2025_s1).
	|

NR Economic utility eligible[NR class,District]=
	IF THEN ELSE(Time<2018, (MAX(NR Ordinary value[NR class,District], MAX(NR Federal value\
		[NR class,District], NR TI value[NR class,District]))-NR Net investment eligible[NR class\
		])/NR Net investment eligible[NR class]/30*100, (NR Ordinary value[NR class,District\
		]-NR Net investment eligible[NR class])/NR Net investment eligible[NR class]/30*100\
		)
	~	Dmnl
	~	[NR] Private plants up to 50 kW (RIC-TI 2014-2017, one-off contribution \
		from 2018).
	|

NR Economic utility[NR class,District]=
	IF THEN ELSE(Time<2018, (MAX(NR Ordinary value[NR class,District], NR Federal value[\
		NR class,District])-NR Net investment[NR class])/NR Net investment[NR class]/30*100\
		, (NR Ordinary value[NR class,District]-NR Net investment[NR class])/NR Net investment\
		[NR class]/30*100)
	~	Dmnl
	~	[NR] Plants above 50 kW: relative NPV of the best available regime (same \
		metric and regime logic as residential).
	|

NR Net investment eligible[NR class]=
	NR Gross cost[NR class]-NR RU[NR class]-NR Cantonal CU eligible[NR class]
	~	CHF
	~	[NR] Private plants up to 50 kW.
	|

NR Net investment[NR class]=
	NR Gross cost[NR class]-NR RU[NR class]-NR Cantonal CU[NR class]
	~	CHF
	~	[NR] Plants above 50 kW. No tax deduction (firms).
	|

NR Cantonal CU eligible[NR class]=
	IF THEN ELSE(Time<NR RU start year, 0, NR CU rule[NR class])
	~	CHF
	~	[NR] Private plants up to 50 kW: contribution from 2018 (RFER 2018), with \
		the federal RU.
	|

NR Cantonal CU[NR class]=
	NR CU open share*NR CU rule[NR class]
	~	CHF
	~	[NR] Plants above 50 kW.
	|

NR CU open share=
	IF THEN ELSE(Time<2021, 0, IF THEN ELSE(Time<2022, 4/12, 1))
	~	Dmnl
	~	[NR] Access of plants >50 kW to the cantonal contribution: from 1.9.2021 \
		(RFER state 1.9.2021).
	|

NR CU rule[NR class]=
	IF THEN ELSE( Time < 2022 , MIN(250000, NR RU[NR class]/3), IF THEN ELSE(Time<2023, \
		0.25*MIN(250000, NR RU[NR class] / 3 ) + 0.75 * NR CU 2022 rule[NR class] , IF THEN ELSE\
		(Time<2026, NR CU 2022 rule[NR class], IF THEN ELSE(Exploratory analysis>0 , 0.1 * \
		Cantonal PV support , PV rebate cantonal ) * NR Gross cost[NR class])))
	~	CHF
	~	[NR] Cantonal one-off contribution: 1/3 of the federal RU (RFER 2018 for \
		<=50 kW; from 1.9.2021 for all, max 250000); 2022 = 3 months old rule + 9 \
		months new rule; after 2025 SURE PV rebate cantonal (Cantonal PV support \
		in the exploratory analysis). Cumulable with the federal RU.
	|

NR CU 2022 rule[NR class]=
	MIN( 250000 , 0.5 * MIN( NR RU 30 kW , NR RU[NR class] ) + MAX( 0 , NR RU[NR class] \
		- NR RU 30 kW) / 3 )
	~	CHF
	~	[NR] RFER from 1.4.2022: 50% of the federal RU on the first 30 kW + 1/3 of \
		the RU above, max CHF 250000.
	|

NR RU 30 kW=
	NR RU grant[NR Mid]+NR RU per kW[NR Mid]*30
	~	CHF
	~	[NR] Federal RU of a 30 kW plant with the 30-100 kW tables (approximation \
		of the KLEIV value at 30 kW).
	|

NR RU[NR class]=
	IF THEN ELSE( Time < NR RU start year , 0, IF THEN ELSE( Time < 2026 , MIN( NR RU grant\
		[NR class] +NR RU per kW[NR class] * NR Size[NR class] , 0.3 * NR Gross cost[NR class\
		]), PV rebate federal*NR Gross cost[NR class]))
	~	CHF
	~	[NR] As SURE PV federal subsidy check (max 30% of cost; PV rebate federal \
		after 2025), paid without delay as in the residential model.
	|

NR RU grant[NR Mid]=
	"PV federal grant 30 - 100 kW" ~~|
NR RU grant[NR Large]=
	"PV federal grant > 100 kW"
	~	CHF
	~	[NR] Base contribution (SURE tables).
	|

NR RU start year=
	2018
	~	year
	~	[NR] One-off payment for plants >=30 kW only under the EnG/EnFV in force \
		1.1.2018.
	|

NR TI value[NR class,District]=
	IF THEN ELSE(Time>=2014 :AND: Time<2018, NR Ordinary value[NR class,District]+NR TI admission\
		(Time)*NR Exported kWh[NR class]*(NR RIC tariff[NR class]-NR Expected export price)\
		*NR TI factor, 0)
	~	CHF
	~	[NR] Only for the eligible segment (RFER 2014 art. 12: RIC-TI for private \
		plants up to 50 kW). From 2018 no RIC-TI admission (budget, list), no new \
		promises after 31.12.2020.
	|

NR TI factor=
	(1-(1+NR Discount rate)^(-16))/NR Discount rate-(1-(1+NR Discount rate)^(-MIN(16,NR TI wait\
		(Time))))/NR Discount rate
	~	year
	~	[NR] RIC-TI paid 16 years after the wait (as residential).
	|

NR TI wait(
	[(2013,0)-(2030,5)],(2013,0.5),(2014,0.5),(2015,1.5),(2016,2),(2030,2))
	~	year
	~	[NR] As residential K1.
	|

NR TI admission(
	[(2013,0)-(2030,1)],(2013,1),(2014,1),(2015,0.55),(2016,0.15),(2017,0),(2030,0))
	~	Dmnl
	~	[NR] RIC-TI admission by request year, as residential K1 (single FER \
		budget, FIFO).
	|

NR Share 30 50 kW=
	0.42
	~	Dmnl
	~	[NR] Share of 30-50 kW plants in the 30-100 kW non-residential class, \
		register x RBD (EGID), 2022-2025 = 0.415 (size-neutral cantonal rules). \
		2014-17 0.22, 2018-21 0.59 (bunching at 50 kW while the cantonal \
		contribution was limited to 50 kW).
	|

NR Eligible share[NR Mid]=
	NR Share 30 50 kW ~~|
NR Eligible share[NR Large]=
	0
	~	Dmnl
	~	[NR] Share of the class with access to the cantonal incentives for private \
		plants up to 50 kW (RIC-TI 2014-2017, one-off contribution 2018-8.2021).
	|

NR Federal value[NR class,District]=
	NR Ordinary value[NR class,District]+NR Federal admission(Time)*NR Exported kWh[NR class\
		]*(NR RIC tariff[NR class]-NR Expected export price)*NR Federal factor
	~	CHF
	~	[NR] Sale at market price while waiting, KEV premium after admission.
	|

NR Federal factor=
	(1-(1+NR Discount rate)^(-NR Federal term))/NR Discount rate-(1-(1+NR Discount rate)\
		^(-MIN(NR Federal term,NR Federal wait(Time))))/NR Discount rate
	~	year
	~	[NR] Present value of the KEV premium paid after the wait.
	|

NR Federal term=
	25
	~	year
	~	[NR] KEV contract for plants commissioned up to 2013: 25 years from \
		commissioning, queue years not paid.
	|

NR Federal wait(
	[(2010,0)-(2030,20)],(2010,3.8),(2011,3.8),(2012,6),(2013,7),(2030,7))
	~	year
	~	[NR] Expected years on the KEV list: 2011 3.8 and 2012 6 as residential \
		K2; 2013 7 (about 25000 projects ahead end 2012, 2400-4000 cleared per \
		year).
	|

NR Federal admission(
	[(2010,0)-(2030,1)],(2010,1),(2012,1),(2013,1),(2014,0),(2030,0))
	~	Dmnl
	~	[NR] Expected admission to the federal KEV by year of decision. 2011-2012 \
		as residential K2; 2013: plants >=30 kW had no RU alternative, the queue \
		was the only route; from 2014 0 (BFE fact sheets 2014-2015).
	|

NR Exported kWh[NR class]=
	NR Generation[NR class]*(1-NR SC[NR class])
	~	kWh/year
	~	[NR]
	|

NR Ordinary value[NR class,District]=
	NR Ordinary cash[NR class,District]*NR Annuity lifetime
	~	CHF
	~	[NR]
	|

NR Ordinary cash[NR class,District]=
	NR Generation[NR class] * (NR SC[NR class] * NR Avoided price[NR class,District] + (\
		 1 - NR SC[NR class] ) * NR Expected export price - PV annual mantainance cost )
	~	CHF/year
	~	[NR] Yearly cash flow without feed-in tariff.
	|

NR SC[NR class]=
	IF THEN ELSE( Time < NR Self consumption start year , 0 , NR Self consumption data[NR class\
		] )
	~	Dmnl
	~	[NR]
	|

NR Self consumption start year=
	2014
	~	year
	~	[NR] Right to self-consumption from 1.1.2014 (BFE FAQ 23.10.2013).
	|

NR Self consumption data[NR Mid]=
	WITH LOOKUP(Time, ([(2000,0)-(2100,1)],(2013,0),(2013.99,0),(2014,0.32),(2017.99,0.32\
		),(2018,0.55),(2100,0.55))) ~~|
NR Self consumption data[NR Large]=
	WITH LOOKUP(Time, ([(2000,0)-(2100,1)],(2013,0),(2013.99,0),(2014,0.36),(2017.99,0.36\
		),(2018,0.6),(2022.99,0.6),(2023,0.55),(2100,0.55)))
	~	Dmnl
	~	[NR] Mean self-consumed share of the class fleet = share of plants with \
		self-consumption x self-consumed share among them. 2014-2017: INFRAS for \
		BFE 2020: 71%x45% (30-100 kW), 74%x49% (>=100 kW). 2018-2022: EBP for BFE \
		2022 fig. 39 / tab. 11 (measured 55.7% 30-100 kW, 66.5% 100-500 kW, 74.9% \
		>500 kW; 3% without self-consumption) and BFE 19.2.2025 (Pronovo 2020-22, \
		30-150 kW: 60%). From 2023 NR Large lowered for the plants without \
		self-consumption (Pronovo HEIV 2023-26: about 20% of the capacity >=150 \
		kW).
	|

NR Annuity lifetime=
	(1-(1+NR Discount rate)^(-30))/NR Discount rate
	~	year
	~	[NR]
	|

