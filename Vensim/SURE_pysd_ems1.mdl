Concern index current=
	WITH LOOKUP(Time,([(2010,0)-(2026,100)],(2010,15),(2011,15),(2012,16),(2013,
	19),(2014,17),(2015,13),(2016,10),(2017,16),(2018,11),(2019,14),(2020,14),
	(2021,14),(2022,25),(2023,26),(2024,20),(2025,15),(2026,15)))
	~	Dmnl
	~	[CORE E14] Sorgenbarometer gfs.bern: share of respondents naming energy as \
		a main concern [%], annual 2010-2026.
	|

Concern raw signal=
	(Concern index current-15)/10
	~	Dmnl
	~	[CORE E14] Signal centred on 15% and scaled by 10 percentage points.
	|

Concern contribution=
	Concern coefficient*Concern raw signal
	~	Dmnl
	~	[CORE E14] Added to Utility PV no Eco (PV, RCP and RCPv).
	|

Exp AET source=
	1
	~	Dmnl
	~	[CORE E05] 1 = expected export price from AET of previous year; 0 = \
		original PV cumulative compensation price.
	|

Exp export lag years=
	0
	~	year
	~	[CORE E05] Information lag of the expected export tariff.
	|

Exp AET reference tariff=
	IF THEN ELSE( (Time - Exp export lag years) < 2011, Export price before 2014, IF THEN ELSE\
		( (Time - Exp export lag years) < 2012,
	Export price before 2014, IF THEN ELSE( (Time - Exp export lag years) < 2013, Export price before 2014\
		, IF THEN ELSE( (Time - Exp export lag years) < 2014,
	Export price before 2014, IF THEN ELSE( (Time - Exp export lag years) < 2015, 0.09548\
		, IF THEN ELSE( (Time - Exp export lag years) < 2016,
	0.07154, IF THEN ELSE( (Time - Exp export lag years) < 2017, 0.0592, IF THEN ELSE( (\
		Time - Exp export lag years) < 2018,
	0.07113, IF THEN ELSE( (Time - Exp export lag years) < 2019, 0.08086, IF THEN ELSE( \
		(Time - Exp export lag years) < 2020,
	0.06439, IF THEN ELSE( (Time - Exp export lag years) < 2021, 0.05146, IF THEN ELSE( \
		(Time - Exp export lag years) < 2022,
	0.11032, IF THEN ELSE( (Time - Exp export lag years) < 2023, 0.22471, IF THEN ELSE( \
		(Time - Exp export lag years) < 2024,
	0.0854, IF THEN ELSE( (Time - Exp export lag years) < 2025, 0.0424055,
	0.0556399 ) ) ) ) ) ) ) ) ) ) )) ) ) )
	~	CHF/kWh
	~	[CORE E05] FER-CU/AET export tariff by production year (2024-2025 \
		PV-weighted quarterly). Before 2014 original 9.55 ct/kWh.
	|

Exp expected export price=
	IF THEN ELSE(Time>=Test start year, Test extra export price, 0) + IF THEN ELSE(Time \
		< 2026, IF THEN ELSE(Exp AET source = 0, PV cumulative compensation price, Exp AET reference tariff\
		), (Exp AET reference tariff)*PV uncertain remunaration factor+ FiT + Cantonal PV support\
		 * 0.05 )
	~	CHF/kWh
	~	[CORE E05] Export price used in residential decision cash flows (PV, RCP, \
		RCPv, batteries).
	|

