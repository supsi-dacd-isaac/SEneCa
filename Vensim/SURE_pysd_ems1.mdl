Annual heating degree days coefficient=
	IF THEN ELSE( Time < 2012 , 0.956, 
	IF THEN ELSE( Time < 2013 , 1.067, 
	IF THEN ELSE( Time < 2014 , 1.129, 
	IF THEN ELSE( Time < 2015 , 0.905, 
	IF THEN ELSE( Time < 2016 , 1, 
	IF THEN ELSE( Time < 2017 , 1.067, 
	IF THEN ELSE( Time < 2018 , 1.052, 
	IF THEN ELSE( Time < 2019 , 0.94, 
	IF THEN ELSE( Time < 2020 , 0.998, 
	IF THEN ELSE( Time < 2021 , 0.953, 
	IF THEN ELSE( Time < 2022 , 1.099, 
	IF THEN ELSE( Time < 2023 , 0.909, 
	IF THEN ELSE( Time < 2024 , 0.926, 
	IF THEN ELSE( Time < 2025 , 0.93 , 
	IF THEN ELSE( Time < 2026 , 0.926 , 
	IF THEN ELSE( Time < 2027 , 0.921 , 
	IF THEN ELSE( Time < 2028 , 0.917 , 
	IF THEN ELSE( Time < 2029 , 0.916 , 
	IF THEN ELSE( Time < 2030 , 0.913 , 
	IF THEN ELSE( Time < 2031 , 0.911 , 
	IF THEN ELSE( Time < 2032 , 0.907 , 
	IF THEN ELSE( Time < 2033 , 0.906 , 
	IF THEN ELSE( Time < 2034 , 0.906 , 
	IF THEN ELSE( Time < 2035 , 0.9 , 
	IF THEN ELSE( Time < 2036 , 0.899 , 
	IF THEN ELSE( Time < 2037 , 0.895 , 
	IF THEN ELSE( Time < 2038 , 0.89 , 
	IF THEN ELSE( Time < 2039 , 0.889 , 
	IF THEN ELSE( Time < 2040 , 0.887 , 
	IF THEN ELSE( Time < 2041 , 0.886 , 
	IF THEN ELSE( Time < 2042 , 0.882 , 
	IF THEN ELSE( Time < 2043 , 0.879 , 
	IF THEN ELSE( Time < 2044 , 0.876 , 
	IF THEN ELSE( Time < 2045 , 0.878 , 
	IF THEN ELSE( Time < 2046 , 0.871 , 
	IF THEN ELSE( Time < 2047 , 0.865 , 
	IF THEN ELSE( Time < 2048 , 0.864 , 
	IF THEN ELSE( Time < 2049 , 0.864 , 0.862 ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) \
		) ) ) ) ) ) ) ) ) ) ) ) ) ) ) ) )
	~	
	~		|

Annual SH demand by arch[District,HS,Performance,Type]=
	Annual SH demand[District,Performance,Type] * SUM(Heating Solution[District,HS,Performance\
		,Type,PVpanel!,Battery!]) * Share primary houses[District]
	~	kWh
	~		|

Batteries by HS[HS]=
