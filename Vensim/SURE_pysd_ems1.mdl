Peer installed base[District]= INTEG(
	Probability of Adoption PV District[District] - Peer decay*Peer installed base[District\
		],
	(41 + 28*(1-Peer decay) + 17*(1-Peer decay)^2 + 4*(1-Peer decay)^3 + 4*(1-Peer decay\
		)^4)*68/73/98617)
	~	Dmnl
	~	[CORE-PV] Decayed share of buildings with PV, from installations of \
		previous years.
	|

Peer decay=
	0.3
	~	1/year
	~	[CORE-PV] Yearly decay of the influence of past installations (0 = full \
		installed base).
	|

Study RU 2013 payment wait=
	1.5
	~	year
	~	[CORE-PV] Wait for the 2013 RU payment (2014 backlog, paid by 2015).
	|

Export price before 2014=
	0.07
	~	CHF/kWh
	~	[CORE-PV] Export price of production years 2011-2013 (SURE_core 0.0955; \
		BFE: market-based 0.05-0.09).
