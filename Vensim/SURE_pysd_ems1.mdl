	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0),(2012,0),(2013,0),(2014,0),\
		(2015,0),(2016,0),(2017,0),(2018,54.6889),(2019,58.4731),(2020,86.1726),(2021,97.2156\
