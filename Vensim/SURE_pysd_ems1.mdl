RoCH federal RUG data[RP40]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0),(2012,0),(2013,0),(2014,0),\
		(2015,0),(2016,0),(2017,0),(2018,54.6889),(2019,58.4731),(2020,86.1726),(2021,97.2156\
		),(2022,116.79),(2023,126.935),(2024,168.405),(2025,320.307),(2026,561.073),(2027,545.179\
		),(2028,464.859),(2029,448.954),(2030,434.555),(2031,438.375),(2032,443.321),(2033,\
