Peer effect HS factor[HS,District,Type] :EXCEPT:         [WithGeoConstraint,District,\
		Type]=
	Peer effect HS[District,HS] / SUM(Peer effect HS[District,HS!]) * Peer effect HS weight\
		 ~~|
Peer effect HS factor[WithGas,District,Type]=
	MIN( Peer effect HS[District,WithGas] / SUM(Peer effect HS[District,HS!]) / Gas suitability\
		[District,Type] * Peer effect HS weight , 5 ) ~~|
Peer effect HS factor[DH,District,Type]=
	MIN( Peer effect HS[District,DH] / SUM(Peer effect HS[District,HS!]) / DH suitability\
		[District,Type] * Peer effect HS weight , 5 )
	~	Dmnl
	~		|

