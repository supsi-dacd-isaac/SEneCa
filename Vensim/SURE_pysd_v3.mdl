		!,Battery!]) / 
	( SUM(Heating Solution[District!,HS!,Moderate,Type!,PVpanel!,Battery!]) + SUM(Heating Solution\
		[District!,HS!,High,Type!,PVpanel!,Battery!]) + SUM(Heating Solution[District!,HS!,\
