Annural Cantonal subsidy CU by archetype[District,HS,Performance,Type]=
	SUM(Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * PV cantonal subsidy[District,Type] + 
	SUM(Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * RCPv cantonal subsidy[District,Type]
	~	CHF
	~		|

DSO charge[Vallemaggia]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Vallemaggia] , 
	
	( Initial DSO expenses[Vallemaggia] + Total annual grid upgrading cost by DSO smooth\
		[Vallemaggia] ) / ( Total annual grid demand Districts[Vallemaggia] + Total annual grid demand Districts\
		[Riviera] + Total annual grid demand Districts[Locarno] + Total annual grid demand Districts\
		[Leventina] + Total annual grid demand Districts[Blenio] ) ) ~~|
DSO charge[Mendrisio]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Mendrisio] , 
	
	( Initial DSO expenses[Mendrisio] + Total annual grid upgrading cost by DSO smooth[Mendrisio\
		]) / Total annual grid demand Districts[Mendrisio] ) ~~|
DSO charge[Bellinzona]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Bellinzona] , 
	
	( Initial DSO expenses[Bellinzona] + Total annual grid upgrading cost by DSO smooth[\
		Bellinzona]) / Total annual grid demand Districts[Bellinzona] ) ~~|
DSO charge[Leventina]=
	DSO charge[Vallemaggia] ~~|
DSO charge[Blenio]=
	DSO charge[Vallemaggia] ~~|
DSO charge[Lugano]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Lugano] , 
	
	( Initial DSO expenses[Lugano] + Total annual grid upgrading cost by DSO smooth[Lugano\
		]) / Total annual grid demand Districts[Lugano] ) ~~|
DSO charge[Riviera]=
	DSO charge[Vallemaggia] ~~|
DSO charge[Locarno]=
	DSO charge[Vallemaggia]
	~	CHF/kWh
	~		|

Initial DSO charge[District]=
	Grid Charge[District] - TSO charge
	~	CHF/kWh
	~		|

Initial DSO expenses[Vallemaggia]=
	Initial DSO charge[Vallemaggia] * Stock total cost increase * ( 40.4501 + 64.1812 + \
		426.566 + 100.634 + 39.921 ) * 1e+06 ~~|
Initial DSO expenses[Mendrisio]=
	Initial DSO charge[Mendrisio] * Stock total cost increase * 429.872 * 1e+06 ~~|
Initial DSO expenses[Bellinzona]=
	Initial DSO charge[Bellinzona] * Stock total cost increase * 372.291 * 1e+06 ~~|
Initial DSO expenses[Leventina]=
	Initial DSO expenses[Vallemaggia] ~~|
Initial DSO expenses[Blenio]=
	Initial DSO expenses[Vallemaggia] ~~|
Initial DSO expenses[Lugano]=
	Initial DSO charge[Lugano] * Stock total cost increase * 1160.01 * 1e+06 ~~|
Initial DSO expenses[Riviera]=
	Initial DSO expenses[Vallemaggia] ~~|
Initial DSO expenses[Locarno]=
	Initial DSO expenses[Vallemaggia]
	~	CHF
	~		|

Res VeryLow Low renovation[District,Type]=
	VeryLow to Performance[District,Type,Low]
	~	building
	~		|

Res VeryLow Buildings[District,Type]= INTEG (
	-Res VeryLow demolition[District,Type]-Res VeryLow High renovation[District,Type]-Res VeryLow Low renovation\
		[District,Type]-Res VeryLow Moderate renovation[District,Type]-Res VeryLow VeryHigh renovation\
		[District,Type],
		Res VeryLow Buildings i[District,Type])
	~	building
	~		|

Res VeryLow demolition[District,Type]=
	IF THEN ELSE( Time < 2026 , 0 ,
	
	IF THEN ELSE(Res VeryLow Buildings[District,Type] > SUM(Overall demolited buildings[\
		Type!]) * Res buildings share[District,VeryLow,Type] ,
	
	SUM(Overall demolited buildings[Type!]) * Res buildings share[District,VeryLow,Type]\
		 , Res VeryLow Buildings[District,Type] ) )
	~	building
	~		|

Res VeryLow Buildings i[District,Type]=
	SUM(Res buildings i[VeryLow,District,Type,PVpanel!])
	~	building
	~		|

