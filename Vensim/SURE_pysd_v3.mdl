	Ground specific cost * Ground size by Type and District[District,Type]
	~	
	~		|

HT cumulative cost change[OilBoiler]=
	1 ~~|
HT cumulative cost change[GasBoiler]=
	1 ~~|
HT cumulative cost change[WoodBoiler]=
	1 ~~|
HT cumulative cost change[PelletBoiler]=
	1 ~~|
HT cumulative cost change[HP]=
	IF THEN ELSE( Time < 2020 , 1.08 - 0.08 * (Time - 2011) / (2020 - 2011) , 
	IF THEN ELSE( Time < 2030 , 1 - 0.08 * (Time - 2020) / (2030 - 2020) , 0.92 - 0.08 *\
		 (Time - 2030) / (2050 - 2030) ) ) ~~|
HT cumulative cost change[EH]=
	1 ~~|
HT cumulative cost change[ST]=
	1
	~	
	~		|

Roof Low[District,Type,VeryLow]=
	- Roof cost Low[District,Type] ~~|
Roof Low[District,Type,Low]=
	- Roof cost Low[District,Type] ~~|
Roof Low[District,Type,Moderate]=
	- Roof cost Moderate[District,Type] - Total present variable costs SH average[District\
		,Moderate,Type] + Total present variable costs SH average[District,Low,Type] ~~|
Roof Low[District,Type,High]=
	- Roof cost High[District,Type] - Total present variable costs SH average[District,High\
		,Type] + Total present variable costs SH average[District,Low,Type] ~~|
Roof Low[District,Type,VeryHigh]=
	- Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,Low,Type]
	~	
	~		|

Roof Low scaled[District,Type,Performance]=
	( Roof Low[District,Type,Performance] - ( VMAX(Roof Low[District,Type,Performance!])\
		 - VMIN(Roof Low[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff Low[Type,Performance\
		]
	~	
	~		|

Roof Moderate[District,Type,VeryLow]=
	- Roof cost Moderate[District,Type] ~~|
Roof Moderate[District,Type,Low]=
	- Roof cost Moderate[District,Type] ~~|
Roof Moderate[District,Type,Moderate]=
	- Roof cost Moderate[District,Type] ~~|
Roof Moderate[District,Type,High]=
	- Roof cost High[District,Type] - Total present variable costs SH average[District,High\
		,Type] + Total present variable costs SH average[District,Moderate,Type] ~~|
Roof Moderate[District,Type,VeryHigh]=
	- Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,Moderate,Type]
	~	
	~		|

Grid HS Factor[HS]=
	Grid HS weight * Dummy Grid HS[HS]
	~	
	~		|

Grid HS weight=
	-1.07405
	~	
	~		|

Roof Moderate scaled[District,Type,PerformanceLow]=
