Ground VeryLow scaled[District,Type,Performance]=
	( Ground VeryLow[District,Type,Performance] - ( VMAX(Ground VeryLow[District,Type,Performance\
		!]) - VMIN(Ground VeryLow[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff VeryLow\
		[Type,Performance]
	~	
	~		|

Wall Low[District,Type,VeryLow]=
	- Wall cost Low[District,Type] ~~|
Wall Low[District,Type,Low]=
	- Wall cost Low[District,Type] ~~|
Wall Low[District,Type,Moderate]=
	- Wall cost Moderate[District,Type] - Total present variable costs SH average Wall[District\
		,Moderate,Type] + Total present variable costs SH average Wall[District,Low,Type] ~~|
Wall Low[District,Type,High]=
	- Wall cost High[District,Type] - Total present variable costs SH average Wall[District\
		,High,Type] + Total present variable costs SH average Wall[District,Low,Type] ~~|
Wall Low[District,Type,VeryHigh]=
	- Wall cost VeryHigh[District,Type] - Total present variable costs SH average Wall[District\
