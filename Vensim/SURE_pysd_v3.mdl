Historical energy price[Bellinzona]=
	IF THEN ELSE( Time < 2012, 0.1003 , 
	IF THEN ELSE( Time < 2013, 0.0954 , 
	IF THEN ELSE( Time < 2014, 0.1064 , 
	IF THEN ELSE( Time < 2015, 0.0985 , 
	IF THEN ELSE( Time < 2016, 0.0935 , 
	IF THEN ELSE( Time < 2017, 0.0891 , 
	IF THEN ELSE( Time < 2018, 0.0801 , 
	IF THEN ELSE( Time < 2019, 0.0659 , 
	IF THEN ELSE( Time < 2020, 0.0698 , 
	IF THEN ELSE( Time < 2021, 0.0726 , 
	IF THEN ELSE( Time < 2022, 0.0726 , 
	IF THEN ELSE( Time < 2023, 0.0749 , 
	IF THEN ELSE( Time < 2024, 0.0846 , 
	IF THEN ELSE( Time < 2025, 0.1196 , 
	IF THEN ELSE( Time < 2026, 0.1206 , 0.0926 ))))))))))))))) ~~|
Historical energy price[Vallemaggia]=
	IF THEN ELSE( Time < 2012, 0.1085 , 
	IF THEN ELSE( Time < 2013, 0.108 , 
