		[District,Vechicle] + 0.0001 )
	~	
	~		|

Res Moderate VeryHigh renovation[District,Type]=
	Moderate to Performance[District,Type,VeryHigh]
	~	
	~		|

MFH High to Performance[Performance]=
	SUM(High to Performance[District!,MFH,Performance])
	~	
	~		|

MFH Low to Performance[Performance]=
	SUM(Low to Performance[District!,MFH,Performance])
	~	
	~		|

Low to Performance SFH MS[Performance]=
	( SUM(Low to Performance[District!,SFH,Performance]) + SUM(Low to Performance[District\
		!,DFH,Performance]) ) / 
	
	( SUM(Low to Performance[District!,SFH,Performance!]) + SUM(Low to Performance[District\
		!,DFH,Performance!]) )
	~	
	~		|

SFH Low to Performance[Performance]=
