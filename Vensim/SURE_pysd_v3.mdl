	IF THEN ELSE( Exploratory analysis > 0 , 
	Investment cost HS noST adj[HeatPump,District,Performance,Type] * Renewable heating incentives\
		 , 
	Investment cost HS noST adj[HeatPump,District,Performance,Type] * Grant share HP ) ~~|
