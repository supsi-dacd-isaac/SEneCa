PV federal investment grant capacity=
	IF THEN ELSE(Time < 2014, 0, 
	IF THEN ELSE(Time < 2015, 1050, 
	IF THEN ELSE(Time < 2016, 830, 
	IF THEN ELSE(Time < 2017, 610, 
	IF THEN ELSE(Time < 2018, 520, 
	IF THEN ELSE(Time < 2019, 460, 
	IF THEN ELSE(Time < 2020, 380, 
	IF THEN ELSE(Time < 2021, 380, 
	IF THEN ELSE(Time < 2026, 420 , 
	IF THEN ELSE(Time < 2030, 420 , 420 ))))))))))
	~	CHF/kW
	~	IF THEN ELSE(Time < 2014.25, 0, 
		IF THEN ELSE(Time < 2015, 1050, 
		IF THEN ELSE(Time < 2016, 830, 
		IF THEN ELSE(Time < 2017, 610, 
		IF THEN ELSE(Time < 2018, 520, 
		IF THEN ELSE(Time < 2019, 460, 
		IF THEN ELSE(Time < 2020, 380, 
		IF THEN ELSE(Time < 2021, 380, 
		IF THEN ELSE(Time < 2022, 420 , 
		SMOOTH( IF THEN ELSE(Time < 2035, Sensitivity 1 , 0 ) , 1 ) )))))))))
	|

PV annual mantainance cost=
