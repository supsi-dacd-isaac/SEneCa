Range Utility V[Vechicle]=
	( Vehicle Range[Vechicle] - ( VMAX(Vehicle Range[Vechicle!]) + VMIN(Vehicle Range[Vechicle\
		!]) ) / 2 ) / VMAX(Vehicle Range[Vechicle!])
	~	Dmnl
