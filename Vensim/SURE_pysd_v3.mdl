Renters adopting PV[District,HS,Performance,Type] :EXCEPT:               [District,HS\
		,Performance,MFH]=
	IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) * Probability adoption PV Renters\
		[District,HS,Performance,Type] ) , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] * ( 1 - Share urban buildings\
		[District,Type] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] * ( Energy Community scenario\
		 - 1 ) ) ~~|
