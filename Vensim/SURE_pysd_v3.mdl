Investment cost HS noST adj[Oil,District,Performance,Type]=
	Investment cost HS noST[Oil,District,Performance,Type] * HT cumulative cost change[OilBoiler\
		] ~~|
Investment cost HS noST adj[Gas,District,Performance,Type]=
	Investment cost HS noST[Gas,District,Performance,Type] * HT cumulative cost change[GasBoiler\
		] ~~|
Investment cost HS noST adj[ElectricHeater,District,Performance,Type]=
	Investment cost HS noST[ElectricHeater,District,Performance,Type] * HT cumulative cost change\
		[EH] ~~|
Investment cost HS noST adj[Wood,District,Performance,Type]=
	Investment cost HS noST[Wood,District,Performance,Type] * HT cumulative cost change[\
		WoodBoiler] ~~|
Investment cost HS noST adj[OilST,District,Performance,Type]=
	Investment cost HS noST[OilST,District,Performance,Type] * HT cumulative cost change\
		[OilBoiler] ~~|
Investment cost HS noST adj[GasST,District,Performance,Type]=
	Investment cost HS noST[GasST,District,Performance,Type] * HT cumulative cost change\
		[GasBoiler] ~~|
Investment cost HS noST adj[WoodST,District,Performance,Type]=
	Investment cost HS noST[WoodST,District,Performance,Type] * HT cumulative cost change\
		[WoodBoiler] ~~|
Investment cost HS noST adj[HPST,District,Performance,Type]=
	Investment cost HS noST[HPST,District,Performance,Type] * HT cumulative cost change[\
		HP] * HP cost uncertainty factor ~~|
Investment cost HS noST adj[HeatPump,District,Performance,Type]=
	Investment cost HS noST[HeatPump,District,Performance,Type] * HT cumulative cost change\
		[HP] * HP cost uncertainty factor ~~|
Investment cost HS noST adj[pellet,District,Performance,Type]=
	Investment cost HS noST[pellet,District,Performance,Type] * HT cumulative cost change\
		[PelletBoiler] ~~|
Investment cost HS noST adj[DH,District,Performance,Type]=
	Investment cost HS noST[DH,District,Performance,Type]
	~	
	~		|

PV initial cantonal subsidy[District,Type]=
	IF THEN ELSE( Time < 2026 , 
	0 , 
	IF THEN ELSE( Exploratory analysis > 0 , PV investment cost[District,Type] * 0.1 * Cantonal PV support\
		 , PV investment cost[District,Type] * PV rebate cantonal ) )
	~	CHF
	~		|

Interest rate uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Interest rate uncertainty )
	~	
	~		|

Import price uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Import price uncertainty )
	~	
	~		|

Roof specific cost CECE High=
	361 * Renovation cost index * Retrofit uncertain cost factor
	~	CHF/m2
	~		|

Industry demand uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Industry demand uncertainty )
	~	
	~		|

"Wood/pellet lifetime uncertainty factor"=
	IF THEN ELSE( Time < 2026 , 1 , 1 + "Wood/pellet lifetime uncertainty" )
	~	
	~		|

HP efficiency uncertainty=
	0
	~	
	~		|

Owners adopting PV[District,HS,Performance,Type] :EXCEPT:                [District,HS\
		,Performance,MFH]=
	IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] * Probability adoption PV Owners[District\
		,HS,Performance,Type] ) ,
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	(1 - Share urban buildings[District,Type] ) * Probability adoption PV Owners[District\
		,HS,Performance,Type] * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * Probability adoption PV Owners\
		[District,HS,Performance,Type] * ( Energy Community scenario - 1 ) ) ~~|
Owners adopting PV[District,HS,Performance,MFH]=
	IF THEN ELSE( Time < 2018 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery!]) > \
		0 ,
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,MFH] , 
	
	SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] * Probability adoption PV Owners\
		[District,HS,Performance,MFH] ) , 0 )
	~	
	~		|

HP efficiency uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + HP efficiency uncertainty )
	~	
	~		|

Exploratory analysis=
	0
	~	
	~		|

Owners adopting RCP[District,HS,Performance,Type] :EXCEPT:    [District,HS,Performance\
		,MFH]=
	0 ~~|
Owners adopting RCP[District,HS,Performance,MFH]=
	IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) )
	~	
	~		|

