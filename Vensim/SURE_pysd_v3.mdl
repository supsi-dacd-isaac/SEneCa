Fuel price factor change[Petrol]=
	IF THEN ELSE( Time < 2012 , 0.08 , 
	IF THEN ELSE( Time < 2013 , -0.04 , 
	IF THEN ELSE( Time < 2014 , -0.05 , 
	IF THEN ELSE( Time < 2015 , -0.23 , 
	IF THEN ELSE( Time < 2016 , -0.08 , 
	IF THEN ELSE( Time < 2017 , 0.1 , 
	IF THEN ELSE( Time < 2018 , 0.12 , 
	IF THEN ELSE( Time < 2019 , -0.03 , 
	IF THEN ELSE( Time < 2020 , -0.17 , 
	IF THEN ELSE( Time < 2021 , 0.24 , 
	IF THEN ELSE( Time < 2022 , 0.33 , 
	IF THEN ELSE( Time < 2023 , -0.17 , 0 )))))))))))) ~~|
Fuel price factor change[Diesel]=
	IF THEN ELSE( Time < 2012 , 0.07 , 
	IF THEN ELSE( Time < 2013 , -0.04 , 
	IF THEN ELSE( Time < 2014 , -0.07 , 
	IF THEN ELSE( Time < 2015 , -0.27 , 
	IF THEN ELSE( Time < 2016 , -0.1 , 
	IF THEN ELSE( Time < 2017 , 0.13 , 
	IF THEN ELSE( Time < 2018 , 0.16 , 
	IF THEN ELSE( Time < 2019 , 0 , 
	IF THEN ELSE( Time < 2020 , -0.2 , 
	IF THEN ELSE( Time < 2021 , 0.2 , 
	IF THEN ELSE( Time < 2022 , 0.44 , 
	IF THEN ELSE( Time < 2023 , -0.2 , 0 ))))))))))))
	~	
	~		|

Annual vehicle tax[Vechicle]=
	Annual circulation tax[Vechicle]
	~	CHF
	~	IF THEN ELSE( Time < 2019, IF THEN ELSE( CO2eq per km adj[Vechicle] > 0.095 , 120 + \
		(CO2eq per km adj[Vechicle] * 1000 - 95) ^ 1.422 , 95 ) , 
		IF THEN ELSE( Time < 2023 , IF THEN ELSE( CO2eq per km adj[Vechicle] > \
		0.12 , 120 + (CO2eq per km adj[Vechicle] * 1000 - 120) ^ 1.422 , 120 ) , \
		Annual circulation tax[Vechicle] ))
	|

PM coefficient=
	1
	~	
	~		|

