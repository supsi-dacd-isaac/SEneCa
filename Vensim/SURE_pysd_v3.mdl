		] + Technology DHW installed capacity SH and DHW[District,Type] ) < 15 , 
	
	"Initial grant < 15 kW"[PelletBoiler] + "Investment grant per kW < 15 kW"[PelletBoiler\
		] * ( Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type] ) , 
	
	"Initial grant > 15 kW"[PelletBoiler] + "Investment grant per kW > 15 kW"[PelletBoiler\
		] * ( Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type] ) ) , Grant absolute[pellet,District,Performance,Type] )
