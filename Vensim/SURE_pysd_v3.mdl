Grid Charge[Bellinzona]=
	IF THEN ELSE( Time < 2012, 0.0902 , 
	IF THEN ELSE( Time < 2013, 0.0872 , 
	IF THEN ELSE( Time < 2014, 0.0784 , 
	IF THEN ELSE( Time < 2015, 0.0827 , 
	IF THEN ELSE( Time < 2016, 0.0801 , 
	IF THEN ELSE( Time < 2017, 0.0822 , 
	IF THEN ELSE( Time < 2018, 0.0747 , 
	IF THEN ELSE( Time < 2019, 0.0739 , 
	IF THEN ELSE( Time < 2020, 0.0784 , 
	IF THEN ELSE( Time < 2021, 0.0816 , 
	IF THEN ELSE( Time < 2022, 0.0846 , 
	IF THEN ELSE( Time < 2023, 0.0851 , 
	IF THEN ELSE( Time < 2024, 0.0901 , 
	IF THEN ELSE( Time < 2025, 0.1095 , 
	IF THEN ELSE( Time < 2026, 0.1045 , 0.0913 ))))))))))))))) ~~|
Grid Charge[Vallemaggia]=
	IF THEN ELSE( Time < 2012, 0.0995 , 
	IF THEN ELSE( Time < 2013, 0.0974 , 
	IF THEN ELSE( Time < 2014, 0.1018 , 
