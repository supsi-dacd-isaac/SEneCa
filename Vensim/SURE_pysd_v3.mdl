Renters adopting RCP[District,HS,Performance,Type] :EXCEPT:        [District,HS,Performance\
		,MFH]=
	0 ~~|
Renters adopting RCP[District,HS,Performance,MFH]=
	IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario - 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) )
	~	
	~		|

Adoptions WoodST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:        \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,WoodST,Performance,Type,PVpanel] ~~|
Adoptions WoodST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

PV uncertain cost factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + PV uncertain cost )
	~	
	~		|

Battery investiment cost=
