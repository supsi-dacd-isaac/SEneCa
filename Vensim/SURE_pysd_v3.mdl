{UTF-8}
HP lifetime uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + HP lifetime uncertainty )
	~	
	~		|

Tertiary demand uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Tertiary demand uncertainty )
	~	
	~		|

Ground specific cost Minergie=
	182 * Renovation cost index * Retrofit uncertain cost factor
	~	CHF/m2
	~		|

"Oil/gas lifetime uncertainty"=
	0
	~	
	~		|

"Oil/gas lifetime uncertainty factor"=
	IF THEN ELSE( Time < 2026 , 1 , 1 + "Oil/gas lifetime uncertainty" )
	~	
	~		|

Adoptions OilST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:      \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,OilST,Performance,Type,PVpanel] ~~|
Adoptions OilST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

PV uncertain cost=
	0
	~	
	~		|

Battery uncertain cost=
	0
	~	
	~		|

Battery uncertain cost factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Battery uncertain cost )
	~	
	~		|

Retrofit uncertain cost factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Retrofit uncertain cost )
	~	
	~		|

New to MiddleAge delay[HS]=
	DELAY FIXED( New to MiddleAge[HS] , 4 , HS MiddleAge[HS] * Aging Rate[HS] )
	~	
	~		|

"PV > 100 kW investment cost Time adj"=
	"PV > 100 kW investment cost" * PV cumulative cost change * PV uncertain cost factor
	~	CHF
	~		|

Import price uncertainty=
	0
	~	
	~		|

Industry demand uncertainty=
	0
	~	
	~		|

Average energy price market=
	SUM(Electricity total hourly cost[Month!,Hour!]) / ( SUM(Hourly demand and PHS[Month\
		!,Hour!]) * 1e+06 ) * Import price uncertainty factor
	~	CHF/kWh
	~		|

Adoptions DH from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:     \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,DH,Performance,Type,PVpanel] ~~|
Adoptions DH from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Electricity consumption Industry=
	Electricity consumption Industry historical * Industry demand uncertainty factor
	~	GWh
	~	IF THEN ELSE( Time < 2024 , Electricity consumption Industry historical , \
		Electricity consumption Industry factor * 854 )
	|

Adoptions GasST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:       \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,GasST,Performance,Type,PVpanel] ~~|
Adoptions GasST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Wall specific cost CECE High=
	290 * Renovation cost index * Retrofit uncertain cost factor
	~	CHF/m2
	~		|

Electricity consumption Tertiary=
	Electricity consumption Tertiary historical * Tertiary demand uncertainty factor
	~	GWh
	~	IF THEN ELSE( Time < 2024 , Electricity consumption Tertiary historical , \
		Electricity consumption Tertiary factor * 744 )
	|

Tertiary demand uncertainty=
	0
	~	
	~		|

