	~	Mio m2
	~		|

Annual SH variable costs HS by archetype[District,OilST,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual SH variable costs HS by archetype[District,GasST,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual SH variable costs HS by archetype[District,pellet,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[PelletBoiler] * Carrier used cost per kWh\
		[District,PelletBoiler] ~~|
Annual SH variable costs HS by archetype[District,HeatPump,Performance,Type,PVyes]=
	( - Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HeatPump,Performance,Type]) -\
		 
	
	Annual SH demand[District,Performance,Type] / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] ) ~~|
Annual SH variable costs HS by archetype[District,WoodST,Performance,Type,PVpanel]=
