	~	
	~		|

Share of buildings with PV=
	SUM(Heating Solution[District!,HS!,Performance!,Type!,PVyes,Battery!]) / SUM(Heating Solution\
		[District!,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		|

DH and Gas suitability[District,Type]=
	DH suitability[District,Type] * Gas suitability[District,Type]
	~	
	~		|

Gas only suitability[District,Type]=
	( 1 - DH suitability[District,Type] ) * Gas suitability[District,Type]
	~	
	~		|

DH only suitability[District,Type]=
	DH suitability[District,Type] * ( 1 - Gas suitability[District,Type] )
	~	
	~		|

NonRenSolution:
	Oil,Gas,ElectricHeater,OilST,GasST
	~	
	~		|

Aging Rate[HS]=
	1 / Lifetime[HS] * 5
	~	
	~		|

Suitability check[District,Type]=
	DH and Gas suitability[District,Type] + DH only suitability[District,Type] + Gas only suitability\
		[District,Type] + No suitability[District,Type]
	~	
	~		|

Roof Moderate exp[District,Type,PerformanceHigh]=
	exp(Roof Moderate scaled[District,Type,PerformanceHigh]) ~~|
Roof Moderate exp[District,Type,PerformanceLow]=
	0
	~	
	~		|

Roof Moderate probabilities[District,Type,Performance]=
	Roof Moderate exp[District,Type,Performance] / SUM(Roof Moderate exp[District,Type,Performance\
		!])
	~	
	~		|

Investment grant per kW DH=
	IF THEN ELSE(Time < 2017, 0, 
	
	IF THEN ELSE(Time < 2022, 50,
	
	IF THEN ELSE(Time < 2025 , 50 , 40 ) ) )
	~	
	~		|

Ground cost High[District,Type]=
	( Ground specific cost CECE High - Incentive CECE ) * Ground size by Type and District\
		[District,Type]
	~	
	~		|

Ground cost Low[District,Type]=
	Ground specific cost Base * Ground size by Type and District[District,Type]
	~	
	~		|

Roof VeryLow[District,Type,VeryLow]=
	- Roof cost[District,Type] ~~|
Roof VeryLow[District,Type,Low]=
	( - Roof cost Low[District,Type] - Total present variable costs SH average[District,\
		Low,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,Moderate]=
	( - Roof cost Moderate[District,Type] - Total present variable costs SH average[District\
		,Moderate,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,High]=
	( - Roof cost High[District,Type] - Total present variable costs SH average[District\
		,High,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,VeryHigh]=
	( - Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,VeryLow,Type] )
	~	
	~		|

