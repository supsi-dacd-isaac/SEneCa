	IF THEN ELSE( Time < 2025 , Utility HS exp no incentives[District,OldS,PerformanceLow\
		,Type,PVpanel] , 
	
	IF THEN ELSE( MuKEn 2014 scenario > 0 , 0 , Utility HS exp no incentives[District,OldS\
		,PerformanceLow,Type,PVpanel] ) ) ~~|
Utility HS exp 2 no incentives[District,NewS,Performance,Type,PVpanel]=
	Utility HS exp no incentives[District,NewS,Performance,Type,PVpanel] ~~|
Utility HS exp 2 no incentives[District,OldS,PerformanceHigh,Type,PVpanel]=
	Utility HS exp no incentives[District,OldS,PerformanceHigh,Type,PVpanel]
	~	
	~		|

Oil vs HP difference[District,Performance,Type,PVpanel]=
	VMIN(Annualized Total Cost HS[District,OldS!,Performance,Type,PVpanel]) - Annualized Total Cost HS\
		[District,HeatPump,Performance,Type,PVpanel]
	~	
	~		|

Old to VeryOld[HS]=
	MiddleAge to Old delay[HS]
	~	
	~		|

Probability of Adoption PV District delay 1[District]=
	DELAY FIXED( Probability of Adoption PV District[District] , 1 , 0.001 )
	~	
	~		|

Probability of Adoption PV District delay 2[District]=
	DELAY FIXED( Probability of Adoption PV District[District] , 2 , 0.001 )
	~	
	~		|

Probability of Adoption PV District smooth[District]=
	Probability of Adoption PV District delay 1[District] + Probability of Adoption PV District delay 2\
		[District] / 2
	~	
	~		|

MuKEn 2025 scenario application=
	IF THEN ELSE( Time < 2031 , 0 , MuKEn 2025 scenario )
	~	
	~		|

Market Share HS no incentives[District,HS,Performance,Type,PVpanel]=
	Utility HS exp 3 no incentives[District,HS,Performance,Type,PVpanel] / SUM(Utility HS exp 3 no incentives\
		[District,HS!,Performance,Type,PVpanel])
	~	
	~		|

Market Share HS no incentives filtered[District,HS,Performance,Type,PVpanel]=
	Market Share HS no incentives[District,HS,Performance,Type,PVpanel] * DH and Gas suitability\
		[District,Type] + 
	Market Share HS no incentives noGas[District,HS,Performance,Type,PVpanel] * DH only suitability\
		[District,Type] + 
	Market Share HS no incentives noDH[District,HS,Performance,Type,PVpanel] * Gas only suitability\
		[District,Type] + 
	Market Share HS no incentives noDH noGas[District,HS,Performance,Type,PVpanel] * No suitability\
		[District,Type]
	~	
	~		|

New to MiddleAge[HS]=
	VeryNew to New delay[HS]
	~	
	~		|

DH suitability[District,Type]=TABBED ARRAY(
	0.022602	0.066001	0.176036
	0.000583	0.003284	0.009009
	0.012277	0.040992	0.109515
	0.042563	0.06957	        0.263917
	0.052761	0.089121	0.305364
	0.054766	0.085355	0.2383
	0.016471	0.036468	0.075795
	0.020444	0.040307	0.036145
	)
	~	
	~		|

RenSolution:
	Wood,WoodST,HPST,HeatPump,pellet,DH
	~	
	~		|

No suitability[District,Type]=
	( 1 - DH suitability[District,Type] ) * ( 1 - Gas suitability[District,Type] )
	~	
	~		|

WithGeoConstraint:
	Gas, GasST, DH
	~	
	~		|

WithGas:
	Gas, GasST
	~	
	~		|

