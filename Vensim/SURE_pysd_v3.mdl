		 + 
	Low changing Wall[District,Type] * Wall Low probabilities[District,Type,Performance]\
		 +
	Low changing Ground[District,Type] * Ground Low probabilities[District,Type,Performance\
		]
	~	
	~		|

Ground VeryLow[District,Type,VeryLow]=
	- Ground cost[District,Type] ~~|
Ground VeryLow[District,Type,Low]=
	( - Ground cost Low[District,Type] - Total present variable costs SH average Ground[\
		District,Low,Type] + Total present variable costs SH average Ground[District,VeryLow\
		,Type] ) ~~|
Ground VeryLow[District,Type,Moderate]=
	( - Ground cost Moderate[District,Type] - Total present variable costs SH average Ground\
		[District,Moderate,Type] + Total present variable costs SH average Ground[District,\
		VeryLow,Type] ) ~~|
Ground VeryLow[District,Type,High]=
	( - Ground cost High[District,Type] - Total present variable costs SH average Ground\
		[District,High,Type] + Total present variable costs SH average Ground[District,VeryLow\
		,Type] ) ~~|
Ground VeryLow[District,Type,VeryHigh]=
	( - Ground cost VeryHigh[District,Type] - Total present variable costs SH average Ground\
		[District,VeryHigh,Type] + Total present variable costs SH average Ground[District,\
		VeryLow,Type] )
	~	
	~		|

