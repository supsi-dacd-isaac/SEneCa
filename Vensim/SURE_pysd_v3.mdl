	Annual total inflow * Hour factor HS[Month,Hour]
	~	
	~		|

Monthly Hydro available supply[Month]=
	SUM(Hydro hourly available supply[Month,Hour!]) * 365 / 12
	~	
	~		~	:SUPPLEMENTARY 
	|

Annual PHSn inflow historical NOT for Ticino:INTERPOLATE::= GET DIRECT DATA('Input Hour Factors_pysd_v3.csv', '', '1', 'B16') ~	
	~		|

Monthly exported electricity[Month,Supplier]=
	SUM(Hourly exported electricity[Month,Hour!,Supplier]) * 365 / 12
	~	
	~		|

Annual electricity demand=
	SUM(Monthly electricity demand[Month!])
	~	
	~		|

Annual electricity dispatched[Supplier]=
	SUM(Monthly electricity dispatched[Month!,Supplier])
	~	
	~		|

Annual HS inflow historical for Ticino:INTERPOLATE::= GET DIRECT DATA('Input Hour Factors_pysd_v3.csv', '', '1', 'B17') ~	
	~		|

Annual total inflow for Ticino=
	(Annual HS inflow for Ticino + Annual PHSn inflow for Ticino) / 1000 - 
	IF THEN ELSE( Time < 2026 , 0 , Deflussi minimi LPAc * 305 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) ) - 
	IF THEN ELSE( Time < 2026 , 0 , Cambiamento climatico Hydro * 225 * ( Time - 2026 ) \
		/ ( 2050 - 2026 ) ) + 
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.2" * 214 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) ) +
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.3" * 293 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) )
	~	
	~		|

