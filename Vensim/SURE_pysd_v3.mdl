HS Old[HS]= INTEG (
	MiddleAge to Old[HS] - Old to VeryOld[HS],
		Buildings by HS 2011[HS] / 5)
	~	
	~		|

HS VeryNew[HS]= INTEG (
	Adoption HS[HS]-VeryNew to New[HS],
		Buildings by HS 2011[HS] / 5)
	~	
	~		|

Solutions by HS[HS]=
	HS VeryOld[HS] + HS Old[HS] + HS MiddleAge[HS] + HS New[HS] + HS VeryNew[HS]
	~	
	~		|

HS MiddleAge[HS]= INTEG (
	New to MiddleAge[HS] - MiddleAge to Old[HS],
		Buildings by HS 2011[HS] / 5)
	~	
	~		|

