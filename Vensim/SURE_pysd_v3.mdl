Total annual demand Districts[District]=
	( Industry electricity consumption by District[District] + Tertiary electricity consumption by District\
		[District] + Other electricity consumption by District[District] ) * 1e+06 + Residential electricity cons by District\
		[District]
	~	kWh
	~		|

Annual HP kW installation[District]=
	SUM(Annual HP kW installation by archetype[District,Performance!,Type!,PVpanel!])
	~	kW
	~		|

Annual PV kW installation[District,HS,Performance,Type]=
	Annual PV kW installation by archetype[District,HS,Performance,Type]
	~	kW
	~		|

Utility HS exp[District,NewS,Performance,Type,PVpanel]=
	exp(Utility HS[District,NewS,Performance,Type,PVpanel]) ~~|
Utility HS exp[District,Oil,Performance,Type,PVpanel]=
	exp(Utility HS[District,Oil,Performance,Type,PVpanel]) ~~|
Utility HS exp[District,Gas,Performance,Type,PVpanel]=
	exp(Utility HS[District,Gas,Performance,Type,PVpanel]) ~~|
Utility HS exp[District,ElectricHeater,Performance,Type,PVpanel]=
	IF THEN ELSE( Time < 2018 , exp(Utility HS[District,ElectricHeater,Performance,Type,\
		PVpanel]) , 0 )
	~	
	~		|

Probability adoption PV Owners[District,HS,Performance,Type]=
	Utility PV Owners exp[District,HS,Performance,Type] / (1 + Utility PV Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~		|

Market Share HS filtered[District,HS,Performance,Type,PVpanel]=
	Market Share HS[District,HS,Performance,Type,PVpanel] * DH and Gas suitability[District\
		,Type] + 
	Market Share HS noGas[District,HS,Performance,Type,PVpanel] * DH only suitability[District\
		,Type] + 
	Market Share HS noDH[District,HS,Performance,Type,PVpanel] * Gas only suitability[District\
		,Type] + 
	Market Share HS noDH noGas[District,HS,Performance,Type,PVpanel] * No suitability[District\
		,Type]
	~	
	~		|

Utility PV Owners exp[District,HS,Performance,Type]=
	exp( Utility PV Owners[District,HS,Performance,Type] )
	~	Dmnl
	~		|

Stock total cost increase= INTEG (
	IF THEN ELSE( Time < 2026 , 0 , Total cost change ),
		1)
	~	
	~		|

Total cost change=
	0.005 * Stock total cost increase
	~	
	~		|

PV Eco weight=
	0.134555
	~	Dmnl
	~		|

STyes:
	OilST, GasST, WoodST, HPST
