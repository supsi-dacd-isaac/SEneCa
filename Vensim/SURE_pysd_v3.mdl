"IRR 30 - 100 kW"[District]=
	( ( 1 + ( "PV total earnings 30 - 100 kW"[District] - "Investment PV 30 - 100 kW" ) \
		/ "Investment PV 30 - 100 kW" ) ^ ( 1 / PV lifetime ) - 1 ) * 100
	~	Dmnl
	~		|

"a param 30 - 100 kW"=
	IF THEN ELSE( Time < 2022 , 1221 , 
	IF THEN ELSE( Time < 2023 , 1307 , 1640 ))
	~	CHF/kW
	~		|

"PV 30 - 100 kW investment cost"=
	"b param 30 - 100 kW" + "a param 30 - 100 kW" * "Average power PV 30 - 100 kW"
	~	CHF
	~		|

"a param > 100 kW"=
	IF THEN ELSE( Time < 2022 , 1024 , 
	IF THEN ELSE( Time < 2023 , 1102 , 1166 ))
	~	CHF/kW
	~		|

"b param > 100 kW"=
	IF THEN ELSE( Time < 2022 , 36606 , 
	IF THEN ELSE( Time < 2023 , 42753 , 61092 ))
	~	
	~		|

"b param 30 - 100 kW"=
	IF THEN ELSE( Time < 2022 , 16979 , 
	IF THEN ELSE( Time < 2023 , 22241 , 13630 ))
	~	
	~		|

"PV > 100 kW investment cost"=
	"b param > 100 kW" + "a param > 100 kW" * "Average power PV > 100 kW"
	~	CHF
	~		|

"IRR > 100 kW"[District]=
	( ( 1 + ( "PV total earnings > 100 kW"[District] - "Investment PV > 100 kW" ) / "Investment PV > 100 kW"\
		 ) ^ ( 1 / PV lifetime ) - 1 ) * 100
	~	Dmnl
	~		|

