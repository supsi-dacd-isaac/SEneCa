		[District,WoodBoiler] ~~|
Annual SH variable costs HS by archetype[District,HPST,Performance,Type,PVyes]=
	- Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HPST,Performance,Type]) - 
	
	Annual SH demand[District,Performance,Type] / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] ~~|
Annual SH variable costs HS by archetype[District,HeatPump,Performance,Type,PVno]=
	- Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual SH variable costs HS by archetype[District,HPST,Performance,Type,PVno]=
	- Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual SH variable costs HS by archetype[District,Oil,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual SH variable costs HS by archetype[District,Gas,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual SH variable costs HS by archetype[District,Wood,Performance,Type,PVpanel]=
