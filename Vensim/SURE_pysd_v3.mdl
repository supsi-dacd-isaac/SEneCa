SFH Moderate to Performance[Performance]=
	SUM(Moderate to Performance[District!,SFH,Performance]) + SUM(Moderate to Performance\
		[District!,DFH,Performance])
	~	
	~		|

MFH Moderate to Performance[Performance]=
	SUM(Moderate to Performance[District!,MFH,Performance])
	~	
	~		|

Low to Performance MFH MS[Performance]=
	SUM(Low to Performance[District!,MFH,Performance]) / 
	
	SUM(Low to Performance[District!,MFH,Performance!])
	~	
	~		|

Utility HS exp 2[District,OldS,PerformanceLow,Type,PVpanel]=
	IF THEN ELSE( Time < 2025 , Utility HS exp[District,OldS,PerformanceLow,Type,PVpanel\
		] , 
	IF THEN ELSE( MuKEn 2014 scenario > 0 , 
	IF THEN ELSE( Oil vs HP difference[District,PerformanceLow,Type,PVpanel] > 0 , 0 , Utility HS exp\
		[District,OldS,PerformanceLow,Type,PVpanel] ) , Utility HS exp[District,OldS,PerformanceLow\
		,Type,PVpanel] ) ) ~~|
Utility HS exp 2[District,NewS,Performance,Type,PVpanel]=
	Utility HS exp[District,NewS,Performance,Type,PVpanel] ~~|
Utility HS exp 2[District,OldS,PerformanceHigh,Type,PVpanel]=
	Utility HS exp[District,OldS,PerformanceHigh,Type,PVpanel]
	~	
	~		|

High to Performance MFH MS[Performance]=
	SUM(High to Performance[District!,MFH,Performance]) / 
	
	SUM(High to Performance[District!,MFH,Performance!])
	~	
	~		|

High to Performance SFH MS[Performance]=
	( SUM(High to Performance[District!,SFH,Performance]) + SUM(High to Performance[District\
		!,DFH,Performance]) ) / 
	
	( SUM(High to Performance[District!,SFH,Performance!]) + SUM(High to Performance[District\
		!,DFH,Performance!]) )
	~	
	~		|

"Utility PV 30 - 100 kW"[District]=
	"Delta 30 - 100 kW" + Share of consumers considering PV stock factor[District] + "IRR 30 - 100 kW"\
		[District] * PV nonRes Eco weight
	~	
	~		|

"Utility PV > 100 kW"[District]=
	"Delta > 100 kW" + Share of consumers considering PV stock factor[District] + "IRR > 100 kW"\
		[District] * PV nonRes Eco weight
	~	
	~		|

Moderate to Performance MFH MS[Performance]=
	SUM(Moderate to Performance[District!,MFH,Performance]) / 
	
	SUM(Moderate to Performance[District!,MFH,Performance!])
	~	
	~		|

Moderate to Performance SFH MS[Performance]=
	( SUM(Moderate to Performance[District!,SFH,Performance]) + SUM(Moderate to Performance\
		[District!,DFH,Performance]) ) / 
	
	( SUM(Moderate to Performance[District!,SFH,Performance!]) + SUM(Moderate to Performance\
		[District!,DFH,Performance!]) )
	~	
	~		|

