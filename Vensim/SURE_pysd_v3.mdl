Annual charging station power installed[District]=
	Consumers acquiring vehicle[District,BEV] * EV private charging station power + ( Consumers acquiring vehicle\
		[District,DieselPHEV] + Consumers acquiring vehicle[District,PetrolPHEV] ) * PHEV private charging station power\
		 + Public charging stations installations per District[District] * 22
	~	kW
	~		|

Public charging stations installations per District[District]=
	( SUM(Consumers acquiring vehicle[District!,BEV]) + ( SUM(Consumers acquiring vehicle\
		[District!,DieselPHEV]) + SUM(Consumers acquiring vehicle[District!,PetrolPHEV]) ) \
		* 0.08 ) / 9 * EV share distribution in Districts[District]
