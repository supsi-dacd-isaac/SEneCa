	0.31	0.344	0.435
	0.128	0.115	0.144
	0.183	0.138	0.162
	0.145	0.159	0.133
	0.496	0.62	0.76
	0.665	0.71	0.841
	0.125	0.157	0.142
	0.151	0.157	0.151
	)
