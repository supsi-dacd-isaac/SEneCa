Utility vehicle[District,Vechicle] :EXCEPT:        [District,BEV]=
	Green Utility V factor[Vechicle] + Economic Utility V factor[District,Vechicle] + Infrastructure Utility factor\
		[Vechicle] + Range Utility V factor[Vechicle] + Dummy factor V[Vechicle] + Peer effect V factor\
		[Vechicle] + Annual V available factor[Vechicle] ~~|
Utility vehicle[District,BEV]=
	Green Utility V factor[BEV] + Economic Utility V factor[District,BEV] + Infrastructure Utility factor\
		[BEV] + Range Utility V factor[BEV] + Dummy factor V[BEV] + Alpha V[District] + Peer effect V factor\
		[BEV] + Annual V available factor[BEV]
