	IF THEN ELSE( Time < 2023 , 1  , 1 + 0 * (Time - 2023) / (2050 - 2023) )
	~	Dmnl
	~		|

Total annual inflow time evolution degree=
	IF THEN ELSE( Time < 2025 , 1 , Annual total inflow for Ticino / 857.725 )
	~	
	~		|

PHS hourly supply 2023 inverse[Month,Hour]=
	IF THEN ELSE( PHS hourly supply[Month,Hour] > 0.001681 , 1 / PHS hourly supply[Month\
		,Hour] , 1 / 0.001681 )
	~	
	~		|

PHS hourly supply 2023 inverse scaled[Month,Hour]=
	PHS hourly supply 2023 inverse[Month,Hour] / VMAX( PHS hourly supply 2023 inverse[Month\
		!,Hour!] )
