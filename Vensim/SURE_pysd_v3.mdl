		,WithGas,Performance,Type,PVpanel]=
	Market Share HS no incentives[District,HS,Performance,Type,PVpanel] / ( SUM(Market Share HS no incentives\
		[District,HS!,Performance,Type,PVpanel]) - SUM(Market Share HS no incentives[District\
		,WithGas!,Performance,Type,PVpanel]) ) ~~|
