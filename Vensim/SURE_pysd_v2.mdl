{UTF-8}
"Provvedimento 1.7"=
	1
	~	
	~		|

Hydro additional hourly supply winter[Winter,Hour]=
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.7" * 89 * Hour factor HS[Winter,Hour\
		] / SUM(Hour factor HS[Winter!,Hour!]) * ( Time - 2026 ) / ( 2050 - 2026 ) ) ~~|
Hydro additional hourly supply winter[Summer,Hour]=
	0
	~	
	~		|

Hydro decrese hourly supply summer[Summer,Hour]=
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.7" * 89 * Hour factor HS[Summer,Hour\
		] / SUM(Hour factor HS[Summer!,Hour!]) * ( Time - 2026 ) / ( 2050 - 2026 ) ) ~~|
Hydro decrese hourly supply summer[Winter,Hour]=
	0
	~	
	~		|

Annual total inflow=
	( Annual HS inflow + Annual PHSn inflow ) / 1000
	~	
	~		|

Hourly total inflow for Ticino[Month,Hour]=
	Hour factor HS[Month,Hour] * Annual total inflow for Ticino + Hydro additional hourly supply winter\
		[Month,Hour] - Hydro decrese hourly supply summer[Month,Hour]
	~	GWh
	~		|

Annual total inflow historical for Ticino=
	( Annual HS inflow historical for Ticino + Annual PHSn inflow historical for Ticino \
		) / 1000 - 
	IF THEN ELSE( Time < 2026 , 0 , Deflussi minimi LPAc * 305 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) ) - 
	IF THEN ELSE( Time < 2026 , 0 , Cambiamento climatico Hydro * 225 * ( Time - 2026 ) \
		/ ( 2050 - 2026 ) ) + 
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.2" * 214 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) ) +
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.3" * 293 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) )
	~	
	~		~	:SUPPLEMENTARY 
	|

Hourly electricity demand[Month,Hour]=
	( Applienaces hourly demand[Month,Hour] + Conditioning hourly demand[Month,Hour] + DHW industry hourly demand\
		[Month,Hour] + DHW residential hourly demand[Month,Hour] + Light hourly demand NonRes\
		[Month,Hour] + Process heat hourly demand[Month,Hour] + SH industry hourly demand[Month\
		,Hour] + SH residential hourly demand[Month,Hour] + SH services hourly demand[Month\
		,Hour] + Transport hourly demand[Month,Hour] + Other annual electricity demand / 365\
		 / 24 )
	~	GWh
	~		|

Total annual electricity consumed=
	SUM(Annual Electricity consumed[Supplier!])
	~	
	~		|

PHS annual production=
	PHS annual production historical + 
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.3" * 260 * ( Time - 2026 ) / ( 2050\
		 - 2026 ) )
	~	
	~		|

Total annual electricity dispatched=
	SUM(Annual electricity dispatched[Supplier!])
	~	
	~		|

Applienaces annual demand=
	Electricity consumption Industry * 0.0219 + Electricity consumption Tertiary * 0.1422\
		 + SUM("Residential light & appl cons by District"[District!]) / 1e+06
	~	GWh
	~		|

Annual PHSn inflow historical for Ticino:INTERPOLATE::= GET DIRECT DATA('Input Hour Factors_pysd_v2.csv', '', '1', 'B2') ~	
	~		|

Cambiamento climatico Hydro=
	1
	~	
	~		|

RR annual production=
	RR annual production historical * Time factor RR + 
	IF THEN ELSE( Time < 2026 , 0 , "Provvedimento 1.4" * 80 * ( Time - 2026 ) / ( 2050 \
		- 2026 ) )
	~	GWh
	~		|

Summer:
	M5, M6, M7, M8, M9, M10
	~	
	~		|

Total annual electricity demand=
	SUM(Hourly electricity demand[Month!,Hour!]) * 365 / 12
	~	
	~		|

"Provvedimento 1.2"=
	1
	~	
	~		|

Deflussi minimi LPAc=
	1
	~	
	~		|

"Provvedimento 1.4"=
	1
	~	
	~		|

Winter:
	M1, M2, M3, M4, M11, M12
	~	
	~		|

Dummy BEV=
	0
	~	
	~		|

Dummy factor V[Diesel]=
	Dummy Diesel ~~|
Dummy factor V[BEV]=
	Dummy BEV ~~|
Dummy factor V[DieselHEV]=
	Dummy HEV ~~|
Dummy factor V[PetrolHEV]=
	Dummy HEV ~~|
Dummy factor V[DieselPHEV]=
	Dummy PHEV ~~|
Dummy factor V[PetrolPHEV]=
	Dummy PHEV ~~|
Dummy factor V[Petrol]=
	Dummy Petrol
	~	
	~		|

Additional annual inflow for Ticino=
	0
	~	GWh
	~		|

Annual HS inflow for Ticino=
	( Annual HS inflow historical for Ticino + IF THEN ELSE( Time < 2024 , 0 , Additional annual inflow for Ticino\
		 * 1000 * ( Time - 2024 ) / ( 2050 - 2024 ) ) ) * Time factor Hydro
	~	
	~		|

CO2eq per km vehicle[Petrol]=
	Fuel consumption per km[Petrol] * Emissions per MWh petrol / 1000 / 3600 ~~|
CO2eq per km vehicle[Diesel]=
	Fuel consumption per km[Diesel] * Emissions per MWh diesel / 1000 / 3600 ~~|
CO2eq per km vehicle[PetrolHEV]=
	Fuel consumption per km[PetrolHEV] * Emissions per MWh petrol / 1000 / 3600 ~~|
CO2eq per km vehicle[PetrolPHEV]=
	Fuel consumption per km[PetrolPHEV] * Emissions per MWh petrol / 1000 / 3600 ~~|
CO2eq per km vehicle[DieselHEV]=
	Fuel consumption per km[DieselHEV] * Emissions per MWh diesel / 1000 / 3600 ~~|
CO2eq per km vehicle[DieselPHEV]=
	Fuel consumption per km[DieselPHEV] * Emissions per MWh diesel / 1000 / 3600 ~~|
CO2eq per km vehicle[BEV]=
	0
	~	CO2eq/km
	~		|

Owners adopting RCP[District,HS,Performance,Type] :EXCEPT:    [District,HS,Performance\
		,MFH]=
	0 ~~|
Owners adopting RCP[District,HS,Performance,MFH]=
	IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) )
	~	
	~		|

Annual CO2 emissions vehicles flow=
	IF THEN ELSE( Time < 2026 , 0 , SUM(Annual CO2 emissions vehicles[Vechicle!]) / 1e+06\
		 )
	~	MtonCO2
	~		|

Cumulative CO2 emissions vehicles= INTEG (
	Annual CO2 emissions vehicles flow,
		0)
	~	MtonCO2
	~		|

Owners adopting PV[District,HS,Performance,Type] :EXCEPT:                [District,HS\
		,Performance,MFH]=
	IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] * Probability adoption PV Owners[District\
		,HS,Performance,Type] ) ,
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	(1 - Share urban buildings[District,Type] ) * Probability adoption PV Owners[District\
		,HS,Performance,Type] * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * Probability adoption PV Owners\
		[District,HS,Performance,Type] * ( Energy Community scenario - 1 ) ) ~~|
Owners adopting PV[District,HS,Performance,MFH]=
	IF THEN ELSE( Time < 2018 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery!]) > \
		0 ,
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,MFH] , 
	
	SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] * Probability adoption PV Owners\
		[District,HS,Performance,MFH] ) , 0 )
	~	
	~		|

ICE ban year=
	2050
	~	
	~		|

Adoption vehicles smooth[Vechicle]=
	SMOOTH( Adoption Vehicles[Vechicle] , 3 )
	~	
	~		|

