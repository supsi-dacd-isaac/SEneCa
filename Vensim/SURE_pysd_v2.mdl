Battery:
	Byes, Bno
	~	
	~		|

kWh over MWh of demand[District,HS,Performance,Type]=
	Battery capacity[District,HS,Performance,Type] / El consumption per building[District\
		,HS,Performance,Type] * 1000
	~	
	~		|

Total present variable costs SH average[District,Performance,Type]=
	SUM(Total over HS present variable costs SH[District,HS!,Performance,Type]) / SUM(Heating Solution\
		[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

