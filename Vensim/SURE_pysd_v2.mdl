Annual CO2 emissions vehicles[Vechicle]=
	CO2eq per km vehicle[Vechicle] * Annual average km per vehicle * SUM(Vehicle[District\
		!,Vechicle])
	~	
	~		|

CO2 coefficient[AlternativeV]=
	0.2,
	1.9,
	1.4,
	1.9,
	1.4 ~~|
CO2 coefficient[ICE]=
	CO2 coefficient ICE
	~	
	~		|

Total PV electricity production District[District]=
	Annual PV prod Residential[District] + "Annual PV prod 30 - 100 kW"[District] + "Annual PV prod < 30 kW"\
		[District] + "Annual PV prod > 100 kW"[District]
	~	GWh
	~		|

Hourly electricity demand with PV[Month,Hour]=
	Hourly electricity demand[Month,Hour] * Share of buildings with PV * Remaining PV SC Ratio delay\
		 * 1.25
	~	GWh
	~		|

Light hourly demand Res[Month,Hour]=
	Light annual demand Res * Hour factor light[Month,Hour]
	~	GWh
	~		|

PV SC initial=
	SUM(PV hourly SC initial[Month!,Hour!])
	~	
	~		|

Light annual demand Res=
	SUM("Residential light & appl cons by District"[District!]) / 1e+06
	~	GWh
	~		|

PV hourly SC initial[Month,Hour]=
	MIN( PV hourly production[Month,Hour] , Hourly electricity demand with PV[Month,Hour\
		] )
	~	
	~		|

PV hourly SC[Month,Hour]=
	PV hourly SC initial[Month,Hour]
	~	GWh
	~		|

Remaining PV SC Ratio delay=
	DELAY FIXED( Remaining PV SC Ratio , 1 , 1 )
	~	
	~		|

Remaining PV SC Ratio=
	MAX( PV Self Consumption / PV SC initial , 1 )
	~	
	~		|

EV charger incentive input=
	500
	~	
	~		|

PV Self Consumption=
	SUM(PV monthly Self Consumption[Month!])
	~	
	~		|

PV hourly Self Consumption[Month,Hour]=
	Hour factor PV[Month,Hour] * Total PV electricity SC
	~	GWh
	~		|

CO2 coefficient ICE=
	2.5
	~	
	~		|

ICE fuel price input=
	1.81
	~	CHF/l
	~		|

Electricity distpatched by month[Month,Hour]=
	SUM(Electricity dispatched[Month,Hour,Supplier!])
	~	
	~		|

Diesel price input=
	1.98
	~	CHF/l
	~		|

PV monthly Self Consumption[Month]=
	SUM(PV hourly Self Consumption[Month,Hour!])
	~	
	~		|

Total electricity produced monthly[Month,Supplier]=
	SUM(Total electricity produced hourly[Month,Hour!,Supplier]) * 365 / 12
	~	
	~		|

EV annual cost reduction input=
	0.01
	~	
	~		|

Total electricity produced annual[Supplier]=
	SUM(Total electricity produced monthly[Month!,Supplier])
	~	
	~		|

Peer effect V factor[AlternativeV]=
	LOG( SUM(Peer effect V[AlternativeV!]) , 10 ) * Peer effect V weight ~~|
Peer effect V factor[ICE]=
	LOG( SUM(Peer effect V[ICE!]) , 10 ) * Peer effect V weight
	~	
	~	LOG( SUM(Peer effect V[AlternativeV!]) , 10 ) * Peer effect V weight
	|

Average MS by Vehicle delay= DELAY FIXED (
	 SUM(Average MS by Vehicle[AlternativeV!]) , 1 , 1e-05)
	~	
	~		|

Hourly exported electricity[Month,Hour,Supplier] :EXCEPT:  [Month,Hour,Import]=
	Hourly available supply by Supplier[Month,Hour,Supplier] - Electricity dispatched[Month\
		,Hour,Supplier] ~~|
Hourly exported electricity[Month,Hour,Import]=
	0
	~	
	~		|

PV cantonal subsidy[District,Type]=
	IF THEN ELSE(Time < 2021, PV federal subsidy check[District,Type] / 3, 
	IF THEN ELSE(Time < 2026, PV federal subsidy check[District,Type] / 2 , PV initial cantonal subsidy\
		[District,Type] ) )
	~	CHF
	~		|

PV reg scenario=
	1
	~	
	~		|

