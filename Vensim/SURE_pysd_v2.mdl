Utility HS[District,HS,Performance,Type,PVpanel] :EXCEPT:         [District,HPs,Performance\
		,Type,PVpanel]=
	Green Utility factor[District,HS,Performance,Type] + 
	Peer effect HS factor[HS,District,Type] + 
	House Value factor[Performance,HS] + 
	Economic utility factor[District,HS,Performance,Type,PVpanel] + 
	Double Tech Factor[HS] + 
	Grid HS Factor[HS] + 
	Dummy HS[HS] ~~|
Utility HS[District,HPs,Performance,Type,PVno]=
	Green Utility factor[District,HPs,Performance,Type] + 
	Peer effect HS factor[HPs,District,Type] + 
	House Value factor[Performance,HPs] + 
	Economic utility factor[District,HPs,Performance,Type,PVno] + 
	Alpha HP[District,Performance,Type] + 
	Double Tech Factor[HPs] + 
	Grid HS Factor[HPs] + 
	Dummy HS[HPs] ~~|
Utility HS[District,HPs,Performance,Type,PVyes]=
	Green Utility factor[District,HPs,Performance,Type] + 
	Peer effect HS factor[HPs,District,Type] + 
	House Value factor[Performance,HPs] + 
	Economic utility factor[District,HPs,Performance,Type,PVno] + 
	Alpha HP[District,Performance,Type] + 
	Double Tech Factor[HPs] + 
	Grid HS Factor[HPs] + 
	Dummy PV for HP factor +
	Dummy HS[HPs]
	~	Dmnl
	~		|

Consumers adopting PV no[District,HS,Performance,Type,PVyes,Battery]=
	0 ~~|
Consumers adopting PV no[District,HS,Performance,Type,PVno,Bno]=
	Owners adopting PV[District,HS,Performance,Type] + Renters adopting PV[District,HS,Performance\
		,Type] + 
	Owners adopting RCP[District,HS,Performance,Type] + Renters adopting RCP[District,HS\
		,Performance,Type] + 
	Owners adopting RCPv[District,HS,Performance,Type] + Renters adopting RCPv[District,\
		HS,Performance,Type] ~~|
Consumers adopting PV no[District,HS,Performance,Type,PVno,Byes]=
	0
	~	
	~		|

Consumers adopting PV yes[District,HS,Performance,Type,PVyes]=
	Owners adopting PV[District,HS,Performance,Type] + Renters adopting PV[District,HS,Performance\
		,Type] + 
	Owners adopting RCP[District,HS,Performance,Type] + Renters adopting RCP[District,HS\
		,Performance,Type] ~~|
Consumers adopting PV yes[District,HS,Performance,Type,PVno]=
	0
	~	
	~		|

Economic utility factor[District,HS,Performance,Type,PVpanel]=
	Economic Utility HS[District,HS,Performance,Type,PVpanel] * Economic Utility weight
	~	Dmnl
	~		|

Green Utility factor[District,HS,Performance,Type]=
	Green Utility HS[District,HS,Performance,Type] * Green Utility weight
	~	Dmnl
	~		|

Economic Utility weight=
	-0.767666
	~	Dmnl
	~		|

Green Utility weight=
	0
	~	
	~		|

