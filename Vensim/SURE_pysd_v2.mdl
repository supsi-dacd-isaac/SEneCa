Annual Cost HP grid expansion[District]=
	Grid expansion cost per kW installed[District] * Annual HP kW installation[District]
	~	CHF
	~		|

Annual HP kW installation by archetype[District,Performance,Type,PVpanel]=
	( SUM(Buildings adopting HS[District,HeatPump,Performance,Type,PVpanel,Battery!]) - \
		SUM(Buildings HS Renovation To[District,HeatPump,Performance,Type,PVpanel,Battery!]\
		) - Consumers adopting PV yes[District,HeatPump,Performance,Type,PVpanel] - SUM(Consumers leaving HS for old age\
		[District,HeatPump,Performance,Type,PVpanel,Battery!]) ) * 
	( Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type] ) + 
	
	( SUM(Buildings adopting HS[District,HPST,Performance,Type,PVpanel,Battery!]) - SUM(\
		Buildings HS Renovation To[District,HPST,Performance,Type,PVpanel,Battery!]) - Consumers adopting PV yes\
		[District,HPST,Performance,Type,PVpanel] - SUM(Consumers leaving HS for old age[District\
		,HPST,Performance,Type,PVpanel,Battery!]) ) * 
	( Technology SH installed capacity just SH[District,Performance,Type] )
	~	kW
	~		|

Annural Federal subsidy RUP by archetype[District,HS,Performance,Type]=
	SUM(Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * PV federal subsidy check[District,Type] + 
	SUM(Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * PV federal subsidy check RCPv[District,Type]
	~	CHF
	~		|

Additional annual PV kWh self consumed[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2015 , 0 , Additional annual PV kWh self consumed by archetype[\
		District,HS,Performance,Type] )
	~	kWh
	~		|

Total annual grid upgrading cost[District]= DELAY FIXED (
	( Annual Cost HP grid expansion[District] + Annual Cost PV grid expansion[District] \
		+ Annual Cost EV grid expansion[District] ) , 0.01 , Total annual grid upgrading cost i\
		[District])
	~	CHF
	~		|

Total Cost PV grid expansion[District]= INTEG (
	Annual Cost PV grid expansion[District],
		0)
	~	CHF
	~		~	:SUPPLEMENTARY 
	|

