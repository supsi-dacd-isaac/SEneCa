	IF THEN ELSE( Time < 2014 , 2500 , 
	IF THEN ELSE( Time < 2015 , 2250 , 
	IF THEN ELSE( Time < 2016 , 2000 , 
	IF THEN ELSE( Time < 2017 , 1750 , 
	IF THEN ELSE( Time < 2018 , 1500 , 
