Annual CO2 tax archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:  [District,NonRenSolution\
		,Performance,Type,PVpanel]=
	0 ~~|
Annual CO2 tax archetype[District,Oil,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] * SUM(Heating Solution[District,Oil,Performance,Type\
		,PVpanel,Battery!]) +
	
	Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,Oil,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[OilBoiler] * CO2 tax * 0.00026532 ~~|
Annual CO2 tax archetype[District,OilST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,Oil,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[OilBoiler] * CO2 tax * 0.00026532 ~~|
Annual CO2 tax archetype[District,Gas,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] * SUM(Heating Solution[District,Gas,Performance,Type\
		,PVpanel,Battery!]) +
	
	Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,Gas,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[GasBoiler] * CO2 tax * 0.0002016 ~~|
Annual CO2 tax archetype[District,GasST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,GasST,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[GasBoiler] * CO2 tax * 0.0002016 ~~|
