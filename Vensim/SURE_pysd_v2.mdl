	IF THEN ELSE( PV hourly difference[Month,Hour] * Share HS[Month,Hour] > Hourly total inflow for Ticino\
		[Month,Hour] , Hourly total inflow for Ticino[Month,Hour] , 
	IF THEN ELSE( ( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Wind hourly supply\
		[Month,Hour] + Waste hourly supply[Month,Hour] + Hourly total inflow for Ticino[Month\
		,Hour] + Hourly PHS production[Month,Hour] ) > Hourly electricity grid demand[Month\
