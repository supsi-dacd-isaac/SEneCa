	( - Roof cost Moderate[District,Type] - Total present variable costs SH average[District\
		,Moderate,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,High]=
	( - Roof cost High[District,Type] - Total present variable costs SH average[District\
		,High,Type] + Total present variable costs SH average[District,VeryLow,Type] ) ~~|
Roof VeryLow[District,Type,VeryHigh]=
	( - Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,VeryLow,Type] )
	~	
	~		|

Roof VeryLow exp[District,Type,Performance]=
	exp(Roof VeryLow scaled[District,Type,Performance])
	~	
	~		|

Roof VeryLow probabilities[District,Type,Performance]=
	Roof VeryLow exp[District,Type,Performance] / SUM(Roof VeryLow exp[District,Type,Performance\
		!])
	~	
	~		|

Coeff High[SFH,Performance]=
	0 ~~|
Coeff High[DFH,Performance]=
	Coeff High[SFH,Performance] ~~|
Coeff High[MFH,Performance]=
	0
	~	
	~		|

Ground Low[District,Type,VeryLow]=
	- Ground cost Low[District,Type] ~~|
Ground Low[District,Type,Low]=
	- Ground cost Low[District,Type] ~~|
Ground Low[District,Type,Moderate]=
	- Ground cost Moderate[District,Type] - Total present variable costs SH average Ground\
		[District,Moderate,Type] + Total present variable costs SH average Ground[District,\
		Low,Type] ~~|
Ground Low[District,Type,High]=
	- Ground cost High[District,Type] - Total present variable costs SH average Ground[District\
		,High,Type] + Total present variable costs SH average Ground[District,Low,Type] ~~|
