	Moderate changing Wall[District,Type] * Wall Moderate probabilities[District,Type,Performance\
		] +
	Moderate changing Ground[District,Type] * Ground Moderate probabilities[District,Type\
		,Performance]
	~	
	~		|

Wall VeryLow[District,Type,VeryLow]=
