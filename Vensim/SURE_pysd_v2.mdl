	~		|

Buildings construction with battery[District,OldS,Performance,Type,PVyes,Byes]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,OldS,Performance,Type,PVyes] * Probability adoption battery[District,OldS\
		,Performance,Type] , 0 ) ~~|
Buildings construction with battery[District,OldS,Performance,Type,PVyes,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,OldS,Performance,Type,PVyes] * ( 1 - Probability adoption battery[District\
		,OldS,Performance,Type] ) , 0 ) ~~|
Buildings construction with battery[District,OldS,Performance,Type,PVno,Byes]=
	0 ~~|
Buildings construction with battery[District,OldS,Performance,Type,PVno,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVno] * Market Share HS no incentives filtered\
		[District,OldS,Performance,Type,PVno] , 0 ) ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVyes,Byes]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] * Probability adoption battery[District,NewS\
		,Performance,Type] ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] / SUM(Market Share HS no incentives filtered\
		[District,NewS!,Performance,Type,PVyes]) * Probability adoption battery[District,NewS\
		,Performance,Type] ) ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVyes,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] * ( 1 - Probability adoption battery[District\
		,NewS,Performance,Type] ) ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] / SUM(Market Share HS no incentives filtered\
		[District,NewS!,Performance,Type,PVyes]) * ( 1 - Probability adoption battery[District\
		,NewS,Performance,Type] ) ) ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVno,Byes]=
	0 ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVno,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVno] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVno] ,
	
	Building construction by archetype[District,Performance,Type,PVno] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVno] / SUM(Market Share HS no incentives filtered[\
		District,NewS!,Performance,Type,PVno]) )
	~	building
	~		|

Adoption PV HeatPump=
	SUM(Owners adopting PV[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting PV\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCP[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Building construction by archetype[District!,Performance!,Type!,PVyes]) * SUM(Heating Solution\
		[District!,HeatPump,Performance!,Type!,PVyes,Battery!]) / SUM(Heating Solution[District\
		!,HS!,Performance!,Type!,PVyes,Battery!]) + 0.0001
	~	
	~		|

"SC 0.5 kWh/MWh"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

Adoption PV no HeatPump=
	( SUM(Owners adopting PV[District!,HS!,Performance!,Type!]) + SUM(Renters adopting PV\
		[District!,HS!,Performance!,Type!]) + 
	SUM(Owners adopting RCP[District!,HS!,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District!,HS!,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District!,HS!,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District!,HS!,Performance!,Type!]) ) - 
	
	( SUM(Owners adopting PV[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting PV\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCP[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District!,HeatPump,Performance!,Type!]) ) +
	
	SUM(Building construction by archetype[District!,Performance!,Type!,PVyes]) * ( SUM(\
		Heating Solution[District!,HS!,Performance!,Type!,PVyes,Battery!]) - SUM(Heating Solution\
		[District!,HeatPump,Performance!,Type!,PVyes,Battery!]) ) / SUM(Heating Solution[District\
		!,HS!,Performance!,Type!,PVyes,Battery!]) + 0.0001
	~	
	~		|

Share of buildings with HP by District[District]=
	SUM(Heating Solution[District,HeatPump,Performance!,Type!,PVpanel!,Battery!]) / SUM(\
		Heating Solution[District,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Share of buildings with PV by District[District]=
	SUM(Heating Solution[District,HS!,Performance!,Type!,PVyes,Battery!]) / SUM(Heating Solution\
		[District,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Battery lifetime=
	15
	~	
	~		|

Battery total savings[District,HS,Performance,Type]=
	Saved energy annually[District,HS,Performance,Type] * (Electricity price[District] -\
		 PV cumulative compensation price) *  ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ Battery lifetime\
		 ) ) ) / Interest rate
	~	
	~		|

Initial Heating Solution battery[District,HS,Performance,Type,PVpanel,Bno]=
	Initial Heating Solution[District,HS,Performance,Type,PVpanel] ~~|
Initial Heating Solution battery[District,HS,Performance,Type,PVpanel,Byes]=
	0
	~	
