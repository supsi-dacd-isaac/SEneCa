HT cumulative cost change[PelletBoiler]=
	1 ~~|
HT cumulative cost change[HP]=
	IF THEN ELSE( Time < 2020 , 1.08 - 0.08 * (Time - 2011) / (2020 - 2011) , 
	IF THEN ELSE( Time < 2030 , 1 - 0.08 * (Time - 2020) / (2030 - 2020) , 0.92 - 0.08 *\
		 (Time - 2030) / (2050 - 2030) ) ) ~~|
HT cumulative cost change[EH]=
	1 ~~|
HT cumulative cost change[ST]=
	1
