PV rebate federal=
	0.2
	~	
	~		|

Efficiency increment factor=
	IF THEN ELSE( Time < 2025 , 1 , 1 - 0.3 * (Time - 2025) / (2050 - 2025) )
	~	
	~		|

Total buildings with PV by Type[Type]=
	Buildings with PV by Type[Type] + Buildings with RCP by Type[Type] + Buildings with RCPv by Type\
		[Type]
	~	
	~		~	:SUPPLEMENTARY 
	|

Owned buildings with RCP[District,Type]= INTEG (
	Owners adopting RCP flow[District,Type],
		0)
	~	
	~		|

Share of owned houses[Type]=
	0.634,
	0.634,
	0.228
	~	
	~		|

Owned buildings with RCPv PVno[District,Type]= INTEG (
	Owners adopting RCPv PVno flow[District,Type],
		0)
	~	
	~		|

Owners adopting PV flow[District,Type]=
	MAX( IF THEN ELSE( Owned buildings with PV[District,Type] > 0 , 
	
	SUM(Owners adopting PV[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * Share of owned houses\
		[Type] * Owned buildings with PV[District,Type] / ( Owned buildings with PV[District\
		,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Owners adopting PV[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Owners adopting RCP flow[District,Type]=
	MAX( IF THEN ELSE( Owned buildings with PV[District,Type] > 0 , 
	
	SUM(Owners adopting RCP[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * Share of owned houses\
		[Type] * Owned buildings with RCP[District,Type] / ( Owned buildings with PV[District\
		,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Owners adopting RCP[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Rented buildings with PV[District,Type]= INTEG (
	Renters adopting PV flow[District,Type],
		SUM(Initial Heating Solution[District,HS!,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ))
	~	
	~		|

Rented buildings with RCP[District,Type]= INTEG (
	Renters adopting RCP flow[District,Type],
		0)
	~	
	~		|

Share urban buildings[District,Type]=TABBED ARRAY(
	0.694	0.693	0.714
	0.25	0.25	0.25
	0.25	0.25	0.25
	0.489	0.504	0.632
	0.628	0.634	0.677
	0.666	0.695	0.716
	0.5	0.5	0.5
	0.25	0.25	0.25
	)
	~	
	~		|

Renters adopting PV flow[District,Type]=
	MAX( IF THEN ELSE( Rented buildings with PV[District,Type] > 0 , 
	
	SUM(Renters adopting PV[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ) * Rented buildings with PV[District,Type] / ( Rented buildings with PV[District\
		,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Renters adopting PV[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Renters adopting RCP flow[District,Type]=
	MAX( IF THEN ELSE( Rented buildings with PV[District,Type] > 0 , 
	
	SUM(Renters adopting RCP[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ) * Rented buildings with RCP[District,Type] / ( Rented buildings with PV[District\
		,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Renters adopting RCP[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Renters adopting RCPv flow[District,Type]=
	MAX( IF THEN ELSE( Rented buildings with PV[District,Type] > 0 , 
	
	SUM(Renters adopting RCPv[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ) * Rented buildings with RCPv[District,Type] / ( Rented buildings with PV[District\
		,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Renters adopting RCPv[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Buildings with RCP by Type[Type]=
	SUM(Owned buildings with RCP[District!,Type]) + SUM(Rented buildings with RCP[District\
		!,Type])
	~	
	~		|

Buildings with RCPv by Type[Type]=
	SUM(Owned buildings with RCPv[District!,Type]) + SUM(Rented buildings with RCPv[District\
		!,Type])
	~	
	~		|

Owned buildings with PV[District,Type]= INTEG (
	Owners adopting PV flow[District,Type],
		SUM(Initial Heating Solution[District,HS!,Performance!,Type,PVyes]) * Share of owned houses\
		[Type])
	~	
	~		|

Owners adopting RCPv PVno flow[District,Type]=
	Owners adopting RCPv flow[District,Type] * Buildings PVno connected to RCPv
	~	
	~		|

Owned buildings with RCPv[District,Type]= INTEG (
	Owners adopting RCPv flow[District,Type],
		0)
	~	
	~		|

Rented buildings with RCPv PVno[District,Type]= INTEG (
	Renters adopting RCPv PVno flow[District,Type],
		0)
	~	
	~		|

Adoption PV Performance[Performance]=
	SUM(Owners adopting PV[District!,HS!,Performance,Type!]) + SUM(Owners adopting RCP[District\
		!,HS!,Performance,Type!]) + 
	SUM(Renters adopting PV[District!,HS!,Performance,Type!]) + SUM(Renters adopting RCP\
		[District!,HS!,Performance,Type!]) + 
	SUM(Owners adopting RCPv[District!,HS!,Performance,Type!]) + SUM(Renters adopting RCPv\
		[District!,HS!,Performance,Type!]) + 
	SUM(Building construction by archetype[District!,Performance,Type!,PVyes]) + 0.001
	~	
	~		|

Adoption PV Type[Type]=
	SUM(Owners adopting PV[District!,HS!,Performance!,Type]) + SUM(Owners adopting RCP[District\
		!,HS!,Performance!,Type]) + 
	SUM(Renters adopting PV[District!,HS!,Performance!,Type]) + SUM(Renters adopting RCP\
		[District!,HS!,Performance!,Type]) + 
	SUM(Owners adopting RCPv[District!,HS!,Performance!,Type]) + SUM(Renters adopting RCPv\
		[District!,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District!,Performance!,Type,PVyes]) + 0.001
	~	
	~		|

Adoption PV District[District]=
	SUM(Owners adopting PV[District,HS!,Performance!,Type!]) + SUM(Owners adopting RCP[District\
		,HS!,Performance!,Type!]) + 
	SUM(Renters adopting PV[District,HS!,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District,HS!,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District,HS!,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District,HS!,Performance!,Type!])+ 
	SUM(Building construction by archetype[District,Performance!,Type!,PVyes]) + 0.001
	~	
	~		|

Owners adopting RCPv flow[District,Type]=
	MAX( IF THEN ELSE( Owned buildings with PV[District,Type] > 0 , 
	
	SUM(Owners adopting RCPv[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * Share of owned houses\
		[Type] * Owned buildings with RCPv[District,Type] / ( Owned buildings with PV[District\
		,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv[District\
		,Type] ), 
	
	SUM(Owners adopting RCPv[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

