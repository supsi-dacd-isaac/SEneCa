Initial kWp installed by archetype[District,HS,Performance,Type]=
	Initial Heating Solution[District,HS,Performance,Type,PVyes] * kWp installed per building\
		[District,Type]
	~	kW
	~		|

Annual PV kW installation by archetype[District,HS,Performance,Type]=
	SUM(PV adoptions by archetype[District,HS,Performance,Type,Battery!]) * kWp installed per building\
		[District,Type] + SUM(RCPv adoptions by archetype[District,HS,Performance,Type,Battery\
		!]) * kWp installed per building RCPv[District,Type]
	~	kW
	~		|

kWp installed per building RCPv[District,Type]=
	kWp installed per building[District,Type] * ( 1 + Share additional power RCPv )
	~	kW
	~		|

kWp installed per building[District,Type]=TABBED ARRAY(
	11.11	12.35	21.03
	10.8	12.05	14.63
	11.6	11.46	13.55
	12.11	11.53	19.67
	10.59	12.02	19.63
	11.32	14.3	20.45
	12.66	15.34	16.4
	10.54	11.62	13.86)
	~	kW
	~		|

PV annual generation per kW=
	1128.26
	~	kWh/kW
	~		|

House Value coefficient HT[Performance,HS] :EXCEPT: [Performance,HPs]=
	0.1295 ~~|
House Value coefficient HT[Performance,HPs]=
	House Value coefficient[Performance]
	~	Dmnl
	~		|

Res VeryLow VeryHigh renovation[District,Type]=
	VeryLow to Performance[District,Type,VeryHigh]
	~	
	~		|

Res VeryLow High renovation[District,Type]=
	VeryLow to Performance[District,Type,High]
	~	
	~		|

Res Low High renovation[District,Type]=
	Low to Performance[District,Type,High]
	~	
	~		|

Res Low VeryHigh renovation[District,Type]=
	Low to Performance[District,Type,VeryHigh]
	~	
	~		|

Res High VeryHigh renovation[District,Type]=
	High to Performance[District,Type,VeryHigh]
	~	
	~		|

Res Moderate High renovation[District,Type]=
	Moderate to Performance[District,Type,High]
	~	
	~		|

Res VeryLow Moderate renovation[District,Type]=
	VeryLow to Performance[District,Type,Moderate]
	~	
	~		|

Res VeryHigh Buildings[District,Type]= INTEG (
	Res High VeryHigh renovation[District,Type]+Res Low VeryHigh renovation[District,Type\
		]+Res Moderate VeryHigh renovation[District,Type]+Res VeryHigh construction[District\
		,Type]+Res VeryLow VeryHigh renovation[District,Type],
		Res VeryHigh Buildings i[District,Type])
	~	
	~		|

Buildings HS Renovation From[District,HS,VeryLow,Type,PVpanel,Battery]=
	( Res VeryLow Low renovation[District,Type] + Res VeryLow Moderate renovation[District\
		,Type] + Res VeryLow High renovation[District,Type] + Res VeryLow VeryHigh renovation\
		[District,Type]) * Share HS by archetype[District,HS,VeryLow,Type,PVpanel,Battery] ~~|
Buildings HS Renovation From[District,HS,Low,Type,PVpanel,Battery]=
	( Res Low High renovation[District,Type] + Res Low to Moderate renovation[District,Type\
		] + Res Low VeryHigh renovation[District,Type] ) * Share HS by archetype[District,HS\
		,Low,Type,PVpanel,Battery] ~~|
Buildings HS Renovation From[District,HS,Moderate,Type,PVpanel,Battery]=
	( Res Moderate High renovation[District,Type] + Res Moderate VeryHigh renovation[District\
		,Type] ) * Share HS by archetype[District,HS,Moderate,Type,PVpanel,Battery] ~~|
Buildings HS Renovation From[District,HS,High,Type,PVpanel,Battery]=
	Res High VeryHigh renovation[District,Type] * Share HS by archetype[District,HS,High\
		,Type,PVpanel,Battery] ~~|
Buildings HS Renovation From[District,HS,VeryHigh,Type,PVpanel,Battery]=
	0
	~	
	~		|

Res Moderate Buildings[District,Type]= INTEG (
	Res Low to Moderate renovation[District,Type]+Res Moderate construction[District,Type\
		]+Res VeryLow Moderate renovation[District,Type]-Res Moderate High renovation[District\
		,Type]-Res Moderate VeryHigh renovation[District,Type],
		Res Moderate Buildings i[District,Type])
	~	
	~		|

Buildings HS Renovation To[District,HS,VeryLow,Type,PVpanel,Battery]=
	0 ~~|
Buildings HS Renovation To[District,HS,Low,Type,PVpanel,Battery]=
	Res VeryLow Low renovation[District,Type] * Share HS by archetype[District,HS,VeryLow\
		,Type,PVpanel,Battery] ~~|
Buildings HS Renovation To[District,HS,Moderate,Type,PVpanel,Battery]=
	Res VeryLow Moderate renovation[District,Type] * Share HS by archetype[District,HS,VeryLow\
		,Type,PVpanel,Battery] + 
	
	Res Low to Moderate renovation[District,Type] * Share HS by archetype[District,HS,Low\
		,Type,PVpanel,Battery] ~~|
Buildings HS Renovation To[District,HS,High,Type,PVpanel,Battery]=
	Res Low High renovation[District,Type] * Share HS by archetype[District,HS,Low,Type,\
		PVpanel,Battery] +
	 
	Res Moderate High renovation[District,Type] * Share HS by archetype[District,HS,Moderate\
		,Type,PVpanel,Battery] +
	
	Res VeryLow High renovation[District,Type] * Share HS by archetype[District,HS,VeryLow\
		,Type,PVpanel,Battery] ~~|
Buildings HS Renovation To[District,HS,VeryHigh,Type,PVpanel,Battery]=
	Res High VeryHigh renovation[District,Type] * Share HS by archetype[District,HS,High\
		,Type,PVpanel,Battery] + 
	
	Res VeryLow VeryHigh renovation[District,Type] * Share HS by archetype[District,HS,VeryLow\
		,Type,PVpanel,Battery] + 
	
	Res Low VeryHigh renovation[District,Type] * Share HS by archetype[District,HS,Low,Type\
		,PVpanel,Battery] + 
	
	Res Moderate VeryHigh renovation[District,Type] * Share HS by archetype[District,HS,\
		Moderate,Type,PVpanel,Battery]
	~	
	~		|

Res VeryHigh construction[District,Type]=
	IF THEN ELSE( Time < 2026 , Buildings Construction[Type,District,VeryHigh] , Res total construction by Perf Type District\
		[VeryHigh,Type,District] )
	~	
	~		|

Res Moderate construction[District,Type]=
	IF THEN ELSE( Time < 2026 , Buildings Construction[Type,District,Moderate] , Res total construction by Perf Type District\
		[Moderate,Type,District] )
	~	
	~		|

Res High construction[District,Type]=
	IF THEN ELSE( Time < 2026 , Buildings Construction[Type,District,High] , Res total construction by Perf Type District\
		[High,Type,District] )
	~	
	~		|

Res buildings by District check[District]=
	SUM(Total Res buildings[District,Performance!,Type!]) /  SUM(Heating Solution[District\
		,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Res buildings by Performance check[Performance]=
	SUM(Total Res buildings[District!,Performance,Type!]) / SUM(Heating Solution[District\
		!,HS!,Performance,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Res buildings by Type check[Type]=
	SUM(Total Res buildings[District!,Performance!,Type]) / SUM(Heating Solution[District\
		!,HS!,Performance!,Type,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Res buildings share[District,Performance,Type]=
	Total Res buildings[District,Performance,Type] / SUM(Total Res buildings[District!,Performance\
		,Type!])
	~	
	~		|

Res High Buildings[District,Type]= INTEG (
	Res High construction[District,Type]+Res Low High renovation[District,Type]+Res Moderate High renovation\
		[District,Type]+Res VeryLow High renovation[District,Type]-Res High VeryHigh renovation\
		[District,Type],
		Res High Buildings i[District,Type])
	~	
	~		|

Low changing Ground[District,Type]=
	Res Low Buildings[District,Type] / Ground Lifetime
	~	
	~		|

Buildings by District and Type[District,Type]=
	SUM(Total Res buildings[District,Performance!,Type])
	~	
	~		|

HeatPumps[District,Type,Performance]=
	SUM(Heating Solution[District,HeatPump,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Low changing Wall[District,Type]=
	Res Low Buildings[District,Type] / Wall Lifetime
	~	
	~		|

Low changing Roof[District,Type]=
	Res Low Buildings[District,Type] / Roof Lifetime
	~	
	~		|

Res Low Buildings[District,Type]= INTEG (
	Res VeryLow Low renovation[District,Type]-Res Low High renovation[District,Type]-Res Low to Moderate renovation\
		[District,Type]-Res Low VeryHigh renovation[District,Type],
		Res Low Buildings i[District,Type])
	~	
	~		|

Overall demolited buildings[Type]=
	Overall demolition rate[Type] * SUM(Total Res buildings[District!,Performance!,Type]\
		)
	~	
	~		|

Peer effect HS[District,HS]=
	SUM(Heating Solution[District,HS,Performance!,Type!,PVpanel!,Battery!]) / SUM(Heating Solution\
		[District,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		|

VeryLow changing Ground[District,Type]=
	Res VeryLow Buildings[District,Type] / Ground Lifetime
	~	
	~		|

Total Res buildings[District,VeryLow,Type]=
	Res VeryLow Buildings[District,Type] ~~|
Total Res buildings[District,Low,Type]=
	Res Low Buildings[District,Type] ~~|
Total Res buildings[District,Moderate,Type]=
	Res Moderate Buildings[District,Type] ~~|
Total Res buildings[District,High,Type]=
	Res High Buildings[District,Type] ~~|
Total Res buildings[District,VeryHigh,Type]=
	Res VeryHigh Buildings[District,Type]
	~	
	~		|

Total Buildings=
	SUM(Total Res buildings[District!,Performance!,Type!])
	~	
	~		|

VeryLow changing Wall[District,Type]=
	Res VeryLow Buildings[District,Type] / Wall Lifetime
	~	
	~		|

VeryLow changing Roof[District,Type]=
	Res VeryLow Buildings[District,Type] / Roof Lifetime
	~	
	~		|

Alpha[District,Type,Performance]=
	Alpha old + Alpha District[District] + Alpha Performance[Performance] + Alpha Type[Type\
		]
	~	Dmnl
	~		|

Alpha HP[District,Performance,Type]=
	Dummy HP District[District] + Dummy HP Performance[Performance] + Dummy HP Type[Type\
		]
	~	Dmnl
	~		|

Average Utility by HS[HS]=
	SUM(Utility HS[District!,HS,Performance!,Type!,PVpanel!]) / (8 * 5 * 3 * 2)
	~	
	~		~	:SUPPLEMENTARY 
	|

Res Moderate Buildings i[District,Type]=
	SUM(Res buildings i[Moderate,District,Type,PVpanel!])
	~	
	~		|

Res VeryHigh Buildings i[District,Type]=
