		IF THEN ELSE( Time < 2015, -0.726, 
		IF THEN ELSE( Time < 2016, -0.2089, 
		IF THEN ELSE( Time < 2017, -0.282, 
		IF THEN ELSE( Time < 2018, -0.2637, 
		IF THEN ELSE( Time < 2019, -0.2683, 
		IF THEN ELSE( Time < 2020, -0.1564, 
		IF THEN ELSE( Time < 2021, -0.0753, 
		IF THEN ELSE( Time < 2025, -0.0468, 
		IF THEN ELSE( Time < 2030, 0 , 
		IF THEN ELSE( Time < 2035, 0 , 
		IF THEN ELSE( Time < 2040, 0 , 
		IF THEN ELSE( Time < 2045, 0 , 0 )))))))))))))))
	|

Owners adopting RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2025 , 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption RCPv Owners[District,HS,Performance,Type] * Share urban buildings\
		[District,Type] ) * Energy Community scenario
	~	
	~		|

Renters adopting RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2025 , 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption RCPv Renters[District,HS,Performance,Type] * Share urban buildings\
		[District,Type] ) * Energy Community scenario
	~	
	~		|

Buildings leaving HS[District,HS,Performance,Type,PVpanel,Battery]=
	Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery] + 
	
	Building demolition by archetype[District,HS,Performance,Type,PVpanel,Battery] +
	
	Buildings HS Renovation From[District,HS,Performance,Type,PVpanel,Battery] +
	
	Consumers adopting PV no[District,HS,Performance,Type,PVpanel,Battery]
	~	
	~		|

Adoption Heating Solution Distirct[District]=
	SUM(Buildings adopting HS[District,HS!,Performance!,Type!,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District,HS!,Performance!,Type!,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District,HS!,Performance!,Type!,PVpanel!])
	~	
	~		|

Adoption Heating Solution Performance[Performance]=
	SUM(Buildings adopting HS[District!,HS!,Performance,Type!,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS!,Performance,Type!,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS!,Performance,Type!,PVpanel!])
	~	
	~		|

Adoption Heating Solution PVpanel[PVpanel]=
	SUM(Buildings adopting HS[District!,HS!,Performance!,Type!,PVpanel,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS!,Performance!,Type!,PVpanel,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS!,Performance!,Type!,PVpanel])
	~	
	~		|

Adoption Heating Solution Type[Type]=
	SUM(Buildings adopting HS[District!,HS!,Performance!,Type,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS!,Performance!,Type,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS!,Performance!,Type,PVpanel!])
	~	
	~		|

Adoption HP District[District]=
	SUM(Buildings adopting HS[District,HeatPump,Performance!,Type!,PVpanel!,Battery!]) -\
		 SUM(Buildings HS Renovation To[District,HeatPump,Performance!,Type!,PVpanel!,Battery\
		!]) - SUM(Consumers adopting PV yes[District,HeatPump,Performance!,Type!,PVpanel!])
	~	
	~		|

Adoption HP Performance[Performance]=
	SUM(Buildings adopting HS[District!,HeatPump,Performance,Type!,PVpanel!,Battery!]) -\
		 SUM(Buildings HS Renovation To[District!,HeatPump,Performance,Type!,PVpanel!,Battery\
		!]) - SUM(Consumers adopting PV yes[District!,HeatPump,Performance,Type!,PVpanel!])
	~	
	~		|

Adoption HP PVpanel[PVpanel]=
	SUM(Buildings adopting HS[District!,HeatPump,Performance!,Type!,PVpanel,Battery!]) -\
		 SUM(Buildings HS Renovation To[District!,HeatPump,Performance!,Type!,PVpanel,Battery\
		!]) - SUM(Consumers adopting PV yes[District!,HeatPump,Performance!,Type!,PVpanel])
	~	
	~		|

Adoption HP Type[Type]=
	SUM(Buildings adopting HS[District!,HeatPump,Performance!,Type,PVpanel!,Battery!]) -\
		 SUM(Buildings HS Renovation To[District!,HeatPump,Performance!,Type,PVpanel!,Battery\
		!]) - SUM(Consumers adopting PV yes[District!,HeatPump,Performance!,Type,PVpanel!])
	~	
	~		|

Heating Solution[District,HS,Performance,Type,PVpanel,Battery]= INTEG (
	Buildings adopting HS[District,HS,Performance,Type,PVpanel,Battery]-Buildings leaving HS\
		[District,HS,Performance,Type,PVpanel,Battery],
		Initial Heating Solution battery[District,HS,Performance,Type,PVpanel,Battery])
	~	
	~		|

Tax deduction investment=
	IF THEN ELSE( Time < 2023 , 0.2 , 0.2)
	~	Dmnl
	~		|

PV cumulative compensation price=
	IF THEN ELSE(Time < 2015 , 0.0955 , 
	IF THEN ELSE(Time < 2016 , 0.0835 , 
	IF THEN ELSE(Time < 2017 , 0.0754 , 
	IF THEN ELSE(Time < 2018 , 0.0673 , 
	IF THEN ELSE(Time < 2019 , 0.0704 ,
	IF THEN ELSE(Time < 2020 , 0.0721 , 
	IF THEN ELSE(Time < 2021 , 0.0656 ,
	IF THEN ELSE(Time < 2022 , 0.0754 , 
	IF THEN ELSE(Time < 2023 , 0.1288 ,
	IF THEN ELSE(Time < 2024 , 0.1401 , 
	IF THEN ELSE(Time < 2025 , 0.12 , 0.075 + FiT ) ) ) ) ) ) ) ) ) ) )
	~	Dmnl
	~	0.0955
		0.0835
		0.0754
		0.0673
		0.0704
		0.0721
		0.0656
		0.0754
		0.1288
		0.1401
		0.1200
	|

Alpha Performance[Performance]=
	0
	~	Dmnl
	~		|

"PV FiT 10 - 30 kW"= INTEG (
	"PV differential FiT 10 - 30 kW",
		0.5502)
	~	CHF/kWh
	~		|

"PV differential FiT < 10 kW"=
	IF THEN ELSE( Time < 2011.01, -0.0508, 
	IF THEN ELSE( Time < 2012.01, -0.0467, 
	IF THEN ELSE( Time < 2013.01, -0.043, 
	IF THEN ELSE( Time < 2014.01, -0.0395, 
	IF THEN ELSE( Time < 2015.01, -0.0364, 
	IF THEN ELSE( Time < 2016.01, -0.0335, 
	IF THEN ELSE( Time < 2017.01, -0.0308, 0 )))))))
	~	CHF/kWh
	~		|

"PV FiT < 10 kW"= INTEG (
	"PV differential FiT < 10 kW",
		0.6348)
	~	CHF/kWh
	~		|

"PV differential FiT 10 - 30 kW"=
	IF THEN ELSE( Time < 2011.01, -0.044, 
	IF THEN ELSE( Time < 2012.01, -0.0405, 
	IF THEN ELSE( Time < 2013.01, -0.0373, 
	IF THEN ELSE( Time < 2014.01, -0.0343, 
	IF THEN ELSE( Time < 2015.01, -0.0315, 
	IF THEN ELSE( Time < 2016.01, -0.029, 
	IF THEN ELSE( Time < 2017.01, -0.0267, 0 )))))))
	~	CHF/kWh
	~		|

"Tax deduction O&M"=
	0.077
	~	Dmnl
	~		|

Share of buildings with suitable roof[District,Type]=TABBED ARRAY(
	0.763	0.805	0.85
	0.573	0.604	0.6
	0.647	0.624	0.66
	0.758	0.789	0.863
	0.868	0.886	0.893
	0.912	0.912	0.911
	0.629	0.625	0.722
	0.534	0.592	0.62
	)
	~	
	~		|

PV cumulative cost change= INTEG (
	PV differential cost change,
		4.7925)
	~	Dmnl
	~		|

