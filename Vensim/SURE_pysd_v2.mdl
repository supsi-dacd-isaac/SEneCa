		,HS,Performance,Type])
	~	Dmnl
	~		|

Market Share HS filtered[District,HS,Performance,Type,PVpanel]=
	Market Share HS[District,HS,Performance,Type,PVpanel] * DH and Gas suitability[District\
		,Type] + 
	Market Share HS noGas[District,HS,Performance,Type,PVpanel] * DH only suitability[District\
		,Type] + 
	Market Share HS noDH[District,HS,Performance,Type,PVpanel] * Gas only suitability[District\
		,Type] + 
	Market Share HS noDH noGas[District,HS,Performance,Type,PVpanel] * No suitability[District\
		,Type]
	~	
	~		|

