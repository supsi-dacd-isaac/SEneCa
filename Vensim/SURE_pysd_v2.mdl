"Additional annual PV kWh self consumed > 100 kW"[District]=
	IF THEN ELSE( Time < 2015 , 0 , 
	"Average SC > 100 kW" * ("Yearly installed capacity PV > 100 kW"[District] - "Additional power District with Battery > 100 kW"\
		[District]) * PV annual generation per kW + 
	"Self consumption degree with Storage > 100 kW" * "Additional power District with Battery > 100 kW"\
		[District] * PV annual generation per kW )
	~	kWh
	~		|

"SC 1.0 kWh/MWh > 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand > 100 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(4,0.2) ))
	~	Dmnl
	~		|

"kWh over MWh of demand 30 - 100 kW"=
	"Average Battery size 30 - 100 kW" / "Average El consumption 30 - 100 kW" / 1000
	~	kWh/MWh
	~		|

"Additional power District with Battery 30 - 100 kW"[District]=
	"Additional power with Battery 30 - 100 kW" * Share annual installed capacity nonRes by District\
		[District]
	~	kW
	~		|

"Additional power District with Battery < 30 kW"[District]=
	"Additional power with Battery < 30 kW" * Share annual installed capacity nonRes by District\
		[District]
	~	kW
	~		|

"Average Battery size 30 - 100 kW"=
	62.6
	~	
	~		|

"Additional power with Battery 30 - 100 kW"=
	"Average power PV 30 - 100 kW" * "Battery adoption 30 - 100 kW"
	~	
	~		|

"Additional power with Battery < 30 kW"=
	"Average power PV < 30 kW" * "Battery adoption < 30 kW"
	~	
	~		|

"Additional power with Battery > 100 kW"=
	"Average power PV > 100 kW" * "Battery adoption > 100 kW"
	~	
	~		|

Adoption Battery District[District]=
	SUM(Consumers adopting PV yes with battery[District,HS!,Performance!,Type!,PVyes,Byes\
		]) + SUM(Consumers adopting RCPv yes with battery[District,HS!,Performance!,Type!,PVyes\
		,Byes]) + SUM(Buildings construction with battery[District,HS!,Performance!,Type!,PVyes\
		,Byes]) + 1e-05
	~	
	~		|

"SC 1.0 kWh/MWh < 30 kW"= WITH LOOKUP (
	"kWp over MWh of demand < 30 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(
		4,0.2) ))
	~	Dmnl
	~		|

Adoption Battery Type[SFH]=
	SUM(Consumers adopting PV yes with battery[District!,HS!,Performance!,SFH,PVyes,Byes\
		]) + SUM(Consumers adopting PV yes with battery[District!,HS!,Performance!,DFH,PVyes\
		,Byes]) + 
	SUM(Consumers adopting RCPv yes with battery[District!,HS!,Performance!,SFH,PVyes,Byes\
		]) + SUM(Consumers adopting RCPv yes with battery[District!,HS!,Performance!,DFH,PVyes\
		,Byes]) + 
	SUM(Buildings construction with battery[District!,HS!,Performance!,SFH,PVyes,Byes]) \
		+ SUM(Buildings construction with battery[District!,HS!,Performance!,DFH,PVyes,Byes\
		]) +
	1e-05 ~~|
Adoption Battery Type[DFH]=
	0 ~~|
Adoption Battery Type[MFH]=
	SUM(Consumers adopting PV yes with battery[District!,HS!,Performance!,MFH,PVyes,Byes\
		]) + SUM(Consumers adopting RCPv yes with battery[District!,HS!,Performance!,MFH,PVyes\
		,Byes]) + SUM(Buildings construction with battery[District!,HS!,Performance!,DFH,PVyes\
		,Byes]) + 1e-05
	~	
	~		|

"Average Battery size < 30 kW"=
	13.14
	~	
	~		|

"SC 1.5 kWh/MWh 30 - 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand 30 - 100 kW",
		       ([(0,0)-(10,10)],(0,1),(0.25,0.97),(0.5,0.92),(0.75,0.81),(1,0.67),(1.25,0.57\
		),(1.5,0.48),(1.75,0.43),(2.25,0.35),(4,0.25) ))
	~	Dmnl
	~		|

"SC 1.5 kWh/MWh < 30 kW"= WITH LOOKUP (
	"kWp over MWh of demand < 30 kW",
		       ([(0,0)-(10,10)],(0,1),(0.25,0.97),(0.5,0.92),(0.75,0.81),(1,0.67),(1.25,0.57\
		),(1.5,0.48),(1.75,0.43),(2.25,0.35
		),(4,0.25) ))
	~	Dmnl
	~		|

"SC 0.5 kWh/MWh 30 - 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand 30 - 100 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

"Share of Batteries 30 - 100 kW"=
	0.153
	~	
	~		|

"Battery adoption < 30 kW"=
	Total Battery adoption nonRes * "Share of Batteries < 30 kW"
	~	
	~		|

"Self consumption degree with Storage 30 - 100 kW"=
	IF THEN ELSE( "kWh over MWh of demand 30 - 100 kW" < 0.5 , "Average SC 30 - 100 kW" \
		+ "Average SC 30 - 100 kW" / 0.5 * ("SC 0.5 kWh/MWh 30 - 100 kW" - "Average SC 30 - 100 kW"\
		) , 
	IF THEN ELSE( "kWh over MWh of demand 30 - 100 kW" < 1 , "SC 0.5 kWh/MWh 30 - 100 kW"\
		 + ( "kWh over MWh of demand 30 - 100 kW" - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh 30 - 100 kW"\
		 - "SC 0.5 kWh/MWh 30 - 100 kW") , 
	"SC 1.0 kWh/MWh 30 - 100 kW" + ( "kWh over MWh of demand 30 - 100 kW" - 1 ) / 0.5 * \
		("SC 1.5 kWh/MWh 30 - 100 kW" - "SC 1.0 kWh/MWh 30 - 100 kW") ) )
	~	
	~		|

Share annual installed capacity nonRes by District[District]=
	( "Yearly installed capacity PV 30 - 100 kW District"[District] + "Yearly installed capacity PV > 100 kW District"\
		[District] ) / ( SUM("Yearly installed capacity PV 30 - 100 kW District"[District!]\
		) + SUM("Yearly installed capacity PV > 100 kW District"[District!]) )
	~	
	~		|

"Average El consumption < 30 kW"=
	"Average power PV < 30 kW" / ( "kWp over MWh of demand < 30 kW" / 1000 )
	~	kWh
	~		|

"kWh over MWh of demand > 100 kW"=
	"Average Battery size > 100 kW" / "Average El consumption > 100 kW" / 1000
	~	kWh/MWh
	~		|

"Average Battery size > 100 kW"=
	356.45
	~	
	~		|

"kWh over MWh of demand < 30 kW"=
	"Average Battery size < 30 kW" / "Average El consumption < 30 kW" / 1000
	~	kWh/MWh
	~		|

"Self consumption degree with Storage < 30 kW"=
	IF THEN ELSE( "kWh over MWh of demand < 30 kW" < 0.5 , "Average SC < 30 kW" + "Average SC < 30 kW"\
		 / 0.5 * ("SC 0.5 kWh/MWh < 30 kW" - "Average SC < 30 kW") , 
	IF THEN ELSE( "kWh over MWh of demand < 30 kW" < 1 , "SC 0.5 kWh/MWh < 30 kW" + ( "kWh over MWh of demand < 30 kW"\
		 - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh < 30 kW" - "SC 0.5 kWh/MWh < 30 kW") , 
	"SC 1.0 kWh/MWh < 30 kW" + ( "kWh over MWh of demand < 30 kW" - 1 ) / 0.5 * ("SC 1.5 kWh/MWh < 30 kW"\
		 - "SC 1.0 kWh/MWh < 30 kW") ) )
	~	Dmnl
	~		|

Total Battery adoption Res=
	SUM(Adoption Battery Type[Type!])
	~	
	~		|

"Share of Batteries >100 kW"=
	0.084
	~	
	~		|

Share of Batteries nonRes=
	0.0243
	~	
	~		|

"Share of Batteries < 30 kW"=
	0.763
	~	
	~		|

"kWp over MWh of demand < 30 kW"=
	0.75 + ( "Average SC < 30 kW" - 0.3 ) / ( 0.37 - 0.3 ) * ( 0.75 - 1 )
	~	kW/MWh
	~		|

"Self consumption degree with Storage > 100 kW"=
	IF THEN ELSE( "kWh over MWh of demand > 100 kW" < 0.5 , "Average SC > 100 kW" + "Average SC > 100 kW"\
		 / 0.5 * ("SC 0.5 kWh/MWh > 100 kW" - "Average SC > 100 kW") , 
	IF THEN ELSE( "kWh over MWh of demand > 100 kW" < 1 , "SC 0.5 kWh/MWh > 100 kW" + ( \
		"kWh over MWh of demand > 100 kW" - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh > 100 kW" - "SC 0.5 kWh/MWh > 100 kW"\
		) , 
	"SC 1.0 kWh/MWh > 100 kW" + ( "kWh over MWh of demand > 100 kW" - 1 ) / 0.5 * ("SC 1.5 kWh/MWh > 100 kW"\
		 - "SC 1.0 kWh/MWh > 100 kW") ) )
	~	Dmnl
	~		|

"SC 0.5 kWh/MWh > 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand > 100 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

"Average power PV < 30 kW"=
	11
	~	
	~		|

"SC 0.5 kWh/MWh < 30 kW"= WITH LOOKUP (
	"kWp over MWh of demand < 30 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

"SC 1.0 kWh/MWh 30 - 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand 30 - 100 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(4,0.2) ))
	~	Dmnl
	~		|

Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Byes]=
	Consumers adopting PV yes[District,HS,Performance,Type,PVyes] * Probability adoption battery\
		[District,HS,Performance,Type] ~~|
Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Bno]=
	Consumers adopting PV yes[District,HS,Performance,Type,PVyes] * ( 1 - Probability adoption battery\
		[District,HS,Performance,Type] ) ~~|
Consumers adopting PV yes with battery[District,HS,Performance,Type,PVno,Battery]=
	0
	~	
	~		|

Consumers adopting RCPv yes[District,HS,Performance,Type,PVyes]=
	Owners adopting RCPv[District,HS,Performance,Type] + Renters adopting RCPv[District,\
		HS,Performance,Type] ~~|
Consumers adopting RCPv yes[District,HS,Performance,Type,PVno]=
	0
	~	
	~		|

Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Byes]=
	Consumers adopting RCPv yes[District,HS,Performance,Type,PVyes] * Probability adoption battery RCPv\
		[District,HS,Performance,Type] ~~|
Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Bno]=
	Consumers adopting RCPv yes[District,HS,Performance,Type,PVyes] * ( 1 - Probability adoption battery RCPv\
		[District,HS,Performance,Type] ) ~~|
Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVno,Battery]=
	0
	~	building
	~		|

Battery total savings RCPv[District,HS,Performance,Type]=
	Saved energy annually RCPv[District,HS,Performance,Type] * (Electricity price[District\
		] - PV cumulative compensation price) *  ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ Battery lifetime\
		 ) ) ) / Interest rate
	~	
	~		|

"SC 1.5 kWh/MWh RCPv"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		       ([(0,0)-(10,10)],(0,1),(0.25,0.97),(0.5,0.92),(0.75,0.81),(1,0.67),(1.25,0.57\
		),(1.5,0.48),(1.75,0.43),(2.25,0.35),(7,0.3) ))
	~	Dmnl
	~		|

Battery Eco factor RCPv[District,HS,Performance,Type]=
	Battery economic utility RCPv[District,HS,Performance,Type] * Battery Eco weight
	~	
	~		|

Battery economic utility RCPv[District,HS,Performance,Type]=
	( ( Battery total savings RCPv[District,HS,Performance,Type] - Battery initial investment RCPv\
		[District,HS,Performance,Type] ) / Battery initial investment RCPv[District,HS,Performance\
		,Type] / Battery lifetime ) * 100
	~	
	~		|

Additional annual PV kWh self consumed by archetype[District,HS,Performance,Type]=
	Additional annual PV kWh produced by archetype[District,HS,Performance,Type,Bno] * Self consumption degree\
		[District,HS,Performance,Type] +
	Additional annual PV kWh produced by archetype[District,HS,Performance,Type,Byes] * \
		Self consumption degree with Storage[District,HS,Performance,Type] +
	Additional annual RCPv kWh produced by archetype[District,HS,Performance,Type,Bno] *\
		 Self consumption degree RCPv[District,HS,Performance,Type] +
	Additional annual RCPv kWh produced by archetype[District,HS,Performance,Type,Byes] \
		* Self consumption degree with Storage RCPv[District,HS,Performance,Type]
	~	kWh
	~		|

RCPv adoptions by archetype[District,HS,Performance,Type,Battery]= DELAY FIXED (
	Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery]\
		 , 0.01, 0)
	~	building
	~		|

New buildings installing PV[District,HS,Performance,Type,Battery]=
	Buildings construction with battery[District,HS,Performance,Type,PVyes,Battery]
	~	building
	~		|

"SC 0.5 kWh/MWh RCPv"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(7,0.08) ))
	~	Dmnl
	~		|

"Average El consumption 30 - 100 kW"=
	"Average power PV 30 - 100 kW" / ( "kWp over MWh of demand 30 - 100 kW" / 1000 )
	~	kWh
	~		|

"SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(7,0.25) ))
	~	Dmnl
	~		|

Probability adoption battery RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2016, 0 , 
	Utility battery exp RCPv[District,HS,Performance,Type] / ( 1 + Utility battery exp RCPv\
		[District,HS,Performance,Type] ) )
	~	
	~		|

"kWp over MWh of demand 30 - 100 kW"=
	0.5 + ( "Average SC 30 - 100 kW" - 0.48 ) / ( 0.68 - 0.48 ) * ( 0.25 - 0.5 )
	~	kW/MWh
	~		|

"kWp over MWh of demand > 100 kW"=
	0.5 + ( "Average SC > 100 kW" - 0.48 ) / ( 0.68 - 0.48 ) * ( 0.25 - 0.5 )
	~	kW/MWh
	~		|

PV adoptions by archetype[District,HS,Performance,Type,Battery]= DELAY FIXED (
	New buildings installing PV[District,HS,Performance,Type,Battery] + Consumers adopting PV yes with battery\
		[District,HS,Performance,Type,PVyes,Battery] , 0.01, 0)
	~	building
	~		|

Self consumption degree with Storage RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( kWh over MWh of demand RCPv[District,HS,Performance,Type] < 0.5 , Self consumption degree RCPv\
		[District,HS,Performance,Type] + kWh over MWh of demand RCPv[District,HS,Performance\
		,Type] / 0.5 * ("SC 0.5 kWh/MWh RCPv"[District,HS,Performance,Type] - Self consumption degree RCPv\
		[District,HS,Performance,Type]) , 
	IF THEN ELSE( kWh over MWh of demand RCPv[District,HS,Performance,Type] < 1 , "SC 0.5 kWh/MWh RCPv"\
		[District,HS,Performance,Type] + ( kWh over MWh of demand RCPv[District,HS,Performance\
		,Type] - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type] - "SC 0.5 kWh/MWh RCPv"\
		[District,HS,Performance,Type]) , 
	"SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type] + ( kWh over MWh of demand RCPv[\
		District,HS,Performance,Type] - 1 ) / 0.5 * ("SC 1.5 kWh/MWh RCPv"[District,HS,Performance\
		,Type] - "SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type]) ) )
	~	
	~		|

Utility battery exp RCPv[District,HS,Performance,Type]=
	exp(Utility battery RCPv[District,HS,Performance,Type])
	~	
	~		|

Saved energy annually RCPv[District,HS,Performance,Type]=
	El consumption per building[District,HS,Performance,Type] * (Self consumption degree with Storage RCPv\
		[District,HS,Performance,Type] - Self consumption degree RCPv[District,HS,Performance\
		,Type]) * Decentralized storage efficiency
	~	
	~		|

Battery capacity RCPv[District,HS,Performance,Type]=
	MIN( Battery capacity 1 RCPv[District,Performance,Type] , Battery capacity 2[District\
		,HS,Performance,Type] )
	~	
	~		|

kWh over MWh of demand RCPv[District,HS,Performance,Type]=
	Battery capacity RCPv[District,HS,Performance,Type] / El consumption per building[District\
		,HS,Performance,Type] * 1000
	~	
	~		|

"Average El consumption > 100 kW"=
	"Average power PV > 100 kW" / ( "kWp over MWh of demand > 100 kW" / 1000 )
	~	kWh
	~		|

"PV annual adoption 30 - 100 kW"=
	SUM("Yearly installed capacity PV 30 - 100 kW District"[District!]) / "Average power PV 30 - 100 kW"
	~	
	~		|

"PV annual adoption > 100 kW"=
	SUM("Yearly installed capacity PV > 100 kW District"[District!]) / "Average power PV > 100 kW"
	~	
	~		|

Ratio annual adoption PV=
	"PV annual adoption 30 - 100 kW" / "PV annual adoption > 100 kW"
	~	
	~		|

Houly electricity cost PV hours[Month,Hour]=
	PV hourly supply[Month,Hour] * Electricity market price[Month,Hour]
	~	
	~		|

Average price PV hours=
	SUM(Houly electricity cost PV hours[Month!,Hour!]) * 365/12 / Total PV electricity injected in the grid
	~	
	~		|

"Capacity PV 30 - 100 kW total"=
	SUM("Capacity PV 30 - 100 kW District"[District!])
	~	kW
	~		|

Share Capacity nonRes=
	Total PV capacity nonRes / (Production PV residential + Total PV capacity nonRes)
	~	Dmnl
	~		|

Share Capacity Res=
	Production PV residential / (Production PV residential + Total PV capacity nonRes)
	~	Dmnl
	~		|

"Total PV kWh self consumed < 30"[District]= INTEG (
	"Additional annual PV kWh self consumed < 30"[District],
		0)
	~	kWh
	~		|

Total PV capacity nonRes=
	( "Capacity PV < 30 kW total" + "Capacity PV > 100 kW total" + "Capacity PV 30 - 100 kW total"\
		 ) * PV annual generation per kW / 1e+06
	~	GWh
	~		|

Total consumption nonRes=
	Electricity consumption Tertiary + Electricity consumption Industry
	~	GWh
	~		|

PV hourly production[Month,Hour]=
	Total PV electricity production * Hour factor PV[Month,Hour]
	~	
	~		|

"Total PV kWh self consumed > 100 kW"[District]= INTEG (
	"Additional annual PV kWh self consumed > 100 kW"[District],
		0)
	~	kWh
	~		|

"Total PV kWh self consumed 30 - 100 kW"[District]= INTEG (
	"Additional annual PV kWh self consumed 30 - 100 kW"[District],
		0)
	~	kWh
	~		|

Total consumption Res=
	SUM(Residential electricity cons by District[District!]) / 1e+06
	~	GWh
	~		|

"Capacity PV > 100 kW total"=
	SUM("Capacity PV > 100 kW District"[District!])
	~	kW
	~		|

"Capacity PV < 30 kW total"=
	SUM("Capacity PV < 30 kW"[District!])
	~	kW
	~		|

Total annual grid demand Districts[District]=
	Total annual demand Districts[District] - PV electricity SC by District[District] * \
		1e+06
	~	kWh
	~		|

Share additional power RCPv=
	0.5
	~	
	~		|

Residential electricity cons SH by District[District]=
	SUM(Residential electricity cons SH by arch[District,HS!,Performance!,Type!])
	~	kWh
	~		|

Residential electricity cons DHW by District[District]=
	SUM(Residential electricity cons DHW by arch[District,HS!,Performance!,Type!])
	~	kWh
	~		|

Self consumption degree RCPv[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		   ([(0,0)-(10,10)],(0,1),(0.25,0.68),(0.5,0.48),(0.75,0.37),(1,0.3),(1.5,0.23),(1.75\
		,0.205),(2.5,0.15),(7,0.04) ))
	~	Dmnl
	~		|

PE battery weight=
	0
	~	
	~		|

Battery Eco weight=
	PV Eco weight
	~	
	~		|

SC degree difference[District,HS,Performance,Type]=
	Self consumption degree with Storage[District,HS,Performance,Type] - Self consumption degree\
		[District,HS,Performance,Type]
	~	
	~		|

SC degree difference by HS[HS]=
	SUM(SC degree difference[District!,HS,Performance!,Type!]) / 8 / 5 / 3
	~	
	~		|

SC degree difference by Performance[Performance]=
	SUM(SC degree difference[District!,HS!,Performance,Type!]) / 8 / 11 / 3
	~	
	~		|

Log PE battery=
	MAX( LOG( Battery PE + 0.001 , 10 ) , -2 )
	~	
	~		|

Battery PE=
	SUM(Heating Solution[District!,HS!,Performance!,Type!,PVyes,Byes]) / SUM(Heating Solution\
		[District!,HS!,Performance!,Type!,PVyes,Battery!])
	~	
	~		|

Battery Eco factor[District,HS,Performance,Type]=
	Battery economic utility[District,HS,Performance,Type] * Battery Eco weight
	~	
	~		|

Alpha battery Type[Type]=
	0,
	0,
	0
	~	
	~		|

Alpha battery District[District]=
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0
	~	
	~		|

PE battery factor=
	Log PE battery * PE battery weight
	~	
	~		|

SC degree difference by Type[Type]=
	SUM(SC degree difference[District!,HS!,Performance!,Type]) / 8 / 5 / 11
	~	
	~		|

"Yearly installed capacity PV > 100 kW"[District]=
	exp("Utility PV > 100 kW"[District]) / ( 1 + exp("Utility PV > 100 kW"[District]) ) \
		* 
	( "Capacity potential PV > 100 kW" - "Capacity PV > 100 kW" ) * Share PV capacity installed per District\
		[District] / 0.125
	~	kW
	~		|

Buildings with PV Type[Type]=
	SUM(Heating Solution[District!,HS!,Performance!,Type,PVyes,Battery!])
	~	
	~		|

Battery Type Log Likelihood=
	IF THEN ELSE( Time < 2025 , 
	Adoption Battery Type Data[SFH] * LN( Probability of Adoption Battery Type[SFH] ) + \
		( Buildings PV Bno Type[SFH] - Adoption Battery Type Data[SFH] ) * LN( 1 - Probability of Adoption Battery Type\
		[SFH] ) + 
	Adoption Battery Type Data[MFH] * LN( Probability of Adoption Battery Type[MFH] ) + \
		( Buildings PV Bno Type[MFH] - Adoption Battery Type Data[MFH] ) * LN( 1 - Probability of Adoption Battery Type\
		[MFH] ) , 0 )
	~	
	~		|

Adoption Battery District Data[District]:INTERPOLATE::= GET DIRECT DATA('PVinput_pysd_v2.csv', '', '1', 'B2') ~	
	~		|

"Delta 30 - 100 kW"=
	-4
	~	
	~		|

Battery District Log Likelihood[District]=
	IF THEN ELSE( Time < 2025 , Adoption Battery District Data[District] * LN( Probability of Adoption Battery District\
		[District] ) + ( Buildings PV Bno District[District] - Adoption Battery District Data\
		[District] ) * LN( 1 - Probability of Adoption Battery District[District] ) , 0 )
	~	
	~		|

Buildings PV Bno District[District]:INTERPOLATE::= GET DIRECT DATA('PVinput_pysd_v2.csv', '', '1', 'B10') ~	
	~		|

Buildings PV Bno Type[Type]:INTERPOLATE::= GET DIRECT DATA('PVinput_pysd_v2.csv', '', '1', 'B18') ~	
	~		|

Adoption Battery Type Data[Type]:INTERPOLATE::= GET DIRECT DATA('PVinput_pysd_v2.csv', '', '1', 'B21') ~	
	~		|

Buildings with PV by District[District]=
	SUM(Heating Solution[District,HS!,Performance!,Type!,PVyes,Battery!])
	~	
	~		|

PV nonRes Eco weight=
	0
	~	Dmnl
	~		|

Probability of Adoption Battery District[District]=
	Adoption Battery District[District] / Buildings PV Bno District[District]
	~	
	~		|

"Yearly installed capacity PV 30 - 100 kW"[District]=
	exp("Utility PV 30 - 100 kW"[District]) / ( 1 + exp("Utility PV 30 - 100 kW"[District\
		]) ) * 
	( "Capacity potential PV 30 - 100 kW" - "Capacity PV 30 - 100 kW" ) * Share PV capacity installed per District\
		[District] / 0.125
	~	kW
	~		|

Probability of Adoption Battery Type[Type]=
	Adoption Battery Type[Type] / Buildings PV Bno Type[Type]
	~	
	~		|

Carrier used cost per kWh smooth[District,Tech]=
	SMOOTH( Carrier used cost per kWh[District,Tech] , 2 )
	~	CHF/kWh
	~		|

Average Economic Utility HS no incentives[HS]=
	SUM(Economic Utility HS no incentives[District!,HS,Performance!,Type!,PVpanel!]) / 8\
		 / 5 / 3 / 2
	~	
	~		|

Peer effect V weight=
	1
	~	
	~		|

Share of consumers considering PV stock factor[District]=
	Log peer effect[District] * Share of consumers considering PV weight
	~	
	~		|

HS VeryOld demolited[HS]=
