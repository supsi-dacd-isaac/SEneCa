		[HS]
	~	
	~		|

Economic Utility HS no incentives[District,HS,Performance,Type,PVpanel]=
	( Annualized Total Cost HS no incentives[District,HS,Performance,Type,PVpanel] - VMIN\
		(Annualized Total Cost HS no incentives[District,HS!,Performance,Type,PVpanel]) ) /\
		 
	( VMAX(Annualized Total Cost HS no incentives[District,HS!,Performance,Type,PVpanel]\
		) - VMIN(Annualized Total Cost HS no incentives[District,HS!,Performance,Type,PVpanel\
		]) )
	~	
	~		|

Share of federal grant over cost[District,Type]=
	PV initial federal subsidy[District,Type] / PV investment cost[District,Type]
	~	Dmnl
	~		|

PV Eco Utility Owners[District,HS,Performance,Type]=
