		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(4,0.2) ))
	~	Dmnl
	~		|

Buildings by Performance SFH[Performance]=
	SUM(Heating Solution[District!,HS!,Performance,SFH,PVpanel!,Battery!]) + SUM(Heating Solution\
		[District!,HS!,Performance,DFH,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
