	0
	~	CHF
	~		|

Grant share ST=
	0.2
	~	
	~		|

Grant ST[Performance,District,Type]=
	IF THEN ELSE( Time < 2026 , "Initial grant < 15 kW"[ST] + "Investment grant per kW < 15 kW"\
		[ST] * ST installed capacity by arch[Performance,District,Type] , Grant absolute ST\
		[Performance,District,Type] )
	~	
	~		|

RCPv cantonal subsidy[District,Type]=
	PV initial cantonal subsidy[District,Type]
	~	CHF
	~		|

Investment cost ST[Performance,District,Type]=
	IF THEN ELSE( ST dimention by arch[District,Type] < 10 , 1950 * ST dimention by arch\
		[District,Type] , 
	IF THEN ELSE( ST dimention by arch[District,Type] < 32 , 1812 * ST dimention by arch\
		[District,Type] , 1700 * ST dimention by arch[District,Type] ) )
	~	
	~		|

Grant absolute[OldS,District,Performance,Type]=
	0 ~~|
Grant absolute[Wood,District,Performance,Type]=
	0 ~~|
Grant absolute[OilST,District,Performance,Type]=
	0 ~~|
Grant absolute[GasST,District,Performance,Type]=
	0 ~~|
Grant absolute[WoodST,District,Performance,Type]=
	Investment cost HS noST adj[WoodST,District,Performance,Type] * Grant share PelletBoiler\
		 ~~|
Grant absolute[HPST,District,Performance,Type]=
	Investment cost HS noST adj[HPST,District,Performance,Type] * Grant share HP ~~|
Grant absolute[HeatPump,District,Performance,Type]=
	Investment cost HS noST adj[HeatPump,District,Performance,Type] * Grant share HP ~~|
Grant absolute[pellet,District,Performance,Type]=
	Investment cost HS noST adj[pellet,District,Performance,Type] * Grant share PelletBoiler\
		 ~~|
Grant absolute[DH,District,Performance,Type]=
	Investment cost HS noST adj[DH,District,Performance,Type] * Grant share DH
	~	
	~		|

EV buying incentive input=
	4000
	~	
	~		|

PV rebate cantonal=
	0.1
	~	
	~		|

Grant share HP=
	0.2
	~	
	~		|

Building construction by archetype[District,PerformanceLow,Type,PVpanel]=
	0 ~~|
Building construction by archetype[District,PerformanceHigh,Type,PVyes]=
	IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,PerformanceHigh,Type,PVpanel!,Battery\
		!]) > 0 , Buildings Construction[Type,District,PerformanceHigh] * SUM(Heating Solution\
		[District,HS!,PerformanceHigh,Type,PVyes,Battery!]) / ( SUM(Heating Solution[District\
		,HS!,PerformanceHigh,Type,PVpanel!,Battery!]) * Coeff roof suitability ) , 0 ) , 
	
	IF THEN ELSE( PV reg scenario = 1 , 
	
	IF THEN ELSE( Time < 2026 , Buildings Construction[Type,District,PerformanceHigh] * \
		Coeff roof suitability , 
	
	Res total construction by Perf Type District[PerformanceHigh,Type,District] * Coeff roof suitability\
		 ) , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,PerformanceHigh,Type,PVpanel!,Battery\
		!]) > 0 , Res total construction by Perf Type District[PerformanceHigh,Type,District\
		] * SUM(Heating Solution[District,HS!,PerformanceHigh,Type,PVyes,Battery!]) / SUM(Heating Solution\
		[District,HS!,PerformanceHigh,Type,PVpanel!,Battery!]) , 0 ) ) ) ~~|
Building construction by archetype[District,PerformanceHigh,Type,PVno]=
	IF THEN ELSE( Time < 2026 , 
	
	Buildings Construction[Type,District,PerformanceHigh] - Building construction by archetype\
		[District,PerformanceHigh,Type,PVyes] , 
	
	Res total construction by Perf Type District[PerformanceHigh,Type,District] - Building construction by archetype\
		[District,PerformanceHigh,Type,PVyes] )
	~	
	~		|

PV initial cantonal subsidy[District,Type]=
	IF THEN ELSE( Time < 2026 , 
	0 , 
	PV investment cost[District,Type] * PV rebate cantonal )
	~	CHF
	~		|

Annual fuel cost archetype[District,HS,Performance,Type,PVpanel] :EXCEPT: [District,No Electricity\
		,Performance,Type,PVpanel]=
	0 ~~|
Annual fuel cost archetype[District,Oil,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler] ~~|
Annual fuel cost archetype[District,OilST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler] ~~|
Annual fuel cost archetype[District,Gas,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler] ~~|
Annual fuel cost archetype[District,GasST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler] ~~|
Annual fuel cost archetype[District,Wood,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler] ~~|
Annual fuel cost archetype[District,WoodST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler] ~~|
Annual fuel cost archetype[District,pellet,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District,PelletBoiler] ~~|
Annual fuel cost archetype[District,DH,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) * 0.12
	~	CHF
	~		|

Retrofit incentive input=
	60
	~	CHF/m2
	~		|

Grant share PelletBoiler=
	0.2
	~	
	~		|

Flow PV incentives archetype[District,HS,Performance,Type,PVno]=
	Annural Federal subsidy RUP by archetype[District,HS,Performance,Type] + Annural Cantonal subsidy CU by archetype\
		[District,HS,Performance,Type] ~~|
Flow PV incentives archetype[District,HS,Performance,Type,PVyes]=
	Annual Subsidy FiT by archetype[District,HS,Performance,Type]
	~	CHF
	~		|

Annual Subsidy FiT by archetype[District,HS,Performance,Type]=
	( PV kW installed Residential[District,HS,Performance,Type] * PV annual generation per kW\
		 - PV kWh self consumed[District,HS,Performance,Type] ) * FiT
	~	CHF
	~		|

Probability of Adoption PV and battery District smooth[District]=
	( Probability of Adoption PV District delay 1[District] + Probability of Adoption PV District delay 2\
		[District] / 2 ) +
	( Probability of Adoption and battery District delay 1[District] + Probability of Adoption and battery District delay 2\
		[District] / 2 )
	~	
	~		|

Log peer effect[District]=
	LOG( Probability of Adoption PV and battery District smooth[District] , 10 )
	~	
	~		|

Share PV and Byes by District[District]=
	Share of buildings with PV by District[District] * Batteries by District[District]
	~	
	~		|

Probability of Adoption and battery District delay 2[District]= DELAY FIXED (
	 Probability of adoption PV and battery District[District] , 2 , 0.001)
	~	
	~		|

Probability of Adoption and battery District delay 1[District]= DELAY FIXED (
	 Probability of adoption PV and battery District[District] , 1 , 0.001)
	~	
	~		|

Share PV and Bno by District[District]=
	Share of buildings with PV by District[District] * ( 1 - Batteries by District[District\
		] )
	~	
	~		|

Probability of adoption PV and battery District[District]=
	Probability of Adoption Battery District[District] * Probability of Adoption PV District\
		[District]
	~	
	~		|

Cumulative retrofit cost[District,HS,Performance,Type,PVpanel]= INTEG (
	Flow retrofit cost[Performance,District,Type,HS,PVpanel],
		0)
	~	CHF
	~		|

Electricity consumption by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel,Battery!]) * El consumption per building\
		[District,HS,Performance,Type]
	~	kWh
	~		|

Average levy minus incentives archetype[District,HS,Performance,Type,PVpanel]=
	Average cumulative Levy archetype[District,HS,Performance,Type,PVpanel] - Average incentives PV archetype\
		[District,HS,Performance,Type,PVpanel]
	~	CHF/dwelling
	~		|

CAPEX retrofit cost[District,Type,VeryLow]=
	0 ~~|
CAPEX retrofit cost[District,Type,Low]=
	Low cost[District,Type] - VeryLow cost[District,Type] ~~|
CAPEX retrofit cost[District,Type,Moderate]=
	Moderate cost[District,Type] - VeryLow cost[District,Type] ~~|
CAPEX retrofit cost[District,Type,High]=
	High cost[District,Type] - VeryLow cost[District,Type] ~~|
CAPEX retrofit cost[District,Type,VeryHigh]=
	VeryHigh cost[District,Type] - VeryLow cost[District,Type]
	~	CHF
	~		|

Share WoodST adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions WoodST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions WoodST from HS by archetype[District,OldS!,Performance,Type\
		,PVpanel]) / SUM(Cumulative adoptions WoodST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) , 0 )
	~	Dmnl
	~		|

Additional annual PV kWh SC[District,HS,Performance,Type]=
	Additional annual PV kWh self consumed by archetype[District,HS,Performance,Type]
	~	kWh
	~		|

Annualised PV CAPEX[District,Type]=
	PV CAPEX[District,Type] * Interest rate / ( 1 - ( 1 + Interest rate ) ^ ( - PV lifetime\
		 ) )
	~	CHF
	~		|

Annualised retrofit CAPEX[District,Type,Performance]=
	CAPEX retrofit cost[District,Type,Performance] * Interest rate / ( 1 - ( 1 + Interest rate\
		 ) ^ ( - 50 ) )
	~	CHF
	~		|

Annualization coefficient for levy payments=
	IF THEN ELSE( Time < 2012 , 1.054 , 
	IF THEN ELSE( Time < 2013 , 1.062 , 
	IF THEN ELSE( Time < 2014 , 1.064 , 
	IF THEN ELSE( Time < 2015 , 1.064 , 
	IF THEN ELSE( Time < 2016 , 1.076 , 
	IF THEN ELSE( Time < 2017 , 1.082 , 
	IF THEN ELSE( Time < 2018 , 1.075 , 
	IF THEN ELSE( Time < 2019 , 1.065 , 
	IF THEN ELSE( Time < 2020 , 1.061 , 
	IF THEN ELSE( Time < 2021 , 1.07 , 
	IF THEN ELSE( Time < 2022 , 1.063 , 
	IF THEN ELSE( Time < 2023 , 1.034 , 
	IF THEN ELSE( Time < 2024 , 1.012 , 
	IF THEN ELSE( Time < 2025 , 1.002 , 
	IF THEN ELSE( Time < 2026 , 1 , 
	IF THEN ELSE( Time < 2027 , 0.99 , 
	IF THEN ELSE( Time < 2028 , 0.98 , 
	IF THEN ELSE( Time < 2029 , 0.971 , 
	IF THEN ELSE( Time < 2030 , 0.961 , 
	IF THEN ELSE( Time < 2031 , 0.951 , 
	IF THEN ELSE( Time < 2032 , 0.942 , 
	IF THEN ELSE( Time < 2033 , 0.933 , 
	IF THEN ELSE( Time < 2034 , 0.923 , 
	IF THEN ELSE( Time < 2035 , 0.914 , 
	IF THEN ELSE( Time < 2036 , 0.905 , 
	IF THEN ELSE( Time < 2037 , 0.896 , 
	IF THEN ELSE( Time < 2038 , 0.887 , 
	IF THEN ELSE( Time < 2039 , 0.879 , 
	IF THEN ELSE( Time < 2040 , 0.87 , 
	IF THEN ELSE( Time < 2041 , 0.861 , 
	IF THEN ELSE( Time < 2042 , 0.853 , 
	IF THEN ELSE( Time < 2043 , 0.844 , 
	IF THEN ELSE( Time < 2044 , 0.836 , 
	IF THEN ELSE( Time < 2045 , 0.828 , 
	IF THEN ELSE( Time < 2046 , 0.82 , 
	IF THEN ELSE( Time < 2047 , 0.811 , 
	IF THEN ELSE( Time < 2048 , 0.803 , 
	IF THEN ELSE( Time < 2049 , 0.795 , 0.788 ))))))))))))))))))))))))))))))))))))))
	~	Dmnl
	~		|

Annual Cantonal subsidy CU=
	( SUM(Annural Cantonal subsidy CU by archetype[District!,HS!,Performance!,Type!]) + \
		"PV annual adoption 30 - 100 kW" * "PV cantonal subsidy 30 - 100 kW check" + "PV annual adoption > 100 kW"\
		 * "PV cantonal subsidy > 100 kW check" ) / 1e+06
	~	Mio CHF
	~		|

Incentive GasST from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions GasST from OS by archetype[District,OldS,Performance,Type,PVpanel] * Grant ST\
		[Performance,District,Type]
	~	CHF
	~		|

Annural Federal subsidy RUP TI=
	( SUM(Annural Federal subsidy RUP by archetype[District!,HS!,Performance!,Type!]) * \
		( 1 + "Share additional power < 30 kW" ) + "PV federal subsidy 30 - 100 kW check" *\
		 "PV annual adoption 30 - 100 kW" ) / 1e+06
	~	Mio CHF
	~		|

Incentive HPST from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions HPST from OS by archetype[District,OldS,Performance,Type,PVpanel] * ( Grant ST\
		[Performance,District,Type] + Grant HP HPST[District,Performance,Type] )
	~	CHF
	~		|

Annual retrofit cost[Performance,District,Type,HS,PVpanel]=
	Annualised retrofit CAPEX[District,Type,Performance] + Incentives by archetype renovation\
		[Performance,District,Type,HS,PVpanel]
	~	CHF
	~		|

Incentive OilST from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions OilST from OS by archetype[District,OldS,Performance,Type,PVpanel] * Grant ST\
		[Performance,District,Type]
	~	CHF
	~		|

PV CAPEX[District,Type]=
	IF THEN ELSE( Time < 2013 , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) , 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	( PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type] ) * (1 - Tax deduction investment) , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) ) , 
	
	( PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type] ) * (1 - Tax deduction investment) ) )
	~	CHF
	~		|

Annual electricity cost[District,HS,Performance,Type,PVyes]=
	( Electricity consumption by archetype[District,HS,Performance,Type,PVyes] - Total PV kWh SC\
		[District,HS,Performance,Type] ) * Electricity price[District] - Annual Subsidy FiT by archetype\
		[District,HS,Performance,Type] ~~|
Annual electricity cost[District,HS,Performance,Type,PVno]=
	Electricity consumption by archetype[District,HS,Performance,Type,PVno] * Electricity price\
		[District]
	~	CHF
	~		|

Annual Levy archetype[District,HS,Performance,Type,PVyes]=
	( Electricity consumption by archetype[District,HS,Performance,Type,PVyes] - Total PV kWh SC\
		[District,HS,Performance,Type] ) * Levy Evolution ~~|
Annual Levy archetype[District,HS,Performance,Type,PVno]=
	Electricity consumption by archetype[District,HS,Performance,Type,PVno] * Levy Evolution
	~	CHF
	~		|

Adoptions DH from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,DH,Performance,Type,PVpanel]
	~	building
	~		|

Average cumulative CO2 tax archetype[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , 
	Cumulative CO2 tax archetype[Performance,District,Type,HS,PVpanel] / Cumulative archetype HH\
		[District,HS,Performance,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

Average cumulative Levy archetype[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , 
	Cumulative Levy archetype[Performance,District,Type,HS,PVpanel] / Cumulative archetype HH\
		[District,HS,Performance,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

Low cost[District,Type]=
	Ground cost Low[District,Type] + Roof cost Low[District,Type] + Wall cost Low[District\
		,Type]
	~	CHF
	~		|

Adoptions HeatPump from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,HeatPump,Performance,Type,PVpanel]
	~	building
	~		|

Annual PV CAPEX[District,HS,Performance,Type,PVyes]=
	Annualised PV CAPEX[District,Type] * SUM(Heating Solution[District,HS,Performance,Type\
		,PVyes,Battery!]) ~~|
Annual PV CAPEX[District,HS,Performance,Type,PVno]=
	0
	~	CHF
	~		|

Annual Cost PV grid expansion[District]=
	( SUM(Annual PV kW installation[District,HS!,Performance!,Type!]) + "Yearly installed capacity PV 30 - 100 kW District"\
		[District] + "Yearly installed capacity PV > 100 kW District"[District] ) * Grid expansion cost per kW PV\
		[District]
	~	CHF/kW
	~		|

Adoptions HPST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,HPST,Performance,Type,PVpanel]
	~	building
	~		|

Low to Performance sq m by archetype[District,Type,Performance,HS,PVpanel]=
	( Low changing Roof[District,Type] * Roof Low probabilities[District,Type,Performance\
		] * Roof size by Type and District[District,Type] + 
	Low changing Wall[District,Type] * Wall Low probabilities[District,Type,Performance]\
		 * Wall size by Type and District[District,Type] +
	Low changing Ground[District,Type] * Ground Low probabilities[District,Type,Performance\
		] * Ground size by Type and District[District,Type] ) * SUM(Share HS by archetype[District\
		,HS,Performance,Type,PVpanel,Battery!])
	~	m2
	~		|

Average electricity and heating and retrofit cost HH[District,HS,Performance,Type,PVpanel\
		]=
	Average electricity and heating cost HH[District,HS,Performance,Type,PVpanel] + Average retrofit cost HH\
		[District,HS,Performance,Type,PVpanel]
	~	CHF/dwelling
	~		|

Average electricity and heating cost=
	IF THEN ELSE( SUM(Cumulative archetype HH[District!,HS!,Performance!,Type!,PVpanel!]\
		) > 0 , SUM(Cumulative electricity and heating cost[District!,HS!,Performance!,Type\
		!,PVpanel!]) / SUM(Cumulative archetype HH[District!,HS!,Performance!,Type!,PVpanel\
		!]) , 0 )
	~	CHF/dwelling
	~		|

Annual PV prod Residential[District]=
	SUM(PV kW installed Residential[District,HS!,Performance!,Type!]) * PV annual generation per kW\
		 / 1e+06
	~	GWh
	~		|

Adoptions Pellet from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,pellet,Performance,Type,PVpanel]
	~	building
	~		|

Adoptions WoodST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:        \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,WoodST,Performance,Type,PVpanel] ~~|
Adoptions WoodST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Electricity and heating and retrofit annual cost[District,HS,Performance,Type,PVpanel\
		]=
	Flow electricity and heating cost[District,HS,Performance,Type,PVpanel] + Flow retrofit cost\
		[Performance,District,Type,HS,PVpanel]
	~	CHF
	~		|

Average incentives retrofit archetype[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , 
	Cumulative incentives retrofit archetypes[Performance,District,Type,HS,PVpanel] / Cumulative archetype HH\
		[District,HS,Performance,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

Cumulative adoptions GasST from HS by archetype[District,HS,Performance,Type,PVpanel]\
		= INTEG (
	Flow adoptions GasST from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Annualised HS CAPEX[HS,District,Performance,Type]=
	Investment cost HS[District,HS,Performance,Type] * Interest rate / ( 1 - ( 1 + Interest rate\
		 ) ^ ( - Lifetime ) )
	~	CHF
	~		|

Annualised HS CAPEX average[OldS,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX no incentives[OldS,District,Performance,Type] ~~|
Annualised HS CAPEX average[Wood,District,Performance,Type,PVpanel]=
	0 ~~|
Annualised HS CAPEX average[OilST,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[OilST,District,Performance,Type] * Share OilST adoption from OS[\
		District,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[OilST,District\
		,Performance,Type] * ( 1 - Share OilST adoption from OS[District,Performance,Type,PVpanel\
		] ) ~~|
Annualised HS CAPEX average[GasST,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[GasST,District,Performance,Type] * Share GasST adoption from OS[\
		District,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[GasST,District\
		,Performance,Type] * ( 1 - Share GasST adoption from OS[District,Performance,Type,PVpanel\
		] ) ~~|
Annualised HS CAPEX average[WoodST,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[WoodST,District,Performance,Type] * Share WoodST adoption from OS\
		[District,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[WoodST,District\
		,Performance,Type] * ( 1 - Share WoodST adoption from OS[District,Performance,Type,\
		PVpanel] ) ~~|
Annualised HS CAPEX average[HPST,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[HPST,District,Performance,Type] * Share HPST adoption from OS[District\
		,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[HPST,District,Performance\
		,Type] * ( 1 - Share HPST adoption from OS[District,Performance,Type,PVpanel] ) ~~|
Annualised HS CAPEX average[HeatPump,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[HeatPump,District,Performance,Type] * Share HeatPump adoption from OS\
		[District,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[HeatPump,District\
		,Performance,Type] * ( 1 - Share HeatPump adoption from OS[District,Performance,Type\
		,PVpanel] ) ~~|
Annualised HS CAPEX average[pellet,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[pellet,District,Performance,Type] * Share Pellet adoption from OS\
		[District,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[pellet,District\
		,Performance,Type] * ( 1 - Share Pellet adoption from OS[District,Performance,Type,\
		PVpanel] ) ~~|
Annualised HS CAPEX average[DH,District,Performance,Type,PVpanel]=
	Annualised HS CAPEX[DH,District,Performance,Type] * Share DH adoption from OS[District\
		,Performance,Type,PVpanel] + Annualised HS CAPEX no incentives[DH,District,Performance\
		,Type] * ( 1 - Share DH adoption from OS[District,Performance,Type,PVpanel] )
	~	CHF
	~		|

PV kW installed Residential[District,HS,Performance,Type]= INTEG (
	Annual PV kW installation[District,HS,Performance,Type],
		Initial kWp installed by archetype[District,HS,Performance,Type])
	~	kW
	~		|

Share DH adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions DH from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions DH from HS by archetype[District,OldS!,Performance,Type,PVpanel\
		]) / SUM(Cumulative adoptions DH from HS by archetype[District,HS!,Performance,Type\
		,PVpanel]) , 0 )
	~	Dmnl
	~		|

Adoptions HeatPump from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:\
		    [District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,HeatPump,Performance,Type,PVpanel] ~~|
Adoptions HeatPump from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Flow adoptions Pellet from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions Pellet from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

Incentive DH from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions DH from OS by archetype[District,OldS,Performance,Type,PVpanel] * Grant DH\
		[Performance,District,Type]
	~	CHF
	~		|

Moderate cost[District,Type]=
	Ground cost Moderate[District,Type] + Roof cost Moderate[District,Type] + Wall cost Moderate\
		[District,Type]
	~	CHF
	~		|

Incentive HeatPump from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions HeatPump from OS by archetype[District,OldS,Performance,Type,PVpanel] * Grant HP HeatPump\
		[Performance,District,Type]
	~	CHF
	~		|

Share HPST adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions HPST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions HPST from HS by archetype[District,OldS!,Performance,Type,PVpanel\
		]) / SUM(Cumulative adoptions HPST from HS by archetype[District,HS!,Performance,Type\
		,PVpanel]) , 0 )
	~	Dmnl
	~		|

High cost[District,Type]=
	Ground cost High[District,Type] + Roof cost High[District,Type] + Wall cost High[District\
		,Type]
	~	CHF
	~		|

VeryLow cost[District,Type]=
	Ground cost[District,Type] + Roof cost[District,Type] + Wall cost[District,Type]
	~	CHF
	~		|

Adoptions Pellet from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:     \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,pellet,Performance,Type,PVpanel] ~~|
Adoptions Pellet from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Incentive Pellet from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions Pellet from OS by archetype[District,OldS,Performance,Type,PVpanel] * Grant PelletBoiler Pellet\
		[Performance,District,Type]
	~	CHF
	~		|

Average incentives from OS archetype[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , 
	Cumulative incentives archetype from OS[District,HS,Performance,Type,PVpanel] / Cumulative archetype HH\
		[District,HS,Performance,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

Average retrofit cost=
	IF THEN ELSE( SUM(Cumulative archetype HH[District!,HS!,Performance!,Type!,PVpanel!]\
		) > 0 , SUM(Cumulative retrofit cost[District!,HS!,Performance!,Type!,PVpanel!]) / \
		SUM(Cumulative archetype HH[District!,HS!,Performance!,Type!,PVpanel!]) , 0 )
	~	CHF/dwelling
	~		|

Incentive WoodST from OS by archetype[District,OldS,Performance,Type,PVpanel]=
	Adoptions WoodST from OS by archetype[District,OldS,Performance,Type,PVpanel] * ( Grant ST\
		[Performance,District,Type] + Grant PelletBoiler WoodST[District,Performance,Type] \
		)
	~	CHF
	~		|

Production PV residential=
	SUM(PV kW installed Residential[District!,HS!,Performance!,Type!]) * PV annual generation per kW\
		 / 1e+06
	~	GWh
	~		|

Adoptions DH from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:     \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,DH,Performance,Type,PVpanel] ~~|
Adoptions DH from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Adoptions GasST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,GasST,Performance,Type,PVpanel]
	~	building
	~		|

Adoptions GasST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:       \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,GasST,Performance,Type,PVpanel] ~~|
Adoptions GasST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Cumulative adoptions Pellet from HS by archetype[District,HS,Performance,Type,PVpanel\
		]= INTEG (
	Flow adoptions Pellet from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Cumulative adoptions WoodST from HS by archetype[District,HS,Performance,Type,PVpanel\
		]= INTEG (
	Flow adoptions WoodST from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Annual fuel cost[District,HS,Performance,Type,PVpanel]=
	Annual fuel cost archetype[District,HS,Performance,Type,PVpanel] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel,Battery!])
	~	CHF
	~		|

Adoptions HPST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:       \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,HPST,Performance,Type,PVpanel] ~~|
Adoptions HPST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Share HeatPump adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions HeatPump from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions HeatPump from HS by archetype[District,OldS!,Performance,Type\
		,PVpanel]) / SUM(Cumulative adoptions HeatPump from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) , 0 )
	~	Dmnl
	~		|

Adoptions OilST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,OilST,Performance,Type,PVpanel]
	~	building
	~		|

Adoptions OilST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:      \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,OilST,Performance,Type,PVpanel] ~~|
Adoptions OilST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Annual HS CAPEX[District,HS,Performance,Type,PVpanel]=
	Annualised HS CAPEX average[HS,District,Performance,Type,PVpanel] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel,Battery!])
	~	CHF
	~		|

Cumulative incentives retrofit archetypes[Performance,District,Type,HS,PVpanel]= INTEG\
		 (
	Flow incentives retrofit archetypes[Performance,District,Type,HS,PVpanel],
		0)
	~	CHF
	~		|

Adoptions WoodST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,WoodST,Performance,Type,PVpanel]
	~	building
	~		|

Cumulative PV incentives archetype[District,HS,Performance,Type,PVpanel]= INTEG (
	Flow PV incentives archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	CHF
	~		|

Total PV kWh SC[District,HS,Performance,Type]= INTEG (
	Additional annual PV kWh SC[District,HS,Performance,Type],
		0)
	~	kWh
	~		|

Cumulative adoptions DH from HS by archetype[District,HS,Performance,Type,PVpanel]= INTEG\
		 (
	Flow adoptions DH from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Share Pellet adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions Pellet from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions Pellet from HS by archetype[District,OldS!,Performance,Type\
		,PVpanel]) / SUM(Cumulative adoptions Pellet from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) , 0 )
	~	Dmnl
	~		|

Cumulative adoptions HeatPump from HS by archetype[District,HS,Performance,Type,PVpanel\
		]= INTEG (
	Flow adoptions HeatPump from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Cumulative adoptions HPST from HS by archetype[District,HS,Performance,Type,PVpanel]=\
		 INTEG (
	Flow adoptions HPST from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Annual archetypes[District,HS,Performance,Type,PVpanel]=
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel,Battery!]) * Dwellings per building\
		[District,Type]
	~	dwelling
	~		|

PV kWh self consumed[District,HS,Performance,Type]= INTEG (
	Additional annual PV kWh self consumed[District,HS,Performance,Type],
		0)
	~	kWh
	~		|

Flow adoptions OilST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions OilST from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

Share OilST adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions OilST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions OilST from HS by archetype[District,OldS!,Performance,Type,\
		PVpanel]) / SUM(Cumulative adoptions OilST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) , 0 )
	~	Dmnl
	~		|

Share GasST adoption from OS[District,Performance,Type,PVpanel]=
	IF THEN ELSE( SUM(Cumulative adoptions GasST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) > 0 , 
	SUM(Cumulative adoptions GasST from HS by archetype[District,OldS!,Performance,Type,\
		PVpanel]) / SUM(Cumulative adoptions GasST from HS by archetype[District,HS!,Performance\
		,Type,PVpanel]) , 0 )
	~	Dmnl
	~		|

Average electricity and heating and retrofit cost=
	Average electricity and heating cost + Average retrofit cost
	~	CHF/dwelling
	~		|

Cumulative incentives archetype from OS[District,HS,Performance,Type,PVpanel]= INTEG \
		(
	Flow incentives archetype from OS[District,HS,Performance,Type,PVpanel],
		0)
	~	CHF
	~		|

Annual electricity and heating cost[District,HS,Performance,Type,PVpanel]=
	Annual electricity cost[District,HS,Performance,Type,PVpanel] + Annual fuel cost[District\
		,HS,Performance,Type,PVpanel] + Annual HS CAPEX[District,HS,Performance,Type,PVpanel\
		] + Annual PV CAPEX[District,HS,Performance,Type,PVpanel]
	~	CHF
	~		|

Average electricity and heating cost HH[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , 
	Cumulative electricity and heating cost[District,HS,Performance,Type,PVpanel] / Cumulative archetype HH\
		[District,HS,Performance,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

VeryHigh cost[District,Type]=
	Ground cost VeryHigh[District,Type] + Roof cost VeryHigh[District,Type] + Wall cost VeryHigh\
		[District,Type]
	~	CHF
	~		|

Average retrofit cost HH[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , Cumulative retrofit cost\
		[District,HS,Performance,Type,PVpanel] / Cumulative archetype HH[District,HS,Performance\
		,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

Flow adoptions HPST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions HPST from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

Flow adoptions DH from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions DH from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

PV electricity SC by District[District]=
	( SUM(PV kWh self consumed[District,HS!,Performance!,Type!]) + "Total PV kWh self consumed < 30"\
		[District] + "Total PV kWh self consumed 30 - 100 kW"[District] + "Total PV kWh self consumed > 100 kW"\
		[District] ) / 1e+06
	~	GWh
	~		|

Cumulative CO2 tax archetype[Performance,District,Type,HS,PVpanel]= INTEG (
	Annual CO2 tax archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	CHF
	~		|

VeryLow to Performance sq m by archetype[District,Type,Performance,HS,PVpanel]=
	( VeryLow changing Roof[District,Type] * Roof VeryLow probabilities[District,Type,Performance\
		] * Roof size by Type and District[District,Type] + 
	VeryLow changing Wall[District,Type] * Wall VeryLow probabilities[District,Type,Performance\
		] * Wall size by Type and District[District,Type] +
	VeryLow changing Ground[District,Type] * Ground VeryLow probabilities[District,Type,\
		Performance] * Ground size by Type and District[District,Type] ) * SUM(Share HS by archetype\
		[District,HS,Performance,Type,PVpanel,Battery!])
	~	m2
	~		|

Flow adoptions GasST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions GasST from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

Flow retrofit cost[Performance,District,Type,HS,PVpanel]=
	Annual retrofit cost[Performance,District,Type,HS,PVpanel] * Annualization coefficient for levy payments
	~	CHF
	~		|

Average tax minus incentives archetype[District,HS,Performance,Type,PVpanel]=
	Average cumulative CO2 tax archetype[District,HS,Performance,Type,PVpanel] - Average incentives from OS archetype\
		[District,HS,Performance,Type,PVpanel] - Average incentives retrofit archetype[District\
		,HS,Performance,Type,PVpanel]
	~	CHF/dwelling
	~		|

Flow incentives retrofit archetypes[Performance,District,Type,HS,PVpanel]=
	Incentives by archetype renovation[Performance,District,Type,HS,PVpanel]
	~	CHF
	~		|

Cumulative electricity and heating cost[District,HS,Performance,Type,PVpanel]= INTEG \
		(
	Flow electricity and heating cost[District,HS,Performance,Type,PVpanel],
		0)
	~	CHF
	~		|

"Capacity PV < 30 kW"[District]=
	SUM(PV kW installed Residential[District,HS!,Performance!,Type!]) * "Share additional power < 30 kW"
	~	kW
	~		|

Flow electricity and heating cost[District,HS,Performance,Type,PVpanel]=
	Annual electricity and heating cost[District,HS,Performance,Type,PVpanel] * Annualization coefficient for levy payments
	~	CHF
	~		|

Cumulative Levy archetype[Performance,District,Type,HS,PVpanel]= INTEG (
	Annual Levy archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	CHF
	~		|

Flow incentives archetype from OS[District,HS,Performance,Type,PVpanel]=
	Incentives by archetype from OS[District,HS,Performance,Type,PVpanel]
	~	CHF
	~		|

Incentives by archetype from OS[District,OldS,Performance,Type,PVpanel]=
	Incentive DH from OS by archetype[District,OldS,Performance,Type,PVpanel] + 
	Incentive GasST from OS by archetype[District,OldS,Performance,Type,PVpanel] + 
	Incentive HeatPump from OS by archetype[District,OldS,Performance,Type,PVpanel] + 
	Incentive HPST from OS by archetype[District,OldS,Performance,Type,PVpanel] +
	Incentive OilST from OS by archetype[District,OldS,Performance,Type,PVpanel] +
	Incentive Pellet from OS by archetype[District,OldS,Performance,Type,PVpanel] +
	Incentive WoodST from OS by archetype[District,OldS,Performance,Type,PVpanel] ~~|
Incentives by archetype from OS[District,NewS,Performance,Type,PVpanel]=
	0
	~	CHF
	~		|

Annualised HS CAPEX no incentives[HS,District,Performance,Type]=
	Investment cost HS no incentives[HS,District,Performance,Type] * Interest rate / ( 1\
		 - ( 1 + Interest rate ) ^ ( - Lifetime ) )
	~	CHF
	~		|

Flow adoptions WoodST from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions WoodST from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

Flow adoptions HeatPump from HS by archetype[District,HS,Performance,Type,PVpanel]=
	Adoptions HeatPump from HS by archetype[District,HS,Performance,Type,PVpanel]
	~	building
	~		|

Incentives by archetype renovation[VeryLow,District,Type,HS,PVpanel]=
	VeryLow to Performance sq m by archetype[District,Type,Moderate,HS,PVpanel] * Incentive Base\
		 + 
	VeryLow to Performance sq m by archetype[District,Type,High,HS,PVpanel] * Incentive CECE\
		 +
	VeryLow to Performance sq m by archetype[District,Type,VeryHigh,HS,PVpanel] * Incentive Minergie\
		 ~~|
Incentives by archetype renovation[Low,District,Type,HS,PVpanel]=
	Low to Performance sq m by archetype[District,Type,Moderate,HS,PVpanel] * Incentive Base\
		 + 
	Low to Performance sq m by archetype[District,Type,High,HS,PVpanel] * Incentive CECE\
		 +
	Low to Performance sq m by archetype[District,Type,VeryHigh,HS,PVpanel] * Incentive Minergie\
		 ~~|
Incentives by archetype renovation[PerformanceHigh,District,Type,HS,PVpanel]=
	0
	~	CHF
	~		|

Cumulative archetype HH[District,HS,Performance,Type,PVpanel]= INTEG (
	Annual archetypes[District,HS,Performance,Type,PVpanel],
		0)
	~	dwelling
	~		|

Cumulative adoptions OilST from HS by archetype[District,HS,Performance,Type,PVpanel]\
		= INTEG (
	Flow adoptions OilST from HS by archetype[District,HS,Performance,Type,PVpanel],
		0)
	~	building
	~		|

Average incentives PV archetype[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Cumulative archetype HH[District,HS,Performance,Type,PVpanel] > 0 , 
	Cumulative PV incentives archetype[District,HS,Performance,Type,PVpanel] / Cumulative archetype HH\
		[District,HS,Performance,Type,PVpanel] , 0 )
	~	CHF/dwelling
	~		|

CO2 tax=
	120
	~	
	~		|

Total SH net consumption=
	( Annual SH consumption DH + Annual SH consumption Electricity HP + Annual SH consumption Electricity EH\
		 + Annual SH consumption Gas + Annual SH consumption Oil + Annual SH consumption Wood\
		 ) * 1e+06
	~	kWh
	~		|

Annual CO2 emissions=
	IF THEN ELSE( Time < 2026 , 0 , ( CO2 emissions Gas + CO2 emissions Oil ) / 1e+06 )
	~	MtonCO2
	~		|

Cumulative CO2 emissions= INTEG (
	Annual CO2 emissions,
		0)
	~	MtonCO2
	~		|

Increase CO2 tax scenario=
	CO2 tax / 120 - 1
	~	Dmnl
	~		|

Specific net final consumption=
	Total SH net consumption / SUM(Primary buildings area by archetype[District!,Performance\
		!,Type!])
	~	kWh/m2
	~		|

Primary buildings area by archetype[District,Performance,Type]=
	SUM(Heating Solution[District,HS!,Performance,Type,PVpanel!,Battery!]) * Average building size\
		[District,Type] * Share primary houses[District]
	~	m2
	~		|

CO2 emissions Gas=
	( Annual SH consumption Gas + Annual DHW consumption Gas ) * 1000 * 73.7
	~	tonCO2
	~		|

CO2 emissions Oil=
	( Annual SH consumption Oil + Annual DHW consumption Oil ) * 1000 * 73.7
	~	tonCO2
	~		|

Total SH consumption=
	( Annual SH consumption Ambient Heat + Annual SH consumption DH + Annual SH consumption Electricity HP\
		 + Annual SH consumption Electricity EH + Annual SH consumption Gas + Annual SH consumption Oil\
		 + Annual SH consumption Wood ) * 1e+06
	~	kWh
	~		|

Specific final consumption=
	Total SH consumption / SUM(Primary buildings area by archetype[District!,Performance\
		!,Type!])
	~	kWh/m2
	~		|

Annual incentives HT and Renovation=
	Annual incentives Heating Technologies + Annual incentives Renovation
	~	Mio CHF
	~		|

Annual incentives HT and Renovation 2024= INTEG (
	Annual incentives HT and Renovation flow,
		0)
	~	Mio CHF
	~		|

Annual incentives HT and Renovation flow=
	IF THEN ELSE( Time = 2024 , Annual incentives HT and Renovation , 0 )
	~	Mio CHF
	~		|

Share funds coming from federal CO2 tax=
	0.5
	~	Dmnl
	~		|

Additional Gas unit cost CO2 tax=
	"Reference CO2 tax 120 CHF/tonCO2" * 56 / 1e+06 * 3.6 * Increase CO2 tax scenario application
	~	CHF/kWh
	~		|

Funds coming from federal CO2 tax 2025=
	Annual incentives HT and Renovation 2024 * Share funds coming from federal CO2 tax
	~	Mio CHF
	~		|

Funds coming from federal CO2 tax=
	IF THEN ELSE( Time < 2025 , 0 , Funds coming from federal CO2 tax 2025 * ( 2050 - Time\
		 ) / ( 2050 - 2025 ) * ( 1 + Increase CO2 tax scenario ) )
	~	Mio CHF
	~		|

Increase CO2 tax scenario application=
	IF THEN ELSE( Time < 2025 , 0 , Increase CO2 tax scenario )
	~	Dmnl
	~		|

"Reference CO2 tax 120 CHF/tonCO2"=
	120
	~	CHF/tonCO2
	~		|

Additional Oil unit cost CO2 tax=
	"Reference CO2 tax 120 CHF/tonCO2" * 73.7 / 1e+06 * 3.6 * Increase CO2 tax scenario application
	~	CHF/kWh
	~		|

Annual cantonal funds needed=
	IF THEN ELSE( Time < 2025 , Annual incentives HT and Renovation * 0.6 , MAX( Annual incentives HT and Renovation\
		 - Funds coming from federal CO2 tax , 0 ) )
	~	Mio CHF
	~		|

Annual incentives Lunen coeal power plant=
	2.7
	~	Mio CHF
	~		|

Collected funds cantonal levy=
	Reference Cantonal Levy * SUM(Total annual grid demand Districts[District!]) / 1e+06
	~	Mio CHF
	~		|

Annual Total Cantonal Subsidy 5 years avg=
	SMOOTH( Annual Total Cantonal net Subsidy , 5 )
	~	Mio CHF
	~		|

Annual Total Cantonal net Subsidy=
	MAX( Annual Total Cantonal Subsidy - Annual incentives Lunen coeal power plant , 0 )
	~	Mio CHF
	~		|

Annual DHW consumption Electricity EH by Type[Type]=
	Annual DHW demand Electricity EH by Type[Type] / Efficiency[EH] / Efficiency DHW storage
	~	GWh
	~		|

Annual DHW consumption Solar by Type[Type]=
	Annual DHW demand Solar by Type[Type]
	~	GWh
	~		|

Efficiency DHW storage=
	0.6
	~	
	~		|

Annual DHW consumption Wood by Type[Type]=
	Annual DHW demand Wood by Type[Type] / Efficiency[WoodBoiler] / Efficiency DHW storage
	~	GWh
	~		|

Annual DHW consumption Gas by Type[Type]=
	Annual DHW demand Gas by Type[Type] / Efficiency[GasBoiler] / Efficiency DHW storage
	~	GWh
	~		|

Annual DHW consumption Ambient Heat by Type[Type]=
	Annual DHW demand Ambient Heat by Type[Type] / Efficiency DHW storage
	~	GWh
	~		|

Total DHW consumption=
	Annual DHW consumption Ambient Heat + 
	Annual DHW consumption DH +
	Annual DHW consumption Electricity EH +
	Annual DHW consumption Electricity HP +
	Annual DHW consumption Gas +
	Annual DHW consumption Oil +
	Annual DHW consumption Solar +
	Annual DHW consumption Wood
	~	GWh
	~		|

Total DHW demand=
	SUM(Annual DHW demand Ambient Heat by Type[Type!]) + 
	SUM(Annual DHW demand DH by Type[Type!]) +
	SUM(Annual DHW demand Electricity EH by Type[Type!]) +
	SUM(Annual DHW demand Electricity HP by Type[Type!]) +
	SUM(Annual DHW demand Gas by Type[Type!]) +
	SUM(Annual DHW demand Oil by Type[Type!]) +
	SUM(Annual DHW demand Solar by Type[Type!]) +
	SUM(Annual DHW demand Wood by Type[Type!])
	~	GWh
	~		|

Annual DHW consumption Oil by Type[Type]=
	Annual DHW demand Oil by Type[Type] / Efficiency[OilBoiler] / Efficiency DHW storage
	~	GWh
	~		|

Annual DHW consumption Electricity HP by Type[Type]=
	Annual DHW demand Electricity HP by Type[Type] / Efficiency DHW storage
	~	GWh
	~		|

Buildings adopting HS for old age[District,HS,Performance,Type,PVpanel,Battery]=
	IF THEN ELSE( Time < 2016 , 
	
	Consumers leaving HS for old age[District,ElectricHeater,Performance,Type,PVpanel,Battery\
		] * Market Share HS filtered[District,HS,Performance,Type,PVpanel] +
	( SUM(Consumers leaving HS for old age[District,HS!,Performance,Type,PVpanel,Battery\
		]) - Consumers leaving HS for old age[District,ElectricHeater,Performance,Type,PVpanel\
		,Battery] ) * Market Share HS no incentives filtered[District,HS,Performance,Type,PVpanel\
		] , 
	
	IF THEN ELSE( Time < 2021 , 
	
	( Consumers leaving HS for old age[District,ElectricHeater,Performance,Type,PVpanel,\
		Battery] + Consumers leaving HS for old age[District,Oil,Performance,Type,PVpanel,Battery\
		] ) * Market Share HS filtered[District,HS,Performance,Type,PVpanel] +
	( SUM(Consumers leaving HS for old age[District,NewS!,Performance,Type,PVpanel,Battery\
		]) + Consumers leaving HS for old age[District,Gas,Performance,Type,PVpanel,Battery\
		] ) * Market Share HS no incentives filtered[District,HS,Performance,Type,PVpanel] \
		, 
	
	SUM(Consumers leaving HS for old age[District,OldS!,Performance,Type,PVpanel,Battery\
		]) * Market Share HS filtered[District,HS,Performance,Type,PVpanel] +
	SUM(Consumers leaving HS for old age[District,NewS!,Performance,Type,PVpanel,Battery\
		]) * Market Share HS no incentives filtered[District,HS,Performance,Type,PVpanel] )\
		 )
	~	
	~		|

Annual inventive renovation Low[District,Type]=
	IF THEN ELSE( Time < 2017 , 
	
	Low to Performance sq m[District,Type,High] * Incentive CECE +
	Low to Performance sq m[District,Type,VeryHigh] * Incentive Minergie , 
	
	Low to Performance sq m[District,Type,Moderate] * Incentive Base +
	Low to Performance sq m[District,Type,High] * Incentive CECE +
	Low to Performance sq m[District,Type,VeryHigh] * Incentive Minergie )
	~	
	~		|

"Investment grant per kW > 15 kW"[OilBoiler]=
	0 ~~|
"Investment grant per kW > 15 kW"[GasBoiler]=
	0 ~~|
"Investment grant per kW > 15 kW"[PelletBoiler]=
	IF THEN ELSE(Time < 2022, 0, 
	
	IF THEN ELSE( Time < 2025 , 100 , 
	
	IF THEN ELSE( Time < 2030 , 360 , 350 ) ) ) ~~|
"Investment grant per kW > 15 kW"[HP]=
	IF THEN ELSE(Time < 2017, 0, 
	
	IF THEN ELSE(Time < 2022, 100,
	
	IF THEN ELSE(Time < 2030 , 180 , 180 ) ) ) ~~|
"Investment grant per kW > 15 kW"[EH]=
	0 ~~|
"Investment grant per kW > 15 kW"[ST]=
	IF THEN ELSE(Time < 2016.1, 0, 
	
	IF THEN ELSE(Time < 2021.1, 200, 
	
	IF THEN ELSE(Time < 2030, 500 , 0 ) ) ) ~~|
"Investment grant per kW > 15 kW"[WoodBoiler]=
	0
	~	CHF/kW
	~	IF THEN ELSE(Time < 2016.1, 0, 
		
		IF THEN ELSE(Time < 2021.1, 100,
		
		IF THEN ELSE(Time < 2030 , 180 , 180 ) ) )
	|

Low to Performance sq m[District,Type,Performance]=
	Low changing Roof[District,Type] * Roof Low probabilities[District,Type,Performance]\
		 * Roof size by Type and District[District,Type] + 
	Low changing Wall[District,Type] * Wall Low probabilities[District,Type,Performance]\
		 * Wall size by Type and District[District,Type] +
	Low changing Ground[District,Type] * Ground Low probabilities[District,Type,Performance\
		] * Ground size by Type and District[District,Type]
	~	
	~		|

"Initial grant > 15 kW"[OilBoiler]=
	0 ~~|
"Initial grant > 15 kW"[GasBoiler]=
	0 ~~|
"Initial grant > 15 kW"[PelletBoiler]=
	IF THEN ELSE(Time < 2022 , 0, 
	
	IF THEN ELSE(Time < 2025 , 5000 , 
	
	IF THEN ELSE( Time < 2030 , 0 , 0 ) ) ) ~~|
"Initial grant > 15 kW"[HP]=
	IF THEN ELSE(Time < 2017, 3000, 
	
	IF THEN ELSE(Time < 2022, 3000, 
	
	IF THEN ELSE(Time < 2030, 6000 , 7000 ) ) ) ~~|
"Initial grant > 15 kW"[EH]=
	0 ~~|
"Initial grant > 15 kW"[ST]=
	IF THEN ELSE(Time < 2017, 2500, 
	
	IF THEN ELSE(Time < 2022 , 1200 , 
	
	IF THEN ELSE(Time < 2030 , 2500 , 2500 ) ) ) ~~|
"Initial grant > 15 kW"[WoodBoiler]=
	0
	~	CHF
	~		|

Annual incentives Renovation=
	( SUM(Annual inventive renovation VeryLow[District!,Type!]) + SUM(Annual inventive renovation Low\
		[District!,Type!]) ) / 1e+06
	~	Mio CHF
	~		|

Roof VeryLow scaled[District,Type,Performance]=
	( Roof VeryLow[District,Type,Performance] - ( VMAX(Roof VeryLow[District,Type,Performance\
		!]) - VMIN(Roof VeryLow[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff VeryLow\
		[Type,Performance]
	~	
	~		|

Roof specific cost CECE Low=
	336 * Renovation cost index
	~	CHF/m2
	~		|

Roof specific cost Minergie=
	393 * Renovation cost index
	~	CHF/m2
	~		|

Roof cost Moderate[District,Type]=
	( Roof specific cost CECE Low - Incentive Base ) * Roof size by Type and District[District\
		,Type]
	~	
	~		|

Retrofit incentives year input=
	IF THEN ELSE( Time < 2018 , 0.514 , 
	IF THEN ELSE( Time < 2019 , 0.616 , 
	IF THEN ELSE( Time < 2020 , 0.84 , 
	IF THEN ELSE( Time < 2021 , 0.956 , 
	IF THEN ELSE( Time < 2022 , 0.998 , 
	IF THEN ELSE( Time < 2023 , 1.003 , 
	IF THEN ELSE( Time < 2024 , 1.003 , 1 )))))))
	~	
	~		|

Wall specific cost=
	163 * Renovation cost index
	~	CHF/m2
	~		|

Renovation cost index=
	IF THEN ELSE( Time < 2012 , 0.991 , 
	IF THEN ELSE( Time < 2013 , 0.987 , 
	IF THEN ELSE( Time < 2014 , 0.985 , 
	IF THEN ELSE( Time < 2015 , 0.982 , 
	IF THEN ELSE( Time < 2016 , 0.975 , 
	IF THEN ELSE( Time < 2017 , 0.97 , 
	IF THEN ELSE( Time < 2018 , 0.97 , 
	IF THEN ELSE( Time < 2019 , 0.978 , 
	IF THEN ELSE( Time < 2020 , 0.985 , 
	IF THEN ELSE( Time < 2021 , 1.002 , 
	IF THEN ELSE( Time < 2022 , 1.028 , 
	IF THEN ELSE( Time < 2023 , 1.085 , 
	IF THEN ELSE( Time < 2024 , 1.106 , 
	IF THEN ELSE( Time < 2025 , 1.11 , 1.119 ))))))))))))))
	~	
	~		|

Total present variable costs SH Ground[District,HS,Performance,Type]=
	SMOOTH( Annual variable costs SH[District,HS,Performance,Type] * (1 - (1 / ((1 + ( Interest rate\
		 + Additional interest rate for loan ) ) ^ Ground Lifetime ))) / ( Interest rate + \
		Additional interest rate for loan ) , 5 )
	~	
	~		|

Additional cantonal incentive CECE=
	IF THEN ELSE( Time < 2016 , 0.5 , 
	IF THEN ELSE( Time < 2021 , 1 , 1.6 ) )
	~	Dmnl
	~		|

Additional cantonal incentive Minergie=
	IF THEN ELSE( Time < 2016 , 0.8 , 
	IF THEN ELSE( Time < 2021 , 2.2 , 2.2 ) )
	~	Dmnl
	~		|

Additional interest rate for loan=
	0.02
	~	Dmnl
	~		|

Wall cost Moderate[District,Type]=
	( Wall specific cost CECE Low - Incentive Base ) * Wall size by Type and District[District\
		,Type]
	~	
	~		|

Ground specific cost=
	91 * Renovation cost index
	~	CHF/m2
	~		|

Incentive CECE=
	Incentive Base * ( 1 + Additional cantonal incentive CECE )
	~	
	~		|

Wall specific cost CECE High=
	290 * Renovation cost index
	~	CHF/m2
	~		|

Wall specific cost CECE Low=
	260 * Renovation cost index
	~	CHF/m2
	~		|

Incentive Minergie=
	Incentive Base * ( 1 + Additional cantonal incentive Minergie )
	~	
	~		|

Wall specific cost Minergie=
	328 * Renovation cost index
	~	CHF/m2
	~		|

Ground specific cost Minergie=
	182 * Renovation cost index
	~	CHF/m2
	~		|

Roof specific cost Base=
	324 * Renovation cost index
	~	CHF/m2
	~		|

Ground specific cost Base=
	137 * Renovation cost index
	~	CHF/m2
	~		|

Roof specific cost=
	254 * Renovation cost index
	~	CHF/m2
	~		|

Ground specific cost CECE Low=
	145 * Renovation cost index
	~	CHF/m2
	~		|

Total present variable costs SH roof[District,HS,Performance,Type]=
	SMOOTH( Annual variable costs SH[District,HS,Performance,Type] * (1 - (1 / ((1 + ( Interest rate\
		 + Additional interest rate for loan )) ^ Roof Lifetime))) / ( Interest rate + Additional interest rate for loan\
		 ) , 5 )
	~	
	~		|

Total present variable costs SH Wall[District,HS,Performance,Type]=
	SMOOTH( Annual variable costs SH[District,HS,Performance,Type] * (1 - (1 / ((1 + ( Interest rate\
		 + Additional interest rate for loan ) ) ^ Wall Lifetime ))) / ( Interest rate + Additional interest rate for loan\
		 ) , 5 )
	~	
	~		|

Annual inventive renovation VeryLow[District,Type]=
	IF THEN ELSE( Time < 2017 , 
	
	VeryLow to Performance sq m[District,Type,High] * Incentive CECE +
	VeryLow to Performance sq m[District,Type,VeryHigh] * Incentive Minergie , 
	
	VeryLow to Performance sq m[District,Type,Moderate] * Incentive Base +
	VeryLow to Performance sq m[District,Type,High] * Incentive CECE +
	VeryLow to Performance sq m[District,Type,VeryHigh] * Incentive Minergie )
	~	
	~		|

Wall specific cost Base=
	246 * Renovation cost index
	~	CHF/m2
	~		|

Roof specific cost CECE High=
	361 * Renovation cost index
	~	CHF/m2
	~		|

Ground cost Moderate[District,Type]=
	( Ground specific cost CECE Low - Incentive Base ) * Ground size by Type and District\
		[District,Type]
	~	
	~		|

Ground specific cost CECE High=
	161 * Renovation cost index
	~	CHF/m2
	~		|

Adoptions HP from OS=
	SUM(Adoptions HS from OS by archetype[District!,HPs!,Performance!,Type!,PVpanel!])
	~	
	~		|

Adoptions HS from OS by archetype[District,HS,Performance,Type,PVpanel]=
	IF THEN ELSE( Time < 2016 , 
	
	SUM(Consumers leaving HS for old age[District,ElectricHeater,Performance,Type,PVpanel\
		,Battery!]) * Market Share HS filtered[District,HS,Performance,Type,PVpanel] , 
	
	IF THEN ELSE( Time < 2021 , 
	
	( SUM(Consumers leaving HS for old age[District,ElectricHeater,Performance,Type,PVpanel\
		,Battery!]) + SUM(Consumers leaving HS for old age[District,Oil,Performance,Type,PVpanel\
		,Battery!]) ) * Market Share HS filtered[District,HS,Performance,Type,PVpanel] , 
	
	SUM(Consumers leaving HS for old age[District,OldS!,Performance,Type,PVpanel,Battery\
		!]) * Market Share HS filtered[District,HS,Performance,Type,PVpanel] ) )
	~	
	~		|

Annual incentives Heating Technologies=
	SUM(Incentive per Tech[Tech!])
	~	Mio CHF
	~		|

Incentive per Tech[Tech]=
	SUM(Incentive per Tech by archetype[District!,Tech,Performance!,Type!]) / 1e+06
	~	Mio CHF
	~		|

Incentive per Tech by archetype[District,OilBoiler,Performance,Type]=
	0 ~~|
Incentive per Tech by archetype[District,GasBoiler,Performance,Type]=
	0 ~~|
Incentive per Tech by archetype[District,WoodBoiler,Performance,Type]=
	SUM(Adoptions HS from OS by archetype[District,WoodST,Performance,Type,PVpanel!]) * \
		Grant PelletBoiler WoodST[District,Performance,Type] ~~|
Incentive per Tech by archetype[District,PelletBoiler,Performance,Type]=
	SUM(Adoptions HS from OS by archetype[District,pellet,Performance,Type,PVpanel!]) * \
		Grant PelletBoiler Pellet[Performance,District,Type] ~~|
Incentive per Tech by archetype[District,HP,Performance,Type]=
	SUM(Adoptions HS from OS by archetype[District,HPST,Performance,Type,PVpanel!]) * Grant HP HPST\
		[District,Performance,Type] +
	SUM(Adoptions HS from OS by archetype[District,HeatPump,Performance,Type,PVpanel!]) \
		* Grant HP HeatPump[Performance,District,Type] ~~|
Incentive per Tech by archetype[District,EH,Performance,Type]=
	0 ~~|
Incentive per Tech by archetype[District,ST,Performance,Type]=
	SUM(Adoptions HS from OS by archetype[District,STyes!,Performance,Type,PVpanel!]) * \
		Grant ST[Performance,District,Type]
	~	
	~		|

VeryLow to Performance sq m[District,Type,Performance]=
	VeryLow changing Roof[District,Type] * Roof VeryLow probabilities[District,Type,Performance\
		] * Roof size by Type and District[District,Type] + 
	VeryLow changing Wall[District,Type] * Wall VeryLow probabilities[District,Type,Performance\
		] * Wall size by Type and District[District,Type] +
	VeryLow changing Ground[District,Type] * Ground VeryLow probabilities[District,Type,\
		Performance] * Ground size by Type and District[District,Type]
	~	
	~		|

Buildings by Type District Performance[District,Performance,Type]=
	SUM(Heating Solution[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Annual variable costs HS by archetype[District,OilST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler]  - 
	
	Annual mantainance costs HS[OilST,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,GasST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler]  - 
	
	Annual mantainance costs HS[GasST,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,pellet,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District\
		,PelletBoiler] - 
	
	Annual mantainance costs HS[pellet,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,HeatPump,Performance,Type,PVyes]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * Carrier used cost per kWh[District,HP] * (1 \
		- Self sufficiency degree[District,HeatPump,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * PV cumulative compensation price * Self sufficiency degree\
		[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,WoodST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler]  - 
	
	Annual mantainance costs HS[WoodST,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,HPST,Performance,Type,PVyes]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST]  - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		 - ST share of total heat production) ) / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HPST,Performance,Type]) - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		 - ST share of total heat production)) / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type]) ~~|
Annual variable costs HS by archetype[District,HeatPump,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * Carrier used cost per kWh[District,HP] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,HPST,Performance,Type,PVno]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP]  - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,Oil,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler\
		] - 
	
	Annual mantainance costs HS[Oil,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,Gas,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler\
		] - 
	
	Annual mantainance costs HS[Gas,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,Wood,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler\
		] - 
	
	Annual mantainance costs HS[Wood,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,ElectricHeater,Performance,Type,PVyes]\
		=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Carrier used cost per kWh[District,EH] * (1 \
		- Self sufficiency degree[District,ElectricHeater,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * PV cumulative compensation price * Self sufficiency degree\
		[District,ElectricHeater,Performance,Type] - 
	
	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,ElectricHeater,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Carrier used cost per kWh[District,EH] - 
	
	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) ~~|
Annual variable costs HS by archetype[District,DH,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type])\
		 / 1 * Carrier used cost per kWh[District,WoodBoiler] - 
	
	Annual mantainance costs HS[DH,District,Performance,Type] )
	~	CHF
	~		|

Annual HS Var cost=
	SUM(Annual Var cost by Type and HS[HS!,Type!])
	~	Mio CHF
	~		|

Average heat demand=
	SUM(Demand by Type District Performance[District!,Performance!,Type!]) / SUM(Buildings by Type District Performance\
		[District!,Performance!,Type!])
	~	
	~		|

Annual SH Var cost by Type and HS[HS,Type]=
	SUM(Annual SH variable cost HS[District!,HS,Performance!,Type,PVpanel!]) / 1e+06
	~	Mio CHF
	~		|

Annual SH variable cost HS[District,HS,Performance,Type,PVpanel]=
	- Annual SH variable costs HS by archetype[District,HS,Performance,Type,PVpanel] * SUM\
		(Heating Solution[District,HS,Performance,Type,PVpanel,Battery!]) * Share primary houses\
		[District]
	~	
	~		|

Building area by Performance[Performance]=
	SUM(Building area by archetype[District!,Type!,Performance]) / 1e+06
	~	Mio m2
	~		|

Annual SH variable costs HS by archetype[District,OilST,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual SH variable costs HS by archetype[District,GasST,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual SH variable costs HS by archetype[District,pellet,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[PelletBoiler] * Carrier used cost per kWh\
		[District,PelletBoiler] ~~|
Annual SH variable costs HS by archetype[District,HeatPump,Performance,Type,PVyes]=
	( - Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HeatPump,Performance,Type]) -\
		 
	
	Annual SH demand[District,Performance,Type] / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] ) ~~|
Annual SH variable costs HS by archetype[District,WoodST,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler] ~~|
Annual SH variable costs HS by archetype[District,HPST,Performance,Type,PVyes]=
	- Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HPST,Performance,Type]) - 
	
	Annual SH demand[District,Performance,Type] / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] ~~|
Annual SH variable costs HS by archetype[District,HeatPump,Performance,Type,PVno]=
	- Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual SH variable costs HS by archetype[District,HPST,Performance,Type,PVno]=
	- Annual SH demand[District,Performance,Type] / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual SH variable costs HS by archetype[District,Oil,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual SH variable costs HS by archetype[District,Gas,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual SH variable costs HS by archetype[District,Wood,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler] ~~|
Annual SH variable costs HS by archetype[District,ElectricHeater,Performance,Type,PVyes\
		]=
	- Annual SH demand[District,Performance,Type] / Efficiency[EH] * Carrier used cost per kWh\
		[District,EH] * (1 - Self sufficiency degree[District,ElectricHeater,Performance,Type\
		]) - 
	
	Annual SH demand[District,Performance,Type] / Efficiency[EH] * PV cumulative compensation price\
		 * Self sufficiency degree[District,ElectricHeater,Performance,Type] ~~|
Annual SH variable costs HS by archetype[District,ElectricHeater,Performance,Type,PVno\
		]=
	- Annual SH demand[District,Performance,Type] / Efficiency[EH] * Carrier used cost per kWh\
		[District,EH] ~~|
Annual SH variable costs HS by archetype[District,DH,Performance,Type,PVpanel]=
	- Annual SH demand[District,Performance,Type] / 1 * Carrier used cost per kWh[District\
		,WoodBoiler]
	~	CHF
	~		|

Annual heat demand[District,Performance,Type]=
	Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient
	~	
	~		|

Annual Inv cost HS by archetype[District,HS,Performance,Type]=
	Investment cost HS[District,HS,Performance,Type] * Adoption HS by Archetype[District\
		,HS,Performance,Type]
	~	
	~		|

Adoption HS by Archetype[District,HS,Performance,Type]=
	SUM(Buildings adopting HS[District,HS,Performance,Type,PVpanel!,Battery!]) - SUM(Buildings HS Renovation To\
		[District,HS,Performance,Type,PVpanel!,Battery!]) - SUM(Consumers adopting PV yes[District\
		,HS,Performance,Type,PVpanel!])
	~	
	~		|

Annual Var cost by Type and HS[HS,Type]=
	SUM(Annual variable cost HS[District!,HS,Performance!,Type,PVpanel!]) / 1e+06
	~	Mio CHF
	~		|

Annual SH Var cost=
	SUM(Annual SH Var cost by Type and HS[HS!,Type!])
	~	Mio CHF
	~		|

Demand by Type District Performance[District,Performance,Type]=
