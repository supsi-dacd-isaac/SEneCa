Wall Low exp[District,Type,Performance] :EXCEPT:   [District,Type,VeryLow]=
	exp(Wall Low scaled[District,Type,Performance]) ~~|
Wall Low exp[District,Type,VeryLow]=
	0
	~	
	~		|

Retrofit High SFH Log Likelihood[PerformanceHigh] :EXCEPT:   [Moderate]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit High SFH Data[PerformanceHigh] * LN( High to Performance SFH MS[PerformanceHigh\
		] ) , 0 ) ~~|
Retrofit High SFH Log Likelihood[PerformanceLow]=
	0 ~~|
Retrofit High SFH Log Likelihood[Moderate]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) + 
		Retrofit Low SFH Data[High] * LN( Low to High SFH MS ) + 
		Retrofit Low SFH Data[VeryHigh] * LN( Low to VeryHigh SFH MS ) , 0 ) )
	|

Ground Low exp[District,Type,Performance] :EXCEPT:   [District,Type,VeryLow]=
	exp(Ground Low scaled[District,Type,Performance]) ~~|
Ground Low exp[District,Type,VeryLow]=
	0
	~	
	~		|

Retrofit High MFH Log Likelihood[PerformanceHigh] :EXCEPT:   [Moderate]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit High MFH Data[PerformanceHigh] * LN( High to Performance MFH MS[PerformanceHigh\
		] ) , 0 ) ~~|
Retrofit High MFH Log Likelihood[PerformanceLow]=
	0 ~~|
Retrofit High MFH Log Likelihood[Moderate]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) + 
		Retrofit Low MFH Data[High] * LN( Low to High MFH MS ) + 
		Retrofit Low MFH Data[VeryHigh] * LN( Low to VeryHigh MFH MS ) , 0 ) )
	|

PV investment cost[District,Type]=
	PV initial investment cost[District,Type] * PV cumulative cost change * PV uncertain cost factor
	~	CHF
	~		|

Interest rate=
	0.02 * Interest rate uncertainty factor
	~	Dmnl
	~		|

PV investment cost RCPv[District,Type]=
	PV initial investment cost RCPv[District,Type] * PV cumulative cost change * PV uncertain cost factor
	~	CHF
	~		|

Retrofit Moderate SFH Log Likelihood[Performance] :EXCEPT:  [PerformanceLow]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit Moderate SFH Data[Performance] * LN( Moderate to Performance SFH MS[Performance\
		] ) , 0 ) ~~|
Retrofit Moderate SFH Log Likelihood[PerformanceLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) + 
		Retrofit Low SFH Data[High] * LN( Low to High SFH MS ) + 
		Retrofit Low SFH Data[VeryHigh] * LN( Low to VeryHigh SFH MS ) , 0 ) )
	|

Retrofit Moderate MFH Log Likelihood[Performance] :EXCEPT:  [PerformanceLow]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit Moderate MFH Data[Performance] * LN( Moderate to Performance MFH MS[Performance\
		] ) , 0 ) ~~|
Retrofit Moderate MFH Log Likelihood[PerformanceLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) + 
		Retrofit Low MFH Data[High] * LN( Low to High MFH MS ) + 
		Retrofit Low MFH Data[VeryHigh] * LN( Low to VeryHigh MFH MS ) , 0 ) )
	|

Battery capacity[District,HS,Performance,Type]=
	MIN( Battery capacity 1[District,Type] , Battery capacity 2[District,HS,Performance,\
		Type] )
	~	
	~		|

Battery capacity 1[District,Type]=
	kWp installed per building[District,Type] * 1.5
	~	kWh
	~		|

Battery capacity 1 RCPv[District,Performance,Type]=
	kWp installed per building RCPv[District,Type] * 1.5
	~	kWh
	~		|

PV total savings Renter[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2013 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + 
	PV annual generation per building[District,Type] * "PV FiT < 10 kW"  ) * (1 - ( 1 / \
		( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate , 
	
	(  - PV annual mantainance cost * PV annual generation per building[District,Type] +\
		 
	PV annual generation per building[District,Type] * "PV FiT 10 - 30 kW" ) * (1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ) , 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	( - PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * PV cumulative compensation price \
		) * ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate , 
	
	( - PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * "PV FiT 10 - 30 kW") * (1 - ( 1 /\
		 ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ), 
	
	( - PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * PV cumulative compensation price \
		) * ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate ) )
	~	CHF
	~		|

RCP Eco Utility Renter[District,HS,Performance,Type]=
	( ( RCP total savings Renter[District,HS,Performance,Type] - Initial Investment PV Renter\
		[District,Type] ) / Initial Investment PV Renter[District,Type] / PV lifetime ) * 100
	~	kCHF
	~		|

RCPv Eco Utility Owners[District,HS,Performance,Type]=
	( ( RCPv total savings Owner[District,HS,Performance,Type] - Initial Investment RCPv Owner\
		[District,Type] ) / Initial Investment RCPv Owner[District,Type] / PV lifetime ) * \
		100
	~	kCHF
	~		|

RCPv Eco Utility Renter[District,HS,Performance,Type]=
	( ( RCPv total savings Renter[District,HS,Performance,Type] - Initial Investment RCPv Renter\
		[District,Type] ) / Initial Investment RCPv Renter[District,Type] / PV lifetime ) *\
		 100
	~	kCHF
	~		|

RCPv total savings Owner[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 0 , 
	
	( PV annual generation per building RCPv[District,Type] * Self consumption degree RCPv\
		[District,HS,Performance,Type] * Electricity price[District] +
	PV annual generation per building RCPv[District,Type] * Self consumption degree RCPv\
		[District,HS,Performance,Type] * 1.6 * Electricity price[District] * 0.8 -
	PV annual mantainance cost * PV annual generation per building RCPv[District,Type] +\
		 
	PV annual generation per building RCPv[District,Type] * ( 1 - Self consumption degree RCPv\
		[District,HS,Performance,Type] * ( 1 + 0.8 * Buildings PVno connected to RCPv ) ) *\
		 PV cumulative compensation price ) / Dwellings per building[District,Type] ) * 
	
	(1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	
	~		|

Initial Investment PV Renter[District,Type]=
	IF THEN ELSE( Time < 2013 , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) , 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) ), 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) ) )
	~	CHF
	~	IF THEN ELSE( Time < 2015, 
		
		IF THEN ELSE( kWp installed per \
		building[District,HeatingSolution,ResPerformance,ResType] < 10, 
		
		(PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] - \
		PV cantonal subsidy[District,HeatingSolution,ResPerformance,ResType] - PV \
		federal subsidy check[District,HeatingSolution,ResPerformance,ResType]) * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] , 
		
		PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] ) , 
		
		(PV total initial investment \
		cost[District,HeatingSolution,ResPerformance,ResType] - PV cantonal \
		subsidy[District,HeatingSolution,ResPerformance,ResType] - PV federal \
		subsidy check[District,HeatingSolution,ResPerformance,ResType]) * (1 - Tax \
		deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] )
	|

Initial Investment RCPv Owner[District,Type]=
	(PV investment cost RCPv[District,Type] - PV federal subsidy check RCPv[District,Type\
		] - RCPv cantonal subsidy[District,Type] ) * (1 - Tax deduction investment) / Dwellings per building\
		[District,Type]
	~	CHF
	~		|

Initial Investment RCPv Renter[District,Type]=
	(PV investment cost RCPv[District,Type] - PV federal subsidy check RCPv[District,Type\
		] - RCPv cantonal subsidy[District,Type] ) * (1 - Tax deduction investment)
	~	CHF
	~		|

Self sufficiency degree[District,HS,Performance,Type]=
	kWp installed per building[District,Type] * PV annual generation per kW * Self consumption degree\
		[District,HS,Performance,Type] / El consumption per building[District,HS,Performance\
		,Type]
	~	
	~		|

Self sufficiency degree RCPv[District,HS,Performance,Type]=
	PV annual generation per building RCPv[District,Type] * Self consumption degree RCPv\
		[District,HS,Performance,Type] / El consumption per building[District,HS,Performance\
		,Type]
	~	
	~		|

kWp over MWh of demand[District,HS,Performance,Type]=
	kWp installed per building[District,Type] / El consumption per building[District,HS,\
		Performance,Type] * 1000
	~	kW/MWh
	~		|

kWp over MWh of demand RCPv[District,HS,Performance,Type]=
	kWp installed per building RCPv[District,Type] / El consumption per building[District\
		,HS,Performance,Type] * 1000
	~	kW/MWh
	~		|

PV federal subsidy check RCPv[District,Type]=
	PV rebate federal * PV investment cost RCPv[District,Type]
	~	
	~		|

Power PV by Type[Type]= INTEG (
	SUM(Power PV by Type flow[District!,HS!,Performance!,Type]) / 1000,
		SUM(Initial Heating Solution[District!,HS!,Performance!,Type,PVyes]) * SUM(kWp installed per building\
		[District!,Type]) / ( 8 * 5 ) / 1000)
	~	
	~		|

Power PV by Type flow[District,HS,Performance,Type]=
	( Owners adopting PV[District,HS,Performance,Type] + Renters adopting PV[District,HS\
		,Performance,Type] ) * kWp installed per building[District,Type]
	~	
	~		|

Power RCP by Type flow[District,HS,Performance,Type]=
	( Owners adopting RCP[District,HS,Performance,Type] + Renters adopting RCP[District,\
		HS,Performance,Type] ) * kWp installed per building[District,Type]
	~	
	~		|

Power RCPv by Type flow[District,HS,Performance,Type]=
	( Owners adopting RCPv[District,HS,Performance,Type] + Renters adopting RCPv[District\
		,HS,Performance,Type] ) * kWp installed per building RCPv[District,Type]
	~	
	~		|

PV annual generation per building RCPv[District,Type]=
	kWp installed per building RCPv[District,Type] * PV annual generation per kW
	~	kWh/year
	~		|

PV Eco Utility Renter[District,HS,Performance,Type]=
	( ( PV total savings Renter[District,HS,Performance,Type] - Initial Investment PV Renter\
		[District,Type] ) / Initial Investment PV Renter[District,Type] / PV lifetime ) * 100
	~	kCHF
	~		|

PV initial investment cost RCPv[District,Type]=
	IF THEN ELSE( kWp installed per building RCPv[District,Type] < 10 , 
	"b param < 10 kW" + "a param < 10 kW" * kWp installed per building RCPv[District,Type\
		] , 
	"b param 10 - 30 kW" + "a param 10 - 30 kW" * kWp installed per building RCPv[District\
		,Type] )
	~	CHF
	~		|

RCPv total savings Renter[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 0 , 
	
	( PV annual generation per building RCPv[District,Type] * Self consumption degree RCPv\
		[District,HS,Performance,Type] * ( 1 + 0.8 * Buildings PVno connected to RCPv ) * Electricity price\
		[District] * 0.8 -
	PV annual mantainance cost * PV annual generation per building RCPv[District,Type] +\
		 
	PV annual generation per building RCPv[District,Type] * ( 1 - Self consumption degree RCPv\
		[District,HS,Performance,Type] * ( 1 + 0.8 * Buildings PVno connected to RCPv ) ) *\
		 PV cumulative compensation price ) ) * 
	
	(1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	CHF
	~		|

Technology SH installed capacity SH and DHW[District,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Equivalent hours SH and DHW
	~	kW
	~		|

ST installed capacity by arch[Performance,District,Type]=
	ST dimention by arch[District,Type]*ST capacity installed per square meter
	~	kW
	~		|

Self consumption degree[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand[District,HS,Performance,Type],
		       ([(0,0)-(10,10)],(0,1),(0.25,0.68),(0.5,0.48),(0.75,0.37),(1,0.3),(1.5,0.23)\
		,(1.75,0.205),(2.5,0.15),(4,0.08) ))
	~	Dmnl
	~		|

Daily hot water consumption per building by size and type[District,Type]=
	Occupants per dwelling by type[Type] * Dwellings per building[District,Type] * Daily hot water consumption per person
	~	l/day
	~		|

ST dimention by arch[District,Type]=
	Occupants per dwelling by type[Type] * Dwellings per building[District,Type] * sqauare meters of ST per person
	~	m2
	~		|

PV initial grant=
	IF THEN ELSE(Time < 2014, 0 , 
	IF THEN ELSE(Time < 2016, 1800, 
	IF THEN ELSE(Time < 2019, 1600, 
	IF THEN ELSE(Time < 2020, 1550, 
	IF THEN ELSE(Time < 2021, 1100, 
	IF THEN ELSE(Time < 2022, 770, 
	IF THEN ELSE(Time < 2030 , 385 , 385 )))))))
	~	CHF
	~		|

Equivalent hours just SH=
	1900
	~	hour/year
	~		|

Dwellings per building[District,SFH]=
	1 ~~|
Dwellings per building[District,DFH]=
	2 ~~|
Dwellings per building[District,MFH]=
	8.1,
	3.7,
	5.1,
	8.6,
	9.1,
	8,
	6.7,
	4.3
	~	dwelling
	~		|

ST share of total heat production=
	0.75
	~	Dmnl
	~		|

Type:
	SFH, DFH, MFH
	~	houses
	~		|

Equivalent hours SH and DHW=
	2200
	~	hour/year
	~		|

sqauare meters of ST per person=
	1
	~	m2/person
	~		|

Occupants per dwelling by type[Type]=
	2.7,
	2.7,
	2.1
	~	person/dwelling
	~		|

Daily hot water consumption per person=
	50
	~	l/(person*day)
	~		|

********************************************************
	.odis with pv
********************************************************~
	|

Ground High scaled[District,Type,PerformanceLow]=
	Ground High scaled[District,Type,High] ~~|
Ground High scaled[District,Type,PerformanceHigh] :EXCEPT:       [District,Type,Moderate\
		]=
	( Ground High[District,Type,PerformanceHigh] - ( VMAX(Ground High[District,Type,Performance\
		!]) - VMIN(Ground High[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff High[Type\
		,PerformanceHigh] ~~|
Ground High scaled[District,Type,Moderate]=
	Ground High scaled[District,Type,High]
	~	
	~		|

Roof High exp[District,Type,PerformanceHigh] :EXCEPT: [District,Type,Moderate]=
	exp(Roof High scaled[District,Type,PerformanceHigh]) ~~|
Roof High exp[District,Type,PerformanceLow]=
	0 ~~|
Roof High exp[District,Type,Moderate]=
	0
	~	
	~		|

Roof High scaled[District,Type,PerformanceLow]=
	Roof High scaled[District,Type,High] ~~|
Roof High scaled[District,Type,PerformanceHigh] :EXCEPT:     [District,Type,Moderate]\
		=
	( Roof High[District,Type,PerformanceHigh] - ( VMAX(Roof High[District,Type,Performance\
		!]) - VMIN(Roof High[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff High[Type\
		,PerformanceHigh] ~~|
Roof High scaled[District,Type,Moderate]=
	Roof High scaled[District,Type,High]
	~	
	~		|

Wall High exp[District,Type,PerformanceHigh] :EXCEPT: [District,Type,Moderate]=
	exp(Wall High scaled[District,Type,PerformanceHigh]) ~~|
Wall High exp[District,Type,PerformanceLow]=
	0 ~~|
Wall High exp[District,Type,Moderate]=
	0
	~	
	~		|

Ground High exp[District,Type,PerformanceHigh] :EXCEPT: [District,Type,Moderate]=
	exp(Ground High scaled[District,Type,PerformanceHigh]) ~~|
Ground High exp[District,Type,PerformanceLow]=
	0 ~~|
Ground High exp[District,Type,Moderate]=
	0
	~	
	~		|

Wall High scaled[District,Type,PerformanceLow]=
	Wall High scaled[District,Type,High] ~~|
Wall High scaled[District,Type,PerformanceHigh] :EXCEPT:       [District,Type,Moderate\
		]=
	( Wall High[District,Type,PerformanceHigh] - ( VMAX(Wall High[District,Type,Performance\
		!]) - VMIN(Wall High[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff High[Type\
		,PerformanceHigh] ~~|
Wall High scaled[District,Type,Moderate]=
	Wall High scaled[District,Type,High]
	~	
	~		|

Retrofit Low SFH Log Likelihood[Performance] :EXCEPT:   [VeryLow]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit Low SFH Data[Performance] * LN( Low to Performance SFH MS[Performance] ) , \
		0 ) ~~|
Retrofit Low SFH Log Likelihood[VeryLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low SFH Data[Low] * LN( Low to Low SFH MS ) + 
		Retrofit Low SFH Data[Moderate] * LN( Low to Moderate SFH MS ) + 
		Retrofit Low SFH Data[High] * LN( Low to High SFH MS ) + 
		Retrofit Low SFH Data[VeryHigh] * LN( Low to VeryHigh SFH MS ) , 0 ) )
	~	:SUPPLEMENTARY 
	|

Retrofit Low MFH Log Likelihood[Performance] :EXCEPT: [VeryLow]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit Low MFH Data[Performance] * LN( Low to Performance MFH MS[Performance] ) , \
		0 ) ~~|
Retrofit Low MFH Log Likelihood[VeryLow]=
	0
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit Low MFH Data[Low] * LN( Low to Low MFH MS ) + 
		Retrofit Low MFH Data[Moderate] * LN( Low to Moderate MFH MS ) + 
		Retrofit Low MFH Data[High] * LN( Low to High MFH MS ) + 
		Retrofit Low MFH Data[VeryHigh] * LN( Low to VeryHigh MFH MS ) , 0 ) )
	~	:SUPPLEMENTARY 
	|

Annual mantainance costs HS[Oil,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,530),(5,530),(10,530),(20,580),(70,770),(100,810),(200,1000) \
		)) ~~|
Annual mantainance costs HS[Gas,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,711),(5,711),(10,722),(20,744),(70,1094),(100,1200),(200,1700\
		) )) ~~|
Annual mantainance costs HS[ElectricHeater,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,530),(5,530),(10,530),(20,580),(70,770),(100,810),(200,1000) \
		)) ~~|
Annual mantainance costs HS[Wood,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,820),(5,820),(10,820),(20,820),(70,920),(100,920),(200,1220) \
		)) ~~|
Annual mantainance costs HS[OilST,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity just SH[District,Performance,Type],
		  ([(0,0)-(10,10)],(0,530),(5,530),(10,530),(20,580),(70,770),(100,810),(200,1000) \
		)) ~~|
Annual mantainance costs HS[GasST,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity just SH[District,Performance,Type],
		  ([(0,0)-(10,10)],(0,711),(5,711),(10,722),(20,744),(70,1094),(100,1200),(200,1700\
		) )) ~~|
Annual mantainance costs HS[WoodST,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity just SH[District,Performance,Type],
		  ([(0,0)-(10,10)],(0,820),(5,820),(10,820),(20,820),(70,920),(100,920),(200,1220) \
		)) ~~|
Annual mantainance costs HS[HPST,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity just SH[District,Performance,Type],
		 ([(0,0)-(10,10)],(0,490),(5,490),(10,490),(20,550),(70,685),(100,1250),(200,2250) \
		)) ~~|
Annual mantainance costs HS[HeatPump,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		 ([(0,0)-(10,10)],(0,490),(5,490),(10,490),(20,550),(70,685),(100,1250),(200,2250) \
		)) ~~|
Annual mantainance costs HS[pellet,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		  ([(0,0)-(10,10)],(0,660),(5,660),(10,660),(20,660),(70,790),(100,830),(200,1220) \
		)) ~~|
Annual mantainance costs HS[DH,District,Performance,Type]= WITH LOOKUP (
	Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type],
		   ([(0,0)-(10,10)],(0,250),(5,250),(10,250),(20,250),(70,250),(100,250),(200,250) \
		))
	~	CHF
	~		|

Annual cost Cantonal Levy by arch[District,HS,Performance,Type,PVno,Battery]=
	MAX( 0 , 
	
	( Heating Solution[District,HS,Performance,Type,PVno,Battery] * El consumption per building\
		[District,HS,Performance,Type] * Cantonal Levy Evolution -
	
	Heating Solution[District,HS,Performance,Type,PVno,Battery] * ( Owned buildings with RCPv PVno\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVno,Battery!]) * 
	PV annual generation per building RCPv[District,Type] * 0.8 * Self consumption degree RCPv\
		[District,HS,Performance,Type] * Cantonal Levy Evolution ) * Share primary houses[District\
		] ) ~~|
Annual cost Cantonal Levy by arch[District,HS,Performance,Type,PVyes,Byes]=
	MAX( 0 , 
	
	IF THEN ELSE( Time < 2015 , 
	
	Heating Solution[District,HS,Performance,Type,PVyes,Byes] * El consumption per building\
		[District,HS,Performance,Type] ,
	
	( Heating Solution[District,HS,Performance,Type,PVyes,Byes] - Buildings RCPv by archetype\
		[District,HS,Performance,Type,Byes] ) * ( El consumption per building[District,HS,Performance\
		,Type] - PV annual generation per building[District,Type] * Self consumption degree with Storage\
		[District,HS,Performance,Type] ) + 
	Buildings RCPv by archetype[District,HS,Performance,Type,Byes] * ( El consumption per building\
		[District,HS,Performance,Type] - PV annual generation per building RCPv[District,Type\
		] * Self consumption degree with Storage RCPv[District,HS,Performance,Type] ) ) * Cantonal Levy Evolution\
		 * Share primary houses[District] ) ~~|
Annual cost Cantonal Levy by arch[District,HS,Performance,Type,PVyes,Bno]=
	MAX( 0 , 
	
	IF THEN ELSE( Time < 2015 , 
	
	Heating Solution[District,HS,Performance,Type,PVyes,Bno] * El consumption per building\
		[District,HS,Performance,Type] ,
	
	( Heating Solution[District,HS,Performance,Type,PVyes,Bno] - Buildings RCPv by archetype\
		[District,HS,Performance,Type,Bno] ) * ( El consumption per building[District,HS,Performance\
		,Type] - PV annual generation per building[District,Type] * Self consumption degree\
		[District,HS,Performance,Type] ) + 
	Buildings RCPv by archetype[District,HS,Performance,Type,Bno] * ( El consumption per building\
		[District,HS,Performance,Type] - PV annual generation per building RCPv[District,Type\
		] * Self consumption degree RCPv[District,HS,Performance,Type] ) ) * Cantonal Levy Evolution\
		 * Share primary houses[District] )
	~	
	~		|

Annual cost Federal Levy by arch[District,HS,Performance,Type,PVno,Battery]=
	MAX( 0 , 
	
	( Heating Solution[District,HS,Performance,Type,PVno,Battery] * El consumption per building\
		[District,HS,Performance,Type] * Levy Evolution -
	
	Heating Solution[District,HS,Performance,Type,PVno,Battery] * ( Owned buildings with RCPv PVno\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVno,Battery!]) * 
	PV annual generation per building RCPv[District,Type] * 0.8 * Self consumption degree RCPv\
		[District,HS,Performance,Type] * Levy Evolution ) * Share primary houses[District] \
		) ~~|
Annual cost Federal Levy by arch[District,HS,Performance,Type,PVyes,Byes]=
	MAX( 0 , 
	
	IF THEN ELSE( Time < 2015 , 
	
	Heating Solution[District,HS,Performance,Type,PVyes,Byes] * El consumption per building\
		[District,HS,Performance,Type] ,
	
	( Heating Solution[District,HS,Performance,Type,PVyes,Byes] - Buildings RCPv by archetype\
		[District,HS,Performance,Type,Byes] ) * ( El consumption per building[District,HS,Performance\
		,Type] - PV annual generation per building[District,Type] * Self consumption degree with Storage\
		[District,HS,Performance,Type] ) + 
	Buildings RCPv by archetype[District,HS,Performance,Type,Byes] * ( El consumption per building\
		[District,HS,Performance,Type] - PV annual generation per building RCPv[District,Type\
		] * Self consumption degree with Storage RCPv[District,HS,Performance,Type] ) ) * Levy Evolution\
		 * Share primary houses[District] ) ~~|
Annual cost Federal Levy by arch[District,HS,Performance,Type,PVyes,Bno]=
	MAX( 0 , 
	
	IF THEN ELSE( Time < 2015 , 
	
	Heating Solution[District,HS,Performance,Type,PVyes,Bno] * El consumption per building\
		[District,HS,Performance,Type] ,
	
	( Heating Solution[District,HS,Performance,Type,PVyes,Bno] - Buildings RCPv by archetype\
		[District,HS,Performance,Type,Bno] ) * ( El consumption per building[District,HS,Performance\
		,Type] - PV annual generation per building[District,Type] * Self consumption degree\
		[District,HS,Performance,Type] ) + 
	Buildings RCPv by archetype[District,HS,Performance,Type,Bno] * ( El consumption per building\
		[District,HS,Performance,Type] - PV annual generation per building RCPv[District,Type\
		] * Self consumption degree RCPv[District,HS,Performance,Type] ) ) * Levy Evolution\
		 * Share primary houses[District] )
	~	
	~		|

PV annual generation per building[District,Type]=
	kWp installed per building[District,Type] * PV annual generation per kW
	~	kWh/year
	~		|

RCP total savings Owner[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2018 , 0 , 
	
	( PV annual generation per building[District,Type] * Self consumption degree[District\
		,HS,Performance,Type] * Electricity price[District] -
	PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * ( 1 - Self consumption degree[District\
		,HS,Performance,Type] ) * PV cumulative compensation price ) / Dwellings per building\
		[District,Type] ) * 
	
	(1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	
	~		|

PV initial investment cost[District,Type]=
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	"b param < 10 kW" + "a param < 10 kW" * kWp installed per building[District,Type] , 
	"b param 10 - 30 kW" + "a param 10 - 30 kW" * kWp installed per building[District,Type\
		] )
	~	CHF
	~		|

RCP total savings Renter[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2018 , 0 , 
	
	( PV annual generation per building[District,Type] * Self consumption degree[District\
		,HS,Performance,Type] * Electricity price[District] * 0.8 -
	PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * ( 1 - Self consumption degree[District\
		,HS,Performance,Type] ) * PV cumulative compensation price ) ) * 
	
	(1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate
	~	CHF
	~		|

Annual light and appl demand by arch[Performance,District,Type]=
	Average electricity consumption by dwelling type[Type] * Efficiency increment factor\
		 * Dwellings per building[District,Type]
	~	kWh/year
	~		|

PV lifetime=
	30
	~	year
	~		|

PV Eco Owners factor[District,HS,Performance,Type]=
	PV Eco Utility Owners[District,HS,Performance,Type] * PV Eco weight
	~	Dmnl
	~		|

PV federal investment grant capacity=
	IF THEN ELSE(Time < 2014, 0, 
	IF THEN ELSE(Time < 2015, 1050, 
	IF THEN ELSE(Time < 2016, 830, 
	IF THEN ELSE(Time < 2017, 610, 
	IF THEN ELSE(Time < 2018, 520, 
	IF THEN ELSE(Time < 2019, 460, 
	IF THEN ELSE(Time < 2020, 380, 
	IF THEN ELSE(Time < 2021, 380, 
	IF THEN ELSE(Time < 2026, 420 , 
	IF THEN ELSE(Time < 2030, 420 , 420 ))))))))))
	~	CHF/kW
	~	IF THEN ELSE(Time < 2014.25, 0, 
		IF THEN ELSE(Time < 2015, 1050, 
		IF THEN ELSE(Time < 2016, 830, 
		IF THEN ELSE(Time < 2017, 610, 
		IF THEN ELSE(Time < 2018, 520, 
		IF THEN ELSE(Time < 2019, 460, 
		IF THEN ELSE(Time < 2020, 380, 
		IF THEN ELSE(Time < 2021, 380, 
		IF THEN ELSE(Time < 2022, 420 , 
		SMOOTH( IF THEN ELSE(Time < 2035, Sensitivity 1 , 0 ) , 1 ) )))))))))
	|

PV annual mantainance cost=
	IF THEN ELSE( Time < 2024, 3.87 - ( 3.87 - 2.38 ) / ( 2024 - 2011 ) * ( Time - 2011 \
		) , 2.38 ) * (1 - "Tax deduction O&M") / 100
	~	CHF/kWh
	~		|

