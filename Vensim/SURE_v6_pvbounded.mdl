	( Annual DHW demand by HS[HeatPump,Type] ) / Efficiency[HP]
	~	GWh
	~		|

Annual DHW demand Gas by Type[Type]=
	( Annual DHW demand by HS[Gas,Type] )
	~	GWh
	~		|

Annual DHW demand Oil by Type[Type]=
	( Annual DHW demand by HS[Oil,Type] )
	~	GWh
	~		|

Annual DHW demand Solar by Type[Type]=
	( Annual DHW demand by HS[OilST,Type] + Annual DHW demand by HS[GasST,Type] + Annual DHW demand by HS\
		[WoodST,Type] + Annual DHW demand by HS[HPST,Type] )
	~	GWh
	~		|

Annual DHW demand Wood by Type[Type]=
	( Annual DHW demand by HS[Wood,Type] )
	~	GWh
	~		|

Annual consumption Gas=
	Annual SH consumption Gas + Annual DHW consumption Gas
	~	GWh
	~		|

Annual consumption Oil=
	Annual SH consumption Oil + Annual DHW consumption Oil
	~	GWh
	~		|

Annual consumption Wood=
	Annual SH consumption Wood + Annual DHW consumption Wood
	~	GWh
	~		|

Annual DHW consumption Electricity HP=
	SUM(Annual DHW consumption Electricity HP by Type[Type!])
	~	GWh
	~		|

Annual DHW consumption Gas=
	SUM(Annual DHW consumption Gas by Type[Type!])
	~	GWh
	~		|

Annual DHW consumption Oil=
	SUM(Annual DHW consumption Oil by Type[Type!])
	~	GWh
	~		|

Annual DHW consumption Electricity EH=
	SUM(Annual DHW consumption Electricity EH by Type[Type!])
	~	GWh
	~		|

Annual consumption Electricity EH=
	Annual SH consumption Electricity EH + Annual DHW consumption Electricity EH
	~	GWh
	~		|

Annual consumption Electricity HP=
	Annual SH consumption Electricity HP + Annual DHW consumption Electricity HP
	~	GWh
	~		|

Annual consumption Ambient Heat=
