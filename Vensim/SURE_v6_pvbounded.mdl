		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,HPST,Performance,Type,PVpanel] ~~|
Adoptions HPST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Roof specific cost CECE Low=
	336 * Renovation cost index * Retrofit uncertain cost factor
	~	CHF/m2
	~		|

Adoption HS delay[HS]=
	DELAY FIXED( Adoption HS[HS] , 4 , HS VeryNew[HS] * Aging Rate[HS] )
	~	
	~		|

"PV 30 - 100 kW investment cost Time adj"=
	"PV 30 - 100 kW investment cost" * PV cumulative cost change * PV uncertain cost factor
	~	CHF
	~		|

Adoptions Pellet from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:     \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,pellet,Performance,Type,PVpanel] ~~|
Adoptions Pellet from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Construction rate uncertainty=
	0
	~	
	~		|

Construction rate uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Construction rate uncertainty )
	~	
	~		|

Investment cost HS noST adj[Oil,District,Performance,Type]=
	Investment cost HS noST[Oil,District,Performance,Type] * HT cumulative cost change[OilBoiler\
		] ~~|
Investment cost HS noST adj[Gas,District,Performance,Type]=
	Investment cost HS noST[Gas,District,Performance,Type] * HT cumulative cost change[GasBoiler\
		] ~~|
Investment cost HS noST adj[ElectricHeater,District,Performance,Type]=
	Investment cost HS noST[ElectricHeater,District,Performance,Type] * HT cumulative cost change\
		[EH] ~~|
Investment cost HS noST adj[Wood,District,Performance,Type]=
	Investment cost HS noST[Wood,District,Performance,Type] * HT cumulative cost change[\
		WoodBoiler] ~~|
Investment cost HS noST adj[OilST,District,Performance,Type]=
	Investment cost HS noST[OilST,District,Performance,Type] * HT cumulative cost change\
		[OilBoiler] ~~|
Investment cost HS noST adj[GasST,District,Performance,Type]=
	Investment cost HS noST[GasST,District,Performance,Type] * HT cumulative cost change\
		[GasBoiler] ~~|
Investment cost HS noST adj[WoodST,District,Performance,Type]=
	Investment cost HS noST[WoodST,District,Performance,Type] * HT cumulative cost change\
		[WoodBoiler] ~~|
Investment cost HS noST adj[HPST,District,Performance,Type]=
	Investment cost HS noST[HPST,District,Performance,Type] * HT cumulative cost change[\
		HP] * HP cost uncertainty factor ~~|
Investment cost HS noST adj[HeatPump,District,Performance,Type]=
	Investment cost HS noST[HeatPump,District,Performance,Type] * HT cumulative cost change\
		[HP] * HP cost uncertainty factor ~~|
Investment cost HS noST adj[pellet,District,Performance,Type]=
