	High changing Roof[District,Type] * Roof High probabilities[District,Type,Performance\
		] + 
	High changing Wall[District,Type] * Wall High probabilities[District,Type,Performance\
		] +
	High changing Ground[District,Type] * Ground High probabilities[District,Type,Performance\
		]
	~	
	~		|

Moderate changing Ground[District,Type]=
	Res Moderate Buildings[District,Type] / Ground Lifetime
	~	
	~		|

Moderate changing Roof[District,Type]=
	Res Moderate Buildings[District,Type] / Roof Lifetime
	~	
	~		|

Moderate changing Wall[District,Type]=
	Res Moderate Buildings[District,Type] / Wall Lifetime
	~	
	~		|

Moderate to Performance[District,Type,Performance]=
	Moderate changing Roof[District,Type] * Roof Moderate probabilities[District,Type,Performance\
		] + 
	Moderate changing Wall[District,Type] * Wall Moderate probabilities[District,Type,Performance\
		] +
	Moderate changing Ground[District,Type] * Ground Moderate probabilities[District,Type\
		,Performance]
	~	
	~		|

Wall VeryLow[District,Type,VeryLow]=
	- Wall cost[District,Type] ~~|
Wall VeryLow[District,Type,Low]=
	( - Wall cost Low[District,Type] - Total present variable costs SH average Wall[District\
		,Low,Type] + Total present variable costs SH average Wall[District,VeryLow,Type] ) ~~|
Wall VeryLow[District,Type,Moderate]=
	( - Wall cost Moderate[District,Type] - Total present variable costs SH average Wall\
		[District,Moderate,Type] + Total present variable costs SH average Wall[District,VeryLow\
		,Type] ) ~~|
Wall VeryLow[District,Type,High]=
	( - Wall cost High[District,Type] - Total present variable costs SH average Wall[District\
		,High,Type] + Total present variable costs SH average Wall[District,VeryLow,Type] )\
		 ~~|
Wall VeryLow[District,Type,VeryHigh]=
	( - Wall cost VeryHigh[District,Type] - Total present variable costs SH average Wall\
		[District,VeryHigh,Type] + Total present variable costs SH average Wall[District,VeryLow\
		,Type] )
	~	
	~		|

Retrofit VeryLow MFH Log Likelihood[Performance]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit VeryLow MFH Data[Performance] * LN( VeryLow to Performance MFH MS[Performance\
		] ) , 0 )
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit VeryLow MFH Data[VeryLow] * LN( VeryLow to VeryLow MFH MS ) + 
		Retrofit VeryLow MFH Data[Low] * LN( VeryLow to Low MFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit VeryLow MFH Data[VeryLow] * LN( VeryLow to VeryLow MFH MS ) + 
		Retrofit VeryLow MFH Data[Low] * LN( VeryLow to Low MFH MS ) + 
		Retrofit VeryLow MFH Data[Moderate] * LN( VeryLow to Moderate MFH MS ) + 
		Retrofit VeryLow MFH Data[High] * LN( VeryLow to High MFH MS ) + 
		Retrofit VeryLow MFH Data[VeryHigh] * LN( VeryLow to VeryHigh MFH MS ) , 0 \
		) )
	~	:SUPPLEMENTARY 
	|

Wall VeryLow probabilities[District,Type,Performance]=
	Wall VeryLow exp[District,Type,Performance] / SUM(Wall VeryLow exp[District,Type,Performance\
		!])
	~	
	~		|

Retrofit VeryLow SFH Log Likelihood[Performance]=
	IF THEN ELSE( Time < 2025 , 
	
	Retrofit VeryLow SFH Data[Performance] * LN( VeryLow to Performance SFH MS[Performance\
		] ) , 0 )
	~	
	~	IF THEN ELSE( Time < 2020 , 
		
		Retrofit VeryLow SFH Data[VeryLow] * LN( VeryLow to VeryLow SFH MS ) + 
		Retrofit VeryLow SFH Data[Low] * LN( VeryLow to Low SFH MS ) , 
		
		IF THEN ELSE( Time < 2024 , 
		
		Retrofit VeryLow SFH Data[VeryLow] * LN( VeryLow to VeryLow SFH MS ) + 
		Retrofit VeryLow SFH Data[Low] * LN( VeryLow to Low SFH MS ) + 
		Retrofit VeryLow SFH Data[Moderate] * LN( VeryLow to Moderate SFH MS ) + 
		Retrofit VeryLow SFH Data[High] * LN( VeryLow to High SFH MS ) + 
		Retrofit VeryLow SFH Data[VeryHigh] * LN( VeryLow to VeryHigh SFH MS ) , 0 \
		) )
	~	:SUPPLEMENTARY 
	|

Wall VeryLow scaled[District,Type,Performance]=
	( Wall VeryLow[District,Type,Performance] - ( VMAX(Wall VeryLow[District,Type,Performance\
		!]) - VMIN(Wall VeryLow[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff VeryLow\
		[Type,Performance]
	~	
	~		|

Ground cost[District,Type]=
	Ground specific cost * Ground size by Type and District[District,Type]
	~	
	~		|

HT cumulative cost change[OilBoiler]=
	1 ~~|
HT cumulative cost change[GasBoiler]=
	1 ~~|
HT cumulative cost change[WoodBoiler]=
	1 ~~|
HT cumulative cost change[PelletBoiler]=
	1 ~~|
HT cumulative cost change[HP]=
	IF THEN ELSE( Time < 2020 , 1.08 - 0.08 * (Time - 2011) / (2020 - 2011) , 
	IF THEN ELSE( Time < 2030 , 1 - 0.08 * (Time - 2020) / (2030 - 2020) , 0.92 - 0.08 *\
		 (Time - 2030) / (2050 - 2030) ) ) ~~|
HT cumulative cost change[EH]=
	1 ~~|
HT cumulative cost change[ST]=
	1
	~	
	~		|

Roof Low[District,Type,VeryLow]=
	- Roof cost Low[District,Type] ~~|
Roof Low[District,Type,Low]=
	- Roof cost Low[District,Type] ~~|
Roof Low[District,Type,Moderate]=
	- Roof cost Moderate[District,Type] - Total present variable costs SH average[District\
		,Moderate,Type] + Total present variable costs SH average[District,Low,Type] ~~|
Roof Low[District,Type,High]=
	- Roof cost High[District,Type] - Total present variable costs SH average[District,High\
		,Type] + Total present variable costs SH average[District,Low,Type] ~~|
Roof Low[District,Type,VeryHigh]=
	- Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,Low,Type]
	~	
	~		|

Roof Low scaled[District,Type,Performance]=
	( Roof Low[District,Type,Performance] - ( VMAX(Roof Low[District,Type,Performance!])\
		 - VMIN(Roof Low[District,Type,Performance!]) ) / 2 ) / 10000 + Coeff Low[Type,Performance\
		]
	~	
	~		|

Roof Moderate[District,Type,VeryLow]=
	- Roof cost Moderate[District,Type] ~~|
Roof Moderate[District,Type,Low]=
	- Roof cost Moderate[District,Type] ~~|
Roof Moderate[District,Type,Moderate]=
	- Roof cost Moderate[District,Type] ~~|
Roof Moderate[District,Type,High]=
	- Roof cost High[District,Type] - Total present variable costs SH average[District,High\
		,Type] + Total present variable costs SH average[District,Moderate,Type] ~~|
Roof Moderate[District,Type,VeryHigh]=
	- Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,Moderate,Type]
	~	
	~		|

Grid HS Factor[HS]=
	Grid HS weight * Dummy Grid HS[HS]
	~	
	~		|

Grid HS weight=
	-1.07405
	~	
	~		|

Roof Moderate scaled[District,Type,PerformanceLow]=
	Roof Moderate scaled[District,Type,Moderate] ~~|
Roof Moderate scaled[District,Type,PerformanceHigh]=
	( Roof Moderate[District,Type,PerformanceHigh] - ( VMAX(Roof Moderate[District,Type,\
		Performance!]) - VMIN(Roof Moderate[District,Type,Performance!]) ) / 2 ) / 10000 + \
		Coeff Moderate[Type,PerformanceHigh]
	~	
	~		|

GridHS:
	Gas, ElectricHeater, GasST, HPST, HeatPump, DH
	~	
	~		|

GridNoHS:
	Oil, Wood, OilST, WoodST, pellet
	~	
	~		|

Wall Moderate exp[District,Type,PerformanceHigh]=
	exp(Wall Moderate scaled[District,Type,PerformanceHigh]) ~~|
Wall Moderate exp[District,Type,PerformanceLow]=
	0
	~	
	~		|

High changing Ground[District,Type]=
	Res High Buildings[District,Type] / Ground Lifetime
	~	
	~		|

Wall Moderate scaled[District,Type,PerformanceLow]=
	Wall Moderate scaled[District,Type,Moderate] ~~|
Wall Moderate scaled[District,Type,PerformanceHigh]=
	( Wall Moderate[District,Type,PerformanceHigh] - ( VMAX(Wall Moderate[District,Type,\
		Performance!]) - VMIN(Wall Moderate[District,Type,Performance!]) ) / 2 ) / 10000 + \
		Coeff Moderate[Type,PerformanceHigh]
	~	
