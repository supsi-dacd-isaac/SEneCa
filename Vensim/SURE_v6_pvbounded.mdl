Roof High probabilities[District,Type,Performance]=
	Roof High exp[District,Type,Performance] / SUM(Roof High exp[District,Type,Performance\
		!])
	~	
	~		|

Initial grant DH=
	IF THEN ELSE(Time < 2017, 3000, 
	
	IF THEN ELSE(Time < 2022, 5000, 
	
	IF THEN ELSE(Time < 2025, 5000 , 8000 ) ) )
	~	
	~		|

Wall Moderate probabilities[District,Type,Performance]=
	Wall Moderate exp[District,Type,Performance] / SUM(Wall Moderate exp[District,Type,Performance\
		!])
	~	
	~		|

Wall cost[District,Type]=
	Wall specific cost * Wall size by Type and District[District,Type]
	~	
	~		|

Roof High[District,Type,VeryLow]=
	- Roof cost High[District,Type] ~~|
Roof High[District,Type,Low]=
	- Roof cost High[District,Type] ~~|
Roof High[District,Type,Moderate]=
	- Roof cost High[District,Type] ~~|
Roof High[District,Type,High]=
	- Roof cost High[District,Type] ~~|
Roof High[District,Type,VeryHigh]=
	- Roof cost VeryHigh[District,Type] - Total present variable costs SH average[District\
		,VeryHigh,Type] + Total present variable costs SH average[District,High,Type]
	~	
	~		|

HP District Log Likelihood[District]=
	IF THEN ELSE( Time < 2025 , Adoption HP District Data[District] * LN( Average MS HP District\
		[District] ) + Adoption noHP District Data[District] * LN( Average MS noHP District\
		[District] ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
	|

"Battery capacity > 100 kW flow"[District]=
	"Battery adoption > 100 kW" * "Average Battery size > 100 kW" * Share annual installed capacity nonRes by District\
		[District]
	~	kWh
	~		|

Battery residential[District,Type]= INTEG (
	SUM(Battery residential flow[District,HS!,Performance!,Type]) / 1000,
		0)
	~	MWh
	~		|

Battery residential District[District]=
	SUM(Battery residential[District,Type!])
	~	
	~		|

Battery residential Type[Type]=
	SUM(Battery residential[District!,Type])
	~	
	~		|

"Battery capacity < 100 kW flow"[District]=
	( "Battery adoption < 30 kW" * "Average Battery size < 30 kW" + "Battery adoption 30 - 100 kW"\
		 * "Average Battery size 30 - 100 kW" ) * Share annual installed capacity nonRes by District\
		[District]
	~	kWh
	~		|

"Battery capacity < 100 kW"[District]= INTEG (
	"Battery capacity < 100 kW flow"[District] / 1000,
		0)
	~	MWh
	~		|

"Battery capacity > 100 kW"[District]= INTEG (
	"Battery capacity > 100 kW flow"[District] / 1000,
		0)
	~	MWh
	~		|

"PV federal subsidy 30 - 100 kW check"=
	IF THEN ELSE( Time < 2026 , 
	IF THEN ELSE( "PV 30 - 100 kW share grant over cost" < 0.3 , "PV federal subsidy 30 - 100 kW"\
		 , 0.3 * "PV 30 - 100 kW investment cost Time adj" ) , 
	PV rebate federal * "PV 30 - 100 kW investment cost Time adj" )
	~	CHF
	~		|

"PV cantonal subsidy 30 - 100 kW check"=
	IF THEN ELSE(Time < 2021, 
	"PV federal subsidy 30 - 100 kW check" / 3 , 
	IF THEN ELSE( Time < 2026 , "PV federal subsidy 30 - 100 kW check" / 2 * ( "Average power PV 30 - 100 kW"\
		 - 30 ) / "Average power PV 30 - 100 kW" + "PV federal subsidy 30 - 100 kW check" /\
		 3 * 30 / "Average power PV 30 - 100 kW" , 
	IF THEN ELSE( Exploratory analysis > 0 , "PV 30 - 100 kW investment cost Time adj" *\
		 0.1 * Cantonal PV support , PV rebate cantonal * "PV 30 - 100 kW investment cost Time adj"\
		 ) ) )
	~	CHF
	~		|

"PV federal subsidy > 100 kW check"=
	IF THEN ELSE( Time < 2026 , 
	IF THEN ELSE( "PV > 100 kW share grant over cost" < 0.3 , "PV federal subsidy > 100 kW"\
		 , 0.3 * "PV > 100 kW investment cost Time adj" ) , 
	PV rebate federal * "PV > 100 kW investment cost Time adj" )
	~	CHF
	~		|

Levy Evolution=
	IF THEN ELSE( Time < 2031 , Reference Levy , 
	IF THEN ELSE( Time < 2036 , Computed Levy avg 2030 Fixed , 
	IF THEN ELSE( Time < 2041 , Computed Levy avg 2035 Fixed , 
	IF THEN ELSE( Time < 2046 , Computed Levy avg 2040 Fixed , Computed Levy avg 2045 Fixed\
		 ))))
	~	CHF/kWh
	~		|

"Total Battery capacity < 100 kW"=
	SUM("Battery capacity < 100 kW"[District!])
	~	
	~		|

"Total Battery capacity > 100 kW"=
	SUM("Battery capacity > 100 kW"[District!])
	~	
	~		|

Total Battery capacity District[District]=
	Battery residential District[District] + "Battery capacity > 100 kW"[District] + "Battery capacity < 100 kW"\
		[District]
	~	
	~		|

Share of buildings with PV by Type[Type]=
	SUM(Heating Solution[District!,HS!,Performance!,Type,PVyes,Battery!]) / SUM(Heating Solution\
		[District!,HS!,Performance!,Type,PVpanel!,Battery!])
	~	
	~		|

"PV cantonal subsidy > 100 kW check"=
	IF THEN ELSE( Time < 2021, "PV federal subsidy > 100 kW check"/ 3, 
	IF THEN ELSE( Time < 2026 , "PV federal subsidy > 100 kW check"/ 2 * ( "Average power PV > 100 kW"\
		- 30 ) / "Average power PV > 100 kW" + "PV federal subsidy > 100 kW check" / 3 * 30\
		 / "Average power PV > 100 kW" , 
	IF THEN ELSE( Exploratory analysis > 0 , "PV > 100 kW investment cost Time adj" * 0.1\
		 * Cantonal PV support , PV rebate cantonal * "PV > 100 kW investment cost Time adj"\
		 ) ) )
	~	CHF
	~		|

Battery residential flow[District,HS,Performance,Type]=
	( Battery capacity[District,HS,Performance,Type] + Buildings construction with battery\
		[District,HS,Performance,Type,PVyes,Byes] ) * Consumers adopting PV yes with battery\
		[District,HS,Performance,Type,PVyes,Byes] + 
	Battery capacity RCPv[District,HS,Performance,Type] * Consumers adopting RCPv yes with battery\
		[District,HS,Performance,Type,PVyes,Byes]
	~	kWh
	~		|

Battery initial investment RCPv[District,HS,Performance,Type]=
	Battery capacity RCPv[District,HS,Performance,Type] * Battery investiment cost - Battery Incentive RCPv\
		[District,HS,Performance,Type]
	~	CHF
	~		|

Cantonal annual grid upgrading cost=
	SMOOTH( SUM(Total annual grid upgrading cost[District!]) , 3 )
	~	CHF
	~		~	:SUPPLEMENTARY 
	|

Annual incentive battery=
	( SUM(Annual incentive battery Res[District!,HS!,Performance!,Type!]) + Annual incentive battery NonRes\
		 ) / 1e+06
	~	Mio CHF
	~		|

Annual incentive battery NonRes=
	"Battery Incentive < 30 kW" * "Battery adoption < 30 kW" + 
	"Battery Incentive 30 - 100 kW" * "Battery adoption 30 - 100 kW" + 
	"Battery Incentive > 100 kW" * "Battery adoption > 100 kW"
	~	CHF
	~		|

Annual incentive battery Res[District,HS,Performance,Type]=
	Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Byes] * Battery Incentive\
		[District,HS,Performance,Type] + 
	Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Byes] * \
		Battery Incentive RCPv[District,HS,Performance,Type]
	~	CHF
	~		|

Battery Incentive RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 0 , Battery capacity RCPv[District,HS,Performance,Type] \
		* Battery investiment cost * Battery Rebate )
	~	
	~		|

Total Battery adoption nonRes=
	IF THEN ELSE( Time < 2025 , 
	Total Battery adoption Res / 0.9757 * Share of Batteries nonRes , 
	Total Battery adoption Res / 0.9757 * Share of Batteries nonRes * Probability adoption battery average\
		 / 0.3 )
	~	
	~		|

Battery Rebate=
	0.5
	~	
	~		|

"Battery Incentive 30 - 100 kW"=
	IF THEN ELSE( Time < 2026 , 0 , "Average Battery size 30 - 100 kW" * Battery investiment cost\
		 * Battery Rebate )
	~	
	~		|

"Battery Incentive < 30 kW"=
	IF THEN ELSE( Time < 2026 , 0 , "Average Battery size < 30 kW" * Battery investiment cost\
		 * Battery Rebate )
	~	
	~		|

Battery Incentive[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2026 , 0 , Battery capacity[District,HS,Performance,Type] * Battery investiment cost\
		 * Battery Rebate )
	~	
	~		|

Buildings PVno connected to RCPv=
	1.5
	~	
	~		|

Probability adoption battery average=
	SUM(Probability adoption battery[District!,HS!,Performance!,Type!]) / ( 8 * 11 * 5 *\
		 3 )
	~	
	~		|

"Battery Incentive > 100 kW"=
	IF THEN ELSE( Time < 2026 , 0 , "Average Battery size > 100 kW" * Battery investiment cost\
		 * Battery Rebate )
	~	
	~		|

Battery investment cost flow=
	IF THEN ELSE( Time < 2026 , 0 , - Annual Battery cost reduction * Battery investment cost scenario\
		 )
	~	
	~		|

Battery investment cost scenario= INTEG (
	Battery investment cost flow,
		586)
	~	
	~		|

Annual Battery cost reduction=
	0.03
	~	
	~		|

Annual Total Cantonal Subsidy=
	Annual incentives RIC TI + Annual Cantonal subsidy CU + Annual incentives Cantonal FiT\
		 + Annual incentive battery
	~	Mio CHF
	~		|

Battery initial investment[District,HS,Performance,Type]=
	Battery capacity[District,HS,Performance,Type] * Battery investiment cost - Battery Incentive\
		[District,HS,Performance,Type]
	~	CHF
	~		|

Annual cost Cantonal Levy by Type and PV[Type,PVpanel]=
	SUM(Annual cost Cantonal Levy by arch[District!,HS!,Performance!,Type,PVpanel,Battery\
		!]) / SUM(Annual buildings by Arch[District!,Performance!,Type,PVpanel])
	~	
	~		|

Annual cost Federal Levy by Type and PV[Type,PVpanel]=
	SUM(Annual cost Federal Levy by arch[District!,HS!,Performance!,Type,PVpanel,Battery\
		!]) / SUM(Annual buildings by Arch[District!,Performance!,Type,PVpanel])
	~	
	~		|

Renters adopting RCPv PVno flow[District,Type]=
	Renters adopting RCPv flow[District,Type] * Buildings PVno connected to RCPv
	~	
	~		|

Total annual renovation by Performance[Performance]=
	SUM(Buildings HS Renovation From[District!,HS!,Performance,Type!,PVpanel!,Battery!])
	~	
	~		|

Annual DHW demand by HS[HS,Type]=
	SUM(Annual DHW demand by arch[District!,HS,Performance!,Type]) / 1e+06
	~	GWh
	~		|

Annual SH demand Wood by Type[Type]=
	( Annual SH demand by HS[Wood,Type] + Annual SH demand by HS[WoodST,Type] )
	~	GWh
	~		|

Annual SH demand by HS[HS,Type]=
	SUM(Annual SH demand by arch[District!,HS,Performance!,Type]) * Annual heating degree days coefficient\
		 / 1e+06
	~	GWh
	~		|

Annual SH demand Electricity EH by Type[Type]=
	( Annual SH demand by HS[ElectricHeater,Type] )
	~	GWh
	~		|

Annual SH demand Gas by Type[Type]=
	( Annual SH demand by HS[Gas,Type] + Annual SH demand by HS[GasST,Type] )
	~	GWh
	~		|

Annual SH demand Oil by Type[Type]=
	( Annual SH demand by HS[Oil,Type] + Annual SH demand by HS[OilST,Type] )
	~	GWh
	~		|

Annual SH demand Solar by Type[Type]=
	0
	~	GWh
