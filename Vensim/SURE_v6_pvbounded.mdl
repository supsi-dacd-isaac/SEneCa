	Dummy PV for HP factor + 
	Dummy HS[HeatPump] ~~|
Utility HS no incentives[District,HeatPump,Performance,Type,PVno]=
	Green Utility factor[District,HeatPump,Performance,Type] + 
	Peer effect HS factor[HeatPump,District,Type] + 
	Economic utility factor no incentives[District,HeatPump,Performance,Type,PVno] + 
	House Value factor[Performance,HeatPump] + 
	Alpha HP[District,Performance,Type] + 
	Double Tech Factor[HeatPump] + 
	Dummy HS[HeatPump]
	~	Dmnl
	~		|

Market Share HS noDH[District,HS,Performance,Type,PVpanel] :EXCEPT:   [District,DH,Performance\
		,Type,PVpanel]=
	Market Share HS[District,HS,Performance,Type,PVpanel] / ( SUM(Market Share HS[District\
		,HS!,Performance,Type,PVpanel]) - Market Share HS[District,DH,Performance,Type,PVpanel\
		] ) ~~|
Market Share HS noDH[District,DH,Performance,Type,PVpanel]=
	0
	~	
	~		|

Market Share HS no incentives noDH[District,HS,Performance,Type,PVpanel] :EXCEPT:   [\
		District,DH,Performance,Type,PVpanel]=
	Market Share HS no incentives[District,HS,Performance,Type,PVpanel] / ( SUM(Market Share HS no incentives\
		[District,HS!,Performance,Type,PVpanel]) - Market Share HS no incentives[District,DH\
		,Performance,Type,PVpanel] ) ~~|
Market Share HS no incentives noDH[District,DH,Performance,Type,PVpanel]=
	0
	~	
	~		|

Buildings adopting HS[District,HS,Performance,Type,PVpanel,Battery]=
	Buildings adopting HS for old age[District,HS,Performance,Type,PVpanel,Battery] +
	
	Buildings construction with battery[District,HS,Performance,Type,PVpanel,Battery] + 
	
	Buildings HS Renovation To[District,HS,Performance,Type,PVpanel,Battery] +
	
	Consumers adopting PV yes with battery[District,HS,Performance,Type,PVpanel,Battery]\
		 + Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVpanel,Battery\
		]
	~	
	~		|

Res Low to Moderate renovation[District,Type]=
	Low to Performance[District,Type,Moderate]
	~	
	~		|

SFH VeryLow to Performance[Performance]=
	SUM(VeryLow to Performance[District!,SFH,Performance]) + SUM(VeryLow to Performance[\
		District!,DFH,Performance])
	~	
	~		|

VeryLow to Performance MFH MS[Performance]=
	SUM(VeryLow to Performance[District!,MFH,Performance]) / 
	
	SUM(VeryLow to Performance[District!,MFH,Performance!])
	~	
	~		|

MFH VeryLow to Performance[Performance]=
	SUM(VeryLow to Performance[District!,MFH,Performance])
	~	
	~		|

VeryLow to Performance SFH MS[Performance]=
	( SUM(VeryLow to Performance[District!,SFH,Performance]) + SUM(VeryLow to Performance\
		[District!,DFH,Performance]) ) / 
	
	( SUM(VeryLow to Performance[District!,SFH,Performance!]) + SUM(VeryLow to Performance\
		[District!,DFH,Performance!]) )
	~	
	~		|

Market Share HS[District,HS,Performance,Type,PVpanel]=
	Utility HS exp 3[District,HS,Performance,Type,PVpanel] / SUM(Utility HS exp 3[District\
		,HS!,Performance,Type,PVpanel])
	~	
	~		|

VeryLow to Performance[District,Type,Performance]=
	VeryLow changing Roof[District,Type] * Roof VeryLow probabilities[District,Type,Performance\
		] + 
	VeryLow changing Wall[District,Type] * Wall VeryLow probabilities[District,Type,Performance\
		] +
	VeryLow changing Ground[District,Type] * Ground VeryLow probabilities[District,Type,\
		Performance]
	~	
	~		|

PV total savings Owner[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2013 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	( - PV annual mantainance cost * PV annual generation per building[District,Type] + 
	PV annual generation per building[District,Type] * "PV FiT < 10 kW"  ) / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate , 
	
	(  - PV annual mantainance cost * PV annual generation per building[District,Type] +\
		  
	PV annual generation per building[District,Type] * "PV FiT 10 - 30 kW" ) / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ) ,\
		 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	( PV annual generation per building[District,Type] * Self consumption degree[District\
		,HS,Performance,Type] * Electricity price[District] -
	PV annual mantainance cost * PV annual generation per building[District,Type] + 
	PV annual generation per building[District,Type] * ( 1 - Self consumption degree[District\
		,HS,Performance,Type] ) * PV cumulative compensation price ) / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate\
		 , 
	
	( - PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * "PV FiT 10 - 30 kW") / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ 20 ) ) ) / Interest rate ), 
	
	( PV annual generation per building[District,Type] * Self consumption degree[District\
		,HS,Performance,Type] * Electricity price[District] -
	PV annual mantainance cost * PV annual generation per building[District,Type] +  
	PV annual generation per building[District,Type] * ( 1 - Self consumption degree[District\
		,HS,Performance,Type] ) * PV cumulative compensation price ) / Dwellings per building\
		[District,Type] * (1 - ( 1 / ( ( 1 + Interest rate ) ^ PV lifetime ) ) ) / Interest rate\
		 ) )
	~	CHF
	~		|

PV federal subsidy check[District,Type]=
	IF THEN ELSE( Share of federal grant over cost[District,Type] < ( 0.3 + PV rebate federal\
		 - 0.2 ) , 
	
	PV initial federal subsidy[District,Type] , 
	
	( 0.3 + PV rebate federal - 0.2 ) * PV investment cost[District,Type] )
	~	CHF
	~		|

Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery]=
	MIN( Heating Solution[District,HS,Performance,Type,PVpanel,Battery]
	 / Equivalent Lifetime[HS] ,
	MAX( 0 , Heating Solution[District,HS,Performance,Type,PVpanel,Battery] - MAX( 0 , Building demolition by archetype\
		[District,HS,Performance,Type,PVpanel,Battery])
	 - MAX( 0 , Buildings HS Renovation From[District,HS,Performance,Type,PVpanel,Battery\
		]) - MAX(0, Consumers adopting PV no[District,HS,Performance,Type,PVpanel,Battery] \
		) ) )
	~	
	~	Heating Solution[District,HS,Performance,Type,PVpanel,Battery] / \
		Equivalent Lifetime[HS]
	|

Economic Utility HS no incentives[District,HS,Performance,Type,PVpanel]=
	( Annualized Total Cost HS no incentives[District,HS,Performance,Type,PVpanel] - VMIN\
		(Annualized Total Cost HS no incentives[District,HS!,Performance,Type,PVpanel]) ) /\
		 
	( VMAX(Annualized Total Cost HS no incentives[District,HS!,Performance,Type,PVpanel]\
		) - VMIN(Annualized Total Cost HS no incentives[District,HS!,Performance,Type,PVpanel\
		]) )
	~	
	~		|

Share of federal grant over cost[District,Type]=
	PV initial federal subsidy[District,Type] / PV investment cost[District,Type]
	~	Dmnl
	~		|

PV Eco Utility Owners[District,HS,Performance,Type]=
	( ( PV total savings Owner[District,HS,Performance,Type] - Initial Investment PV Owner\
		[District,Type] ) / Initial Investment PV Owner[District,Type] / PV lifetime ) * 100
	~	kCHF
	~		|

PV total initial investment cost[District,Performance,Type]=
	PV investment cost[District,Type]
	~	CHF
	~		~	:SUPPLEMENTARY 
	|

Annualized Total Cost HS no incentives[District,HS,Performance,Type,PVpanel]=
	( Investment cost HS no incentives[HS,District,Performance,Type] - Total variable costs HS\
		[District,HS,Performance,Type,PVpanel] ) / Lifetime[HS]
	~	
	~		|

PV initial federal subsidy[District,Type]=
	IF THEN ELSE( Time < 2026 , 
	PV initial grant + PV federal investment grant capacity * kWp installed per building\
		[District,Type] , 
	PV investment cost[District,Type] * PV rebate federal )
	~	CHF
	~		|

Investment cost HS[District,OilST,Performance,Type]=
	Investment cost HS no incentives[OilST,District,Performance,Type] - Grant ST[Performance\
		,District,Type] ~~|
Investment cost HS[District,GasST,Performance,Type]=
	Investment cost HS no incentives[GasST,District,Performance,Type] - Grant ST[Performance\
		,District,Type] ~~|
Investment cost HS[District,pellet,Performance,Type]=
	Investment cost HS no incentives[pellet,District,Performance,Type] - Grant PelletBoiler Pellet\
		[Performance,District,Type] ~~|
Investment cost HS[District,HeatPump,Performance,Type]=
	Investment cost HS no incentives[HeatPump,District,Performance,Type] - Grant HP HeatPump\
		[Performance,District,Type] ~~|
Investment cost HS[District,WoodST,Performance,Type]=
	Investment cost HS no incentives[WoodST,District,Performance,Type] - Grant PelletBoiler WoodST\
		[District,Performance,Type] - Grant ST[Performance,District,Type] ~~|
Investment cost HS[District,HPST,Performance,Type]=
	Investment cost HS no incentives[HPST,District,Performance,Type] - Grant HP HPST[District\
		,Performance,Type] - Grant ST[Performance,District,Type] ~~|
Investment cost HS[District,OldS,Performance,Type]=
	Investment cost HS no incentives[OldS,District,Performance,Type] ~~|
Investment cost HS[District,Wood,Performance,Type]=
	Investment cost HS no incentives[Wood,District,Performance,Type] ~~|
Investment cost HS[District,DH,Performance,Type]=
	Investment cost HS no incentives[DH,District,Performance,Type] - Grant DH[Performance\
		,District,Type]
	~	CHF
	~		|

PV differential cost change=
	IF THEN ELSE( Time < 2012, -1.1256, 
	IF THEN ELSE( Time < 2013, -0.4658, 
	IF THEN ELSE( Time < 2014, -0.3231, 
	IF THEN ELSE( Time < 2015, -0.726, 
	IF THEN ELSE( Time < 2016, -0.2089, 
	IF THEN ELSE( Time < 2017, -0.282, 
	IF THEN ELSE( Time < 2018, -0.2637, 
	IF THEN ELSE( Time < 2019, -0.2683, 
	IF THEN ELSE( Time < 2020, -0.1564, 
	IF THEN ELSE( Time < 2021, 0 , 
	IF THEN ELSE( Time < 2025, 0 , 
	IF THEN ELSE( Time < 2030, 0 , 
	IF THEN ELSE( Time < 2040, 0 , 0 )))))))))))))
	~	
	~	IF THEN ELSE( Time < 2012, -1.1256, 
		IF THEN ELSE( Time < 2013, -0.4658, 
		IF THEN ELSE( Time < 2014, -0.3231, 
		IF THEN ELSE( Time < 2015, -0.726, 
		IF THEN ELSE( Time < 2016, -0.2089, 
		IF THEN ELSE( Time < 2017, -0.282, 
		IF THEN ELSE( Time < 2018, -0.2637, 
		IF THEN ELSE( Time < 2019, -0.2683, 
		IF THEN ELSE( Time < 2020, -0.1564, 
		IF THEN ELSE( Time < 2021, -0.0753, 
		IF THEN ELSE( Time < 2025, -0.0468, 
		IF THEN ELSE( Time < 2030, 0 , 
		IF THEN ELSE( Time < 2035, 0 , 
		IF THEN ELSE( Time < 2040, 0 , 
		IF THEN ELSE( Time < 2045, 0 , 0 )))))))))))))))
	|

Requested Owners adopting RCPv[District,HS,Performance,Type]=
	MAX( IF THEN ELSE( Time < 2025 , 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption RCPv Owners[District,HS,Performance,Type] * Share urban buildings\
		[District,Type] ) * Energy Community scenario , 0 )
	~	
	~		|

Requested Renters adopting RCPv[District,HS,Performance,Type]=
	MAX( IF THEN ELSE( Time < 2025 , 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption RCPv Renters[District,HS,Performance,Type] * Share urban buildings\
		[District,Type] ) * Energy Community scenario , 0 )
	~	
	~		|

Buildings leaving HS[District,HS,Performance,Type,PVpanel,Battery]=
	Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery] + 
	
	Building demolition by archetype[District,HS,Performance,Type,PVpanel,Battery] +
	
	Buildings HS Renovation From[District,HS,Performance,Type,PVpanel,Battery] +
	
	Consumers adopting PV no[District,HS,Performance,Type,PVpanel,Battery]
	~	
	~		|

Adoption Heating Solution Distirct[District]=
	SUM(Buildings adopting HS[District,HS!,Performance!,Type!,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District,HS!,Performance!,Type!,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District,HS!,Performance!,Type!,PVpanel!])
	~	
	~		|

Adoption Heating Solution Performance[Performance]=
	SUM(Buildings adopting HS[District!,HS!,Performance,Type!,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS!,Performance,Type!,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS!,Performance,Type!,PVpanel!])
	~	
	~		|

Adoption Heating Solution PVpanel[PVpanel]=
	SUM(Buildings adopting HS[District!,HS!,Performance!,Type!,PVpanel,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS!,Performance!,Type!,PVpanel,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS!,Performance!,Type!,PVpanel])
	~	
	~		|

Adoption Heating Solution Type[Type]=
	SUM(Buildings adopting HS[District!,HS!,Performance!,Type,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS!,Performance!,Type,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS!,Performance!,Type,PVpanel!])
	~	
	~		|

Adoption HP District[District]=
	SUM(Buildings adopting HS[District,HeatPump,Performance!,Type!,PVpanel!,Battery!]) -\
		 SUM(Buildings HS Renovation To[District,HeatPump,Performance!,Type!,PVpanel!,Battery\
		!]) - SUM(Consumers adopting PV yes[District,HeatPump,Performance!,Type!,PVpanel!])
	~	
	~		|

Adoption HP Performance[Performance]=
	SUM(Buildings adopting HS[District!,HeatPump,Performance,Type!,PVpanel!,Battery!]) -\
		 SUM(Buildings HS Renovation To[District!,HeatPump,Performance,Type!,PVpanel!,Battery\
		!]) - SUM(Consumers adopting PV yes[District!,HeatPump,Performance,Type!,PVpanel!])
	~	
	~		|

Adoption HP PVpanel[PVpanel]=
	SUM(Buildings adopting HS[District!,HeatPump,Performance!,Type!,PVpanel,Battery!]) -\
		 SUM(Buildings HS Renovation To[District!,HeatPump,Performance!,Type!,PVpanel,Battery\
		!]) - SUM(Consumers adopting PV yes[District!,HeatPump,Performance!,Type!,PVpanel])
	~	
	~		|

Adoption HP Type[Type]=
	SUM(Buildings adopting HS[District!,HeatPump,Performance!,Type,PVpanel!,Battery!]) -\
		 SUM(Buildings HS Renovation To[District!,HeatPump,Performance!,Type,PVpanel!,Battery\
		!]) - SUM(Consumers adopting PV yes[District!,HeatPump,Performance!,Type,PVpanel!])
	~	
	~		|

Heating Solution[District,HS,Performance,Type,PVpanel,Battery]= INTEG (
	Buildings adopting HS[District,HS,Performance,Type,PVpanel,Battery]-Buildings leaving HS\
		[District,HS,Performance,Type,PVpanel,Battery],
		Initial Heating Solution battery[District,HS,Performance,Type,PVpanel,Battery])
	~	
	~		|

Tax deduction investment=
	IF THEN ELSE( Time < 2023 , 0.2 , 0.2)
	~	Dmnl
	~		|

Alpha Performance[Performance]=
	0
	~	Dmnl
	~		|

"PV FiT 10 - 30 kW"= INTEG (
	"PV differential FiT 10 - 30 kW",
		0.5502)
	~	CHF/kWh
	~		|

"PV differential FiT < 10 kW"=
	IF THEN ELSE( Time < 2011.01, -0.0508, 
	IF THEN ELSE( Time < 2012.01, -0.0467, 
	IF THEN ELSE( Time < 2013.01, -0.043, 
	IF THEN ELSE( Time < 2014.01, -0.0395, 
	IF THEN ELSE( Time < 2015.01, -0.0364, 
	IF THEN ELSE( Time < 2016.01, -0.0335, 
	IF THEN ELSE( Time < 2017.01, -0.0308, 0 )))))))
	~	CHF/kWh
	~		|

"PV FiT < 10 kW"= INTEG (
	"PV differential FiT < 10 kW",
		0.6348)
	~	CHF/kWh
	~		|

"PV differential FiT 10 - 30 kW"=
	IF THEN ELSE( Time < 2011.01, -0.044, 
	IF THEN ELSE( Time < 2012.01, -0.0405, 
	IF THEN ELSE( Time < 2013.01, -0.0373, 
	IF THEN ELSE( Time < 2014.01, -0.0343, 
	IF THEN ELSE( Time < 2015.01, -0.0315, 
	IF THEN ELSE( Time < 2016.01, -0.029, 
	IF THEN ELSE( Time < 2017.01, -0.0267, 0 )))))))
	~	CHF/kWh
	~		|

"Tax deduction O&M"=
	0.077
	~	Dmnl
	~		|

Share of buildings with suitable roof[District,Type]=TABBED ARRAY(
	0.763	0.805	0.85
	0.573	0.604	0.6
	0.647	0.624	0.66
	0.758	0.789	0.863
	0.868	0.886	0.893
	0.912	0.912	0.911
	0.629	0.625	0.722
	0.534	0.592	0.62
	)
	~	
	~		|

PV cumulative cost change= INTEG (
	PV differential cost change,
		4.7925)
	~	Dmnl
	~		|

