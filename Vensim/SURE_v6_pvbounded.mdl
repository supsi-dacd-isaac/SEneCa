	IF THEN ELSE( Time < 2022, 0.0826 , 
	IF THEN ELSE( Time < 2023, 0.083 , 
	IF THEN ELSE( Time < 2024, 0.1006 , 
	IF THEN ELSE( Time < 2025, 0.1271 , 
	IF THEN ELSE( Time < 2026, 0.1295 , 0.1184 ))))))))))))))) ~~|
Grid Charge[Leventina]=
	Grid Charge[Vallemaggia] ~~|
Grid Charge[Blenio]=
	Grid Charge[Vallemaggia] ~~|
Grid Charge[Lugano]=
	IF THEN ELSE( Time < 2012, 0.079, 
	IF THEN ELSE( Time < 2013, 0.0639 , 
	IF THEN ELSE( Time < 2014, 0.0663 , 
	IF THEN ELSE( Time < 2015, 0.075 , 
	IF THEN ELSE( Time < 2016, 0.0754 , 
	IF THEN ELSE( Time < 2017, 0.0791 , 
	IF THEN ELSE( Time < 2018, 0.0803 , 
	IF THEN ELSE( Time < 2019, 0.081 , 
	IF THEN ELSE( Time < 2020, 0.0837 , 
	IF THEN ELSE( Time < 2021, 0.0844 , 
	IF THEN ELSE( Time < 2022, 0.0879 , 
	IF THEN ELSE( Time < 2023, 0.0874 , 
	IF THEN ELSE( Time < 2024, 0.0969 , 
	IF THEN ELSE( Time < 2025, 0.1241 , 
	IF THEN ELSE( Time < 2026, 0.12 , 0.1033 ))))))))))))))) ~~|
Grid Charge[Riviera]=
	Grid Charge[Vallemaggia] ~~|
Grid Charge[Locarno]=
	Grid Charge[Vallemaggia]
	~	CHF/kWh
	~		|

Total annual demand Districts[District]=
	( Industry electricity consumption by District[District] + Tertiary electricity consumption by District\
		[District] + Other electricity consumption by District[District] ) * 1e+06 + Residential electricity cons by District\
		[District]
	~	kWh
	~		|

Annual HP kW installation[District]=
	SUM(Annual HP kW installation by archetype[District,Performance!,Type!,PVpanel!])
	~	kW
	~		|

Annual PV kW installation[District,HS,Performance,Type]=
	Annual PV kW installation by archetype[District,HS,Performance,Type]
	~	kW
	~		|

Utility HS exp[District,NewS,Performance,Type,PVpanel]=
	exp(Utility HS[District,NewS,Performance,Type,PVpanel]) ~~|
Utility HS exp[District,Oil,Performance,Type,PVpanel]=
	exp(Utility HS[District,Oil,Performance,Type,PVpanel]) ~~|
Utility HS exp[District,Gas,Performance,Type,PVpanel]=
	exp(Utility HS[District,Gas,Performance,Type,PVpanel]) ~~|
Utility HS exp[District,ElectricHeater,Performance,Type,PVpanel]=
	IF THEN ELSE( Time < 2018 , exp(Utility HS[District,ElectricHeater,Performance,Type,\
		PVpanel]) , 0 )
	~	
	~		|

Probability adoption PV Owners[District,HS,Performance,Type]=
	Utility PV Owners exp[District,HS,Performance,Type] / (1 + Utility PV Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~		|

Market Share HS filtered[District,HS,Performance,Type,PVpanel]=
	Market Share HS[District,HS,Performance,Type,PVpanel] * DH and Gas suitability[District\
		,Type] + 
	Market Share HS noGas[District,HS,Performance,Type,PVpanel] * DH only suitability[District\
		,Type] + 
	Market Share HS noDH[District,HS,Performance,Type,PVpanel] * Gas only suitability[District\
		,Type] + 
	Market Share HS noDH noGas[District,HS,Performance,Type,PVpanel] * No suitability[District\
		,Type]
	~	
	~		|

Utility PV Owners exp[District,HS,Performance,Type]=
	exp( Utility PV Owners[District,HS,Performance,Type] )
	~	Dmnl
	~		|

Stock total cost increase= INTEG (
	IF THEN ELSE( Time < 2026 , 0 , Total cost change ),
		1)
	~	
	~		|

Total cost change=
	0.005 * Stock total cost increase
	~	
	~		|

PV Eco weight=
	0.134555
	~	Dmnl
	~		|

STyes:
	OilST, GasST, WoodST, HPST
	~	
	~		|

STno:
	Oil, Gas, ElectricHeater, Wood, pellet, HeatPump, DH
	~	
	~		|

NewS:
	Wood, OilST, GasST, WoodST, HPST, HeatPump, pellet, DH
	~	
	~		|

OldS:
	Oil, Gas, ElectricHeater
	~	
	~		|

HS:
	Oil, Gas, ElectricHeater, Wood, OilST, GasST, WoodST, HPST, HeatPump, pellet, DH
	~	
	~		|

ST capacity installed per square meter=
	0.7
	~	kW/m2
	~		|

Annual Cost HP grid expansion[District]=
	Grid expansion cost per kW installed[District] * Annual HP kW installation[District]
	~	CHF
	~		|

Annual HP kW installation by archetype[District,Performance,Type,PVpanel]=
	( SUM(Buildings adopting HS[District,HeatPump,Performance,Type,PVpanel,Battery!]) - \
		SUM(Buildings HS Renovation To[District,HeatPump,Performance,Type,PVpanel,Battery!]\
		) - Consumers adopting PV yes[District,HeatPump,Performance,Type,PVpanel] - SUM(Consumers leaving HS for old age\
		[District,HeatPump,Performance,Type,PVpanel,Battery!]) ) * 
	( Technology SH installed capacity SH and DHW[District,Performance,Type] + Technology DHW installed capacity SH and DHW\
		[District,Type] ) + 
	
	( SUM(Buildings adopting HS[District,HPST,Performance,Type,PVpanel,Battery!]) - SUM(\
		Buildings HS Renovation To[District,HPST,Performance,Type,PVpanel,Battery!]) - Consumers adopting PV yes\
		[District,HPST,Performance,Type,PVpanel] - SUM(Consumers leaving HS for old age[District\
		,HPST,Performance,Type,PVpanel,Battery!]) ) * 
	( Technology SH installed capacity just SH[District,Performance,Type] )
	~	kW
	~		|

Annural Federal subsidy RUP by archetype[District,HS,Performance,Type]=
	SUM(Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * PV federal subsidy check[District,Type] + 
	SUM(Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * PV federal subsidy check RCPv[District,Type]
	~	CHF
	~		|

Additional annual PV kWh self consumed[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2015 , 0 , Additional annual PV kWh self consumed by archetype[\
		District,HS,Performance,Type] )
	~	kWh
	~		|

Total annual grid upgrading cost[District]= DELAY FIXED (
	( Annual Cost HP grid expansion[District] + Annual Cost PV grid expansion[District] \
		+ Annual Cost EV grid expansion[District] ) , 0.01 , Total annual grid upgrading cost i\
		[District])
	~	CHF
	~		|

Total Cost PV grid expansion[District]= INTEG (
	Annual Cost PV grid expansion[District],
		0)
	~	CHF
	~		~	:SUPPLEMENTARY 
	|

Total annual grid upgrading cost by DSO[Vallemaggia]=
	Total annual grid upgrading cost[Vallemaggia] + Total annual grid upgrading cost[Leventina\
		] + Total annual grid upgrading cost[Blenio] + Total annual grid upgrading cost[Riviera\
		] + Total annual grid upgrading cost[Locarno] ~~|
Total annual grid upgrading cost by DSO[Mendrisio]=
	Total annual grid upgrading cost[Mendrisio] ~~|
Total annual grid upgrading cost by DSO[Bellinzona]=
	Total annual grid upgrading cost[Bellinzona] ~~|
Total annual grid upgrading cost by DSO[Leventina]=
	Total annual grid upgrading cost by DSO[Vallemaggia] ~~|
Total annual grid upgrading cost by DSO[Blenio]=
	Total annual grid upgrading cost by DSO[Vallemaggia] ~~|
Total annual grid upgrading cost by DSO[Lugano]=
	Total annual grid upgrading cost[Lugano] ~~|
Total annual grid upgrading cost by DSO[Riviera]=
	Total annual grid upgrading cost by DSO[Vallemaggia] ~~|
Total annual grid upgrading cost by DSO[Locarno]=
	Total annual grid upgrading cost by DSO[Vallemaggia]
	~	CHF
	~		|

Total Cost HP grid expansion[District]= INTEG (
	Annual Cost HP grid expansion[District],
		0)
	~	CHF
	~		~	:SUPPLEMENTARY 
	|

Grid expansion cost per kW PV[District]=
	174.4,
	248,
	248,
	198.9,
	180.4,
	176.8,
	188.4,
	248
	~	CHF/kW
	~		|

Grid expansion cost per kW installed[District]=
	43.1,
	178,
	178,
	80.6,
	49.1,
	47.2,
	43,
	178
	~	CHF/kW
	~		|

Additional annual PV kWh produced by archetype[District,HS,Performance,Type,Battery]=
	PV adoptions by archetype[District,HS,Performance,Type,Battery] * kWp installed per building\
		[District,Type] * PV annual generation per kW
	~	kWh
	~		|

Additional annual RCPv kWh produced by archetype[District,HS,Performance,Type,Battery\
		]=
	RCPv adoptions by archetype[District,HS,Performance,Type,Battery] * kWp installed per building RCPv\
		[District,Type] * PV annual generation per kW
	~	kWh
	~		|

Annural Cantonal subsidy CU by archetype[District,HS,Performance,Type]=
	SUM(Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * PV cantonal subsidy[District,Type] + 
	SUM(Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery\
		!]) * RCPv cantonal subsidy[District,Type]
	~	CHF
	~		|

DSO charge[Vallemaggia]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Vallemaggia] , 
	
	( Initial DSO expenses[Vallemaggia] + Total annual grid upgrading cost by DSO smooth\
		[Vallemaggia] ) / ( Total annual grid demand Districts[Vallemaggia] + Total annual grid demand Districts\
		[Riviera] + Total annual grid demand Districts[Locarno] + Total annual grid demand Districts\
		[Leventina] + Total annual grid demand Districts[Blenio] ) ) ~~|
DSO charge[Mendrisio]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Mendrisio] , 
	
	( Initial DSO expenses[Mendrisio] + Total annual grid upgrading cost by DSO smooth[Mendrisio\
		]) / Total annual grid demand Districts[Mendrisio] ) ~~|
DSO charge[Bellinzona]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Bellinzona] , 
	
	( Initial DSO expenses[Bellinzona] + Total annual grid upgrading cost by DSO smooth[\
		Bellinzona]) / Total annual grid demand Districts[Bellinzona] ) ~~|
DSO charge[Leventina]=
	DSO charge[Vallemaggia] ~~|
DSO charge[Blenio]=
	DSO charge[Vallemaggia] ~~|
DSO charge[Lugano]=
	IF THEN ELSE(Time < 2027 , 
	
	Initial DSO charge[Lugano] , 
	
	( Initial DSO expenses[Lugano] + Total annual grid upgrading cost by DSO smooth[Lugano\
		]) / Total annual grid demand Districts[Lugano] ) ~~|
DSO charge[Riviera]=
	DSO charge[Vallemaggia] ~~|
DSO charge[Locarno]=
	DSO charge[Vallemaggia]
	~	CHF/kWh
	~		|

Initial DSO charge[District]=
	Grid Charge[District] - TSO charge
	~	CHF/kWh
	~		|

Initial DSO expenses[Vallemaggia]=
	Initial DSO charge[Vallemaggia] * Stock total cost increase * ( 40.4501 + 64.1812 + \
		426.566 + 100.634 + 39.921 ) * 1e+06 ~~|
Initial DSO expenses[Mendrisio]=
	Initial DSO charge[Mendrisio] * Stock total cost increase * 429.872 * 1e+06 ~~|
Initial DSO expenses[Bellinzona]=
	Initial DSO charge[Bellinzona] * Stock total cost increase * 372.291 * 1e+06 ~~|
Initial DSO expenses[Leventina]=
	Initial DSO expenses[Vallemaggia] ~~|
Initial DSO expenses[Blenio]=
	Initial DSO expenses[Vallemaggia] ~~|
Initial DSO expenses[Lugano]=
	Initial DSO charge[Lugano] * Stock total cost increase * 1160.01 * 1e+06 ~~|
Initial DSO expenses[Riviera]=
	Initial DSO expenses[Vallemaggia] ~~|
Initial DSO expenses[Locarno]=
	Initial DSO expenses[Vallemaggia]
	~	CHF
	~		|

Res VeryLow Low renovation[District,Type]=
	VeryLow to Performance[District,Type,Low]
	~	building
	~		|

Res VeryLow Buildings[District,Type]= INTEG (
	-Res VeryLow demolition[District,Type]-Res VeryLow High renovation[District,Type]-Res VeryLow Low renovation\
		[District,Type]-Res VeryLow Moderate renovation[District,Type]-Res VeryLow VeryHigh renovation\
		[District,Type],
		Res VeryLow Buildings i[District,Type])
	~	building
	~		|

Res VeryLow demolition[District,Type]=
	IF THEN ELSE( Time < 2026 , 0 ,
	
	IF THEN ELSE(Res VeryLow Buildings[District,Type] > SUM(Overall demolited buildings[\
		Type!]) * Res buildings share[District,VeryLow,Type] ,
	
	SUM(Overall demolited buildings[Type!]) * Res buildings share[District,VeryLow,Type]\
		 , Res VeryLow Buildings[District,Type] ) )
	~	building
	~		|

Res VeryLow Buildings i[District,Type]=
	SUM(Res buildings i[VeryLow,District,Type,PVpanel!])
	~	building
	~		|

Res buildings i[Performance,District,Type,PVpanel]:INTERPOLATE::=
	GET VDF DATA( 'Input2011.vdfx', 'Res buildings i[Performance,District,Type,PVpanel]'\
		 , 0 , 1 )
	~	building
	~		|

Adoption Heating Solution[HS]=
	SUM(Buildings adopting HS[District!,HS,Performance!,Type!,PVpanel!,Battery!]) - SUM(\
		Buildings HS Renovation To[District!,HS,Performance!,Type!,PVpanel!,Battery!]) - SUM\
		(Consumers adopting PV yes[District!,HS,Performance!,Type!,PVpanel!])
	~	
	~		|

HS substituted[HS]=
	Old to VeryOld delay[HS] - HS VeryOld demolited[HS]
	~	
	~		|

Equivalent Lifetime[HS]=
	IF THEN ELSE( HS substituted[HS] > 0.001 , MAX(SUM(Heating Solution[District!,HS,Performance\
		!,Type!,PVpanel!,Battery!])
	 / HS substituted[HS], 1 ) , 1e+06)
	~	
	~		|

Initial Investment PV Owner[District,Type]=
	IF THEN ELSE( Time < 2013 , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) / Dwellings per building\
		[District,Type] , 
	
	IF THEN ELSE( Time < 2016 , 
	
	IF THEN ELSE( kWp installed per building[District,Type] < 10 , 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) / Dwellings per building[District\
		,Type] , 
	
	PV investment cost[District,Type] * (1 - Tax deduction investment) / Dwellings per building\
		[District,Type] ), 
	
	(PV investment cost[District,Type] - PV cantonal subsidy[District,Type] - PV federal subsidy check\
		[District,Type]) * (1 - Tax deduction investment) / Dwellings per building[District\
		,Type] ) )
	~	CHF
	~	IF THEN ELSE( Time < 2015, 
		
		IF THEN ELSE( kWp installed per \
		building[District,HeatingSolution,ResPerformance,ResType] < 10, 
		
		(PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] - \
		PV cantonal subsidy[District,HeatingSolution,ResPerformance,ResType] - PV \
		federal subsidy check[District,HeatingSolution,ResPerformance,ResType]) * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] , 
		
		PV total initial investment cost[District,HeatingSolution,ResPerformance,ResType] * \
		(1 - Tax deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] ) , 
		
		(PV total initial investment \
		cost[District,HeatingSolution,ResPerformance,ResType] - PV cantonal \
		subsidy[District,HeatingSolution,ResPerformance,ResType] - PV federal \
		subsidy check[District,HeatingSolution,ResPerformance,ResType]) * (1 - Tax \
		deduction investment) / Dwellings per \
		building[ResPerformance,District,ResType] )
	|

RCP Eco Utility Owners[District,HS,Performance,Type]=
	( ( RCP total savings Owner[District,HS,Performance,Type] - Initial Investment PV Owner\
		[District,Type] ) / Initial Investment PV Owner[District,Type] / PV lifetime ) * 100
	~	kCHF
	~	( ( 1 + ( PV total \
		savings[District,HeatingSolution,ResPerformance,ResType] - Initial \
		Investment PV[District,HeatingSolution,ResPerformance,ResType] ) / Initial \
		Investment PV[District,HeatingSolution,ResPerformance,ResType] ) ^ ( 1 / \
		PV lifetime ) - 1 ) * 100
	|

Green Utility HS[District,HS,Performance,Type]=
	Annual GWP Heating Solution[District,HS,Performance,Type] / VMAX(Annual GWP Heating Solution\
		[District,HS!,Performance,Type])
	~	Dmnl
	~		|

Total variable costs HS[District,OilST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler]  - 
	
	Annual mantainance costs HS[OilST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 +\
		 Interest rate ) ^ Lifetime[OilST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,GasST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler]  - 
	
	Annual mantainance costs HS[GasST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 +\
		 Interest rate ) ^ Lifetime[GasST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,pellet,Performance,Type,PVpanel]=
	( - ( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District\
		,PelletBoiler] - 
	
	Annual mantainance costs HS[pellet,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 \
		+ Interest rate ) ^ Lifetime[pellet] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HeatPump,Performance,Type,PVyes]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * Carrier used cost per kWh[District,HP] * (1 \
		- Self sufficiency degree[District,HeatPump,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * PV cumulative compensation price * Self sufficiency degree\
		[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) * ( 1 - ( 1 / ( ( \
		1 + Interest rate ) ^ Lifetime[HeatPump] ) ) ) / Interest rate ~~|
Total variable costs HS[District,WoodST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler]  - 
	
	Annual mantainance costs HS[WoodST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 \
		+ Interest rate ) ^ Lifetime[WoodST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HPST,Performance,Type,PVyes]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST]  - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		 - ST share of total heat production) ) / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HPST,Performance,Type]) - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		 - ST share of total heat production)) / Efficiency[HP] * PV cumulative compensation price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type]) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime[HPST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HeatPump,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[HP] * Carrier used cost per kWh[District,HP] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) * ( 1 - ( 1 / ( ( \
		1 + Interest rate ) ^ Lifetime[HeatPump] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HPST,Performance,Type,PVno]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[HP] * Carrier used cost per kWh\
		[District,HP]  - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + \
		Interest rate ) ^ Lifetime[HPST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,Oil,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler\
		] - 
	
	Annual mantainance costs HS[Oil,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime[Oil] ) ) ) / Interest rate ~~|
Total variable costs HS[District,Gas,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler\
		] - 
	
	Annual mantainance costs HS[Gas,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime[Gas] ) ) ) / Interest rate ~~|
Total variable costs HS[District,Wood,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler\
		] - 
	
	Annual mantainance costs HS[Wood,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + \
		Interest rate ) ^ Lifetime[Wood] ) ) ) / Interest rate ~~|
Total variable costs HS[District,ElectricHeater,Performance,Type,PVyes]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Carrier used cost per kWh[District,EH] * (1 \
		- Self sufficiency degree[District,ElectricHeater,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * PV cumulative compensation price * Self sufficiency degree\
		[District,ElectricHeater,Performance,Type] - 
	
	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) * ( 1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ Lifetime[ElectricHeater] ) ) ) / Interest rate ~~|
Total variable costs HS[District,ElectricHeater,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Carrier used cost per kWh[District,EH] - 
	
	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) * ( 1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ Lifetime[ElectricHeater] ) ) ) / Interest rate ~~|
Total variable costs HS[District,DH,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type])\
		 / 1 * Carrier used cost per kWh[District,WoodBoiler] - 
	
	Annual mantainance costs HS[DH,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime[DH] ) ) ) / Interest rate
	~	CHF
	~		|

Share HS by archetype[District,HS,Performance,Type,PVpanel,Battery]=
	Heating Solution[District,HS,Performance,Type,PVpanel,Battery] / SUM(Heating Solution\
		[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	Dmnl
	~		|

Initial Heating Solution[District,HS,Performance,Type,PVpanel]:INTERPOLATE::=
	GET VDF DATA( 'Input2011.vdfx', 'Initial Heating Solution[District,HS,Performance,Type,PVpanel]'\
		 , 0 , 1 )
	~	
	~		|

Initial kWp installed by archetype[District,HS,Performance,Type]=
	Initial Heating Solution[District,HS,Performance,Type,PVyes] * kWp installed per building\
		[District,Type]
	~	kW
	~		|

