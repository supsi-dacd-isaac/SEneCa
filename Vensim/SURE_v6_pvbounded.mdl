{UTF-8}
Requested Owners adopting RCP[District,HS,Performance,Type] :EXCEPT:    [District,HS,Performance\
		,MFH]=
	0 ~~|
Requested Owners adopting RCP[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) ) , 0 )
	~	
	~		|

Requested Owners adopting PV[District,HS,Performance,Type] :EXCEPT:                 [District,HS\
		,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] * Probability adoption PV Owners[District\
		,HS,Performance,Type] ) ,
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	(1 - Share urban buildings[District,Type] ) * Probability adoption PV Owners[District\
		,HS,Performance,Type] * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * Probability adoption PV Owners\
		[District,HS,Performance,Type] * ( Energy Community scenario - 1 ) ) , 0 ) ~~|
Requested Owners adopting PV[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery!]) > \
		0 ,
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,MFH] , 
	
	SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] * Probability adoption PV Owners\
		[District,HS,Performance,MFH] ) , 0 ) , 0 )
	~	
	~		|

Rented buildings with RCP[District,Type]= INTEG (
	Renters adopting RCP flow[District,Type]-Rented buildings with RCP demolished[District\
		,Type],
		0)
	~	
	~		|

Owned buildings with RCPv[District,Type]= INTEG (
	Owners adopting RCPv flow[District,Type]-Owned buildings with RCPv demolished[District\
		,Type],
		0)
	~	
	~		|

Rented buildings with RCPv[District,Type]= INTEG (
	Renters adopting RCPv flow[District,Type]-Rented buildings with RCPv demolished[District\
		,Type],
		0)
	~	
	~		|

House Value coefficient HT[Performance,HS] :EXCEPT: [Performance,HPs]=
	0.1295 ~~|
House Value coefficient HT[Performance,HPs]=
	House Value coefficient[Performance]
	~	Dmnl
	~		|

Rented buildings with PV[District,Type]= INTEG (
	Renters adopting PV flow[District,Type]-Rented buildings with PV demolished[District\
		,Type],
		SUM(Initial Heating Solution[District,HS!,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ))
	~	
	~		|

Requested Renters adopting RCP[District,HS,Performance,Type] :EXCEPT:        [District,HS,Performance\
		,MFH]=
	0 ~~|
Requested Renters adopting RCP[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario - 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) ) , 0 )
	~	
	~		|

Annual fuel cost archetype[District,HS,Performance,Type,PVpanel] :EXCEPT: [District,No Electricity\
		,Performance,Type,PVpanel]=
	0 ~~|
Annual fuel cost archetype[District,Oil,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler] ~~|
Annual fuel cost archetype[District,OilST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler] ~~|
Annual fuel cost archetype[District,Gas,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler] ~~|
Annual fuel cost archetype[District,GasST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler] ~~|
Annual fuel cost archetype[District,Wood,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler] ~~|
Annual fuel cost archetype[District,WoodST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler] ~~|
Annual fuel cost archetype[District,pellet,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District,PelletBoiler] ~~|
Annual fuel cost archetype[District,DH,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) * 0.12
	~	CHF
	~		|

Requested Renters adopting PV[District,HS,Performance,Type] :EXCEPT:                [District,HS\
		,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) * Probability adoption PV Renters\
		[District,HS,Performance,Type] ) , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] * ( 1 - Share urban buildings\
		[District,Type] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] * ( Energy Community scenario\
		 - 1 ) ) , 0 ) ~~|
Requested Renters adopting PV[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery!]) > \
		0 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,MFH] , 
	
	SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) * Probability adoption PV Renters\
		[District,HS,Performance,MFH] ) , 0 ) , 0 )
	~	
	~		|

Equipped buildings[District,Type]=
	SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!])
	~	
	~		|

Rented buildings with PV demolished[District,Type]=
	IF THEN ELSE( Equipped buildings[District,Type] > 0 , MAX(0, Rented buildings with PV\
		[District,Type]) / Equipped buildings[District,Type] * MIN(SUM(Building demolition by archetype\
		[District,HS!,Performance!,Type,PVyes,Battery!]) , Equipped buildings[District,Type\
		] ) , 0 )
	~	
	~		|

Rented buildings with RCP demolished[District,Type]=
	IF THEN ELSE( Equipped buildings[District,Type] > 0 , MAX(0, Rented buildings with RCP\
		[District,Type]) / Equipped buildings[District,Type] * MIN(SUM(Building demolition by archetype\
		[District,HS!,Performance!,Type,PVyes,Battery!]) , Equipped buildings[District,Type\
		] ) , 0 )
	~	
	~		|

Owned buildings with RCPv demolished[District,Type]=
	IF THEN ELSE( Equipped buildings[District,Type] > 0 , MAX(0, Owned buildings with RCPv\
		[District,Type]) / Equipped buildings[District,Type] * MIN(SUM(Building demolition by archetype\
		[District,HS!,Performance!,Type,PVyes,Battery!]) , Equipped buildings[District,Type\
		] ) , 0 )
	~	
	~		|

Rented buildings with RCPv demolished[District,Type]=
	IF THEN ELSE( Equipped buildings[District,Type] > 0 , MAX(0, Rented buildings with RCPv\
		[District,Type]) / Equipped buildings[District,Type] * MIN(SUM(Building demolition by archetype\
		[District,HS!,Performance!,Type,PVyes,Battery!]) , Equipped buildings[District,Type\
		] ) , 0 )
	~	
	~		|

Owned buildings with RCP demolished[District,Type]=
	IF THEN ELSE( Equipped buildings[District,Type] > 0 , MAX(0, Owned buildings with RCP\
		[District,Type]) / Equipped buildings[District,Type] * MIN(SUM(Building demolition by archetype\
		[District,HS!,Performance!,Type,PVyes,Battery!]) , Equipped buildings[District,Type\
		] ) , 0 )
	~	
	~		|

Owned buildings with PV demolished[District,Type]=
	IF THEN ELSE( Equipped buildings[District,Type] > 0 , MAX(0, Owned buildings with PV\
		[District,Type]) / Equipped buildings[District,Type] * MIN(SUM(Building demolition by archetype\
		[District,HS!,Performance!,Type,PVyes,Battery!]) , Equipped buildings[District,Type\
		] ) , 0 )
	~	
	~		|

Owned buildings with PV[District,Type]= INTEG (
	Owners adopting PV flow[District,Type]-Owned buildings with PV demolished[District,Type\
		],
		SUM(Initial Heating Solution[District,HS!,Performance!,Type,PVyes]) * Share of owned houses\
		[Type])
	~	
	~		|

Owned buildings with RCP[District,Type]= INTEG (
	Owners adopting RCP flow[District,Type]-Owned buildings with RCP demolished[District\
		,Type],
		0)
	~	
	~		|

Prove 2[Month,Hour]=
	PV hourly difference[Month,Hour] * Share PHS[Month,Hour]
	~	
	~		|

Prove[Month,Hour]=
	( PV hourly supply[Month,Hour] + RR hourly supply[Month,Hour] + Wind hourly supply[Month\
		,Hour] + Waste hourly supply[Month,Hour] + Hourly total inflow for Ticino[Month,Hour\
		] + Hourly PHS production[Month,Hour] )
	~	
	~		|

HP lifetime uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + HP lifetime uncertainty )
	~	
	~		|

Tertiary demand uncertainty factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Tertiary demand uncertainty )
	~	
	~		|

Ground specific cost Minergie=
	182 * Renovation cost index * Retrofit uncertain cost factor
	~	CHF/m2
	~		|

"Oil/gas lifetime uncertainty"=
	0
	~	
	~		|

"Oil/gas lifetime uncertainty factor"=
	IF THEN ELSE( Time < 2026 , 1 , 1 + "Oil/gas lifetime uncertainty" )
	~	
	~		|

Adoptions OilST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:      \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,OilST,Performance,Type,PVpanel] ~~|
Adoptions OilST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

PV uncertain cost=
	0
	~	
	~		|

Battery uncertain cost=
	0
	~	
	~		|

Battery uncertain cost factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Battery uncertain cost )
	~	
	~		|

Retrofit uncertain cost factor=
	IF THEN ELSE( Time < 2026 , 1 , 1 + Retrofit uncertain cost )
	~	
	~		|

New to MiddleAge delay[HS]=
	DELAY FIXED( New to MiddleAge[HS] , 4 , HS MiddleAge[HS] * Aging Rate[HS] )
	~	
	~		|

"PV > 100 kW investment cost Time adj"=
	"PV > 100 kW investment cost" * PV cumulative cost change * PV uncertain cost factor
	~	CHF
	~		|

Import price uncertainty=
	0
	~	
	~		|

Industry demand uncertainty=
	0
	~	
	~		|

Average energy price market=
	SUM(Electricity total hourly cost[Month!,Hour!]) / ( SUM(Hourly demand and PHS[Month\
		!,Hour!]) * 1e+06 ) * Import price uncertainty factor
	~	CHF/kWh
	~		|

Adoptions DH from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:     \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,DH,Performance,Type,PVpanel] ~~|
Adoptions DH from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Electricity consumption Industry=
	Electricity consumption Industry historical * Industry demand uncertainty factor
	~	GWh
	~	IF THEN ELSE( Time < 2024 , Electricity consumption Industry historical , \
		Electricity consumption Industry factor * 854 )
	|

Adoptions GasST from OS by archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:       \
		[District,NewS,Performance,Type,PVpanel]=
	SUM(Consumers leaving HS for old age[District,HS,Performance,Type,PVpanel,Battery!])\
		 * Market Share HS filtered[District,GasST,Performance,Type,PVpanel] ~~|
Adoptions GasST from OS by archetype[District,NewS,Performance,Type,PVpanel]=
	0
	~	building
	~		|

Wall specific cost CECE High=
	290 * Renovation cost index * Retrofit uncertain cost factor
	~	CHF/m2
	~		|

Electricity consumption Tertiary=
	Electricity consumption Tertiary historical * Tertiary demand uncertainty factor
	~	GWh
	~	IF THEN ELSE( Time < 2024 , Electricity consumption Tertiary historical , \
		Electricity consumption Tertiary factor * 744 )
	|

Tertiary demand uncertainty=
	0
	~	
	~		|

"Oil/gas carrier cost uncertainty factor"=
	IF THEN ELSE( Time < 2026 , 1 , 1 + "Oil/gas carrier cost uncertainty" )
	~	
	~		|

"Oil/gas carrier cost uncertainty"=
	0
	~	
	~		|

