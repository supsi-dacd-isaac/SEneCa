"Self consumption degree with Storage < 30 kW"=
	IF THEN ELSE( "kWh over MWh of demand < 30 kW" < 0.5 , "Average SC < 30 kW" + "Average SC < 30 kW"\
		 / 0.5 * ("SC 0.5 kWh/MWh < 30 kW" - "Average SC < 30 kW") , 
	IF THEN ELSE( "kWh over MWh of demand < 30 kW" < 1 , "SC 0.5 kWh/MWh < 30 kW" + ( "kWh over MWh of demand < 30 kW"\
		 - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh < 30 kW" - "SC 0.5 kWh/MWh < 30 kW") , 
	"SC 1.0 kWh/MWh < 30 kW" + ( "kWh over MWh of demand < 30 kW" - 1 ) / 0.5 * ("SC 1.5 kWh/MWh < 30 kW"\
		 - "SC 1.0 kWh/MWh < 30 kW") ) )
	~	Dmnl
	~		|

Total Battery adoption Res=
	SUM(Adoption Battery Type[Type!])
	~	
	~		|

"Share of Batteries >100 kW"=
	0.084
	~	
	~		|

Share of Batteries nonRes=
	0.0243
	~	
	~		|

"Share of Batteries < 30 kW"=
	0.763
	~	
	~		|

"kWp over MWh of demand < 30 kW"=
	0.75 + ( "Average SC < 30 kW" - 0.3 ) / ( 0.37 - 0.3 ) * ( 0.75 - 1 )
	~	kW/MWh
	~		|

"Self consumption degree with Storage > 100 kW"=
	IF THEN ELSE( "kWh over MWh of demand > 100 kW" < 0.5 , "Average SC > 100 kW" + "Average SC > 100 kW"\
		 / 0.5 * ("SC 0.5 kWh/MWh > 100 kW" - "Average SC > 100 kW") , 
	IF THEN ELSE( "kWh over MWh of demand > 100 kW" < 1 , "SC 0.5 kWh/MWh > 100 kW" + ( \
		"kWh over MWh of demand > 100 kW" - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh > 100 kW" - "SC 0.5 kWh/MWh > 100 kW"\
		) , 
	"SC 1.0 kWh/MWh > 100 kW" + ( "kWh over MWh of demand > 100 kW" - 1 ) / 0.5 * ("SC 1.5 kWh/MWh > 100 kW"\
		 - "SC 1.0 kWh/MWh > 100 kW") ) )
	~	Dmnl
	~		|

"SC 0.5 kWh/MWh > 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand > 100 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

"Average power PV < 30 kW"=
	11
	~	
	~		|

"SC 0.5 kWh/MWh < 30 kW"= WITH LOOKUP (
	"kWp over MWh of demand < 30 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

"SC 1.0 kWh/MWh 30 - 100 kW"= WITH LOOKUP (
	"kWp over MWh of demand 30 - 100 kW",
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(4,0.2) ))
	~	Dmnl
	~		|

Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Byes]=
	Consumers adopting PV yes[District,HS,Performance,Type,PVyes] * Probability adoption battery\
		[District,HS,Performance,Type] ~~|
Consumers adopting PV yes with battery[District,HS,Performance,Type,PVyes,Bno]=
	Consumers adopting PV yes[District,HS,Performance,Type,PVyes] * ( 1 - Probability adoption battery\
		[District,HS,Performance,Type] ) ~~|
Consumers adopting PV yes with battery[District,HS,Performance,Type,PVno,Battery]=
	0
	~	
	~		|

Consumers adopting RCPv yes[District,HS,Performance,Type,PVyes]=
	Owners adopting RCPv[District,HS,Performance,Type] + Renters adopting RCPv[District,\
		HS,Performance,Type] ~~|
Consumers adopting RCPv yes[District,HS,Performance,Type,PVno]=
	0
	~	
	~		|

Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Byes]=
	Consumers adopting RCPv yes[District,HS,Performance,Type,PVyes] * Probability adoption battery RCPv\
		[District,HS,Performance,Type] ~~|
Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Bno]=
	Consumers adopting RCPv yes[District,HS,Performance,Type,PVyes] * ( 1 - Probability adoption battery RCPv\
		[District,HS,Performance,Type] ) ~~|
Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVno,Battery]=
	0
	~	building
	~		|

Battery total savings RCPv[District,HS,Performance,Type]=
	Saved energy annually RCPv[District,HS,Performance,Type] * (Electricity price[District\
		] - PV cumulative compensation price) *  ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ Battery lifetime\
		 ) ) ) / Interest rate
	~	
	~		|

"SC 1.5 kWh/MWh RCPv"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		       ([(0,0)-(10,10)],(0,1),(0.25,0.97),(0.5,0.92),(0.75,0.81),(1,0.67),(1.25,0.57\
		),(1.5,0.48),(1.75,0.43),(2.25,0.35),(7,0.3) ))
	~	Dmnl
	~		|

Battery Eco factor RCPv[District,HS,Performance,Type]=
	Battery economic utility RCPv[District,HS,Performance,Type] * Battery Eco weight
	~	
	~		|

Battery economic utility RCPv[District,HS,Performance,Type]=
	( ( Battery total savings RCPv[District,HS,Performance,Type] - Battery initial investment RCPv\
		[District,HS,Performance,Type] ) / Battery initial investment RCPv[District,HS,Performance\
		,Type] / Battery lifetime ) * 100
	~	
	~		|

Additional annual PV kWh self consumed by archetype[District,HS,Performance,Type]=
	Additional annual PV kWh produced by archetype[District,HS,Performance,Type,Bno] * Self consumption degree\
		[District,HS,Performance,Type] +
	Additional annual PV kWh produced by archetype[District,HS,Performance,Type,Byes] * \
		Self consumption degree with Storage[District,HS,Performance,Type] +
	Additional annual RCPv kWh produced by archetype[District,HS,Performance,Type,Bno] *\
		 Self consumption degree RCPv[District,HS,Performance,Type] +
	Additional annual RCPv kWh produced by archetype[District,HS,Performance,Type,Byes] \
		* Self consumption degree with Storage RCPv[District,HS,Performance,Type]
	~	kWh
	~		|

RCPv adoptions by archetype[District,HS,Performance,Type,Battery]= DELAY FIXED (
	Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes,Battery]\
		 , 0.01, 0)
	~	building
	~		|

New buildings installing PV[District,HS,Performance,Type,Battery]=
	Buildings construction with battery[District,HS,Performance,Type,PVyes,Battery]
	~	building
	~		|

"SC 0.5 kWh/MWh RCPv"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(7,0.08) ))
	~	Dmnl
	~		|

"Average El consumption 30 - 100 kW"=
	"Average power PV 30 - 100 kW" / ( "kWp over MWh of demand 30 - 100 kW" / 1000 )
	~	kWh
	~		|

"SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(7,0.25) ))
	~	Dmnl
	~		|

Probability adoption battery RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2016, 0 , 
	Utility battery exp RCPv[District,HS,Performance,Type] / ( 1 + Utility battery exp RCPv\
		[District,HS,Performance,Type] ) )
	~	
	~		|

"kWp over MWh of demand 30 - 100 kW"=
	0.5 + ( "Average SC 30 - 100 kW" - 0.48 ) / ( 0.68 - 0.48 ) * ( 0.25 - 0.5 )
	~	kW/MWh
	~		|

"kWp over MWh of demand > 100 kW"=
	0.5 + ( "Average SC > 100 kW" - 0.48 ) / ( 0.68 - 0.48 ) * ( 0.25 - 0.5 )
	~	kW/MWh
	~		|

PV adoptions by archetype[District,HS,Performance,Type,Battery]= DELAY FIXED (
	New buildings installing PV[District,HS,Performance,Type,Battery] + Consumers adopting PV yes with battery\
		[District,HS,Performance,Type,PVyes,Battery] , 0.01, 0)
	~	building
	~		|

Self consumption degree with Storage RCPv[District,HS,Performance,Type]=
	IF THEN ELSE( kWh over MWh of demand RCPv[District,HS,Performance,Type] < 0.5 , Self consumption degree RCPv\
		[District,HS,Performance,Type] + kWh over MWh of demand RCPv[District,HS,Performance\
		,Type] / 0.5 * ("SC 0.5 kWh/MWh RCPv"[District,HS,Performance,Type] - Self consumption degree RCPv\
		[District,HS,Performance,Type]) , 
	IF THEN ELSE( kWh over MWh of demand RCPv[District,HS,Performance,Type] < 1 , "SC 0.5 kWh/MWh RCPv"\
		[District,HS,Performance,Type] + ( kWh over MWh of demand RCPv[District,HS,Performance\
		,Type] - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type] - "SC 0.5 kWh/MWh RCPv"\
		[District,HS,Performance,Type]) , 
	"SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type] + ( kWh over MWh of demand RCPv[\
		District,HS,Performance,Type] - 1 ) / 0.5 * ("SC 1.5 kWh/MWh RCPv"[District,HS,Performance\
		,Type] - "SC 1.0 kWh/MWh RCPv"[District,HS,Performance,Type]) ) )
	~	
	~		|

Utility battery exp RCPv[District,HS,Performance,Type]=
	exp(Utility battery RCPv[District,HS,Performance,Type])
	~	
	~		|

Saved energy annually RCPv[District,HS,Performance,Type]=
	El consumption per building[District,HS,Performance,Type] * (Self consumption degree with Storage RCPv\
		[District,HS,Performance,Type] - Self consumption degree RCPv[District,HS,Performance\
		,Type]) * Decentralized storage efficiency
	~	
	~		|

Battery capacity RCPv[District,HS,Performance,Type]=
	MIN( Battery capacity 1 RCPv[District,Performance,Type] , Battery capacity 2[District\
		,HS,Performance,Type] )
	~	
	~		|

kWh over MWh of demand RCPv[District,HS,Performance,Type]=
	Battery capacity RCPv[District,HS,Performance,Type] / El consumption per building[District\
		,HS,Performance,Type] * 1000
	~	
	~		|

"Average El consumption > 100 kW"=
	"Average power PV > 100 kW" / ( "kWp over MWh of demand > 100 kW" / 1000 )
	~	kWh
	~		|

"PV annual adoption 30 - 100 kW"=
	SUM("Yearly installed capacity PV 30 - 100 kW District"[District!]) / "Average power PV 30 - 100 kW"
	~	
	~		|

"PV annual adoption > 100 kW"=
	SUM("Yearly installed capacity PV > 100 kW District"[District!]) / "Average power PV > 100 kW"
	~	
	~		|

Ratio annual adoption PV=
	"PV annual adoption 30 - 100 kW" / "PV annual adoption > 100 kW"
	~	
	~		|

Houly electricity cost PV hours[Month,Hour]=
	PV hourly supply[Month,Hour] * Electricity market price[Month,Hour]
	~	
	~		|

Average price PV hours=
	SUM(Houly electricity cost PV hours[Month!,Hour!]) * 365/12 / Total PV electricity injected in the grid
	~	
	~		|

"Capacity PV 30 - 100 kW total"=
	SUM("Capacity PV 30 - 100 kW District"[District!])
	~	kW
	~		|

Share Capacity nonRes=
	Total PV capacity nonRes / (Production PV residential + Total PV capacity nonRes)
	~	Dmnl
	~		|

Share Capacity Res=
	Production PV residential / (Production PV residential + Total PV capacity nonRes)
	~	Dmnl
	~		|

"Total PV kWh self consumed < 30"[District]= INTEG (
	"Additional annual PV kWh self consumed < 30"[District],
		0)
	~	kWh
	~		|

Total PV capacity nonRes=
	( "Capacity PV < 30 kW total" + "Capacity PV > 100 kW total" + "Capacity PV 30 - 100 kW total"\
		 ) * PV annual generation per kW / 1e+06
	~	GWh
	~		|

Total consumption nonRes=
	Electricity consumption Tertiary + Electricity consumption Industry
	~	GWh
	~		|

PV hourly production[Month,Hour]=
	Total PV electricity production * Hour factor PV[Month,Hour]
	~	
	~		|

"Total PV kWh self consumed > 100 kW"[District]= INTEG (
	"Additional annual PV kWh self consumed > 100 kW"[District],
		0)
	~	kWh
	~		|

"Total PV kWh self consumed 30 - 100 kW"[District]= INTEG (
	"Additional annual PV kWh self consumed 30 - 100 kW"[District],
		0)
	~	kWh
	~		|

Total consumption Res=
	SUM(Residential electricity cons by District[District!]) / 1e+06
	~	GWh
	~		|

"Capacity PV > 100 kW total"=
	SUM("Capacity PV > 100 kW District"[District!])
	~	kW
	~		|

"Capacity PV < 30 kW total"=
	SUM("Capacity PV < 30 kW"[District!])
	~	kW
	~		|

Total annual grid demand Districts[District]=
	Total annual demand Districts[District] - PV electricity SC by District[District] * \
		1e+06
	~	kWh
	~		|

Share additional power RCPv=
	0.5
	~	
	~		|

Residential electricity cons SH by District[District]=
	SUM(Residential electricity cons SH by arch[District,HS!,Performance!,Type!])
	~	kWh
	~		|

Residential electricity cons DHW by District[District]=
	SUM(Residential electricity cons DHW by arch[District,HS!,Performance!,Type!])
	~	kWh
	~		|

Self consumption degree RCPv[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand RCPv[District,HS,Performance,Type],
		   ([(0,0)-(10,10)],(0,1),(0.25,0.68),(0.5,0.48),(0.75,0.37),(1,0.3),(1.5,0.23),(1.75\
		,0.205),(2.5,0.15),(7,0.04) ))
	~	Dmnl
	~		|

PE battery weight=
	0
	~	
	~		|

Battery Eco weight=
	PV Eco weight
	~	
	~		|

SC degree difference[District,HS,Performance,Type]=
	Self consumption degree with Storage[District,HS,Performance,Type] - Self consumption degree\
		[District,HS,Performance,Type]
	~	
	~		|

SC degree difference by HS[HS]=
	SUM(SC degree difference[District!,HS,Performance!,Type!]) / 8 / 5 / 3
	~	
	~		|

SC degree difference by Performance[Performance]=
	SUM(SC degree difference[District!,HS!,Performance,Type!]) / 8 / 11 / 3
	~	
	~		|

Log PE battery=
	MAX( LOG( Battery PE + 0.001 , 10 ) , -2 )
	~	
	~		|

Battery PE=
	SUM(Heating Solution[District!,HS!,Performance!,Type!,PVyes,Byes]) / SUM(Heating Solution\
		[District!,HS!,Performance!,Type!,PVyes,Battery!])
	~	
	~		|

Battery Eco factor[District,HS,Performance,Type]=
	Battery economic utility[District,HS,Performance,Type] * Battery Eco weight
	~	
	~		|

Alpha battery Type[Type]=
	0,
	0,
	0
	~	
	~		|

Alpha battery District[District]=
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	0
	~	
	~		|

PE battery factor=
	Log PE battery * PE battery weight
	~	
	~		|

SC degree difference by Type[Type]=
	SUM(SC degree difference[District!,HS!,Performance!,Type]) / 8 / 5 / 11
	~	
	~		|

"Yearly installed capacity PV > 100 kW"[District]=
	exp("Utility PV > 100 kW"[District]) / ( 1 + exp("Utility PV > 100 kW"[District]) ) \
		* 
	( "Capacity potential PV > 100 kW" - "Capacity PV > 100 kW" ) * Share PV capacity installed per District\
		[District] / 0.125
	~	kW
	~		|

Buildings with PV Type[Type]=
	SUM(Heating Solution[District!,HS!,Performance!,Type,PVyes,Battery!])
	~	
	~		|

Battery Type Log Likelihood=
	IF THEN ELSE( Time < 2025 , 
	Adoption Battery Type Data[SFH] * LN( Probability of Adoption Battery Type[SFH] ) + \
		( Buildings PV Bno Type[SFH] - Adoption Battery Type Data[SFH] ) * LN( 1 - Probability of Adoption Battery Type\
		[SFH] ) + 
	Adoption Battery Type Data[MFH] * LN( Probability of Adoption Battery Type[MFH] ) + \
		( Buildings PV Bno Type[MFH] - Adoption Battery Type Data[MFH] ) * LN( 1 - Probability of Adoption Battery Type\
		[MFH] ) , 0 )
	~	
	~		|

Adoption Battery District Data[District]:INTERPOLATE::=
	GET VDF DATA( 'PVinput.vdfx', 'Adoption Battery District[District]' , 0 , 1 )
	~	
	~		|

"Delta 30 - 100 kW"=
	-4
	~	
	~		|

Battery District Log Likelihood[District]=
	IF THEN ELSE( Time < 2025 , Adoption Battery District Data[District] * LN( Probability of Adoption Battery District\
		[District] ) + ( Buildings PV Bno District[District] - Adoption Battery District Data\
		[District] ) * LN( 1 - Probability of Adoption Battery District[District] ) , 0 )
	~	
	~		|

Buildings PV Bno District[District]:INTERPOLATE::=
	GET VDF DATA( 'PVinput.vdfx', 'Buildings PV Bno District[District]' , 0 , 1 )
	~	
	~		|

Buildings PV Bno Type[Type]:INTERPOLATE::=
	GET VDF DATA( 'PVinput.vdfx', 'Buildings PV Bno Type[Type]' , 0 , 1 )
	~	
	~		|

Adoption Battery Type Data[Type]:INTERPOLATE::=
	GET VDF DATA( 'PVinput.vdfx', 'Adoption Battery Type[Type]' , 0 , 1 )
	~	
	~		|

Buildings with PV by District[District]=
	SUM(Heating Solution[District,HS!,Performance!,Type!,PVyes,Battery!])
	~	
	~		|

PV nonRes Eco weight=
	0
	~	Dmnl
	~		|

Probability of Adoption Battery District[District]=
	Adoption Battery District[District] / Buildings PV Bno District[District]
	~	
	~		|

"Yearly installed capacity PV 30 - 100 kW"[District]=
	exp("Utility PV 30 - 100 kW"[District]) / ( 1 + exp("Utility PV 30 - 100 kW"[District\
		]) ) * 
	( "Capacity potential PV 30 - 100 kW" - "Capacity PV 30 - 100 kW" ) * Share PV capacity installed per District\
		[District] / 0.125
	~	kW
	~		|

Probability of Adoption Battery Type[Type]=
	Adoption Battery Type[Type] / Buildings PV Bno Type[Type]
	~	
	~		|

Average Economic Utility HS no incentives[HS]=
	SUM(Economic Utility HS no incentives[District!,HS,Performance!,Type!,PVpanel!]) / 8\
		 / 5 / 3 / 2
	~	
	~		|

Peer effect V weight=
	0
	~	
	~		|

Share of consumers considering PV stock factor[District]=
	Log peer effect[District] * Share of consumers considering PV weight
	~	
	~		|

HS VeryOld demolited[HS]=
	IF THEN ELSE( HS VeryOld[HS] > SUM(Building demolition by archetype[District!,HS,Performance\
		!,Type!,PVpanel!,Battery!]) , SUM(Building demolition by archetype[District!,HS,Performance\
		!,Type!,PVpanel!,Battery!]) , 0 )
	~	
	~		|

Buildings construction with battery[District,OldS,Performance,Type,PVyes,Byes]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,OldS,Performance,Type,PVyes] * Probability adoption battery[District,OldS\
		,Performance,Type] , 0 ) ~~|
Buildings construction with battery[District,OldS,Performance,Type,PVyes,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,OldS,Performance,Type,PVyes] * ( 1 - Probability adoption battery[District\
		,OldS,Performance,Type] ) , 0 ) ~~|
Buildings construction with battery[District,OldS,Performance,Type,PVno,Byes]=
	0 ~~|
Buildings construction with battery[District,OldS,Performance,Type,PVno,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVno] * Market Share HS no incentives filtered\
		[District,OldS,Performance,Type,PVno] , 0 ) ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVyes,Byes]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] * Probability adoption battery[District,NewS\
		,Performance,Type] ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] / SUM(Market Share HS no incentives filtered\
		[District,NewS!,Performance,Type,PVyes]) * Probability adoption battery[District,NewS\
		,Performance,Type] ) ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVyes,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] * ( 1 - Probability adoption battery[District\
		,NewS,Performance,Type] ) ,
	
	Building construction by archetype[District,Performance,Type,PVyes] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVyes] / SUM(Market Share HS no incentives filtered\
		[District,NewS!,Performance,Type,PVyes]) * ( 1 - Probability adoption battery[District\
		,NewS,Performance,Type] ) ) ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVno,Byes]=
	0 ~~|
Buildings construction with battery[District,NewS,Performance,Type,PVno,Bno]=
	IF THEN ELSE( Time < 2025 ,
	
	Building construction by archetype[District,Performance,Type,PVno] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVno] ,
	
	Building construction by archetype[District,Performance,Type,PVno] * Market Share HS no incentives filtered\
		[District,NewS,Performance,Type,PVno] / SUM(Market Share HS no incentives filtered[\
		District,NewS!,Performance,Type,PVno]) )
	~	building
	~		|

Adoption PV HeatPump=
	SUM(Owners adopting PV[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting PV\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCP[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Building construction by archetype[District!,Performance!,Type!,PVyes]) * SUM(Heating Solution\
		[District!,HeatPump,Performance!,Type!,PVyes,Battery!]) / SUM(Heating Solution[District\
		!,HS!,Performance!,Type!,PVyes,Battery!]) + 0.0001
	~	
	~		|

"SC 0.5 kWh/MWh"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.92),(0.5,0.68),(0.75,0.57),(1,0.48),(1.25,0.4)\
		,(1.5,0.35),(1.75,0.3),(2.25,0.25),(4,0.14) ))
	~	Dmnl
	~		|

Adoption PV no HeatPump=
	( SUM(Owners adopting PV[District!,HS!,Performance!,Type!]) + SUM(Renters adopting PV\
		[District!,HS!,Performance!,Type!]) + 
	SUM(Owners adopting RCP[District!,HS!,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District!,HS!,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District!,HS!,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District!,HS!,Performance!,Type!]) ) - 
	
	( SUM(Owners adopting PV[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting PV\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCP[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District!,HeatPump,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District!,HeatPump,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District!,HeatPump,Performance!,Type!]) ) +
	
	SUM(Building construction by archetype[District!,Performance!,Type!,PVyes]) * ( SUM(\
		Heating Solution[District!,HS!,Performance!,Type!,PVyes,Battery!]) - SUM(Heating Solution\
		[District!,HeatPump,Performance!,Type!,PVyes,Battery!]) ) / SUM(Heating Solution[District\
		!,HS!,Performance!,Type!,PVyes,Battery!]) + 0.0001
	~	
	~		|

Share of buildings with HP by District[District]=
	SUM(Heating Solution[District,HeatPump,Performance!,Type!,PVpanel!,Battery!]) / SUM(\
		Heating Solution[District,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Share of buildings with PV by District[District]=
	SUM(Heating Solution[District,HS!,Performance!,Type!,PVyes,Battery!]) / SUM(Heating Solution\
		[District,HS!,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Battery lifetime=
	15
	~	
	~		|

Battery total savings[District,HS,Performance,Type]=
	Saved energy annually[District,HS,Performance,Type] * (Electricity price[District] -\
		 PV cumulative compensation price) *  ( 1 - ( 1 / ( ( 1 + Interest rate ) ^ Battery lifetime\
		 ) ) ) / Interest rate
	~	
	~		|

Initial Heating Solution battery[District,HS,Performance,Type,PVpanel,Bno]=
	Initial Heating Solution[District,HS,Performance,Type,PVpanel] ~~|
Initial Heating Solution battery[District,HS,Performance,Type,PVpanel,Byes]=
	0
	~	
	~		|

Buildings by Performance MFH[Performance]=
	SUM(Heating Solution[District!,HS!,Performance,MFH,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Self consumption degree with Storage[District,HS,Performance,Type]=
	IF THEN ELSE( kWh over MWh of demand[District,HS,Performance,Type] < 0.5 , Self consumption degree\
		[District,HS,Performance,Type] + kWh over MWh of demand[District,HS,Performance,Type\
		] / 0.5 * ("SC 0.5 kWh/MWh"[District,HS,Performance,Type] - Self consumption degree\
		[District,HS,Performance,Type]) , 
	IF THEN ELSE( kWh over MWh of demand[District,HS,Performance,Type] < 1 , "SC 0.5 kWh/MWh"\
		[District,HS,Performance,Type] + ( kWh over MWh of demand[District,HS,Performance,Type\
		] - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh"[District,HS,Performance,Type] - "SC 0.5 kWh/MWh"\
		[District,HS,Performance,Type]) , 
	"SC 1.0 kWh/MWh"[District,HS,Performance,Type] + ( kWh over MWh of demand[District,HS\
		,Performance,Type] - 1 ) / 0.5 * ("SC 1.5 kWh/MWh"[District,HS,Performance,Type] - \
		"SC 1.0 kWh/MWh"[District,HS,Performance,Type]) ) )
	~	
	~		|

Total over HS present variable costs SH[District,HS,Performance,Type]=
	Total present variable costs SH roof[District,HS,Performance,Type] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Total over HS present variable costs SH Ground[District,HS,Performance,Type]=
	Total present variable costs SH Ground[District,HS,Performance,Type] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Total over HS present variable costs SH Wall[District,HS,Performance,Type]=
	Total present variable costs SH Wall[District,HS,Performance,Type] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Battery:
	Byes, Bno
	~	
	~		|

kWh over MWh of demand[District,HS,Performance,Type]=
	Battery capacity[District,HS,Performance,Type] / El consumption per building[District\
		,HS,Performance,Type] * 1000
	~	
	~		|

Total present variable costs SH average[District,Performance,Type]=
	SUM(Total over HS present variable costs SH[District,HS!,Performance,Type]) / SUM(Heating Solution\
		[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Battery capacity 2[District,HS,Performance,Type]=
	El consumption per building[District,HS,Performance,Type] / 2 / 365
	~	kWh
	~		|

"SC 1.5 kWh/MWh"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand[District,HS,Performance,Type],
		       ([(0,0)-(10,10)],(0,1),(0.25,0.97),(0.5,0.92),(0.75,0.81),(1,0.67),(1.25,0.57\
		),(1.5,0.48),(1.75,0.43),(2.25,0.35),(4,0.25) ))
	~	Dmnl
	~		|

Decentralized storage efficiency=
	0.9
	~	
	~		|

Residential electricity cons DHW by arch[District,HS,Performance,Type]=
	Residential electricity cons DHW per building[District,HS,Performance,Type] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel!,Battery!]) * Share primary houses[District]
	~	kWh
	~		|

Buildings by HS[HS]=
	SUM(Heating Solution[District!,HS,Performance!,Type!,PVpanel!,Battery!])
	~	
	~		|

Residential electricity cons SH by arch[District,HS,Performance,Type]=
	Residential electricity cons SH per building[District,HS,Performance,Type] * SUM(Heating Solution\
		[District,HS,Performance,Type,PVpanel!,Battery!]) * Share primary houses[District]
	~	kWh
	~		|

Res total construction by Perf Type District[VeryLow,Type,District]=
	0 ~~|
Res total construction by Perf Type District[Low,Type,District]=
	0 ~~|
Res total construction by Perf Type District[Moderate,Type,District]=
	Overall constructed buildings * SUM(Heating Solution[District,HS!,Moderate,Type,PVpanel\
		!,Battery!]) / 
	( SUM(Heating Solution[District!,HS!,Moderate,Type!,PVpanel!,Battery!]) + SUM(Heating Solution\
		[District!,HS!,High,Type!,PVpanel!,Battery!]) + SUM(Heating Solution[District!,HS!,\
		VeryHigh,Type!,PVpanel!,Battery!])) ~~|
Res total construction by Perf Type District[High,Type,District]=
	Overall constructed buildings * SUM(Heating Solution[District,HS!,High,Type,PVpanel!\
		,Battery!]) / 
	( SUM(Heating Solution[District!,HS!,Moderate,Type!,PVpanel!,Battery!]) + SUM(Heating Solution\
		[District!,HS!,High,Type!,PVpanel!,Battery!]) + SUM(Heating Solution[District!,HS!,\
		VeryHigh,Type!,PVpanel!,Battery!])) ~~|
Res total construction by Perf Type District[VeryHigh,Type,District]=
	Overall constructed buildings * SUM(Heating Solution[District,HS!,VeryHigh,Type,PVpanel\
		!,Battery!]) / 
	( SUM(Heating Solution[District!,HS!,Moderate,Type!,PVpanel!,Battery!]) + SUM(Heating Solution\
		[District!,HS!,High,Type!,PVpanel!,Battery!]) + SUM(Heating Solution[District!,HS!,\
		VeryHigh,Type!,PVpanel!,Battery!]))
	~	
	~		|

Probability adoption battery[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2016, 0 , 
	Utility battery exp[District,HS,Performance,Type] / ( 1 + Utility battery exp[District\
		,HS,Performance,Type] ) )
	~	
	~		|

"Residential light & appl cons by arch"[District,Performance,Type]=
	Annual light and appl demand by arch[Performance,District,Type] * SUM(Heating Solution\
		[District,HS!,Performance,Type,PVpanel!,Battery!]) * Share primary houses[District]
	~	kWh
	~		|

Alpha battery=
	-2
	~	
	~		|

Battery economic utility[District,HS,Performance,Type]=
	( ( Battery total savings[District,HS,Performance,Type] - Battery initial investment\
		[District,HS,Performance,Type] ) / Battery initial investment[District,HS,Performance\
		,Type] / Battery lifetime ) * 100
	~	
	~		|

Total present variable costs SH average Wall[District,Performance,Type]=
	SUM(Total over HS present variable costs SH Wall[District,HS!,Performance,Type]) / SUM\
		(Heating Solution[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Utility battery exp[District,HS,Performance,Type]=
	exp(Utility battery[District,HS,Performance,Type])
	~	
	~		|

Saved energy annually[District,HS,Performance,Type]=
	El consumption per building[District,HS,Performance,Type] * (Self consumption degree with Storage\
		[District,HS,Performance,Type] - Self consumption degree[District,HS,Performance,Type\
		]) * Decentralized storage efficiency
	~	
	~		|

Total present variable costs SH average Ground[District,Performance,Type]=
	SUM(Total over HS present variable costs SH Ground[District,HS!,Performance,Type]) /\
		 SUM(Heating Solution[District,HS!,Performance,Type,PVpanel!,Battery!])
	~	
	~		|

Check[District,Type]=
	Owned buildings with PV[District,Type] + Rented buildings with PV[District,Type] + 
	Owned buildings with RCP[District,Type] + Rented buildings with RCP[District,Type] +\
		 
	Owned buildings with RCPv[District,Type] + Rented buildings with RCPv[District,Type]\
		 - SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Buildings by Type and District[District,Type]=
	SUM(Heating Solution[District,HS!,Performance!,Type,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

Buildings by Performance[Performance]=
	SUM(Heating Solution[District!,HS!,Performance,Type!,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

"SC 1.0 kWh/MWh"[District,HS,Performance,Type]= WITH LOOKUP (
	kWp over MWh of demand[District,HS,Performance,Type],
		      ([(0,0)-(10,10)],(0,1),(0.25,0.95),(0.5,0.9),(0.75,0.73),(1,0.59),(1.25,0.5),\
		(1.5,0.43),(1.75,0.38),(2.25,0.3),(4,0.2) ))
	~	Dmnl
	~		|

Buildings by Performance SFH[Performance]=
	SUM(Heating Solution[District!,HS!,Performance,SFH,PVpanel!,Battery!]) + SUM(Heating Solution\
		[District!,HS!,Performance,DFH,PVpanel!,Battery!])
	~	
	~		~	:SUPPLEMENTARY 
	|

PV rebate federal=
	0.2
	~	
	~		|

Efficiency increment factor=
	IF THEN ELSE( Time < 2025 , 1 , 1 - 0.3 * (Time - 2025) / (2050 - 2025) )
	~	
	~		|

Total buildings with PV by Type[Type]=
	Buildings with PV by Type[Type] + Buildings with RCP by Type[Type] + Buildings with RCPv by Type\
		[Type]
	~	
	~		~	:SUPPLEMENTARY 
	|

Share of owned houses[Type]=
	0.634,
	0.634,
	0.228
	~	
	~		|

Owned buildings with RCPv PVno[District,Type]= INTEG (
	Owners adopting RCPv PVno flow[District,Type],
		0)
	~	
	~		|

Owners adopting PV flow[District,Type]=
	MAX( IF THEN ELSE( Owned buildings with PV[District,Type] > 0 , 
	
	SUM(Owners adopting PV[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * Share of owned houses\
		[Type] * Owned buildings with PV[District,Type] / ( Owned buildings with PV[District\
		,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Owners adopting PV[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Owners adopting RCP flow[District,Type]=
	MAX( IF THEN ELSE( Owned buildings with PV[District,Type] > 0 , 
	
	SUM(Owners adopting RCP[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * Share of owned houses\
		[Type] * Owned buildings with RCP[District,Type] / ( Owned buildings with PV[District\
		,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Owners adopting RCP[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Share urban buildings[District,Type]=TABBED ARRAY(
	0.694	0.693	0.714
	0.25	0.25	0.25
	0.25	0.25	0.25
	0.489	0.504	0.632
	0.628	0.634	0.677
	0.666	0.695	0.716
	0.5	0.5	0.5
	0.25	0.25	0.25
	)
	~	
	~		|

Renters adopting PV flow[District,Type]=
	MAX( IF THEN ELSE( Rented buildings with PV[District,Type] > 0 , 
	
	SUM(Renters adopting PV[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ) * Rented buildings with PV[District,Type] / ( Rented buildings with PV[District\
		,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Renters adopting PV[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Renters adopting RCP flow[District,Type]=
	MAX( IF THEN ELSE( Rented buildings with PV[District,Type] > 0 , 
	
	SUM(Renters adopting RCP[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ) * Rented buildings with RCP[District,Type] / ( Rented buildings with PV[District\
		,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Renters adopting RCP[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Renters adopting RCPv flow[District,Type]=
	MAX( IF THEN ELSE( Rented buildings with PV[District,Type] > 0 , 
	
	SUM(Renters adopting RCPv[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ) * Rented buildings with RCPv[District,Type] / ( Rented buildings with PV[District\
		,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv[District\
		,Type] ) , 
	
	SUM(Renters adopting RCPv[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Buildings with RCP by Type[Type]=
	SUM(Owned buildings with RCP[District!,Type]) + SUM(Rented buildings with RCP[District\
		!,Type])
	~	
	~		|

Buildings with RCPv by Type[Type]=
	SUM(Owned buildings with RCPv[District!,Type]) + SUM(Rented buildings with RCPv[District\
		!,Type])
	~	
	~		|

Owners adopting RCPv PVno flow[District,Type]=
	Owners adopting RCPv flow[District,Type] * Buildings PVno connected to RCPv
	~	
	~		|

Rented buildings with RCPv PVno[District,Type]= INTEG (
	Renters adopting RCPv PVno flow[District,Type],
		0)
	~	
	~		|

Adoption PV Performance[Performance]=
	SUM(Owners adopting PV[District!,HS!,Performance,Type!]) + SUM(Owners adopting RCP[District\
		!,HS!,Performance,Type!]) + 
	SUM(Renters adopting PV[District!,HS!,Performance,Type!]) + SUM(Renters adopting RCP\
		[District!,HS!,Performance,Type!]) + 
	SUM(Owners adopting RCPv[District!,HS!,Performance,Type!]) + SUM(Renters adopting RCPv\
		[District!,HS!,Performance,Type!]) + 
	SUM(Building construction by archetype[District!,Performance,Type!,PVyes]) + 0.001
	~	
	~		|

Adoption PV Type[Type]=
	SUM(Owners adopting PV[District!,HS!,Performance!,Type]) + SUM(Owners adopting RCP[District\
		!,HS!,Performance!,Type]) + 
	SUM(Renters adopting PV[District!,HS!,Performance!,Type]) + SUM(Renters adopting RCP\
		[District!,HS!,Performance!,Type]) + 
	SUM(Owners adopting RCPv[District!,HS!,Performance!,Type]) + SUM(Renters adopting RCPv\
		[District!,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District!,Performance!,Type,PVyes]) + 0.001
	~	
	~		|

Adoption PV District[District]=
	SUM(Owners adopting PV[District,HS!,Performance!,Type!]) + SUM(Owners adopting RCP[District\
		,HS!,Performance!,Type!]) + 
	SUM(Renters adopting PV[District,HS!,Performance!,Type!]) + SUM(Renters adopting RCP\
		[District,HS!,Performance!,Type!]) + 
	SUM(Owners adopting RCPv[District,HS!,Performance!,Type!]) + SUM(Renters adopting RCPv\
		[District,HS!,Performance!,Type!])+ 
	SUM(Building construction by archetype[District,Performance!,Type!,PVyes]) + 0.001
	~	
	~		|

Owners adopting RCPv flow[District,Type]=
	MAX( IF THEN ELSE( Owned buildings with PV[District,Type] > 0 , 
	
	SUM(Owners adopting RCPv[District,HS!,Performance!,Type]) + 
	SUM(Building construction by archetype[District,Performance!,Type,PVyes]) * Share of owned houses\
		[Type] * Owned buildings with RCPv[District,Type] / ( Owned buildings with PV[District\
		,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv[District\
		,Type] ), 
	
	SUM(Owners adopting RCPv[District,HS!,Performance!,Type]) ) , 0 )
	~	
	~		|

Energy Community scenario=
	0
	~	
	~		|

Buildings with PV by Type[Type]=
	SUM(Owned buildings with PV[District!,Type]) + SUM(Rented buildings with PV[District\
		!,Type])
	~	
	~		|

RCPv Eco Renter factor[District,HS,Performance,Type]=
	RCPv Eco Utility Renter[District,HS,Performance,Type] * PV Eco weight
	~	Dmnl
	~		|

PV Eco Renter factor[District,HS,Performance,Type]=
	PV Eco Utility Renter[District,HS,Performance,Type] * PV Eco weight
	~	Dmnl
	~		|

Utility PV Renter[District,HS,Performance,Type]=
	Utility PV no Eco[District,HS,Type,Performance] + PV Eco Renter factor[District,HS,Performance\
		,Type]
	~	Dmnl
	~		|

Probability adoption RCP Owners[District,HS,Performance,Type]=
	Utility RCP Owners exp[District,HS,Performance,Type] / (1 + Utility RCP Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~		|

Probability adoption RCP Renters[District,HS,Performance,Type]=
	Utility RCP Renter exp[District,HS,Performance,Type] / (1 + Utility RCP Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~		|

Probability adoption RCPv Owners[District,HS,Performance,Type]=
	Utility RCPv Owners exp[District,HS,Performance,Type] / (1 + Utility RCPv Owners exp\
		[District,HS,Performance,Type])
	~	Dmnl
	~		|

Probability adoption RCPv Renters[District,HS,Performance,Type]=
	Utility RCPv Renter exp[District,HS,Performance,Type] / (1 + Utility RCPv Renter exp\
		[District,HS,Performance,Type])
	~	Dmnl
	~		|

RCP Eco Renter factor[District,HS,Performance,Type]=
	RCP Eco Utility Renter[District,HS,Performance,Type] * PV Eco weight
	~	Dmnl
	~		|

Utility RCPv Owners exp[District,HS,Performance,Type]=
	exp( Utility RCPv Owners[District,HS,Performance,Type] )
	~	Dmnl
	~		|

Utility PV Renter exp[District,HS,Performance,Type]=
	exp( Utility PV Renter[District,HS,Performance,Type] )
	~	Dmnl
	~		|

RCPv Eco Owners factor[District,HS,Performance,Type]=
	RCPv Eco Utility Owners[District,HS,Performance,Type] * PV Eco weight
	~	Dmnl
	~		|

Utility RCP Owners[District,HS,Performance,Type]=
	Utility PV no Eco[District,HS,Type,Performance] + RCP Eco Owners factor[District,HS,\
		Performance,Type]
	~	Dmnl
	~		|

Utility RCP Owners exp[District,HS,Performance,Type]=
	exp( Utility RCP Owners[District,HS,Performance,Type] )
	~	Dmnl
	~		|

Utility RCP Renter[District,HS,Performance,Type]=
	Utility PV no Eco[District,HS,Type,Performance] + RCP Eco Renter factor[District,HS,\
		Performance,Type]
	~	Dmnl
	~		|

Utility RCPv Renter[District,HS,Performance,Type]=
	Utility PV no Eco[District,HS,Type,Performance] + RCPv Eco Renter factor[District,HS\
		,Performance,Type]
	~	Dmnl
	~		|

Utility RCPv Renter exp[District,HS,Performance,Type]=
	exp( Utility RCPv Renter[District,HS,Performance,Type] )
	~	Dmnl
	~		|

RCP Eco Owners factor[District,HS,Performance,Type]=
	RCP Eco Utility Owners[District,HS,Performance,Type] * PV Eco weight
	~	Dmnl
	~		|

Utility RCPv Owners[District,HS,Performance,Type]=
	Utility PV no Eco[District,HS,Type,Performance] + RCPv Eco Owners factor[District,HS\
		,Performance,Type]
	~	Dmnl
	~		|

Probability adoption PV Renters[District,HS,Performance,Type]=
	Utility PV Renter exp[District,HS,Performance,Type] / (1 + Utility PV Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~		|

Utility RCP Renter exp[District,HS,Performance,Type]=
	exp( Utility RCP Renter[District,HS,Performance,Type] )
	~	Dmnl
	~		|

Check by HS[HS]=
	Buildings by HS[HS] - Solutions by HS[HS]
	~	
	~		~	:SUPPLEMENTARY 
	|

HS VeryOld[HS]= INTEG (
	Old to VeryOld[HS]-HS substituted[HS]-HS VeryOld demolited[HS],
		Buildings by HS 2011[HS] / 5)
	~	
	~		|

Industry electricity consumption by District[District]=
	Electricity consumption Industry * Industry electricity consumption share by District\
		[District]
	~	
	~		|

Tertiary electricity consumption by District[District]=
	Electricity consumption Tertiary * Tertiary electricity consumption share by District\
		[District]
	~	
	~		|

Fuels consumption Tertiary=
	IF THEN ELSE( Time < 2024 , Fuels consumption Tertiary historical , Fuels consumption Tertiary factor\
		 * 658 )
	~	
	~		~	:SUPPLEMENTARY 
	|

SH industry annual electricity demand=
	Electricity consumption Industry * 0.0077
	~	GWh
	~		|

Fuels consumption Industry=
	IF THEN ELSE( Time < 2024 , Fuels consumption Industry historical , Fuels consumption Industry factor\
		 * 598 )
	~	
	~		~	:SUPPLEMENTARY 
	|

Fuels consumption Industry factor:INTERPOLATE::=
	GET VDF DATA( 'Input Hour Factors.vdfx', 'Fuels consumption Industry factor' , 0 , 1\
		 )
	~	
	~		|

Electricity consumption Industry historical:INTERPOLATE::=
	GET VDF DATA( 'Input Hour Factors.vdfx', 'Electricity consumption Industry historical'\
		 , 0 , 1 )
	~	GWh
	~		|

Fuels consumption Tertiary factor:=
	GET VDF DATA( 'Input Hour Factors.vdfx', 'Electricity consumption Industry factor' ,\
		 0 , 1 )
	~	
	~		|

Electricity consumption Tertiary historical:INTERPOLATE::=
	GET VDF DATA( 'Input Hour Factors.vdfx', 'Electricity consumption Tertiary historical'\
		 , 0 , 1 )
	~	GWh
	~		|

Electricity consumption Industry factor:=
	GET VDF DATA( 'Input Hour Factors.vdfx', 'Electricity consumption Industry factor' ,\
		 0 , 1 )
	~	Dmnl
	~		|

Electricity consumption Tertiary factor:=
	GET VDF DATA( 'Input Hour Factors.vdfx', 'Electricity consumption Tertiary factor' ,\
		 0 , 1 )
	~	Dmnl
	~		|

SH services annual electricity demand=
	Electricity consumption Tertiary * 0.039
	~	GWh
	~		|

Import marginal cost delay=
	DELAY FIXED( Import marginal cost hystorical + Import marginal cost dummy variable ,\
		 1 , Import marginal cost hystorical + Import marginal cost dummy variable )
	~	
	~		|

Import marginal cost=
	SMOOTH( Import marginal cost delay , 1 )
	~	CHF/MWh
	~		|

Total annual grid upgrading cost by DSO smooth[District]=SMOOTH ( Total annual grid upgrading cost by DSO\
		[District] , 5 )
	~	CHF
