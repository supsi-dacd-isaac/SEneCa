{UTF-8}
Total variable costs HS[District,OilST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler]  - 
	
	Annual mantainance costs HS[OilST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 +\
		 Interest rate ) ^ Lifetime[OilST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,GasST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler]  - 
	
	Annual mantainance costs HS[GasST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 +\
		 Interest rate ) ^ Lifetime[GasST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,pellet,Performance,Type,PVpanel]=
	( - ( Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District\
		,PelletBoiler] - 
	
	Annual mantainance costs HS[pellet,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 \
		+ Interest rate ) ^ Lifetime[pellet] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HeatPump,Performance,Type,PVyes]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / HP efficiency[Performance] * Carrier used cost per kWh[District\
		,HP] * (1 - Self sufficiency degree[District,HeatPump,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / HP efficiency[Performance] * Exp expected export price * Self sufficiency degree\
		[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) * ( 1 - ( 1 / ( ( \
		1 + Interest rate ) ^ Lifetime[HeatPump] ) ) ) / Interest rate ~~|
Total variable costs HS[District,WoodST,Performance,Type,PVpanel]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		 1 - ST share of total heat production ) ) / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler]  - 
	
	Annual mantainance costs HS[WoodST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 \
		+ Interest rate ) ^ Lifetime[WoodST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HPST,Performance,Type,PVyes]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST]  - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		- ST share of total heat production) ) / HP efficiency[Performance] * Carrier used cost per kWh\
		[District,HP] * (1 - Self sufficiency degree[District,HPST,Performance,Type]) - 
	
	(Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (1\
		- ST share of total heat production)) / HP efficiency[Performance] * Exp expected export price\
		 * Self sufficiency degree[District,HeatPump,Performance,Type] - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type]) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		) ^ Lifetime[HPST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HeatPump,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / HP efficiency[Performance] * Carrier used cost per kWh[District\
		,HP] - 
	
	Annual mantainance costs HS[HeatPump,District,Performance,Type] ) * ( 1 - ( 1 / ( ( \
		1 + Interest rate ) ^ Lifetime[HeatPump] ) ) ) / Interest rate ~~|
Total variable costs HS[District,HPST,Performance,Type,PVno]=
	( - Annual DHW demand[District,Type] * ST share of total heat production / Efficiency\
		[ST] * Carrier used cost per kWh[District,ST] - 
	
	( Annual SH demand[District,Performance,Type] + Annual DHW demand[District,Type] * (\
		1 - ST share of total heat production ) ) / HP efficiency[Performance] * Carrier used cost per kWh\
		[District,HP]  - 
	
	Annual mantainance costs HS[HPST,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + \
		Interest rate ) ^ Lifetime[HPST] ) ) ) / Interest rate ~~|
Total variable costs HS[District,Oil,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler\
		] - 
	
	Annual mantainance costs HS[Oil,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime[Oil] ) ) ) / Interest rate ~~|
Total variable costs HS[District,Gas,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler\
		] - 
	
	Annual mantainance costs HS[Gas,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		 ) ^ Lifetime[Gas] ) ) ) / Interest rate ~~|
Total variable costs HS[District,Wood,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler\
		] - 
	
	Annual mantainance costs HS[Wood,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + \
		Interest rate ) ^ Lifetime[Wood] ) ) ) / Interest rate ~~|
Total variable costs HS[District,ElectricHeater,Performance,Type,PVyes]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Carrier used cost per kWh[District,EH] * (1 \
		- Self sufficiency degree[District,ElectricHeater,Performance,Type]) - 
	
	(Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Exp expected export price * Self sufficiency degree\
		[District,ElectricHeater,Performance,Type] - 
	
	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) * ( 1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ Lifetime[ElectricHeater] ) ) ) / Interest rate ~~|
Total variable costs HS[District,ElectricHeater,Performance,Type,PVno]=
	( - (Annual DHW demand[District,Type] / Efficiency DHW storage + Annual SH demand[District\
		,Performance,Type]) / Efficiency[EH] * Carrier used cost per kWh[District,EH] - 
	
	Annual mantainance costs HS[ElectricHeater,District,Performance,Type] ) * ( 1 - ( 1 \
		/ ( ( 1 + Interest rate ) ^ Lifetime[ElectricHeater] ) ) ) / Interest rate ~~|
Total variable costs HS[District,DH,Performance,Type,PVpanel]=
	( - (Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type])\
		/ 1 * Carrier cost DH - 
	
	Annual mantainance costs HS[DH,District,Performance,Type] ) * ( 1 - ( 1 / ( ( 1 + Interest rate\
		) ^ Lifetime[DH] ) ) ) / Interest rate
	~	CHF
	~		|

CHF per kCHF=
	1000
	~	CHF
	~	[EXP no normalisation] Economic utility expressed as annualised cost in \
		kCHF/year; the weight is then utility per kCHF/year.
	|

PV District Log Likelihood[District]=
	IF THEN ELSE( Time <= 2025 , Adoption PV District Data[District] * LN( MAX(1e-12, Probability of Adoption PV District\
		[District]) ) + ( Buildings district[District] - Adoption PV District Data[District\
		] ) * LN( MAX(1e-12, 1 - Probability of Adoption PV District[District]) ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
	|

Self consumption degree with Storage household[District,HS,Performance,Type]=
	
	IF THEN ELSE( kWh over MWh of demand[District,HS,Performance,Type] < 0.5 , Self consumption degree household\
		[District,HS,Performance,Type] + kWh over MWh of demand[District,HS,Performance,Type\
		] / 0.5 * ("SC 0.5 kWh/MWh"[District,HS,Performance,Type] - Self consumption degree household\
		[District,HS,Performance,Type]) , 
	IF THEN ELSE( kWh over MWh of demand[District,HS,Performance,Type] < 1 , "SC 0.5 kWh/MWh"\
		[District,HS,Performance,Type] + ( kWh over MWh of demand[District,HS,Performance,Type\
		] - 0.5 ) / 0.5 * ("SC 1.0 kWh/MWh"[District,HS,Performance,Type] - "SC 0.5 kWh/MWh"\
		[District,HS,Performance,Type]) , 
	"SC 1.0 kWh/MWh"[District,HS,Performance,Type] + ( kWh over MWh of demand[District,HS\
		,Performance,Type] - 1 ) / 0.5 * ("SC 1.5 kWh/MWh"[District,HS,Performance,Type] - \
		"SC 1.0 kWh/MWh"[District,HS,Performance,Type]) ) )
	~	Dmnl
	~	[EV-PV balance 06.11.2026] Self-consumption with battery for the household \
		demand only (as Self consumption degree with Storage, with Self \
		consumption degree household). Used in the levy bills and the battery \
		charging.
	|

NR battery losses GWh=
	SUM( NR battery annual loss[District!] ) / 1e+06
	~	GWh/year
	~	[NR battery 06.11.2026] Removed from the PV electricity fed to the grid.
	|

NR battery annual loss[District]= INTEG (
	NR battery annual loss added[District],
		0)
	~	kWh/year
	~	[NR battery 06.11.2026] Losses of the non-residential battery stock.
	|

NR battery annual loss added[District]=
	IF THEN ELSE( Time < 2015 , 0 , ( 1 / Decentralized storage efficiency - 1 ) * PV annual generation per kW\
		 * ( "Additional power District with Battery < 30 kW"[District] * MAX( 0 , "Self consumption degree with Storage < 30 kW"\
		 - "Average SC < 30 kW" ) + "Additional power District with Battery 30 - 100 kW"[District\
		] * MAX( 0 , "Self consumption degree with Storage 30 - 100 kW" - "Average SC 30 - 100 kW"\
		 ) + "Additional power District with Battery > 100 kW"[District] * MAX( 0 , "Self consumption degree with Storage > 100 kW"\
		 - "Average SC > 100 kW" ) ) )
	~	kWh/year
	~	[NR battery 06.11.2026] Storage losses of the new non-residential \
		batteries: energy delivered by the battery (self-consumption with minus \
		without storage) x (1 / round-trip efficiency - 1), as residential \
		(Decentralized storage efficiency).
	|

"NR battery attach factor > 100 kW"=
	0.098
	~	Dmnl
	~	[NR battery 06.11.2026] Battery attach rate of non-residential plants >100 \
		kW relative to the residential attach rate. Reproduces over 2016-2024 the \
		previous assumption (non-residential batteries = 2.43% of all batteries; \
		class shares 76.3 / 15.3 / 8.4%). No observed data: the BFE plant register \
		has no batteries.
	|

"NR battery attach factor 30 - 100 kW"=
	0.16
	~	Dmnl
	~	[NR battery 06.11.2026] Battery attach rate of non-residential plants \
		30-100 kW relative to the residential attach rate. Reproduces over \
		2016-2024 the previous assumption (non-residential batteries = 2.43% of \
		all batteries; class shares 76.3 / 15.3 / 8.4%). No observed data: the BFE \
		plant register has no batteries.
	|

"NR battery attach factor < 30 kW"=
	0.421
	~	Dmnl
	~	[NR battery 06.11.2026] Battery attach rate of non-residential plants <30 \
		kW relative to the residential attach rate. Reproduces over 2016-2024 the \
		previous assumption (non-residential batteries = 2.43% of all batteries; \
		class shares 76.3 / 15.3 / 8.4%). No observed data: the BFE plant register \
		has no batteries.
	|

"NR plants < 30 kW"=
	( SUM( Additional annual PV kWh produced by archetype[District!,HS!,Performance!,Type\
		!,Battery!] ) + SUM( Additional annual RCPv kWh produced by archetype[District!,HS!\
		,Performance!,Type!,Battery!] ) ) * "Share additional power < 30 kW" / PV annual generation per kW\
		 / "Average power PV < 30 kW"
	~	plants/year
	~	[NR battery 06.11.2026] New non-residential plants <30 kW (added power = \
		residential added power x Share additional power < 30 kW).
	|

Residential battery attach rate=
	ZIDZ( Total Battery adoption Res , SUM( Adoption PV Type[Type!] ) )
	~	Dmnl
	~	[NR battery 06.11.2026] Share of residential PV adoptions (PV, RCP, RCPv, \
		new buildings) with a battery.
	|

"Battery kWh per kWp > 100 kW"=
	1.208
	~	kWh/kWp
	~	[NR battery 06.11.2026] Battery capacity per kWp of PV, from the previous \
		fixed values 356.45 kWh / 295 kW.
	|

"Battery kWh per kWp 30 - 100 kW"=
	1.204
	~	kWh/kWp
	~	[NR battery 06.11.2026] Battery capacity per kWp of PV, from the previous \
		fixed values 62.6 kWh / 52 kW.
	|

NR Payoff[NR class]=
	IF THEN ELSE( Time<=2025 , NR Log likelihood[NR class], 0)
	~	Dmnl
	~	[NRH 06.11.2026] Non-residential log-likelihood 2011 (INITIAL TIME) - 2025 \
		(last year with observed data).
	|

PV no HeatPump Log Likelihood=
	IF THEN ELSE( Time <= 2025 , Adoption PV no HeatPump Data* LN( MAX(1e-12, Probability of Adoption PV no HeatPump\
		) ) + ( Buildings no HeatPump- Adoption PV no HeatPump Data ) * LN( MAX(1e-12, 1 - \
		Probability of Adoption PV no HeatPump) ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
	|

PV Performance Log Likelihood[Performance]=
	IF THEN ELSE( Time <= 2025 , Adoption PV Performance Data[Performance] * LN( MAX(1e-12\
		, Probability of Adoption PV Performance[Performance])) + ( Buildings Performance[Performance\
		] - Adoption PV Performance Data[Performance] ) * LN( MAX(1e-12, 1 - Probability of Adoption PV Performance\
		[Performance]) ) , 0)
	~	
	~		~	:SUPPLEMENTARY 
	|

PV HeatPump Log Likelihood=
	IF THEN ELSE( Time <= 2025 , Adoption PV HeatPump Data* LN( MAX(1e-12, Probability of Adoption PV HeatPump\
		) ) + ( Buildings HeatPump - Adoption PV HeatPump Data) * LN( MAX(1e-12, 1 - Probability of Adoption PV HeatPump\
		) ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
	|

PV Type Log Likelihood[Type]=
	IF THEN ELSE( Time <= 2025 , Adoption PV Type Data[Type] * LN( MAX(1e-12, Probability of Adoption PV Type\
		[Type]) ) + ( Buildings Type[Type] - Adoption PV Type Data[Type] ) * LN( MAX(1e-12,\
		1 - Probability of Adoption PV Type[Type]) ) , 0 )
	~	
	~		~	:SUPPLEMENTARY 
	|

NR RU per kW[NR Mid]=
	"PV capacity federal subsidy 30 - 100 kW" ~~|
NR RU per kW[NR Large]=
	"PV capacity federal subsidy > 100 kW"
	~	CHF/kW
	~	[NR] Power contribution (SURE tables).
	|

EV PV coverage 2050=
	0.56
	~	Dmnl
	~	[EV-PV 06.11.2026] Share in 2050 if simple controlled (PV-surplus) \
		charging becomes standard: 56% (Martin et al. 2022). Upper value: \
		full-roof PV in the study. Set to EV PV coverage 2025 for a constant share.
	|

EV PV coverage 2025=
	0.15
	~	Dmnl
	~	[EV-PV 06.11.2026] Share of EV home charging covered by own PV with \
		uncontrolled charging: 15% (Martin, Buffat, Bucher 2022, RSER 157, 111969; \
		78 BEV users in Switzerland).
	|

Share of dwellings with PV[District]=
	MIN( 1 , ZIDZ( Dwellings with PV[District] , SUM( Primary dwellings by District Type and Performance\
		[District,Type!] ) ) )
	~	Dmnl
	~	[EV-PV co-ownership 06.11.2026] Dwellings in residential buildings with PV \
		over the primary dwellings of the district.
	|

EV ownership ratio PV dwellings=
	3.9
	~	Dmnl
	~	[EV-PV 06.11.2026] P(EV given PV) / P(EV given no PV) = 9.5% / 2.4%, from \
		Lagomarsino et al. 2023 (iScience 26, 107815; 1967 owners of \
		(semi-)detached houses, Geneva, 2021): about 65 PV+EV households \
		(supplement Figure S3), 684 PV and 96 EV owners. Range 2.5-6.7 (reading of \
		the heatmap). 1 = independence. Wealthy house owners: probably an upper \
		value for Ticino and multi-family houses. Acts on the balance, the PV \
		decision and the share of EV buyers with PV (also in 2011-2025).
	|

EV PV self consumption[District]=
	IF THEN ELSE( Time < 2015 , 0 , 1 ) * EV to PV link * EV home charging in PV dwellings\
		[District] * EV home charging covered by PV
	~	kWh/year
	~	[EV-PV balance 06.11.2026] EV home charging covered by the residential PV \
		of the district (15% of the home charging in PV dwellings, Martin et al. \
		2022), at most the PV surplus; from 2015, as the household \
		self-consumption stock. Added to the self-consumption in the electricity \
		balance.
	|

EV home charging in PV dwellings[District]=
	MIN( EV home charging district[District] , EV home charging per dwelling[District] *\
		EV ownership factor PV dwellings[District] * Dwellings with PV[District] )
	~	kWh/year
	~	[EV-PV balance 06.11.2026] Home charging of the EVs in dwellings with PV.
	|

EV home charging district[District]=
	SUM( Annual electricity charged at home EV[Vechicle!] * Vehicle[District,Vechicle!] \
		)
	~	kWh/year
	~	[EV-PV balance 06.11.2026] Home charging of the district fleet (BEV, \
		PHEV); every EV owner has a home charger.
	|

Dwellings with PV[District]=
	SUM( Heating Solution[District,HS!,Performance!,Type!,PVyes,Battery!] * Dwellings per building\
		[District,Type!] )
	~	dwellings
	~	[EV-PV balance 06.11.2026] Dwellings in residential buildings with PV.
	|

EV ownership factor PV dwellings[District]=
	EV ownership ratio PV dwellings / ( Share of dwellings with PV[District] * EV ownership ratio PV dwellings\
		 + 1 - Share of dwellings with PV[District] )
	~	Dmnl
	~	[EV-PV co-ownership 06.11.2026] EV ownership in dwellings with PV relative \
		to the average dwelling of the district, from the ratio PV / non-PV \
		dwellings and the share of dwellings with PV (the EVs in PV dwellings \
		never exceed the fleet). Was a constant 1.
	|

Share of PV buildings for EV[District]=
	IF THEN ELSE( PV to EV link > 0.5 , MIN( 1 , Share of buildings with PV by District[\
		District] * EV ownership factor PV dwellings[District] ) , Share of buildings with PV\
		 )
	~	Dmnl
	~	[EV-PV 06.11.2026] Share of EV buyers with PV: district share of buildings \
		with PV x co-ownership factor (at most 1); previous model: canton share \
		(PV to EV link = 0).
	|

Home charging cost factor PV owners[District]=
	IF THEN ELSE( PV to EV link > 0.5 , 1 - EV home charging covered by PV + EV home charging covered by PV\
		 * Exp expected export price / Electricity price[District] , 0.65 )
	~	Dmnl
	~	[EV-PV 06.11.2026] Cost of home charging for PV owners relative to the \
		retail price: PV-covered share at the expected export price (opportunity \
		cost), the rest at the retail price. Previous model: 0.65.
	|

Self consumption degree[District,HS,Performance,Type]=
	MIN( 1 , Self consumption degree household[District,HS,Performance,Type] + EV PV self consumed per building\
		[District,HS,Performance,Type] / PV annual generation per building[District,Type] )
	~	Dmnl
	~	[EV-PV 06.11.2026] Self-consumed share of PV generation including the \
		expected EV home charging covered by PV.
	|

EV PV self consumed per building[District,HS,Performance,Type]=
	EV to PV link * MIN( EV home charging per dwelling[District] * EV ownership factor PV dwellings\
		[District] * Dwellings per building[District,Type] * EV home charging covered by PV\
		 , PV annual generation per building[District,Type] * ( 1 - Self consumption degree household\
		[District,HS,Performance,Type] ) )
	~	kWh/year
	~	[EV-PV co-ownership 06.11.2026] PV electricity used for home charging in \
		the PV decision: expected EV home charging of a dwelling with PV (average \
		x co-ownership factor), 15% covered by PV, limited to the PV surplus left \
		by the household demand.
	|

EV home charging per dwelling[District]=
	SUM( Annual electricity charged at home EV[Vechicle!] * Vehicle[District,Vechicle!] \
		) / SUM( Primary dwellings by District Type and Performance[District,Type!] )
	~	kWh/year
	~	[EV-PV 06.11.2026] Expected EV home charging per dwelling of the district: \
		home charging of the district fleet (BEV and PHEV) over the primary \
		dwellings. Every EV owner is assumed to have a home charger.
	|

PV to EV link=
	1
	~	Dmnl
	~	[EV-PV 06.11.2026] 1 = PV owners pay the PV-covered share of home charging \
		at the expected export price; 0 = previous model (PV owners pay 0.65 x \
		retail price for all home charging).
	|

EV to PV link=
	1
	~	Dmnl
	~	[EV-PV 06.11.2026] 1 = EV home charging raises the self-consumption of \
		residential PV; 0 = previous model (no effect).
	|

EV home charging covered by PV=
	IF THEN ELSE( Time < 2025 , EV PV coverage 2025 , EV PV coverage 2025 + ( EV PV coverage 2050\
		 - EV PV coverage 2025 ) * MIN( 1 , ( Time - 2025 ) / 25 ) )
	~	Dmnl
	~	[EV-PV 06.11.2026] Share of EV home charging covered by the household PV: \
		EV PV coverage 2025 until 2025, then linear to EV PV coverage 2050 \
		(diffusion of PV-surplus charging; mid-path about 35%, within the 33-47% \
		of field tests, Mittelsdorf et al.).
	|

HP efficiency[Performance]=
	HP efficiency input[Performance] * HP efficiency uncertainty factor
	~	Dmnl
	~	[CH-align heat 06.11.2026] Heat-pump efficiency used in costs, electricity \
		demand and emissions (uncertainty factor from 2026 as before).
	|

HP efficiency input[Performance]=
	2.86, 3.07, 3.36, 3.51, 3.68
	~	Dmnl
	~	[CH-align heat 06.11.2026] Seasonal performance factor of heat pumps by \
		building performance class (VeryLow ... VeryHigh), as CH model Efficiency \
		input[HP,Performance]: lower supply temperature in better buildings. Was \
		3.4 for all buildings.
	|

Carrier cost DH=
	0.106
	~	CHF/kWh
	~	[CH-align heat 06.11.2026] District heating tariff per kWh of heat, as CH \
		model (Marktbeobachtung Fernwaermetarife Schweiz). Replaces the wood price \
		in the DH operating costs of the decision and 0.12 CHF/kWh in the \
		fuel-cost results.
	|

NR Maintenance cost=
	PV OM cost gross / 100
	~	CHF/kWh
	~	[NRH 06.11.2026] O&M per kWh of non-residential plants as CH (PV OM cost \
		gross), without the 7.7% household tax deduction: for firms O&M is an \
		ordinary business cost and the NR economics have no taxes on the other \
		cash flows.
	|

NR RIC VAT=
	0.08
	~	Dmnl
	~	[NRH 06.11.2026] VAT included in the KEV rates (8% in 2011-2017). Firms: \
		revenue without VAT, as the investment cost.
	|

NR RIC tariff 100 to 1000 kW= WITH LOOKUP (
	Time,
		([(2011,0)-(2050,1)],(2011,0.378),(2012,0.30563),(2013,0.231),(2014,0.213),(2015,0.19125\
		),(2016,0.164),(2017,0.14255),(2050,0.14255)))
	~	CHF/kWh
	~	[NRH 06.11.2026] KEV rate of the 100-1000 kW class, roof-mounted, incl. 8% \
		VAT, annual mean by commissioning year (EnV Anhang 1.2 Ziff. 3.1, same \
		table and averaging as the CH model): 37.8 (2011), 30.6, 23.1, 21.3, 19.1, \
		16.4 Rp/kWh (2016); 2017 approximated (not used: no federal admission \
		after 2012, no RIC-TI for >100 kW).
	|

PV OM cost gross= WITH LOOKUP (
	Time,
		([(2011,0)-(2050,6)],(2011,5),(2014,5),(2017,3.5),(2019,3.5),(2025,3),(2030,2.705),\
		(2040,2.358),(2050,2.22)))
	~	Rp/kWh
	~	[CH-align 05.11.2026] PV O&M cost per kWh before tax deduction (as CH): \
		5.0 Rp/kWh 2011-2014 (SFOE reference plant 30 kW, Erlaeuterungen EnV Nov. \
		2014, p. 3), 3.5 Rp/kWh 2017-2019 (SFOE reference plant 100 kW, \
		Erlaeuterungen EnFV 12.02.2019, p. 1), 3.0 Rp/kWh 2025 (SFOE reference \
		plants 15 and 50 kW, Konzept PV-Foerderung July 2025, p. 21), after 2025 \
		scaled with the Nexus-e O&M trajectory (Han & Hug 2020).
	|

RoCH federal RUG=
	SUM(Rebate interpolation weight[Rebate point!]*RoCH federal RUG data[Rebate point!])
	~	Mio CHF
	~	[RoCH] Federal RUG spending of the rest of Switzerland interpolated in PV \
		rebate federal.
	|

