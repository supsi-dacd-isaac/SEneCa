RoCH federal RUP data[RP40]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0),(2012,0),(2013,0),(2014,83.8656\
		),(2015,100.482),(2016,75.4261),(2017,70.8266),(2018,80.5015),(2019,76.2708),(2020,\
		79.4049),(2021,96.1534),(2022,213.961),(2023,308.864),(2024,252.325),(2025,343.065)\
		,(2026,537.025),(2027,585.229),(2028,584.49),(2029,560.129),(2030,532.98),(2031,512.908\
		),(2032,490.073),(2033,460.082),(2034,430.049),(2035,381.485),(2036,333.438),(2037,\
		309.189),(2038,293.12),(2039,276.245),(2040,258.76),(2041,240.417),(2042,215.319),(\
		2043,191.495),(2044,178.293),(2045,172.502),(2046,163.608),(2047,149.562),(2048,137.59\
		),(2049,127.172),(2050,118.879)))
	~	Mio CHF
	~	[RoCH 11.11.2026] Federal RUP spending of the rest of Switzerland: Ticino \
		RUP spending (residential, non-residential <30 kW and 30-100 kW) x \
		(1/0.0508 - 1), 0.0508 = Share RUP TI over RUP (original model, source to \
		be documented). From runs of Claude/SURE.mdl of 11.11.2026 with \
		Calibration.out (11.11.2026 00:07), PV rebate federal = 0 ... 0.4, other \
		settings at base value, to 2050, iterated to convergence of the levy \
		(iteration 2).
	|

Rebate interpolation weight[Rebate point]=
	MAX(0, 1-ABS(Rebate federal for RoCH-Rebate point value[Rebate point])/0.1)
	~	Dmnl
	~	[RoCH] Weight of each simulated run for linear interpolation (weights sum \
		to 1).
	|

Rebate federal for RoCH=
	MAX(0, MIN(0.4, PV rebate federal))
	~	Dmnl
	~	[RoCH] PV rebate federal limited to the simulated range 0-0.4.
	|

Rebate point value[Rebate point]=
	0, 0.1, 0.2, 0.3, 0.4
	~	Dmnl
	~	[RoCH] PV rebate federal of each simulated run.
	|

Rebate point:
	RP00, RP10, RP20, RP30, RP40
	~	
	~	[RoCH] Values of PV rebate federal simulated to build the RoCH data.
	|

Cumulative Cantonal demand 5 years before= DELAY FIXED(
	Cumulative Cantonal demand, 5, 0)
	~	kWh
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Cantonal demand= INTEG(
	SUM(Total annual grid demand Districts[District!]),
	0)
	~	kWh
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

Cumulative Cantonal net Subsidy 5 years before= DELAY FIXED(
	Cumulative Cantonal net Subsidy, 5, 0)
	~	Mio CHF
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Cantonal net Subsidy= INTEG(
	Annual Total Cantonal net Subsidy,
	0)
	~	Mio CHF
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

Cumulative Federal demand 5 years before= DELAY FIXED(
	Cumulative Federal demand, 5, 0)
	~	kWh
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Federal demand= INTEG(
	Total Federal demand grid,
	0)
	~	kWh
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

Cumulative Federal Subsidy 5 years before= DELAY FIXED(
	Cumulative Federal Subsidy, 5, 0)
	~	Mio CHF
	~	[LEVY] Cumulative value 5 years earlier (DELAY FIXED must stand alone in \
		its equation).
	|

Cumulative Federal Subsidy= INTEG(
	Annual Total Federal Subsidy,
	0)
	~	Mio CHF
	~	[LEVY] Sum of the yearly values up to the previous year.
	|

NR Cantonal subsidy per plant[NR class]=
	NR Eligible share[NR class]*NR Cantonal CU eligible[NR class]+(1-NR Eligible share[NR class\
		])*NR Cantonal CU[NR class]
	~	CHF/plant
	~	[NR] Cantonal one-off contribution per new plant (mix of private plants up \
		to 50 kW and the others), as in the NR decision.
	|

Probability adoption RCP Renters[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability RCP Renters\
		[District,HS,Performance,Type]+Install lag share*Decision probability RCP Renters last year\
		[District,HS,Performance,Type], Decision probability RCP Renters[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Decision probability RCPv Renters last year[District,HS,Performance,Type]= DELAY FIXED\
		(
	Decision probability RCPv Renters[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCPv Renters[District,HS,Performance,Type]=
	Utility RCPv Renter exp[District,HS,Performance,Type]/(1+Utility RCPv Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability RCPv Owners last year[District,HS,Performance,Type]= DELAY FIXED\
		(
	Decision probability RCPv Owners[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCPv Owners[District,HS,Performance,Type]=
	Utility RCPv Owners exp[District,HS,Performance,Type]/(1+Utility RCPv Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability RCP Renters last year[District,HS,Performance,Type]= DELAY FIXED\
		(
	Decision probability RCP Renters[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCP Renters[District,HS,Performance,Type]=
	Utility RCP Renter exp[District,HS,Performance,Type]/(1+Utility RCP Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability RCP Owners last year[District,HS,Performance,Type]= DELAY FIXED(
	Decision probability RCP Owners[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability RCP Owners[District,HS,Performance,Type]=
	Utility RCP Owners exp[District,HS,Performance,Type]/(1+Utility RCP Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability PV Renters last year[District,HS,Performance,Type]= DELAY FIXED(
	Decision probability PV Renters[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability PV Renters[District,HS,Performance,Type]=
	Utility PV Renter exp[District,HS,Performance,Type]/(1+Utility PV Renter exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Decision probability PV Owners last year[District,HS,Performance,Type]= DELAY FIXED(
	Decision probability PV Owners[District,HS,Performance,Type], 1, 0)
	~	Dmnl
	~	[K2N3_2025] Decision probability of the previous year.
	|

Decision probability PV Owners[District,HS,Performance,Type]=
	Utility PV Owners exp[District,HS,Performance,Type]/(1+Utility PV Owners exp[District\
		,HS,Performance,Type])
	~	Dmnl
	~	[K2N3_2025] Logit adoption probability in the decision year.
	|

Install lag share=
	0.5
	~	Dmnl
	~	[NRH 06.11.2026] Residential case CHA_L5_X0_D1 (ritardo 0.5, segnale anno \
		di decisione, d=0.1); also in PV utility CHA_L5_X0_D1_2025.out.
	|

PV federal cap share=
	IF THEN ELSE(Time<2026, 0.3, 0.3+PV rebate federal-0.2)
	~	Dmnl
	~	[NR] Cap of the residential federal RU as share of the cost: 30% until \
		2025 (historical rule, independent of the lever); SURE formula from 2026.
	|

NR Calibration end year=
	2025
	~	year
	~	[NR]
	|

NR Log likelihood[NR class]=
	GAMMA LN(NR Observed count[NR class]+NR Dispersion[NR class])-GAMMA LN(NR Dispersion\
		[NR class])-GAMMA LN(NR Observed count[NR class]+1)+NR Dispersion[NR class]*LN(NR Dispersion\
		[NR class]/(NR Dispersion[NR class]+NR Mu[NR class]))+NR Observed count[NR class]*LN\
		(NR Mu[NR class]/(NR Dispersion[NR class]+NR Mu[NR class]))
	~	Dmnl
	~	[NR] Negative binomial NB2 on yearly counts.
	|

NR Mu[NR class]=
	MAX(NR Completed[NR class], 1e-09)
	~	plants/year
	~	[NR]
	|

NR Dispersion[NR class]=
	10^NR Log dispersion[NR class]
	~	Dmnl
	~	[NR]
	|

NR Log dispersion[NR Mid]=
	0.756401 ~~|
NR Log dispersion[NR Large]=
	0.313375
	~	Dmnl
	~	[NRH 06.11.2026] NRHA calibration (stand-alone nonres_core.mdl, LL \
		2011-2025, ritardo 0.5, peer d=0.1); also in NR utility NRHA_2025.out.
	|

NR Stock[NR class]= INTEG(
	NR Installed kW[NR class], NR Initial stock[NR class])
	~	kW
	~	[NR] Additions of year t enter the stock at t+1.
	|

NR Completed[NR class]=
	NR Pending count[NR class]+NR Completion share same year*NR Orders[NR class]
	~	plants/year
	~	[NR] New plants per year.
	|

NR Pending count[NR class]= INTEG(
	NR Orders[NR class]-NR Completed[NR class],
	0)
	~	plants
	~	[NR] Plants ordered and not yet installed.
	|

NR Orders[NR class]=
	SUM(NR Orders kW district[NR class,District!])/NR Size[NR class]
	~	plants/year
	~	[NR] Plants ordered per year.
	|

NR Installed kW[NR class]=
	SUM(NR Installed kW district[NR class,District!])
	~	kW/year
	~	[NR]
	|

NR Pending kW[NR class]=
	SUM(NR Pending kW district[NR class,District!])
	~	kW
	~	[NR]
	|

NR Installed kW district[NR class,District]=
	NR Pending kW district[NR class,District]+NR Completion share same year*NR Orders kW district\
		[NR class,District]
	~	kW/year
	~	[NR] Installed power: share of this year orders plus the rest of last year \
		orders.
	|

NR Pending kW district[NR class,District]= INTEG(
	NR Orders kW district[NR class,District]-NR Installed kW district[NR class,District]\
		,
	0)
	~	kW
	~	[NR] Orders of the previous year still to be installed.
	|

NR Orders kW district[NR class,District]=
	NR Eligible kW[NR class]*NR Probability district[NR class,District]
	~	kW/year
	~	[NR] Power ordered in the decision year.
	|

NR Completion share same year=
	0.5
	~	Dmnl
	~	[NRH 06.11.2026] NRHA calibration (stand-alone nonres_core.mdl, LL \
		2011-2025, ritardo 0.5, peer d=0.1); also in NR utility NRHA_2025.out.
	|

NR Eligible kW[NR class]=
	MAX(0, NR Potential[NR class]-NR Stock[NR class]-NR Pending kW[NR class])
	~	kW
	~	[NR] Residual potential (without the orders not yet installed).
	|

NR Probability[NR class]=
	SUM(NR Probability district[NR class,District!])
	~	Dmnl
	~	[NR]
	|

NR Probability district[NR class,District]=
	Share PV capacity installed per District[District]*(NR Eligible share[NR class]/(1+EXP\
		(-NR Utility eligible[NR class,District]))+(1-NR Eligible share[NR class])/(1+EXP(-\
		NR Utility[NR class,District])))
	~	Dmnl
	~	[NR] District contribution to the yearly probability that a residual \
		project is realised (mix of the two segments).
	|

NR Utility eligible[NR class,District]=
	NR Delta[NR class]+NR Peer utility+NR Eco weight*NR Economic utility eligible[NR class\
		,District]
	~	Dmnl
	~	[NR]
	|

NR Utility[NR class,District]=
	NR Delta[NR class]+NR Peer utility+NR Eco weight*NR Economic utility[NR class,District\
		]
	~	Dmnl
	~	[NR]
	|

NR Peer utility=
	NR Peer weight*LOG(MAX(NR Installed base share, 1e-06), 10)
	~	Dmnl
	~	[NR]
	|

NR Installed base share=
	NR Peer installed base/(NR Potential[NR Mid]+NR Potential[NR Large])
	~	Dmnl
	~	[NR] Installed base as share of the potential, canton-wide, in kW.
	|

NR Peer installed base= INTEG(
	NR Installed kW[NR Mid]+NR Installed kW[NR Large]-NR Peer decay*NR Peer installed base\
		,
	53+224.38*(1-NR Peer decay)+122.85*(1-NR Peer decay)^2)
	~	kW
	~	[NR] Installed base >=30 kW with decay; initial value from the register \
		2008-2010 with the same decay (as residential).
	|

NR Peer decay=
	0.1
	~	1/year
	~	[NRH 06.11.2026] NRHA calibration (stand-alone nonres_core.mdl, LL \
		2011-2025, ritardo 0.5, peer d=0.1); also in NR utility NRHA_2025.out.
	|

NR Peer weight=
	0.615658
	~	Dmnl
	~	[NRH 06.11.2026] NRHA calibration (stand-alone nonres_core.mdl, LL \
		2011-2025, ritardo 0.5, peer d=0.1); also in NR utility NRHA_2025.out.
	|

NR Eco weight=
	0.083767
	~	Dmnl
	~	[NRH 06.11.2026] NRHA calibration (stand-alone nonres_core.mdl, LL \
		2011-2025, ritardo 0.5, peer d=0.1); also in NR utility NRHA_2025.out.
	|

NR Delta[NR Mid]=
	-4.37888 ~~|
NR Delta[NR Large]=
	-4.33621
	~	Dmnl
	~	[NRH 06.11.2026] NRHA calibration (stand-alone nonres_core.mdl, LL \
		2011-2025, ritardo 0.5, peer d=0.1); also in NR utility NRHA_2025.out.
	|

NR Economic utility eligible[NR class,District]=
	IF THEN ELSE(Time<2018, (MAX(NR Ordinary value[NR class,District], MAX(NR Federal value\
		[NR class,District], NR TI value[NR class,District]))-NR Net investment eligible[NR class\
		])/NR Net investment eligible[NR class]/30*100, (NR Ordinary value[NR class,District\
		]-NR Net investment eligible[NR class])/NR Net investment eligible[NR class]/30*100\
		)
	~	Dmnl
	~	[NR] Private plants up to 50 kW (RIC-TI 2014-2017, one-off contribution \
		from 2018).
	|

NR Economic utility[NR class,District]=
	IF THEN ELSE(Time<2018, (MAX(NR Ordinary value[NR class,District], NR Federal value[\
		NR class,District])-NR Net investment[NR class])/NR Net investment[NR class]/30*100\
		, (NR Ordinary value[NR class,District]-NR Net investment[NR class])/NR Net investment\
		[NR class]/30*100)
	~	Dmnl
	~	[NR] Plants above 50 kW: relative NPV of the best available regime (same \
		metric and regime logic as residential).
	|

NR Net investment eligible[NR class]=
	NR Gross cost[NR class]-NR RU[NR class]-NR Cantonal CU eligible[NR class]
	~	CHF
	~	[NR] Private plants up to 50 kW.
	|

NR Net investment[NR class]=
	NR Gross cost[NR class]-NR RU[NR class]-NR Cantonal CU[NR class]
	~	CHF
	~	[NR] Plants above 50 kW. No tax deduction (firms).
	|

NR Cantonal CU eligible[NR class]=
	IF THEN ELSE(Time<NR RU start year, 0, NR CU rule[NR class])
	~	CHF
	~	[NR] Private plants up to 50 kW: contribution from 2018 (RFER 2018), with \
		the federal RU.
	|

NR Cantonal CU[NR class]=
	NR CU open share*NR CU rule[NR class]
	~	CHF
	~	[NR] Plants above 50 kW.
	|

NR CU open share=
	IF THEN ELSE(Time<2021, 0, IF THEN ELSE(Time<2022, 4/12, 1))
	~	Dmnl
	~	[NR] Access of plants >50 kW to the cantonal contribution: from 1.9.2021 \
		(RFER state 1.9.2021).
	|

NR CU rule[NR class]=
	IF THEN ELSE( Time < 2022 , MIN(250000, NR RU[NR class]/3), IF THEN ELSE(Time<2023, \
		0.25*MIN(250000, NR RU[NR class] / 3 ) + 0.75 * NR CU 2022 rule[NR class] , IF THEN ELSE\
		(Time<2026, NR CU 2022 rule[NR class], IF THEN ELSE(Exploratory analysis>0 , 0.1 * \
		Cantonal PV support , PV rebate cantonal ) * NR Gross cost[NR class])))
	~	CHF
	~	[NR] Cantonal one-off contribution: 1/3 of the federal RU (RFER 2018 for \
		<=50 kW; from 1.9.2021 for all, max 250000); 2022 = 3 months old rule + 9 \
		months new rule; after 2025 SURE PV rebate cantonal (Cantonal PV support \
		in the exploratory analysis). Cumulable with the federal RU.
	|

NR CU 2022 rule[NR class]=
	MIN( 250000 , 0.5 * MIN( NR RU 30 kW , NR RU[NR class] ) + MAX( 0 , NR RU[NR class] \
		- NR RU 30 kW) / 3 )
	~	CHF
	~	[NR] RFER from 1.4.2022: 50% of the federal RU on the first 30 kW + 1/3 of \
		the RU above, max CHF 250000.
	|

NR RU 30 kW=
	NR RU grant[NR Mid]+NR RU per kW[NR Mid]*30
	~	CHF
	~	[NR] Federal RU of a 30 kW plant with the 30-100 kW tables (approximation \
		of the KLEIV value at 30 kW).
	|

NR RU[NR class]=
	IF THEN ELSE( Time < NR RU start year , 0, IF THEN ELSE( Time < 2026 , MIN( NR RU grant\
		[NR class] +NR RU per kW[NR class] * NR Size[NR class] , 0.3 * NR Gross cost[NR class\
		]), PV rebate federal*NR Gross cost[NR class]))
	~	CHF
	~	[NR] As SURE PV federal subsidy check (max 30% of cost; PV rebate federal \
		after 2025), paid without delay as in the residential model.
	|

NR RU grant[NR Mid]=
	"PV federal grant 30 - 100 kW" ~~|
NR RU grant[NR Large]=
	"PV federal grant > 100 kW"
	~	CHF
	~	[NR] Base contribution (SURE tables).
	|

NR RU start year=
	2018
	~	year
	~	[NR] One-off payment for plants >=30 kW only under the EnG/EnFV in force \
		1.1.2018.
	|

NR TI value[NR class,District]=
	IF THEN ELSE(Time>=2014 :AND: Time<2018, NR Ordinary value[NR class,District]+NR TI admission\
		(Time)*NR Exported kWh[NR class]*(NR RIC tariff[NR class]-NR Expected export price)\
		*NR TI factor, 0)
	~	CHF
	~	[NR] Only for the eligible segment (RFER 2014 art. 12: RIC-TI for private \
		plants up to 50 kW). From 2018 no RIC-TI admission (budget, list), no new \
		promises after 31.12.2020.
	|

NR TI factor=
	(1-(1+NR Discount rate)^(-16))/NR Discount rate-(1-(1+NR Discount rate)^(-MIN(16,NR TI wait\
		(Time))))/NR Discount rate
	~	year
	~	[NR] RIC-TI paid 16 years after the wait (as residential).
	|

NR TI wait(
	[(2013,0)-(2030,5)],(2013,0.5),(2014,0.5),(2015,1.5),(2016,2),(2030,2))
	~	year
	~	[NR] As residential K1.
	|

NR TI admission(
	[(2013,0)-(2030,1)],(2013,1),(2014,1),(2015,0.55),(2016,0.15),(2017,0),(2030,0))
	~	Dmnl
	~	[NR] RIC-TI admission by request year, as residential K1 (single FER \
		budget, FIFO).
	|

NR Share 30 50 kW=
	0.42
	~	Dmnl
	~	[NR] Share of 30-50 kW plants in the 30-100 kW non-residential class, \
		register x RBD (EGID), 2022-2025 = 0.415 (size-neutral cantonal rules). \
		2014-17 0.22, 2018-21 0.59 (bunching at 50 kW while the cantonal \
		contribution was limited to 50 kW).
	|

NR Eligible share[NR Mid]=
	NR Share 30 50 kW ~~|
NR Eligible share[NR Large]=
	0
	~	Dmnl
	~	[NR] Share of the class with access to the cantonal incentives for private \
		plants up to 50 kW (RIC-TI 2014-2017, one-off contribution 2018-8.2021).
	|

NR Federal value[NR class,District]=
	NR Ordinary value[NR class,District]+NR Federal admission(Time)*NR Exported kWh[NR class\
		]*(NR RIC tariff[NR class]-NR Expected export price)*NR Federal factor
	~	CHF
	~	[NR] Sale at market price while waiting, KEV premium after admission.
	|

NR Federal factor=
	(1-(1+NR Discount rate)^(-NR Federal term))/NR Discount rate-(1-(1+NR Discount rate)\
		^(-MIN(NR Federal term,NR Federal wait(Time))))/NR Discount rate
	~	year
	~	[NR] Present value of the KEV premium paid after the wait.
	|

NR Federal term=
	25
	~	year
	~	[NR] KEV contract for plants commissioned up to 2013: 25 years from \
		commissioning, queue years not paid.
	|

NR Federal wait(
	[(2010,0)-(2030,20)],(2010,3.7),(2011,3.7),(2012,6),(2013,7),(2030,7))
	~	year
	~	[NRH 06.11.2026] Expected years on the KEV list: 3.7 (2011) and 6 (2012) \
		as CH model / residential.
	|

NR Federal admission(
	[(2010,0)-(2030,1)],(2010,0.8),(2011,0.8),(2012,0.4),(2013,0),(2030,0))
	~	Dmnl
	~	[NRH 06.11.2026] Expected admission to the federal KEV by year of \
		decision, as CH model / residential: 0.8 (2011), 0.4 (2012), 0 from 2013. \
		Was 1 in 2011-2013.
	|

NR Exported kWh[NR class]=
	NR Generation[NR class]*(1-NR SC[NR class])
	~	kWh/year
	~	[NR]
	|

NR Ordinary value[NR class,District]=
	NR Ordinary cash[NR class,District]*NR Annuity lifetime
	~	CHF
	~	[NR]
	|

NR Ordinary cash[NR class,District]=
	NR Generation[NR class] * (NR SC[NR class] * NR Avoided price[NR class,District] + (\
		1 - NR SC[NR class] ) * NR Expected export price - NR Maintenance cost )
	~	CHF/year
	~	[NRH 06.11.2026] Yearly cash flow without feed-in tariff; O&M = NR \
		Maintenance cost (was PV annual mantainance cost).
	|

NR SC[NR class]=
	IF THEN ELSE( Time < NR Self consumption start year , 0 , NR Self consumption data[NR class\
		] )
	~	Dmnl
	~	[NR]
	|

NR Self consumption start year=
	2014
	~	year
	~	[NR] Right to self-consumption from 1.1.2014 (BFE FAQ 23.10.2013).
	|

NR Self consumption data[NR Mid]=
	WITH LOOKUP(Time, ([(2000,0)-(2100,1)],(2013,0),(2013.99,0),(2014,0.32),(2017.99,0.32\
		),(2018,0.55),(2100,0.55))) ~~|
NR Self consumption data[NR Large]=
	WITH LOOKUP(Time, ([(2000,0)-(2100,1)],(2013,0),(2013.99,0),(2014,0.36),(2017.99,0.36\
		),(2018,0.6),(2022.99,0.6),(2023,0.55),(2100,0.55)))
	~	Dmnl
	~	[NR] Mean self-consumed share of the class fleet = share of plants with \
		self-consumption x self-consumed share among them. 2014-2017: INFRAS for \
		BFE 2020: 71%x45% (30-100 kW), 74%x49% (>=100 kW). 2018-2022: EBP for BFE \
		2022 fig. 39 / tab. 11 (measured 55.7% 30-100 kW, 66.5% 100-500 kW, 74.9% \
		>500 kW; 3% without self-consumption) and BFE 19.2.2025 (Pronovo 2020-22, \
		30-150 kW: 60%). From 2023 NR Large lowered for the plants without \
		self-consumption (Pronovo HEIV 2023-26: about 20% of the capacity >=150 \
		kW).
	|

NR Annuity lifetime=
	(1-(1+NR Discount rate)^(-30))/NR Discount rate
	~	year
	~	[NR]
	|

NR Discount rate=
	0.02
	~	1/year
	~	[NR] Interest rate of SURE (residential).
	|

NR RIC tariff[NR class]=
	( MIN( NR Size[NR class] , 10 ) * "PV FiT < 10 kW" + ( MIN( NR Size[NR class] , 30 )\
		 - 10 ) * "PV FiT 10 - 30 kW" + ( MIN( NR Size[NR class] , 100 ) - 30 ) * "PV FiT 30 - 100 kW"\
		 + MAX( 0 , MIN( NR Size[NR class] , 1000 ) - 100 ) * NR RIC tariff 100 to 1000 kW \
		) / NR Size[NR class] / ( 1 + NR RIC VAT )
	~	CHF/kWh
	~	[NRH 06.11.2026] KEV rate of the representative plant: power-weighted mean \
		of the official class rates (EnV Anhang 1.2 Ziff. 3.2, as Study RIC \
		tariff), without VAT. Was "PV FiT 30 - 100 kW" / "PV FiT > 100 kW" (0.525 \
		/ 0.508 in 2011, -8%/year).
	|

NR Expected export price=
	Exp expected export price
	~	CHF/kWh
	~	[NR] Same as residential: FER-CU/AET tariff of the previous production \
		year (7 ct for 2011-2013), including the test lever.
	|

NR Avoided price[NR class,District]=
	Electricity price[District]*NR Price category ratio[NR class]
	~	CHF/kWh
	~	[NR] SURE household price of the district scaled to the business category.
	|

NR Ratio C4=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0.9466),(2012,0.8218),(2013,0.8472\
		),(2014,0.9589),(2015,0.9562),(2016,0.952),(2017,0.9808),(2018,0.9124),(2019,0.9491\
		),(2020,0.9451),(2021,0.9503),(2022,0.95),(2023,0.9288),(2024,0.9733),(2025,0.9654)\
		,(2026,0.9765),(2027,0.9166)))
	~	Dmnl
	~	[NR] ElCom C4/H4, Ticino median.
	|

NR Price category ratio[NR Mid]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,1.0737),(2012,0.9252),(2013,0.9121\
		),(2014,1.0385),(2015,1.0361),(2016,1.0317),(2017,1.0522),(2018,0.9766),(2019,1.0126\
		),(2020,1.0129),(2021,1.0175),(2022,1.0153),(2023,0.9797),(2024,1.0229),(2025,1.0263\
		),(2026,1.0247),(2027,0.9711))) ~~|
NR Price category ratio[NR Large]=
	NR Ratio C4
	~	Dmnl
	~	[NR] ElCom tariff of the business category over the household tariff H4, \
		Ticino median, standard product, total without VAT: NR Mid = C3 (150 \
		MWh/year, low voltage), NR Large = C4 (500 MWh/year) or C6 (1.5 GWh/year, \
		medium voltage) as sensitivity. Free-market customers (>100 MWh) not \
		covered. Flat after 2027.
	|

NR Initial stock[NR Mid]=
	153.22 ~~|
NR Initial stock[NR Large]=
	247.01
	~	kW
	~	[NR] Power installed up to 2010 (register; no plants of these classes \
		before 2008).
	|

NR Potential[NR Mid]=
	"Capacity potential PV 30 - 100 kW" ~~|
NR Potential[NR Large]=
	"Capacity potential PV > 100 kW"
	~	kW
	~	[NR] SURE capacity potential.
	|

NR Generation[NR class]=
	PV annual generation per kW*NR Size[NR class]
	~	kWh/year
	~	[NR]
	|

NR Gross cost[NR class]=
	NR Specific cost[NR class]*NR Size[NR class]
	~	CHF/plant
	~	[NR] Gross investment of a representative plant.
	|

NR Specific cost[NR Mid]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,4522.98),(2012,3092.01),(2013,\
		2780.48),(2014,2483.76),(2015,2213.6),(2016,1961.37),(2017,1746.31),(2018,1559.91),\
		(2019,1453.01),(2020,1308.48),(2021,1511.72),(2022,1723.5),(2023,1887.43),(2024,1577.17\
		),(2025,1718.37))) ~~|
NR Specific cost[NR Large]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,4331.27),(2012,2826.93),(2013,\
		2392.22),(2014,2002.29),(2015,1702.33),(2016,1425.77),(2017,1239),(2018,1033.21),(2019\
		,1182.4),(2020,921.181),(2021,1160.8),(2022,1271.91),(2023,1376.89),(2024,1015.75),\
		(2025,917.868)))
	~	CHF/kW
	~	[NR] Gross investment per kW without VAT at the class size: 2011-2012 \
		BFE/NET reference plants 30/100/1000 kW (VAT 8% removed, log interpolation \
		in size); 2013-2017 geometric interpolation 2012-2018; 2018-2025 BFE cost \
		functions of each year (2021-2024 branches 30-100 and 100-300 kW; 2025 \
		branches 2-75 and 75-300 kW). Flat after 2025.
	|

NR Size[NR Mid]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,51.0733),(2012,49.505),(2013,51.0681\
		),(2014,54.3379),(2015,57.585),(2016,61.8747),(2017,64.1942),(2018,65.3314),(2019,64.2625\
		),(2020,64.1948),(2021,58.4025),(2022,53.4),(2023,55.0869),(2024,54.3243),(2025,58.4056\
		))) ~~|
NR Size[NR Large]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,123.505),(2012,124.16),(2013,210.148\
		),(2014,275.777),(2015,284.75),(2016,314.299),(2017,285.19),(2018,311.034),(2019,240.912\
		),(2020,303.979),(2021,267.588),(2022,251.614),(2023,289.689),(2024,297.781),(2025,\
		321.973)))
	~	kW/plant
	~	[NR] Mean size of the plants of the three previous years; flat after 2025.
	|

NR Observed count[NR Mid]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,3),(2012,12),(2013,24),(2014,10\
		),(2015,13),(2016,13),(2017,9),(2018,10),(2019,12),(2020,22),(2021,32),(2022,29),(2023\
		,79),(2024,85),(2025,58))) ~~|
NR Observed count[NR Large]=
	WITH LOOKUP(Time, ([(2000,-1e+09)-(2100,1e+09)],(2011,0),(2012,5),(2013,21),(2014,14\
		),(2015,20),(2016,12),(2017,4),(2018,11),(2019,9),(2020,9),(2021,22),(2022,22),(2023\
		,75),(2024,99),(2025,50)))
	~	plants/year
	~	[NR] New non-residential plants per year (BFE/Pronovo register x RBD, \
		buildings_TI_2026.ipynb ch. 6, PVinput_nonres.csv).
	|

NR class:
	NR Mid, NR Large
	~	
	~	[NR] Non-residential PV classes: NR Mid = 30-100 kW, NR Large = >100 kW \
		(initial power).
	|

Probability adoption RCPv Owners[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability RCPv Owners\
		[District,HS,Performance,Type]+Install lag share*Decision probability RCPv Owners last year\
		[District,HS,Performance,Type], Decision probability RCPv Owners[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Probability adoption RCPv Renters[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability RCPv Renters\
		[District,HS,Performance,Type]+Install lag share*Decision probability RCPv Renters last year\
		[District,HS,Performance,Type], Decision probability RCPv Renters[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Study current Renter ordinary PV[District,HS,Performance,Type]=
	Study current Renter ordinary cash[District,HS,Performance,Type]*((1-(1+Interest rate\
		)^(-(PV lifetime)))/Interest rate)
	~	CHF
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study RU[District,Type]=
	IF THEN ELSE( Time>=2014 :AND: kWp installed per building[District,Type]<30 , PV federal subsidy check\
		[District,Type] , IF THEN ELSE( Time>=2013 :AND: kWp installed per building[District\
		,Type]<30 , MIN(1500+1000*kWp installed per building[District,Type] , 0.3*PV investment cost\
		[District,Type])*(1+Interest rate)^(-Study RU 2013 payment wait), IF THEN ELSE( kWp installed per building\
		[District,Type]<30 , MIN(1500+1000*kWp installed per building[District,Type] , 0.3*\
		PV investment cost[District,Type])*(1+Interest rate)^(-Study federal wait), 0)))
	~	CHF
	~	[CH-align 05.11.2026] Federal one-off payment in the historical economics. \
		2011-2012: RU for plants not admitted to the RIC (2013 rule), paid after \
		the RIC waiting time (as CH).
	|

Probability adoption RCP Owners[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability RCP Owners\
		[District,HS,Performance,Type]+Install lag share*Decision probability RCP Owners last year\
		[District,HS,Performance,Type], Decision probability RCP Owners[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Probability adoption PV Renters[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability PV Renters\
		[District,HS,Performance,Type]+Install lag share*Decision probability PV Renters last year\
		[District,HS,Performance,Type], Decision probability PV Renters[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Study TI factor=
	((1-(1+Interest rate )^(-16))/Interest rate) - ((1-(1+Interest rate)^(-(MIN(16,Study TI wait\
		))))/Interest rate)
	~	year
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study current Owners ordinary PV[District,HS,Performance,Type]=
	Study current Owners ordinary cash[District,HS,Performance,Type]*((1-(1+Interest rate\
		)^(-(PV lifetime)))/Interest rate)
	~	CHF
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Probability adoption PV Owners[District,HS,Performance,Type]=
	IF THEN ELSE(Time > INITIAL TIME, (1-Install lag share)*Decision probability PV Owners\
		[District,HS,Performance,Type]+Install lag share*Decision probability PV Owners last year\
		[District,HS,Performance,Type], Decision probability PV Owners[District,HS,Performance\
		,Type])
	~	Dmnl
	~		|

Study federal factor=
	((1-(1+Interest rate)^(-(Study federal term)))/Interest rate) - ((1-(1+Interest rate\
		)^(-(MIN(Study federal term,Study federal wait))))/Interest rate)
	~	year
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Concern coefficient=
	0.663563
	~	Dmnl
	~	[CORE E14/E15] Weight of the energy-concern signal in the PV/RCP/RCPv \
		adoption utility (log-odds per 10 points of concern). To be calibrated, \
		bounds [-2,2]; E14-E17 estimates 0.57-0.98. With 0 the mechanism is \
		inactive.
	|

Study self consumption start year=
	2013
	~	year
	~	[CORE-PV] First year with self-consumption in the historical economics \
		(SURE_core 2014).
	|

Study K2 federal term=
	25
	~	year
	~	[CORE-PV] K2: RIC contract length from commissioning (plants up to 2013), \
		queue years lost.
	|

Study K2 federal wait 2012=
	6
	~	year
	~	[CORE-PV] K2: expected wait for the federal RIC, decisions 2012.
	|

Study K2 federal wait 2011=
	3.7
	~	year
	~	[CH-align 05.11.2026] Expected wait for the federal RIC, decisions 2011 \
		(cohorts admitted 2014-2016). Was 3.8.
	|

Peer installed base[District]= INTEG(
	Probability of Adoption PV District[District] - Peer decay*Peer installed base[District\
		],
	(41 + 28*(1-Peer decay) + 17*(1-Peer decay)^2 + 4*(1-Peer decay)^3 + 4*(1-Peer decay\
		)^4)*68/73/98617)
	~	Dmnl
	~	[CORE-PV] Decayed share of buildings with PV, from installations of \
		previous years.
	|

Peer decay=
	0.1
	~	1/year
	~	[NRH 06.11.2026] Residential case CHA_L5_X0_D1 (ritardo 0.5, segnale anno \
		di decisione, d=0.1); also in PV utility CHA_L5_X0_D1_2025.out.
	|

Study RU 2013 payment wait=
	1.5
	~	year
	~	[CORE-PV] Wait for the 2013 RU payment (2014 backlog, paid by 2015).
	|

Export price before 2014=
	0.07
	~	CHF/kWh
	~	[CORE-PV] Export price of production years 2011-2013 (SURE_core 0.0955; \
		BFE: market-based 0.05-0.09).
	|

Study K1 TI wait(
	[(2013,0)-(2020,5)],(2013,0.5),(2014,0.5),(2015,1.5),(2016,2),(2020,2))
	~	year
	~	[CORE-PV] K1 years without RIC-TI payment after the decision: promise at \
		request in 2014 (build
	|

Study K1 TI admission(
	[(2013,0)-(2020,1)],(2013,1),(2014,1),(2015,0.55),(2016,0.15),(2017,0),(2020,0))
	~	Dmnl
	~	[CORE-PV] K1 realised share of 10-30 kWp RIC-TI requests admitted by \
		request year, estimated from FER reports 2016-2018 (requests 488 in \
		2014-16 and 110 in 2017; waiting list 10-30 kWp 334 end-2016, 426 \
		end-2017; list since end-2014;
	|

Study K1 federal term=
	20
	~	year
	~	[CORE-PV] K1 KEV duration for positive decisions from 2014: 20 years from \
		commissioning, years on the waiting list not remunerated (BFE fact sheet \
		11.2014, 2.3).
	|

Study K1 federal wait(
	[(2010,0)-(2020,10)],(2010,3.8),(2011,3.8),(2020,3.8))
	~	year
	~	[CORE-PV] K1 years from 2011 registration to positive decision: \
		registrations to 15.6.2011 admitted 2014 (
	|

Study K1 federal admission(
	[(2010,0)-(2020,1)],(2010,0.9),(2011,0.9),(2012,0),(2020,0))
	~	Dmnl
	~	[CORE-PV] K1 realised share of federal KEV admission for 10-30 kWp by \
		registration year. 2011: registrations up to 8.11.2011 admitted in the \
		2014-2016 quotas (BFE fact sheets 11.2014, 11.2015, 01.2016); later 2011 \
		registrations and all from 2012 never admitted below 100 kW (Pronovo: EVS \
		only >=100 kW registered by 30.6.2012). 0.9 = share of the year before
	|

Test extra grant share=
	0
	~	Dmnl
	~	[CORE-PV] Lever: extra investment grant as share of PV CAPEX (e.g. 0.1).
	|

Test extra export price=
	0
	~	CHF/kWh
	~	[CORE-PV] Lever: extra expected export price (e.g. 0.05).
	|

Test start year=
	2023
	~	year
	~	[CORE-PV] First year of the test levers.
	|

Study TI admission late=
	1
	~	Dmnl
	~	[CORE-PV] Probability of obtaining RIC-TI for decisions from 2015 (FER \
		report 2016: waiting list for >10 kWp since end 2014, 359 plants waiting \
		end 2016; converted to one-off contribution in 2018).
	|

Study TI admission probability=
	Study K1 TI admission(Time)
	~	Dmnl
	~	[CORE-PV] Probability of obtaining the TI cantonal programme tariff \
		(2014-2017).
	|

Study federal admission probability=
	IF THEN ELSE( Time < 2012 , 0.8 , IF THEN ELSE( Time < 2013 , 0.4 , 0 ) )
	~	Dmnl
	~	[CH-align 05.11.2026] 2011: 0.8 (plants registered up to 8.11.2011 \
		admitted in 2014-2016, BFE KEV fact sheets 2013-2016); 2012: 0.4, \
		perceived (ex post about 0 below 100 kW); 0 from 2013. Was 1 in 2011-2012.
	|

Study federal admission end year=
	2014
	~	year
	~	[CORE-PV] Year of decision from which a new registration has no prospect \
		of federal RIC.
	|

Study federal admission 2011=
	0.5
	~	Dmnl
	~	[CORE-PV] Expected probability of eventually obtaining the federal RIC for \
		a plant decided in 2011.
	|

Study admission mode=
	3
	~	Dmnl
	~	[CORE-PV] 0 = federal RIC admission probability constant (Study admission \
		probability); 1 = admission probability by year of decision (Study federal \
		admission 2011 declining linearly to 0 at Study federal admission end \
		year). Rationale: RIC waiting list (UFE 11.11.2015:
	|

Concern index current=
	WITH LOOKUP(Time,([(2010,0)-(2026,100)],(2010,15),(2011,15),(2012,16),(2013,
	19),(2014,17),(2015,13),(2016,10),(2017,16),(2018,11),(2019,14),(2020,14),
	(2021,14),(2022,25),(2023,26),(2024,20),(2025,15),(2026,15)))
	~	Dmnl
	~	[CORE E14] Sorgenbarometer gfs.bern: share of respondents naming energy as \
		a main concern [%], annual 2010-2026.
	|

Concern raw signal=
	(Concern index current-15)/10
	~	Dmnl
	~	[CORE E14] Signal centred on 15% and scaled by 10 percentage points.
	|

Concern contribution=
	Concern coefficient*Concern raw signal
	~	Dmnl
	~	[CORE E14] Added to Utility PV no Eco (PV, RCP and RCPv).
	|

Exp AET source=
	1
	~	Dmnl
	~	[CORE E05] 1 = expected export price from AET of previous year; 0 = \
		original PV cumulative compensation price.
	|

Exp export lag years=
	0
	~	year
	~	[NRH 06.11.2026] Residential case CHA_L5_X0_D1 (ritardo 0.5, segnale anno \
		di decisione, d=0.1); also in PV utility CHA_L5_X0_D1_2025.out.
	|

Exp AET reference tariff=
	IF THEN ELSE( (Time - Exp export lag years) < 2011, Export price before 2014, IF THEN ELSE\
		( (Time - Exp export lag years) < 2012,
	Export price before 2014, IF THEN ELSE( (Time - Exp export lag years) < 2013, Export price before 2014\
		, IF THEN ELSE( (Time - Exp export lag years) < 2014,
	Export price before 2014, IF THEN ELSE( (Time - Exp export lag years) < 2015, 0.09548\
		, IF THEN ELSE( (Time - Exp export lag years) < 2016,
	0.07154, IF THEN ELSE( (Time - Exp export lag years) < 2017, 0.0592, IF THEN ELSE( (\
		Time - Exp export lag years) < 2018,
	0.07113, IF THEN ELSE( (Time - Exp export lag years) < 2019, 0.08086, IF THEN ELSE( \
		(Time - Exp export lag years) < 2020,
	0.06439, IF THEN ELSE( (Time - Exp export lag years) < 2021, 0.05146, IF THEN ELSE( \
		(Time - Exp export lag years) < 2022,
	0.11032, IF THEN ELSE( (Time - Exp export lag years) < 2023, 0.22471, IF THEN ELSE( \
		(Time - Exp export lag years) < 2024,
	0.0854, IF THEN ELSE( (Time - Exp export lag years) < 2025, 0.0424055,
	0.0556399 ) ) ) ) ) ) ) ) ) ) )) ) ) )
	~	CHF/kWh
	~	[CORE E05] FER-CU/AET export tariff by production year (2024-2025 \
		PV-weighted quarterly). Before 2014 original 9.55 ct/kWh.
	|

Exp expected export price=
	IF THEN ELSE(Time>=Test start year, Test extra export price, 0) + IF THEN ELSE(Time \
		< 2026, IF THEN ELSE(Exp AET source = 0, PV cumulative compensation price, Exp AET reference tariff\
		), (Exp AET reference tariff)*PV uncertain remunaration factor+ FiT + Cantonal PV support\
		 * 0.05 )
	~	CHF/kWh
	~	[CORE E05] Export price used in residential decision cash flows (PV, RCP, \
		RCPv, batteries).
	|

Study economics enabled=
	1
	~	Dmnl
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study delayed access=
	1
	~	Dmnl
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study wait multiplier=
	1
	~	Dmnl
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study admission probability=
	1
	~	Dmnl
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study TI discounted offset=
	1
	~	Dmnl
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study federal wait=
	IF THEN ELSE(Time<2012, Study K2 federal wait 2011, Study K2 federal wait 2012)
	~	year
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study TI wait=
	Study K1 TI wait(Time)
	~	year
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study federal term=
	Study K2 federal term
	~	year
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study CU[District,Type]=
	IF THEN ELSE(Time>=2014 :AND: kWp installed per building[District,Type]<10,
	MIN(5000,Study RU[District,Type]/3),0)
	~	CHF
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study cost without RU[District,Type]=
	(PV investment cost[District,Type])*(1-Tax deduction investment)
	~	CHF
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study cost RU[District,Type]=
	(PV investment cost[District,Type]-Study RU[District,Type]-Study CU[District,Type])*\
		(1-Tax deduction investment)
	~	CHF
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study RIC tariff[District,Type]=
	( MIN( kWp installed per building[District,Type] , 10 ) * "PV FiT < 10 kW" + MAX( 0 \
		, MIN( kWp installed per building[District,Type] , 30 ) - 10 ) * "PV FiT 10 - 30 kW"\
		 + MAX( 0 , MIN( kWp installed per building[District,Type] , 100 ) - 30 ) * "PV FiT 30 - 100 kW"\
		 ) / kWp installed per building[District,Type]
	~	CHF/kWh
	~	[CH-align 05.11.2026] RIC rate of the plant: power-weighted mean of the \
		class rates (EnV Anhang 1.2 Ziff. 3.2). Was the <10 or 10-30 kW class rate \
		for the whole plant.
	|

Study TI annual offset[District,Type]=
	Study RU[District,Type]/IF THEN ELSE(Study TI discounted offset>0.5,((1-(1+Interest rate\
		)^(-16))/Interest rate),
	16)
	~	CHF/year
	~	[CORE M01/E08] Historical PV economics 2011-2017: ordinary sale, RU/CU, \
		federal RIC with waiting list, TI programme.
	|

Study self consumption Owners[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=Study self consumption start year,Self consumption degree[District\
		,HS,Performance,Type],
	0)
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study exported kWh Owners[District,HS,Performance,Type]=
	PV annual generation per building[District,Type]*(1-Study self consumption Owners[District\
		,HS,Performance,Type])
	~	kWh/year
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Owners ordinary cash[District,HS,Performance,Type]=
	PV annual generation per building[District,Type]*(Study self consumption Owners[District\
		,HS,Performance,Type]*Electricity price[District]-PV annual mantainance cost)+Study exported kWh Owners\
		[District,HS,Performance,Type]*Exp expected export price
	~	CHF/year
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Owners ordinary utility[District,HS,Performance,Type]=
	(Study current Owners ordinary PV[District,HS,Performance,Type]-Study cost RU[District\
		,Type])/Study cost RU[District,Type]/PV lifetime*100
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Owners federal utility[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=2014 :AND: kWp installed per building[District,Type]<10,
	-1000,(Study current Owners ordinary PV[District,HS,Performance,Type]+Study exported kWh Owners\
		[District,HS,Performance,Type]*(Study RIC tariff[District,Type]-Exp expected export price\
		)*Study federal factor-Study cost without RU[District,Type])/Study cost without RU[\
		District,Type]/PV lifetime*100)
	~	Dmnl
	~	[CH-align 05.11.2026] Utility if admitted to the federal RIC (premium \
		after the wait, no RU); the admission probability now weights the regimes.
	|

Study current Owners TI utility[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=2014 :AND: Time<2018 :AND: kWp installed per building[District,Type\
		]>=10 :AND: kWp installed per building[District,Type]<30,
	(Study current Owners ordinary PV[District,HS,Performance,Type]+Study TI admission probability\
		*Study exported kWh Owners[District,HS,Performance,Type]*(Study RIC tariff[District\
		,Type]-Exp expected export price)*Study TI factor-Study cost without RU[District,Type\
		])/Study cost without RU[District,Type]/PV lifetime*100,
	-1000)
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Owners TI RU utility[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=2014 :AND: Time<2018 :AND: kWp installed per building[District,Type\
		]>=10 :AND: kWp installed per building[District,Type]<30,
	(Study current Owners ordinary PV[District,HS,Performance,Type]+Study TI admission probability\
		*(MAX(0,
	Study exported kWh Owners[District,HS,Performance,Type]*Study RIC tariff[District,Type\
		]-Study TI annual offset[District,Type])-Study exported kWh Owners[District,HS,Performance\
		,Type]*Exp expected export price)*Study TI factor-Study cost RU[District,Type])/Study cost RU\
		[District,Type]/PV lifetime*100,
	-1000)
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Owners historical utility[District,HS,Performance,Type]=
	Study federal admission probability*Study current Owners federal utility[District,HS\
		,Performance,Type]+(1-Study federal admission probability)*MAX(Study current Owners ordinary utility\
		[District,HS,Performance,Type], MAX(Study current Owners TI utility[District,HS,Performance\
		,Type], Study current Owners TI RU utility[District,HS,Performance,Type]))
	~	Dmnl
	~	[CH-align 05.11.2026] Expected utility: federal RIC with probability p, \
		otherwise the best of ordinary sale + RU and the TI programme (RIC-TI, \
		2014-2017). Was the maximum of all regimes with p only on the RIC premium.
	|

Study self consumption Renter[District,HS,Performance,Type]=
	0
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study exported kWh Renter[District,HS,Performance,Type]=
	PV annual generation per building[District,Type]*(1-Study self consumption Renter[District\
		,HS,Performance,Type])
	~	kWh/year
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Renter ordinary cash[District,HS,Performance,Type]=
	PV annual generation per building[District,Type]*(Study self consumption Renter[District\
		,HS,Performance,Type]*Electricity price[District]-PV annual mantainance cost)+Study exported kWh Renter\
		[District,HS,Performance,Type]*Exp expected export price
	~	CHF/year
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Renter ordinary utility[District,HS,Performance,Type]=
	(Study current Renter ordinary PV[District,HS,Performance,Type]-Study cost RU[District\
		,Type])/Study cost RU[District,Type]/PV lifetime*100
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Renter federal utility[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=2014 :AND: kWp installed per building[District,Type]<10,
	-1000,(Study current Renter ordinary PV[District,HS,Performance,Type]+Study exported kWh Renter\
		[District,HS,Performance,Type]*(Study RIC tariff[District,Type]-Exp expected export price\
		)*Study federal factor-Study cost without RU[District,Type])/Study cost without RU[\
		District,Type]/PV lifetime*100)
	~	Dmnl
	~	[CH-align 05.11.2026] Utility if admitted to the federal RIC (premium \
		after the wait, no RU); the admission probability now weights the regimes.
	|

Study current Renter TI utility[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=2014 :AND: Time<2018 :AND: kWp installed per building[District,Type\
		]>=10 :AND: kWp installed per building[District,Type]<30,
	(Study current Renter ordinary PV[District,HS,Performance,Type]+Study TI admission probability\
		*Study exported kWh Renter[District,HS,Performance,Type]*(Study RIC tariff[District\
		,Type]-Exp expected export price)*Study TI factor-Study cost without RU[District,Type\
		])/Study cost without RU[District,Type]/PV lifetime*100,
	-1000)
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Renter TI RU utility[District,HS,Performance,Type]=
	IF THEN ELSE(Time>=2014 :AND: Time<2018 :AND: kWp installed per building[District,Type\
		]>=10 :AND: kWp installed per building[District,Type]<30,
	(Study current Renter ordinary PV[District,HS,Performance,Type]+Study TI admission probability\
		*(MAX(0,
	Study exported kWh Renter[District,HS,Performance,Type]*Study RIC tariff[District,Type\
		]-Study TI annual offset[District,Type])-Study exported kWh Renter[District,HS,Performance\
		,Type]*Exp expected export price)*Study TI factor-Study cost RU[District,Type])/Study cost RU\
		[District,Type]/PV lifetime*100,
	-1000)
	~	Dmnl
	~	[CORE M01/E08] Utility of the best available regime (normalised 30-year \
		return, same scale as PV Eco Utility).
	|

Study current Renter historical utility[District,HS,Performance,Type]=
	Study federal admission probability*Study current Renter federal utility[District,HS\
		,Performance,Type]+(1-Study federal admission probability)*MAX(Study current Renter ordinary utility\
		[District,HS,Performance,Type], MAX(Study current Renter TI utility[District,HS,Performance\
		,Type], Study current Renter TI RU utility[District,HS,Performance,Type]))
	~	Dmnl
	~	[CH-align 05.11.2026] Expected utility: federal RIC with probability p, \
		otherwise the best of ordinary sale + RU and the TI programme (RIC-TI, \
		2014-2017). Was the maximum of all regimes with p only on the RIC premium.
	|

Calendar enabled=
	1
	~	Dmnl
	~	[CORE M04] 1 = adoptions are realised after a preparation time (orders -> \
		completions); 0 = original immediate acceptance.
	|

Calendar preparation months=
	3
	~	month
	~	[CORE M04] Average preparation time between order and commissioning \
		(E07-E19 reference: 3 months).
	|

Calendar ready share=
	1-Calendar preparation months/12
	~	Dmnl
	~	[CORE M04] Share of the orders of a year that can be commissioned in the \
		same year (orders spread uniformly over the year).
	|

Calendar pending total[District,HS,Performance,Type]=
	Calendar pending Owners PV[District,HS,Performance,Type] + Calendar pending Owners RCP\
		[District,HS,Performance,Type] + Calendar pending Owners RCPv[District,HS,Performance\
		,Type] + Calendar pending Renters PV[District,HS,Performance,Type] + Calendar pending Renters RCP\
		[District,HS,Performance,Type] + Calendar pending Renters RCPv[District,HS,Performance\
		,Type]
	~	building
	~	[CORE M04] Orders placed but not yet commissioned.
	|

Calendar retention[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar pending total[District,HS,Performance,Type]>0, MIN(1,Available PV adoption\
		[District,HS,Performance,Type]/Calendar pending total[District,HS,Performance,Type]\
		),1)
	~	Dmnl
	~	[CORE M04] Share of pending orders still feasible (buildings still \
		available); the rest is cancelled.
	|

Calendar order fraction[District,HS,Performance,Type]=
	MIN(1, ZIDZ(Available PV adoption[District,HS,Performance,Type], Total PV request[District\
		,HS,Performance,Type])) * MAX(0,
	1-XIDZ(Calendar pending total[District,HS,Performance,Type], Available PV adoption[District\
		,HS,Performance,Type], 1))
	~	Dmnl
	~	[CORE M04] Requests turned into new orders: limited by available buildings \
		and net of buildings that already have an order pending (no double \
		counting).
	|

Calendar orders Owners PV[District,HS,Performance,Type]=
	MAX(0, Requested Owners adopting PV[District,HS,Performance,Type])*Calendar order fraction\
		[District,HS,Performance,Type]
	~	building/year
	~	[CORE M04] New orders of the year.
	|

Calendar pending Owners PV[District,HS,Performance,Type]=
	INTEG(Calendar orders Owners PV[District,HS,Performance,Type]*(1-Calendar ready share\
		)-Calendar pending Owners PV[District,HS,Performance,Type]/TIME STEP,
	0)
	~	building
	~	[CORE M04] Orders of the previous year not yet commissioned at the start \
		of the year.
	|

Calendar completed Owners PV[District,HS,Performance,Type]=
	Calendar ready share*Calendar orders Owners PV[District,HS,Performance,Type]+Calendar retention\
		[District,HS,Performance,Type]*Calendar pending Owners PV[District,HS,Performance,Type\
		]/TIME STEP
	~	building/year
	~	[CORE M04] Commissioned installations: share ready in the order year + \
		pending orders of the previous year.
	|

Calendar orders Owners RCP[District,HS,Performance,Type]=
	MAX(0, Requested Owners adopting RCP[District,HS,Performance,Type])*Calendar order fraction\
		[District,HS,Performance,Type]
	~	building/year
	~	[CORE M04] New orders of the year.
	|

Calendar pending Owners RCP[District,HS,Performance,Type]=
	INTEG(Calendar orders Owners RCP[District,HS,Performance,Type]*(1-Calendar ready share\
		)-Calendar pending Owners RCP[District,HS,Performance,Type]/TIME STEP,
	0)
	~	building
	~	[CORE M04] Orders of the previous year not yet commissioned at the start \
		of the year.
	|

Calendar completed Owners RCP[District,HS,Performance,Type]=
	Calendar ready share*Calendar orders Owners RCP[District,HS,Performance,Type]+Calendar retention\
		[District,HS,Performance,Type]*Calendar pending Owners RCP[District,HS,Performance,\
		Type]/TIME STEP
	~	building/year
	~	[CORE M04] Commissioned installations: share ready in the order year + \
		pending orders of the previous year.
	|

Calendar orders Owners RCPv[District,HS,Performance,Type]=
	MAX(0, Requested Owners adopting RCPv[District,HS,Performance,Type])*Calendar order fraction\
		[District,HS,Performance,Type]
	~	building/year
	~	[CORE M04] New orders of the year.
	|

Calendar pending Owners RCPv[District,HS,Performance,Type]=
	INTEG(Calendar orders Owners RCPv[District,HS,Performance,Type]*(1-Calendar ready share\
		)-Calendar pending Owners RCPv[District,HS,Performance,Type]/TIME STEP,
	0)
	~	building
	~	[CORE M04] Orders of the previous year not yet commissioned at the start \
		of the year.
	|

Calendar completed Owners RCPv[District,HS,Performance,Type]=
	Calendar ready share*Calendar orders Owners RCPv[District,HS,Performance,Type]+Calendar retention\
		[District,HS,Performance,Type]*Calendar pending Owners RCPv[District,HS,Performance\
		,Type]/TIME STEP
	~	building/year
	~	[CORE M04] Commissioned installations: share ready in the order year + \
		pending orders of the previous year.
	|

Calendar orders Renters PV[District,HS,Performance,Type]=
	MAX(0, Requested Renters adopting PV[District,HS,Performance,Type])*Calendar order fraction\
		[District,HS,Performance,Type]
	~	building/year
	~	[CORE M04] New orders of the year.
	|

Calendar pending Renters PV[District,HS,Performance,Type]=
	INTEG(Calendar orders Renters PV[District,HS,Performance,Type]*(1-Calendar ready share\
		)-Calendar pending Renters PV[District,HS,Performance,Type]/TIME STEP,
	0)
	~	building
	~	[CORE M04] Orders of the previous year not yet commissioned at the start \
		of the year.
	|

Calendar completed Renters PV[District,HS,Performance,Type]=
	Calendar ready share*Calendar orders Renters PV[District,HS,Performance,Type]+Calendar retention\
		[District,HS,Performance,Type]*Calendar pending Renters PV[District,HS,Performance,\
		Type]/TIME STEP
	~	building/year
	~	[CORE M04] Commissioned installations: share ready in the order year + \
		pending orders of the previous year.
	|

Calendar orders Renters RCP[District,HS,Performance,Type]=
	MAX(0, Requested Renters adopting RCP[District,HS,Performance,Type])*Calendar order fraction\
		[District,HS,Performance,Type]
	~	building/year
	~	[CORE M04] New orders of the year.
	|

Calendar pending Renters RCP[District,HS,Performance,Type]=
	INTEG(Calendar orders Renters RCP[District,HS,Performance,Type]*(1-Calendar ready share\
		)-Calendar pending Renters RCP[District,HS,Performance,Type]/TIME STEP,
	0)
	~	building
	~	[CORE M04] Orders of the previous year not yet commissioned at the start \
		of the year.
	|

Calendar completed Renters RCP[District,HS,Performance,Type]=
	Calendar ready share*Calendar orders Renters RCP[District,HS,Performance,Type]+Calendar retention\
		[District,HS,Performance,Type]*Calendar pending Renters RCP[District,HS,Performance\
		,Type]/TIME STEP
	~	building/year
	~	[CORE M04] Commissioned installations: share ready in the order year + \
		pending orders of the previous year.
	|

Calendar orders Renters RCPv[District,HS,Performance,Type]=
	MAX(0, Requested Renters adopting RCPv[District,HS,Performance,Type])*Calendar order fraction\
		[District,HS,Performance,Type]
	~	building/year
	~	[CORE M04] New orders of the year.
	|

Calendar pending Renters RCPv[District,HS,Performance,Type]=
	INTEG(Calendar orders Renters RCPv[District,HS,Performance,Type]*(1-Calendar ready share\
		)-Calendar pending Renters RCPv[District,HS,Performance,Type]/TIME STEP,
	0)
	~	building
	~	[CORE M04] Orders of the previous year not yet commissioned at the start \
		of the year.
	|

Calendar completed Renters RCPv[District,HS,Performance,Type]=
	Calendar ready share*Calendar orders Renters RCPv[District,HS,Performance,Type]+Calendar retention\
		[District,HS,Performance,Type]*Calendar pending Renters RCPv[District,HS,Performance\
		,Type]/TIME STEP
	~	building/year
	~	[CORE M04] Commissioned installations: share ready in the order year + \
		pending orders of the previous year.
	|

Calendar pending count=
	SUM(Calendar pending total[District!,HS!,Performance!,Type!])
	~	building
	~	[CORE M04] Diagnostic.
	|

PV adoptions by archetype legacy[District,HS,Performance,Type,Battery]=
	DELAY FIXED(New buildings installing PV[District,HS,Performance,Type,Battery]+Consumers adopting PV yes with battery\
		[District,HS,Performance,Type,PVyes,Battery],
	0.01,0)
	~	building/year
	~	[CORE E07] Original 0.01-year DELAY FIXED, used only with Calendar enabled \
		= 0 (must be a separate level).
	|

RCPv adoptions by archetype legacy[District,HS,Performance,Type,Battery]=
	DELAY FIXED(Consumers adopting RCPv yes with battery[District,HS,Performance,Type,PVyes\
		,Battery],
	0.01,0)
	~	building/year
	~	[CORE E07] Original 0.01-year DELAY FIXED, used only with Calendar enabled \
		= 0.
	|

Battery generation[District,HS,Performance,Type]=
	kWp installed per building[District,Type]*PV annual generation per kW
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery direct use[District,HS,Performance,Type]=
	MIN(El consumption per building[District,HS,Performance,Type],MIN(Battery generation\
		[District,HS,Performance,Type],
	MAX(0,Battery generation[District,HS,Performance,Type]*Self consumption degree household\
		[District,HS,Performance,Type])))
	~	kWh/year
	~	[EV-PV balance 06.11.2026] PV used directly by the household demand \
		(household self-consumption; the EV part is counted on the stock in EV PV \
		self consumption).
	|

Battery charging[District,HS,Performance,Type]=
	MIN(Battery generation[District,HS,Performance,Type]-Battery direct use[District,HS,\
		Performance,Type],
	MIN((El consumption per building[District,HS,Performance,Type]-Battery direct use[District\
		,HS,Performance,Type])/Decentralized storage efficiency,
	MAX(0,Battery generation[District,HS,Performance,Type]*(Self consumption degree with Storage household\
		[District,HS,Performance,Type]-Self consumption degree household[District,HS,Performance\
		,Type]))))
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery delivered[District,HS,Performance,Type]=
	Battery charging[District,HS,Performance,Type]*Decentralized storage efficiency
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery loss[District,HS,Performance,Type]=
	Battery charging[District,HS,Performance,Type]-Battery delivered[District,HS,Performance\
		,Type]
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery generation RCPv[District,HS,Performance,Type]=
	kWp installed per building RCPv[District,Type]*PV annual generation per kW
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery direct use RCPv[District,HS,Performance,Type]=
	MIN(El consumption per building[District,HS,Performance,Type],MIN(Battery generation RCPv\
		[District,HS,Performance,Type],
	MAX(0,Battery generation RCPv[District,HS,Performance,Type]*Self consumption degree RCPv\
		[District,HS,Performance,Type])))
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery charging RCPv[District,HS,Performance,Type]=
	MIN(Battery generation RCPv[District,HS,Performance,Type]-Battery direct use RCPv[District\
		,HS,Performance,Type],
	MIN((El consumption per building[District,HS,Performance,Type]-Battery direct use RCPv\
		[District,HS,Performance,Type])/Decentralized storage efficiency,
	MAX(0,Battery generation RCPv[District,HS,Performance,Type]*(Self consumption degree with Storage RCPv\
		[District,HS,Performance,Type]-Self consumption degree RCPv[District,HS,Performance\
		,Type]))))
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery delivered RCPv[District,HS,Performance,Type]=
	Battery charging RCPv[District,HS,Performance,Type]*Decentralized storage efficiency
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery loss RCPv[District,HS,Performance,Type]=
	Battery charging RCPv[District,HS,Performance,Type]-Battery delivered RCPv[District,\
		HS,Performance,Type]
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery annual loss added[District,HS,Performance,Type]=
	IF THEN ELSE(Time<2015,0,PV adoptions by archetype[District,HS,Performance,Type,Byes\
		]*Battery loss[District,HS,Performance,Type]+RCPv adoptions by archetype[District,HS\
		,Performance,Type,Byes]*Battery loss RCPv[District,HS,Performance,Type])
	~	kWh/year/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery annual loss installed[District,HS,Performance,Type]=
	INTEG(Battery annual loss added[District,HS,Performance,Type]-Battery annual loss installed\
		[District,HS,Performance,Type]*PV removal fraction[District,HS,Performance,Type],
	0)
	~	kWh/year
	~	[CORE E19] Physically consistent battery balance: direct use, charging, \
		delivered energy and losses bounded by production and demand.
	|

Battery residential losses GWh=
	SUM(Battery annual loss installed[District!,HS!,Performance!,Type!])/1e+06
	~	GWh/year
	~	[CORE E19] Storage losses removed from PV production fed to the grid.
	|

PV buildings[District,HS,Performance,Type]=
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!])
	~	building
	~	[CORE E19] Buildings with PV, used for the removal fraction of installed \
		battery losses.
	|

PV removal fraction[District,HS,Performance,Type]=
	IF THEN ELSE(PV buildings[District,HS,Performance,Type]>1e-10,MIN(1/TIME STEP,
	SUM(Building demolition by archetype[District,HS,Performance,Type,PVyes,Battery!])/IF THEN ELSE\
		(PV buildings[District,HS,Performance,Type]>1e-10,
	PV buildings[District,HS,Performance,Type],1)),0)
	~	1/year
	~	[CORE E19] Share of PV buildings demolished in the year. Stocks at or below \
		1e-10 buildings are numerical zero.
	|

Dispatchable supply by supplier[Month,Hour,Supplier]=
	MAX(0, Hourly available supply by Supplier[Month,Hour,Supplier])
	~	
	~	[CORE dispatch] Non-negative capacity offered to dispatch.
	|

Electricity dispatch balance error[Month,Hour]=
	SUM(Electricity dispatched[Month,Hour,Supplier!]) - MIN(Hourly demand and PHS[Month,\
		Hour],
	SUM(Dispatchable supply by supplier[Month,Hour,Supplier!]))
	~	
	~	[CORE dispatch] Diagnostic: zero when dispatch equals demand capped by \
		capacity.
	|

Unserved hourly electricity[Month,Hour]=
	MAX(0, Hourly demand and PHS[Month,Hour] - SUM(Electricity dispatched[Month,Hour,Supplier\
		!]))
	~	
	~	[CORE dispatch] Diagnostic: demand not served.
	|

PV SC check=
	SUM(PV Hourly SC computed[Month!,Hour!]) * 365 / 12
	~	
	~		|

Hourly electricity grid demand[Month,Hour]=
	IF THEN ELSE( PV Hourly SC computed[Month,Hour] < Hourly electricity demand[Month,Hour\
		] , Hourly electricity demand[Month,Hour] - PV Hourly SC computed[Month,Hour] , 0 )
	~	
	~		|

Hourly el demand with PV[Month,Hour]=
	Hourly electricity demand[Month,Hour] * Share of buildings with PV
	~	
	~		|

PV hour SC[Month,Hour]=
	MIN( PV hourly production[Month,Hour] , Hourly el demand with PV[Month,Hour] )
	~	
	~		|

PV Hourly SC computed[Month,Hour]=
	Total PV electricity SC * PV hour SC[Month,Hour] / SUM(PV hour SC[Month!,Hour!]) / (\
		 365 / 12 )
	~	
	~		|

Building demolition by archetype[District,HS,VeryLow,Type,PVpanel,Battery]=
	Res VeryLow demolition[District,Type] * Share HS by archetype[District,HS,VeryLow,Type\
		,PVpanel,Battery] ~~|
Building demolition by archetype[District,HS,Performance,Type,PVpanel,Battery] :EXCEPT:\
		  [District,HS,VeryLow,Type,PVpanel,Battery]=
	0
	~	
	~		|

Total PV kWh SC[District,HS,Performance,Type]= INTEG (
	Additional annual PV kWh SC[District,HS,Performance,Type]-PV kWh SC demolished[District\
		,HS,Performance,Type],
		0)
	~	kWh
	~		|

PV kW installed Residential[District,HS,Performance,Type]= INTEG (
	Annual PV kW installation[District,HS,Performance,Type] - PV kW Residential demolished\
		[District,HS,Performance,Type],
		Initial kWp installed by archetype[District,HS,Performance,Type])
	~	kW
	~		|

Annual CO2 tax archetype[District,HS,Performance,Type,PVpanel] :EXCEPT:  [District,NonRenSolution\
		,Performance,Type,PVpanel]=
	0 ~~|
Annual CO2 tax archetype[District,Oil,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] * SUM(Heating Solution[District,Oil,Performance,Type\
		,PVpanel,Battery!]) +
	
	Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,Oil,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[OilBoiler] * CO2 tax * 0.00026532 ~~|
Annual CO2 tax archetype[District,OilST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,Oil,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[OilBoiler] * CO2 tax * 0.00026532 ~~|
Annual CO2 tax archetype[District,Gas,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] * SUM(Heating Solution[District,Gas,Performance,Type\
		,PVpanel,Battery!]) +
	
	Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,Gas,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[GasBoiler] * CO2 tax * 0.0002016 ~~|
Annual CO2 tax archetype[District,GasST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 * SUM(Heating Solution[District,GasST,Performance,Type,PVpanel,Battery!]) ) / Efficiency\
		[GasBoiler] * CO2 tax * 0.0002016 ~~|
Annual CO2 tax archetype[District,ElectricHeater,Performance,Type,PVpanel]=
	0
	~	CHF
	~		|

PV kWh SC demolished[District,HS,Performance,Type]=
	PV kWh self consumed demolished[District,HS,Performance,Type]
	~	
	~		|

PV kWh self consumed[District,HS,Performance,Type]= INTEG (
	Additional annual PV kWh self consumed[District,HS,Performance,Type]-PV kWh self consumed demolished\
		[District,HS,Performance,Type],
		0)
	~	kWh
	~		|

PV kWh self consumed demolished[District,HS,Performance,Type]=
	IF THEN ELSE( Time < 2015 , 0 , SUM(Building demolition by archetype[District,HS,Performance\
		,Type,PVyes,Battery!]) * kWp installed per building[District,Type] * PV annual generation per kW\
		* Self consumption degree household[District,HS,Performance,Type] )
	~	
	~	[EV-PV balance 06.11.2026] Household self-consumption of demolished \
		buildings (consistent with Battery direct use).
	|

PV kW Residential demolished[District,HS,Performance,Type]=
	SUM(Building demolition by archetype[District,HS,Performance,Type,PVyes,Battery!]) *\
		 kWp installed per building[District,Type]
	~	
	~		|

Requested Owners adopting RCP[District,HS,Performance,Type] :EXCEPT:    [District,HS,\
		Performance,MFH]=
	0 ~~|
Requested Owners adopting RCP[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share of owned houses[MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Owners[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) ) , 0 )
	~	
	~		|

Requested Owners adopting PV[District,HS,Performance,Type] :EXCEPT:                 [\
		District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] * Probability adoption PV Owners[District\
		,HS,Performance,Type] ) ,
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	(1 - Share urban buildings[District,Type] ) * Probability adoption PV Owners[District\
		,HS,Performance,Type] * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * Share of owned houses[Type] - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,Type] + Owned buildings with RCP[District,Type] + Owned buildings with RCPv\
		[District,Type] + Owned buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * Probability adoption PV Owners\
		[District,HS,Performance,Type] * ( Energy Community scenario - 1 ) ) , 0 ) ~~|
Requested Owners adopting PV[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery!]) > \
		0 ,
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Owned buildings with PV\
		[District,MFH] + Owned buildings with RCP[District,MFH] + Owned buildings with RCPv\
		[District,MFH] + Owned buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption PV Owners[District,HS,Performance,MFH] , 
	
	SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * Share urban buildings[District,MFH] * Probability adoption PV Owners\
		[District,HS,Performance,MFH] ) , 0 ) , 0 )
	~	
	~		|

Rented buildings with RCP[District,Type]= INTEG (
	Renters adopting RCP flow[District,Type]-Rented buildings with RCP demolished[District\
		,Type],
		0)
	~	
	~		|

Owned buildings with RCPv[District,Type]= INTEG (
	Owners adopting RCPv flow[District,Type]-Owned buildings with RCPv demolished[District\
		,Type],
		0)
	~	
	~		|

Rented buildings with RCPv[District,Type]= INTEG (
	Renters adopting RCPv flow[District,Type]-Rented buildings with RCPv demolished[District\
		,Type],
		0)
	~	
	~		|

House Value coefficient HT[Performance,HS] :EXCEPT: [Performance,HPs]=
	0.1295 ~~|
House Value coefficient HT[Performance,HPs]=
	House Value coefficient[Performance]
	~	Dmnl
	~		|

Rented buildings with PV[District,Type]= INTEG (
	Renters adopting PV flow[District,Type]-Rented buildings with PV demolished[District\
		,Type],
		SUM(Initial Heating Solution[District,HS!,Performance!,Type,PVyes]) * ( 1 - Share of owned houses\
		[Type] ))
	~	
	~		|

Requested Renters adopting RCP[District,HS,Performance,Type] :EXCEPT:        [District\
		,HS,Performance,MFH]=
	0 ~~|
Requested Renters adopting RCP[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 0 , 
	
	IF THEN ELSE( Time < 2025 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] ) / SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery\
		!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] * ( 1 - Share urban buildings\
		[District,MFH] ) * Energy Community scenario - 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption RCP Renters[District,HS,Performance,MFH] * ( Energy Community scenario\
		 - 1 ) ) ) , 0 )
	~	
	~		|

Annual fuel cost archetype[District,HS,Performance,Type,PVpanel] :EXCEPT: [District,No Electricity\
		,Performance,Type,PVpanel]=
	0 ~~|
Annual fuel cost archetype[District,Oil,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler] ~~|
Annual fuel cost archetype[District,OilST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[OilBoiler] * Carrier used cost per kWh[District,OilBoiler] ~~|
Annual fuel cost archetype[District,Gas,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler] ~~|
Annual fuel cost archetype[District,GasST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[GasBoiler] * Carrier used cost per kWh[District,GasBoiler] ~~|
Annual fuel cost archetype[District,Wood,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler] ~~|
Annual fuel cost archetype[District,WoodST,Performance,Type,PVpanel]=
	( Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[WoodBoiler] * Carrier used cost per kWh[District,WoodBoiler] ~~|
Annual fuel cost archetype[District,pellet,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		 ) / Efficiency[PelletBoiler] * Carrier used cost per kWh[District,PelletBoiler] ~~|
Annual fuel cost archetype[District,DH,Performance,Type,PVpanel]=
	( Annual DHW demand[District,Type] + Annual SH demand[District,Performance,Type] * Annual heating degree days coefficient\
		) * Carrier cost DH
	~	CHF
	~		|

Requested Renters adopting PV[District,HS,Performance,Type] :EXCEPT:                [\
		District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2025 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery!]) >\
		 0 , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] ) / SUM(Heating Solution[District,HS!,Performance!,Type,PVyes,Battery\
		!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] , 
	
	SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) * Probability adoption PV Renters\
		[District,HS,Performance,Type] ) , 
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] * ( 1 - Share urban buildings\
		[District,Type] ) * Energy Community scenario -
	
	( SUM(Heating Solution[District,HS,Performance,Type,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,Type] * ( 1 - Share of owned houses[Type] ) - 
	SUM(Heating Solution[District,HS,Performance,Type,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,Type] + Rented buildings with RCP[District,Type] + Rented buildings with RCPv\
		[District,Type] + Rented buildings with RCPv PVno[District,Type] ) / SUM(Heating Solution\
		[District,HS!,Performance!,Type,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,Type] * ( Energy Community scenario\
		 - 1 ) ) , 0 ) ~~|
Requested Renters adopting PV[District,HS,Performance,MFH]=
	MAX( IF THEN ELSE( Time < 2018 , 
	
	IF THEN ELSE( SUM(Heating Solution[District,HS!,Performance!,MFH,PVyes,Battery!]) > \
		0 , 
	
	( SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) - 
	SUM(Heating Solution[District,HS,Performance,MFH,PVyes,Battery!]) * ( Rented buildings with PV\
		[District,MFH] + Rented buildings with RCP[District,MFH] + Rented buildings with RCPv\
		[District,MFH] + Rented buildings with RCPv PVno[District,MFH] ) / SUM(Heating Solution\
		[District,HS!,Performance!,MFH,PVyes,Battery!]) ) * 
	Probability adoption PV Renters[District,HS,Performance,MFH] , 
	
	SUM(Heating Solution[District,HS,Performance,MFH,PVpanel!,Battery!]) * Share of buildings with suitable roof\
		[District,MFH] * ( 1 - Share of owned houses[MFH] ) * Probability adoption PV Renters\
		[District,HS,Performance,MFH] ) , 0 ) , 0 )
	~	
	~		|

