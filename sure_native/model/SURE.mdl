		,(2026,344.939),(2027,365.302),(2028,366.296),(2029,355.488),(2030,344.233),(2031,332.872\
		),(2032,318.41),(2033,304.086),(2034,289.491),(2035,262.973),(2036,234.813),(2037,219.28\
		),(2038,209.45),(2039,199.463),(2040,189.074),(2041,178.723),(2042,163.549),(2043,147.778\
