		[District,HP] ~~|
Annual variable costs SH[District,WoodST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler] ~~|
Annual variable costs SH[District,HPST,Performance,Type]=
	Annual SH demand[District,Performance,Type] / HP efficiency[Performance] * Carrier used cost per kWh\
		[District,HP] ~~|
Annual variable costs SH[District,Oil,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[OilBoiler] * Carrier used cost per kWh\
		[District,OilBoiler] ~~|
Annual variable costs SH[District,Gas,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[GasBoiler] * Carrier used cost per kWh\
		[District,GasBoiler] ~~|
Annual variable costs SH[District,Wood,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[WoodBoiler] * Carrier used cost per kWh\
		[District,WoodBoiler] ~~|
Annual variable costs SH[District,ElectricHeater,Performance,Type]=
	Annual SH demand[District,Performance,Type] / Efficiency[EH] * Carrier used cost per kWh\
		[District,EH] ~~|
Annual variable costs SH[District,DH,Performance,Type]=
	Annual SH demand[District,Performance,Type] / 1 * Carrier cost DH
	~	CHF
	~		|

"Initial grant < 15 kW"[OilBoiler]=
	0 ~~|
"Initial grant < 15 kW"[GasBoiler]=
	0 ~~|
"Initial grant < 15 kW"[PelletBoiler]=
	IF THEN ELSE(Time < 2022 , 0, 
	
	IF THEN ELSE(Time < 2025 , 5000 , 
	
	IF THEN ELSE( Time < 2030 , 7000 , 7000 ) ) ) ~~|
"Initial grant < 15 kW"[HP]=
	IF THEN ELSE(Time < 2017, 3000 , 
	
	IF THEN ELSE(Time < 2022, 4000 , 
	
	IF THEN ELSE(Time < 2030, 7000 , 7000 ) ) ) ~~|
"Initial grant < 15 kW"[EH]=
	0 ~~|
"Initial grant < 15 kW"[ST]=
	IF THEN ELSE(Time < 2017, 2500, 
	
	IF THEN ELSE(Time < 2022 , 1200 , 
	
	IF THEN ELSE(Time < 2025 , 2500 , 
	
	
	IF THEN ELSE(Time < 2030 , 2400 , 2400 ) ) ) ) ~~|
"Initial grant < 15 kW"[WoodBoiler]=
	0
	~	CHF
	~		|

"Investment grant per kW < 15 kW"[OilBoiler]=
	0 ~~|
"Investment grant per kW < 15 kW"[GasBoiler]=
	0 ~~|
"Investment grant per kW < 15 kW"[PelletBoiler]=
	IF THEN ELSE(Time < 2022, 0, 
	
	IF THEN ELSE( Time < 2025 , 100 , 
	
	IF THEN ELSE( Time < 2030 , 0 , 0 ) ) ) ~~|
"Investment grant per kW < 15 kW"[HP]=
	IF THEN ELSE(Time < 2017, 0, 
	
	IF THEN ELSE(Time < 2022, 100,
	
	IF THEN ELSE(Time < 2030 , 300 , 0 ) ) ) ~~|
"Investment grant per kW < 15 kW"[EH]=
	0 ~~|
"Investment grant per kW < 15 kW"[ST]=
	IF THEN ELSE(Time < 2016.1, 0, 
	
	IF THEN ELSE(Time < 2021.1, 200, 
	
	IF THEN ELSE(Time < 2030, 500 , 0 ) ) ) ~~|
"Investment grant per kW < 15 kW"[WoodBoiler]=
	0
	~	CHF/kW
	~	IF THEN ELSE(Time < 2016.1, 0, 
		
		IF THEN ELSE(Time < 2021.1, 100,
		
		IF THEN ELSE(Time < 2030 , 180 , 180 ) ) )
	|

Emissions per capacity installed[OilBoiler]=
	21.1 ~~|
Emissions per capacity installed[GasBoiler]=
	21.1 ~~|
Emissions per capacity installed[PelletBoiler]=
	21.1 ~~|
Emissions per capacity installed[HP]=
	164.9 ~~|
Emissions per capacity installed[EH]=
	1.47 ~~|
Emissions per capacity installed[ST]=
	221.2 ~~|
Emissions per capacity installed[WoodBoiler]=
	21.1
	~	CO2eq/kW
	~		|

Tech:
	OilBoiler, GasBoiler, WoodBoiler, PelletBoiler, HP, EH, ST
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2050
	~	year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2011
	~	year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	year [0,?]
	~	The time step for the simulation.
	|

Available PV adoption[District,HS,Performance,Type]=
	MAX(0, Heating Solution[District,HS,Performance,Type,PVno,Bno] - MAX(0, Building demolition by archetype\
		[District,HS,Performance,Type,PVno,Bno]) - MAX(0, Buildings HS Renovation From[District\
		,HS,Performance,Type,PVno,Bno]))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Total PV request[District,HS,Performance,Type]=
	MAX(0, Requested Owners adopting PV[District,HS,Performance,Type]) + 
	MAX(0, Requested Owners adopting RCP[District,HS,Performance,Type]) + 
	MAX(0, Requested Owners adopting RCPv[District,HS,Performance,Type]) + 
	MAX(0, Requested Renters adopting PV[District,HS,Performance,Type]) + 
	MAX(0, Requested Renters adopting RCP[District,HS,Performance,Type]) + 
	MAX(0, Requested Renters adopting RCPv[District,HS,Performance,Type])
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Accepted PV adoption[District,HS,Performance,Type] =
	MIN(Available PV adoption[District,HS,Performance,Type], Total PV request[District,HS\
		,Performance,Type])
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Owners adopting PV[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Owners PV[District,HS,Performance\
		,Type],
	MAX(0, Requested Owners adopting PV[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Owners adopting RCP[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Owners RCP[District,HS,Performance\
		,Type],
	MAX(0, Requested Owners adopting RCP[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Owners adopting RCPv[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Owners RCPv[District,HS,Performance\
		,Type],
	MAX(0, Requested Owners adopting RCPv[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Renters adopting PV[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Renters PV[District,HS,Performance\
		,Type],
	MAX(0, Requested Renters adopting PV[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Renters adopting RCP[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Renters RCP[District,HS,Performance\
		,Type],
	MAX(0, Requested Renters adopting RCP[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

Renters adopting RCPv[District,HS,Performance,Type]=
	IF THEN ELSE(Calendar enabled>0.5, Calendar completed Renters RCPv[District,HS,Performance\
		,Type],
	MAX(0, Requested Renters adopting RCPv[District,HS,Performance,Type]) * (Accepted PV adoption\
		[District,HS,Performance,Type]/IF THEN ELSE(Total PV request[District,HS,Performance\
		,Type]>0,
	Total PV request[District,HS,Performance,Type], 1)))
	~	building/year
	~	sure-v6-pv-budget-2: shared PV source budget.
	|

