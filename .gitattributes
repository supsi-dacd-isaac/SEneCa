# Il .mdl e un sorgente di testo, ma con terminazioni di riga che Vensim
# gestisce da se: niente normalizzazione.
*.mdl -text whitespace=cr-at-eol
*.pdf binary
*.pkl binary
*.xlsx binary
# Runtime/provenance text uses identical bytes on Windows and Unix.
*.py text eol=lf
*.json text eol=lf
# Preserve the received calibration bytes for provenance checks.
Vensim/calibration/*.out -text
# CSV input and calibration-curve hashes use the canonical LF checkout bytes.
Vensim/*_pysd_ems1.csv text eol=lf
content/system_dynamics/plots_data/calibration_sim_adoptions_ems1.csv text eol=lf
