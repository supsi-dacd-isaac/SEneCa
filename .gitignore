# Ambiente virtuale locale
.venv/
dist/
.data-release-installed.json

# Credenziali locali (non versionare le chiavi API)
.env
.env.*
!.env.example

# Bytecode Python
__pycache__/
*.py[cod]

# Snapshot binari: pubblicati come asset delle release dati, non in Git.
*.parquet
*.vpmx
*.vdfx

# Directory di lavoro create dai runner Vensim
precomputed/**/_runs/

# Backup automatici della pipeline di ritraduzione
Vensim/_backup_retranslate_*/
*.py.pre_hotpath

# Log della ritraduzione / validazione
_retranslate_*.log
_coherence_*.log
